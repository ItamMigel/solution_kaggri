#!/bin/bash
# Read-only guard around the Kaggle CLI. Submissions are reserved for the human (HARD RULE).
for a in "$@"; do
  case "$a" in
    submit|push|create|launch|settings|solution|init) echo "BLOCKED: 'kaggle $*' — agents never submit/modify on Kaggle. Hand the artifact to the user." >&2; exit 97;;
  esac
done
exec /workspace/kaggriculture/.venv/bin/python -m kaggle.cli "$@"
