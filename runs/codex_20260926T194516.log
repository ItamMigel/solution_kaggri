  4538	def _ca_decays(mls, a, b):
  4539	    """Decay events at steps s in [max(a, mls), b) with (s - mls) even."""
  4540	    a = max(a, mls)
  4541	    if b <= a:
  4542	        return 0
  4543	    first = a if (a - mls) % 2 == 0 else a + 1
  4544	    return 0 if first >= b else (b - 1 - first) // 2 + 1
