  2785	def _r97_market_stock(shed,orders):
  2786	    stock=dict(shed);buys={};sales={}
  2787	    for index,order in enumerate(orders):
  2788	        if len(order)<3:continue
  2789	        op,item,n=order[:3];n=max(0,int(n))
  2790	        if op=='SELL':
  2791	            q=min(n,max(0,stock.get(item,0)));stock[item]=stock.get(item,0)-q;sales[index]=q
  2792	        elif op in ('BUY_PRODUCT','BUY_ANIMAL'):
  2793	            q=min(n,max(0,100-sum(stock.values())));stock[item]=stock.get(item,0)+q;buys[index]=q
  2794	    return stock,buys,sales
