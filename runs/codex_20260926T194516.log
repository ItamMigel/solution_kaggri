  7145	def _33_seedfloat_agent(observation, configuration=None):
  7146	    action = _33_SF_PARENT(observation, configuration)
  7147	    try:
  7148	        step = int(observation["step"])
  7149	        if step < _33_SF_FROM:
  7150	            return action
  7151	        market = [list(o) for o in (action.get("market") or [])]
  7152	        seeds = observation["private"]["seeds"]; prices = observation["market"]["prices"]
  7153	        units = [action.get("farmer")] + list(action.get("hands") or [])
  7154	        pw = sum(1 for u in units if u and u[:2] == ["PLANT", "WHEAT"])
  7155	        pc = sum(1 for u in units if u and u[:2] == ["PLANT", "CARROT"])
  7156	        w_ahead = _33_SF_W[step + 1] if step < 719 else 0
  7157	        c_ahead = _33_SF_C[step + 1] if step < 719 else 0
  7158	        p_c, p_w = float(prices.get("CARROT", 0)), float(prices.get("WHEAT", 0))
  7159	        swapping = 3 * (p_c - _CA_DROP) - 20 > 4 * p_w - 10 + _CA_MARGIN and step // 24 <= _CA_TO
  7160	        need_c = c_ahead + (w_ahead if swapping else 0)
  7161	        need_w = 0 if swapping else w_ahead
  7162	        c_left = int(seeds.get("CARROT", 0)) - pc
  7163	        w_left = int(seeds.get("WHEAT", 0)) - pw
  7164	        allow_c = max(0, need_c - c_left)
  7165	        out = []
  7166	        for o in market:
  7167	            if len(o) >= 3 and o[:2] == ["BUY_SEED", "CARROT"]:
  7168	                q = min(int(o[2]), allow_c); allow_c -= q
  7169	                _33_SF_REPORT["carrot_cut"] += int(o[2]) - q
  7170	                c_left += q
  7171	                if q <= 0:
  7172	                    continue
  7173	                o = ["BUY_SEED", "CARROT", q]
  7174	            out.append(o)
  7175	        short_c = max(0, need_c - c_left)
  7176	        allow_w = max(0, min(w_ahead, need_w + short_c + _33_SF_HEDGE) - w_left)
  7177	        final = []
  7178	        for o in out:
  7179	            if len(o) >= 3 and o[:2] == ["BUY_SEED", "WHEAT"]:
  7180	                q = min(int(o[2]), allow_w); allow_w -= q
  7181	                _33_SF_REPORT["wheat_cut"] += int(o[2]) - q
  7182	                if q <= 0:
  7183	                    continue
  7184	                o = ["BUY_SEED", "WHEAT", q]
  7185	            final.append(o)
  7186	        if final != market:
  7187	            action = dict(action, market=final)
  7188	    except Exception:
  7189	        _33_SF_REPORT["errors"] += 1
  7190	    return action
