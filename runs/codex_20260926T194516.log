  2562	def _r85_feed(obs, action):
  2563	    step=int(obs['step']);day=step//24
  2564	    if not 10<=day<=28 or step%24>21:return action
  2565	    player=int(obs['player']);native=_IMPL.chassis.players[player]
  2566	    tape=_v219_native_day(native,day)
