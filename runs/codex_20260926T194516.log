  3793	def _v9_town_draw(shops, step):
  3794	    """Units each shop instance and the town centre remove after `step`'s market."""
  3795	    draw = dict.fromkeys(V9_RACE_ITEMS, 0)
  3796	    if step % 4 == 0:
