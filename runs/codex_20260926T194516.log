  2569	    commands=[action.get('farmer') or ['PASS'],*(action.get('hands') or [])]
  2570	    prices=obs['market']['prices'];changed=False
  2571	    for actor,command in enumerate(commands[:expected+1]):
  2572	        if command!=['FEED'] or actor>=len(positions):continue
  2573	        tile=_tile_at(farm['tiles'],positions[actor])
  2574	        if not isinstance(tile,dict) or tile.get('animal') not in ('GOOSE','COW','SHEEP'):continue
  2575	        if tile.get('fed_today') or int(tile.get('consecutive_unfed',0))!=0:continue
  2576	        if int(obs['private']['inventories'][actor].get('WHEAT',0))<=0:continue
  2577	        item={'GOOSE':'EGG','COW':'MILK','SHEEP':'WOOL'}[tile['animal']]
  2578	        bonus=_r88_feed_bonus_cost(tile,day)
  2579	        if bonus*(float(prices[item])+5)*1.25>=float(prices['WHEAT']):continue
  2580	        if not _r86_next_feed(obs,positions[actor]):continue
  2581	        commands[actor]=['PASS'];changed=True
  2582	        _R85_REPORT['feed_skips']+=1
