  3339	    action = _V9_FERT_PARENT(observation, configuration)
  3340	    try:
  3341	        return _v9_fert(observation, action)
  3342	    except Exception:
  3343	        _V9_FERT_REPORT["fert_errors"] += 1
  3344	        return action
