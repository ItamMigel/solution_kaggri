  2601	    for parent in (_V219_STATES.get(player,{}),_V233_STATES.get(player,{})):
  2602	        for actor,role in parent.get('workers',{}).items():
  2603	            if not isinstance(role,dict) or not role.get('needs_fertilizer') or role.get('loaded'):continue
  2604	            desired=role.get('fertilizer_quantity',10 if role.get('kind')=='fertilizer' else 5)
  2605	            carried=obs['private']['inventories'][actor].get('FERTILIZER',0)
