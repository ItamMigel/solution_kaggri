  7126	# busyaprime, 2026-09-21, Apache-2.0. Seed float trim for the last planting day (v2).
  7127	# On day 27 the chassis switches to route 2, and the CARROT2 layer keeps a float of carrot seed
  7128	# (buffer 8) while the tape keeps buying wheat seed for its own plants. Nothing planted after day 27
  7129	# can be harvested before the engine's last acted step (718), so whatever float is left at the end is
  7130	# money spent on nothing. This layer reads the PLANT orders still ahead on the route 2 tape, asks
  7131	# CARROT2's own price test whether those plants will turn into carrots, and caps the seed buys so the
  7132	# float never exceeds what the rest of the day can plant, plus a small wheat hedge.
  7133	_33_SF_TAPE = _IMPL.chassis.routes.get(2) or []
  7134	_33_SF_W = [0] * 721
  7135	_33_SF_C = [0] * 721
  7136	for _t in range(719, -1, -1):
  7137	    _a = _33_SF_TAPE[_t] if _t < len(_33_SF_TAPE) else {}
  7138	    _u = [_x for _x in [_a.get("farmer")] + list(_a.get("hands") or []) if _x and _x[0] == "PLANT" and _t <= 671]
  7139	    _33_SF_W[_t] = _33_SF_W[_t + 1] + sum(1 for _x in _u if _x[1] == "WHEAT")
