  6490	    else:
  6491	        CT_TABLE={}
  6492	        tape[0]['market']=[['BUY_PRODUCT','WHEAT',5],['BUY_SEED','WHEAT',1]]
  6493	        tape[1]['market']=[o for o in tape[1]['market'] if not (len(o)>=3 and o[0] in ('BUY_PRODUCT','SELL') and o[1]=='WHEAT')]
  6494	    # Day-zero idle hand 1 walks from (5,4) to the future (2,4) pasture.
  6495	    for step,command in {2:['WEST'],3:['WEST'],4:['WEST'],5:['PLANT','WHEAT'],6:['WATER']}.items():
  6496	        assert tape[step]['hands'][1]==['PASS']
  6497	        tape[step]['hands'][1]=command
  6498	    # On day one, water instead of building the not-yet-needed pasture.
  6499	    assert tape[29]['hands'][2]==['BUILD_PASTURE']
  6500	    tape[29]['hands'][2]=['WATER']
  6501	    # Day-two idle hand 0: water, harvest, restore pasture, deliver.
  6502	    commands=[['WEST'],['WEST'],['WEST'],['WATER'],['HARVEST'],['BUILD_PASTURE'],['EAST'],['EAST'],['DROP']]
  6503	    for step,command in zip(range(49,58),commands):
  6504	        assert tape[step]['hands'][0]==['PASS']
  6505	        tape[step]['hands'][0]=command
  6506	    if mode=='TomatoInsteadOfCow':
  6507	        tape[0]['market'].append(['BUY_SEED','TOMATO',1])
