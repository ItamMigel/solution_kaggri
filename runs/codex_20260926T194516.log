  3818	def _v9_race_update(obs, st):
  3819	    """Recover last turn's rival sales and record the leads that prove racing."""
  3820	    prev = st["prev"]
  3821	    step = int(obs["step"])
  3822	    if not prev or prev["step"] != step - 1:
  3823	        return
  3824	    native = _IMPL.chassis.players.get(int(obs["player"]))
  3825	    if not native or native.get("route") not in _IMPL.chassis.routes:
