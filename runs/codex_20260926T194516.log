  3838	        if prev["left"].get(item, 0) <= 0:
  3839	            continue
  3840	        planned = _v9_planned_sells(tape, item, t)
  3841	        after = [s for s in planned if s >= t]
  3842	        before = [s for s in planned if s < t]
  3843	        if not after or (before and t - before[-1] < V9_RACE_GAP):
  3844	            continue
  3845	        st["lead"] = max(st["lead"], after[0] - t)
  3846	        _V9_RACE_REPORT["leads"] += 1
  3847	
  3848	
  3849	_V9_RACE_PARENT = agent
  3850	
