  6531	def agent(observation,configuration=None):
  6532	    seat,step=int(observation['player']),int(observation['step'])
  6533	    state=_ALT_STATE.get(seat)
  6534	    if state is None or step<=state['step']:
  6535	        mode=_ALT_MODE
  6536	        if mode=='Mixed':
  6537	            # Private RNG: no mutation of the engine or opponent's random state.
  6538	            # Seed is used only for reproducible opening selection, never prediction.
  6539	            import random as _opening_random
  6540	            seed=(configuration or {}).get('seed',0)
  6541	            bit=_opening_random.Random('productive-opening:'+str(seed)+':'+str(seat)).getrandbits(1)
  6542	            mode='EarlyCycle' if bit else 'Original'
  6543	        _alt_install(mode)
  6544	        state=_ALT_STATE[seat]={'step':-1,'mode':mode}
  6545	        _ALT_REPORT.clear()
  6546	        _ALT_REPORT.update(selected_opening=mode,temporary_crop_seen=0,temporary_crop_harvested=0,
  6547	                           restored_pasture_seen=0,delivered_extra_wheat=0,tomato_seen=0,
  6548	                           tomato_water_requests=0,tomato_harvest_requests=0,tomato_units_harvest_requested=0,
  6549	                           extension_errors=0)
  6550	    action=_ALT_PARENT(observation,configuration)
  6551	    try:
  6552	        mode=state['mode']
