  3068	def _v9_carrot(obs, action, st):
  3069	    step = int(obs["step"])
  3070	    day = step // 24
  3071	    prices = obs["market"]["prices"]
  3072	    private = obs["private"]
  3073	    commands = [list(action.get("farmer") or ["PASS"])] + [list(c) for c in (action.get("hands") or [])]
  3074	    market = [list(o) for o in action.get("market") or []]
  3075	    changed = False
  3076	    if st.get("tiles"):
  3077	        # swapped carrots die at the start of age 4, but the wheat tape may harvest at age 4:
  3078	        # harvest them on the age-3 watering visit instead
  3079	        _farm = obs["farms"][int(obs["player"])]
  3080	        _pos = [_farm["farmer"]] + list(_farm["hands"])
  3081	        for _i, c in enumerate(commands[:len(_pos)]):
  3082	            if c != ["WATER"]:
  3083	                continue
  3084	            _p = tuple(_pos[_i])
  3085	            if st["tiles"].get(_p) != day - 3:
  3086	                continue
  3087	            _t = _farm["tiles"][_p[1]][_p[0]]
  3088	            if isinstance(_t, dict) and _t.get("crop") == "CARROT" and int(_t.get("planted_day", -9)) == day - 3 and int(_t.get("yield_units", 0)) > 0:
  3089	                commands[_i] = ["HARVEST"]
  3090	                changed = True
