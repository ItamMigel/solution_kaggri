  3493	    seen = st["obs"]
  3494	    lo = step - 240
  3495	    scored = []
  3496	    recent = [(tt, i) for (tt, i) in seen if tt >= lo]
  3497	    for ep, ev in cands:
  3498	        m = f = 0
  3499	        for (tt, i), q in ev.items():
  3500	            if lo <= tt < step - 1:
