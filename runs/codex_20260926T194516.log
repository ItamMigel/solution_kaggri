  3264	# ---------------------------------------------------------------------------
  3265	# v9 FERT: spend carried fertilizer on young wheat and carrots.
  3266	#
  3267	# Workers that tend animals carry collected fertilizer back to the shed, where
  3268	# the tape sells it into a book that falls from $55 on day 14 to $10 by day 27.
  3269	# On a short crop the same unit is worth far more: a watered wheat plant ends at
  3270	# 4 units, but fertilized for its yield window it caps at 6.  A worker that
  3271	# carries fertilizer and is about to water a wheat or carrot plant one day
  3272	# after planting (watered on planting day, not yet fertilized) fertilizes it
  3273	# instead; the tape waters it again on the following days.  Fertilizer the
  3274	# worker's own tape commands still spend today is left alone, and the layer only
  3275	# acts from day 16, once the fertilizer book is worth less than two wheat.
  3276	# ---------------------------------------------------------------------------
  3277	V9_FERT_CROPS = ("WHEAT", "CARROT")
  3278	V9_FERT_AGES = (1,)
  3279	V9_FERT_FIRST_DAY = 14
  3280	_V9_FERT_REPORT = dict(fert_applied=0, fert_errors=0)
  3281	
  3282	
  3283	def _v9_fert(obs, action):
  3284	    step = int(obs["step"])
  3285	    day = step // 24
  3286	    if day < V9_FERT_FIRST_DAY or step >= 700:
  3287	        return action
  3288	    player = int(obs["player"])
  3289	    farm = obs["farms"][player]
  3290	    positions = [tuple(farm["farmer"])] + [tuple(p) for p in farm["hands"]]
  3291	    inventories = obs["private"]["inventories"]
  3292	    commands = [list(action.get("farmer") or ["PASS"])] + [list(c) for c in (action.get("hands") or [])]
  3293	    changed = False
  3294	    native = _IMPL.chassis.players.get(player)
  3295	    tape = _IMPL.chassis.routes.get(native.get("route")) if native else None
  3296	    planned = {}
  3297	    if tape is not None:
  3298	        # fertilizer this worker's own tape commands still spend today
  3299	        for t in range(step, min(len(tape), day * 24 + 24)):
  3300	            a = tape[t] or {}
  3301	            for u, c in enumerate([a.get("farmer") or ["PASS"]] + list(a.get("hands") or [])):
  3302	                if c and c[0] == "FERTILIZE":
  3303	                    planned[u] = planned.get(u, 0) + 1
  3304	    carried = {}
  3305	    targeted = set()
  3306	    for unit, command in enumerate(commands[:len(positions)]):
  3307	        if not command or command[0] != "WATER":
  3308	            continue
  3309	        x, y = positions[unit]
  3310	        tile = farm["tiles"][y][x]
  3311	        if not (isinstance(tile, dict) and tile.get("kind") == "PLANT" and tile.get("crop") in V9_FERT_CROPS):
  3312	            continue
  3313	        if (day - int(tile["planted_day"])) not in V9_FERT_AGES or tile.get("watered_today"):
  3314	            continue
  3315	        if int(tile.get("consecutive_unwatered", 1)) != 0 or int(tile.get("fertilized_until_day", -1)) >= day:
  3316	            continue
  3317	        have = carried.setdefault(unit, int((inventories[unit] if unit < len(inventories) else {}).get("FERTILIZER", 0))
  3318	                                  - planned.get(unit, 0))
  3319	        if have <= 0 or (x, y) in targeted:
  3320	            continue
  3321	        commands[unit] = ["FERTILIZE"]
  3322	        carried[unit] = have - 1
  3323	        targeted.add((x, y))
  3324	        changed = True
  3325	        _V9_FERT_REPORT["fert_applied"] += 1
  3326	    if not changed:
  3327	        return action
  3328	    result = dict(action)
  3329	    result["farmer"], result["hands"] = commands[0], commands[1:]
  3330	    return result
  3331	
