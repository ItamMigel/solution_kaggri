  3505	        miss = sum(1 for (tt, i) in recent if (tt, i) not in ev and (tt - 1, i) not in ev and (tt + 1, i) not in ev)
  3506	        scored.append((m - 0.5 * f - 0.5 * miss, ev))
  3507	    scored.sort(key=lambda x: -x[0])
