  7658	def _hp_land(obs, action):
  7659	    """Macro L: buy a quadrant up to land_k steps before the current Horizon tape plans it (if cash stays >= buffer);
  7660	    then drop the next Horizon BUY_LAND (from tape or any layer) so the total number of quadrants is unchanged."""
