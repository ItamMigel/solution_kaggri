  2719	    native=_IMPL.chassis.players[player];route=native['route']
  2720	    key=(route,step)
  2721	    if key not in _R95_RESERVES:
  2722	        demand=6  # Physical buffer beyond every scheduled pickup and sale.
  2723	        for t in range(step+1,min(719,step+49)):
  2724	            a=_IMPL.chassis.routes[2 if t>=648 else route][t]
  2725	            for c in [a.get('farmer') or ['PASS'],*(a.get('hands') or [])]:
  2726	                if c[:2]==['PICKUP','WHEAT']:
  2727	                    demand+=max(0,int(c[2]) if len(c)>2 else 1)
  2728	            for o in a.get('market',[]):
  2729	                if len(o)>2 and o[:2]==['SELL','WHEAT']:
  2730	                    demand+=max(0,int(o[2]))
  2731	        _R95_RESERVES[key]=demand
  2732	    demand=_R95_RESERVES[key]
  2733	    # Reserve full feed for a possible southeast sheep commitment. Do not
  2734	    # rely on its future discretionary buy, eligibility, or existing cargo.
  2735	    if obs['town']['unlocked_shops'].count('YARN_STORE')>=2:
  2736	        demand+=6*len({t//24 for t in range(step+1,step+49) if t//24>=12})
