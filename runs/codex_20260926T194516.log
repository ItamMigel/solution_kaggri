  3048	# ---------------------------------------------------------------------------
  3049	# v9 CARROT: plant carrots instead of wheat when the carrot book pays for it.
  3050	#
  3051	# The tape replants wheat on the same short cycle a carrot needs (water daily,
  3052	# harvest at age 2-4), so the swap keeps every worker's schedule intact.  A
  3053	# watered wheat plant yields 4 and a carrot 3, for $10 more seed, so the swap
  3054	# only pays once the carrot quote clears V9_CARROT_RATIO x the wheat quote --
  3055	# which pet cafes and farmers markets make happen by draining the hinge book.
  3056	# Wheat is also feed, so the swap stops while the shed holds less than
  3057	# V9_CARROT_WHEAT_RESERVE wheat.
  3058	# ---------------------------------------------------------------------------
  3059	V9_CARROT_RATIO = 1.8
  3060	V9_CARROT_FIRST_DAY = 10
  3061	V9_CARROT_LAST_DAY = 23
  3062	V9_CARROT_WHEAT_RESERVE = 40
  3063	V9_CARROT_BOOM_RATIO = 3.5   # from this ratio the feed reserve is bought instead of grown
  3064	V9_CARROT_BOOM_RESERVE = 10
  3065	_V9_CARROT_REPORT = dict(carrot_swaps=0, carrot_seed_swaps=0, carrot_errors=0)
  3066	
  3067	
  3068	def _v9_carrot(obs, action, st):
  3069	    step = int(obs["step"])
  3070	    day = step // 24
  3071	    prices = obs["market"]["prices"]
  3072	    private = obs["private"]
  3073	    commands = [list(action.get("farmer") or ["PASS"])] + [list(c) for c in (action.get("hands") or [])]
  3074	    market = [list(o) for o in action.get("market") or []]
  3075	    changed = False
  3076	    if st.get("tiles"):
  3077	        # swapped carrots die at the start of age 4, but the wheat tape may harvest at age 4:
  3078	        # harvest them on the age-3 watering visit instead
  3079	        _farm = obs["farms"][int(obs["player"])]
  3080	        _pos = [_farm["farmer"]] + list(_farm["hands"])
  3081	        for _i, c in enumerate(commands[:len(_pos)]):
  3082	            if c != ["WATER"]:
  3083	                continue
  3084	            _p = tuple(_pos[_i])
  3085	            if st["tiles"].get(_p) != day - 3:
  3086	                continue
  3087	            _t = _farm["tiles"][_p[1]][_p[0]]
  3088	            if isinstance(_t, dict) and _t.get("crop") == "CARROT" and int(_t.get("planted_day", -9)) == day - 3 and int(_t.get("yield_units", 0)) > 0:
  3089	                commands[_i] = ["HARVEST"]
  3090	                changed = True
  3091	                _V9_CARROT_REPORT["carrot_rescues"] = _V9_CARROT_REPORT.get("carrot_rescues", 0) + 1
  3092	    wheat_held = int(private["shed"].get("WHEAT", 0)) + sum(int(i.get("WHEAT", 0)) for i in private["inventories"])
  3093	    ratio = int(prices.get("CARROT", 0)) / max(1, int(prices.get("WHEAT", 99)))
  3094	    boom = ratio >= V9_CARROT_BOOM_RATIO
  3095	    reserve = V9_CARROT_BOOM_RESERVE if boom else V9_CARROT_WHEAT_RESERVE
  3096	    if boom and V9_CARROT_FIRST_DAY <= day <= V9_CARROT_LAST_DAY and wheat_held < V9_CARROT_WHEAT_RESERVE:
  3097	        # Carrots are worth several wheat each: buy the feed the swap no longer grows.
  3098	        topup = V9_CARROT_WHEAT_RESERVE - wheat_held
  3099	        budget = float(obs["farms"][int(obs["player"])]["money"]) - 1500
  3100	        qty = min(topup, int(budget // max(1, int(prices.get("WHEAT", 99)) + 5)))
  3101	        if qty > 0 and len(market) < MAX_ORDERS and not any(o[:2] == ["BUY_PRODUCT", "WHEAT"] for o in market if len(o) >= 2):
  3102	            market.append(["BUY_PRODUCT", "WHEAT", qty])
  3103	            changed = True
  3104	    if (V9_CARROT_FIRST_DAY <= day <= V9_CARROT_LAST_DAY and wheat_held >= reserve
  3105	            and ratio >= V9_CARROT_RATIO):
  3106	        carrot_seeds = int(private["seeds"].get("CARROT", 0)) - sum(1 for c in commands if c[:2] == ["PLANT", "CARROT"])
  3107	        _farm = obs["farms"][int(obs["player"])]
  3108	        _pos = [_farm["farmer"]] + list(_farm["hands"])
  3109	        for _i, c in enumerate(commands):
  3110	            if c[:2] == ["PLANT", "WHEAT"] and carrot_seeds > 0:
  3111	                c[1] = "CARROT"
  3112	                carrot_seeds -= 1
  3113	                changed = st["swapped"] = True
  3114	                _V9_CARROT_REPORT["carrot_swaps"] += 1
  3115	                if _i < len(_pos):
  3116	                    st.setdefault("tiles", {})[tuple(_pos[_i])] = day
  3117	        for o in market:
  3118	            if len(o) >= 3 and o[:2] == ["BUY_SEED", "WHEAT"]:
  3119	                o[1] = "CARROT"
  3120	                changed = st["swapped"] = True
  3121	                _V9_CARROT_REPORT["carrot_seed_swaps"] += int(o[2])
  3122	    result = dict(action)
  3123	    result["farmer"], result["hands"], result["market"] = commands[0], commands[1:], market
  3124	    if st.get("swapped") and day < 24:
  3125	        # Swapped carrots have no planned sale on the tape before its own carrot days.
  3126	        stock = projected_shed(result, FarmView(obs)).get("CARROT", 0)
  3127	        selling = sum(int(o[2]) for o in market if len(o) >= 3 and o[:2] == ["SELL", "CARROT"])
  3128	        if stock > selling and len(market) < MAX_ORDERS and int(prices.get("CARROT", 0)) >= 2:
  3129	            market.insert(0, ["SELL", "CARROT", stock - selling])
  3130	            changed = True
  3131	    return result if changed else action
  3132	
