  2690	def _r88_feed_bonus_cost(tile, day):
  2691	    first, interval = _R88_ANIMAL_DAYS[tile['animal']]
  2692	    first += int(tile['placed_day'])
  2693	    tomorrow = day + 1
  2694	    produces = tomorrow >= first and (tomorrow - first) % interval == 0
  2695	    pending = max(0, int(tile.get('pending_care_bonus', 0)))
  2696	    if _R88_PHASE and not produces:
  2697	        pending = 0  # It remains banked on non-production dawns.
  2698	    care = 1  # Conservative: charge one possible CARE even if not yet observed.
  2699	    if _R88_HORIZON:
  2700	        # Today's care is added AFTER tomorrow's production; its first possible
  2701	        # payout is a later production dawn, which must occur before game end.
  2702	        next_use = first
  2703	        if next_use <= tomorrow:
  2704	            next_use += ((tomorrow - next_use) // interval + 1) * interval
  2705	        if next_use > 29:
  2706	            care = 0
  2707	    return pending + care
