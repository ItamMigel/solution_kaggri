  4500	def _ca_spawn(positions, board):
  4501	    half = board // 2
  4502	    access = [(half - 1, half - 1), (half, half - 1), (half - 1, half), (half, half)]
  4503	    occ = {a: 0 for a in access}
  4504	    for p in positions:
  4505	        if tuple(p) in occ:
  4506	            occ[tuple(p)] += 1
