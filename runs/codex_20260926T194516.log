  4510	def _ca_visits(obs, action, pos, t_end, start=None):
  4511	    """Non-move commands issued on tile ``pos`` from this step (with ``action``) until ``t_end``."""
  4512	    seat = int(obs["player"])
  4513	    step = int(obs["step"])
  4514	    farm = obs["farms"][seat]
  4515	    board = len(farm["tiles"])
  4516	    half = board // 2
  4517	    positions = [list(farm["farmer"])] + [list(h) for h in farm["hands"]]
  4518	    out = []
  4519	    for t in range(step, min(t_end, 719) + 1):
  4520	        act = action if t == step else _ca_tape(seat, t)
  4521	        units = [act.get("farmer") or ["PASS"]] + list(act.get("hands") or [])
  4522	        for i in range(len(positions)):
  4523	            cmd = units[i] if i < len(units) and units[i] else ["PASS"]
  4524	            if cmd[0] in _CA_MOVES:
  4525	                dx, dy = _CA_MOVES[cmd[0]]
  4526	                nx, ny = positions[i][0] + dx, positions[i][1] + dy
  4527	                if 0 <= nx < board and 0 <= ny < board:
