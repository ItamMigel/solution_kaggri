  3092	    wheat_held = int(private["shed"].get("WHEAT", 0)) + sum(int(i.get("WHEAT", 0)) for i in private["inventories"])
  3093	    ratio = int(prices.get("CARROT", 0)) / max(1, int(prices.get("WHEAT", 99)))
  3094	    boom = ratio >= V9_CARROT_BOOM_RATIO
  3095	    reserve = V9_CARROT_BOOM_RESERVE if boom else V9_CARROT_WHEAT_RESERVE
  3096	    if boom and V9_CARROT_FIRST_DAY <= day <= V9_CARROT_LAST_DAY and wheat_held < V9_CARROT_WHEAT_RESERVE:
  3097	        # Carrots are worth several wheat each: buy the feed the swap no longer grows.
  3098	        topup = V9_CARROT_WHEAT_RESERVE - wheat_held
  3099	        budget = float(obs["farms"][int(obs["player"])]["money"]) - 1500
  3100	        qty = min(topup, int(budget // max(1, int(prices.get("WHEAT", 99)) + 5)))
  3101	        if qty > 0 and len(market) < MAX_ORDERS and not any(o[:2] == ["BUY_PRODUCT", "WHEAT"] for o in market if len(o) >= 2):
  3102	            market.append(["BUY_PRODUCT", "WHEAT", qty])
  3103	            changed = True
  3104	    if (V9_CARROT_FIRST_DAY <= day <= V9_CARROT_LAST_DAY and wheat_held >= reserve
  3105	            and ratio >= V9_CARROT_RATIO):
  3106	        carrot_seeds = int(private["seeds"].get("CARROT", 0)) - sum(1 for c in commands if c[:2] == ["PLANT", "CARROT"])
  3107	        _farm = obs["farms"][int(obs["player"])]
  3108	        _pos = [_farm["farmer"]] + list(_farm["hands"])
  3109	        for _i, c in enumerate(commands):
  3110	            if c[:2] == ["PLANT", "WHEAT"] and carrot_seeds > 0:
  3111	                c[1] = "CARROT"
  3112	                carrot_seeds -= 1
