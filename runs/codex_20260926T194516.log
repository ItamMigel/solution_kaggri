  3731	# ---------------------------------------------------------------------------
  3732	# v9 RACE: fit the sale-reservation horizon to the rival's observed sale lead.
  3733	#
  3734	# Premium books crash within ~60 units of glut, so the first seller of a lot
  3735	# takes the price and the second sells into the crash.  The parent reserves
  3736	# planned tape sales a fixed four turns ahead; any deeper fixed horizon beats
  3737	# it head-to-head, but selling earlier than necessary gives away town-demand
  3738	# recovery against a rival that does not race.
  3739	#
  3740	# Everything here is public.  Each turn the rival's executed sales are
  3741	#
  3742	#   rival_sold[p] = inventory'[p] - inventory[p] + town_draw[p] - own_sold[p]
  3743	#
  3744	# (exact above the $1 floor, where sales never enter inventory).  When the
  3745	# rival sells a product while we still hold stock that our tape sells later,
  3746	# and the sale is not a late fill of our previous lot, the turns until our next
  3747	# planned sale are the rival's lead.  One horizon serves every product:
  3748	#
  3749	#   horizon = clamp(largest lead seen + RACE_MARGIN, RACE_DEFAULT, RACE_MAX)
  3750	#
  3751	# and it also lifts the parent's 72-turn block bound (patched into the
  3752	# parent's reservation by the release builder).
  3753	#
  3754	# v9/2: the shipped horizon is 40 turns with a 12-turn margin (was 6 and 4).
  3755	# Mirrors are the ladder's real opponent, and the premium books are first-come
  3756	# races, so reserve depth is the whole decision.  Against the 6/4 build the new
  3757	# setting wins 73-7 (+308) over 80 mirror games; against the shipped 32/12 build
  3758	# it wins 74-6 (+358).  Deeper is not better: 44/12 beats 40 head to head but
  3759	# drops the shallow-baseline record to 65-15, and 48/12 (a constant 48) falls to
  3760	# 14-26 against it, because a horizon past the rival's next lot gives up
  3761	# town-demand recovery for nothing.  The frozen top-30 stream panel is unchanged
  3762	# inside its noise (52.2% / +2,797 over 178 games vs 52.8% / +2,929 at 32/12) and
  3763	# the public field still goes 8-0.
  3764	#
  3765	# v9/2b: the reservation window starts at step 192 (day 8) instead of 288 (day 12),
  3766	# a one-line change in the parent's `_r36_reserve` gate made by the release builder.
  3767	# The herd's first milk and wool lots land on days 8-11 and the same-day sale
  3768	# reservation is what takes their price before a rival's lot lands; the two middle
  3769	# days of the tape's own schedule give that up.  Three fresh mirror blocks against
  3770	# the step-288 build: 32-0 (+147), 30-2 (+11), 30-2 (+10); and against the shallow
  3771	# 6/4 baseline the new build is if anything stronger, not weaker: 28-4 (+556) vs
  3772	# 28-4 (+406), 29-3 (+272), 31-1 (+359) vs 31-1 (+349).  Per-item horizons instead of
  3773	# one global horizon change nothing once the window starts at 192 (28 of 32 games
  3774	# identical), so the one-line gate is the whole change.
  3775	# ---------------------------------------------------------------------------
  3776	V9_RACE_DEFAULT = 40
  3777	V9_RACE_MAX = 48
  3778	V9_RACE_MARGIN = 12
  3779	V9_RACE_GAP = 3            # a sale this soon after our previous planned lot is a late fill
  3780	V9_RACE_WINDOW = 30        # turns of tape searched for planned sales around a rival sale
  3781	V9_RACE_ITEMS = ("CARROT", "TOMATO", "STRAWBERRY", "MELON", "EGG", "MILK", "WOOL")
  3782	_V9_SHOP_ITEMS = {
  3783	    "BAKERY": ("EGG", "WHEAT"), "PIZZA_SHOP": ("MILK", "TOMATO", "WHEAT"),
  3784	    "BRUNCH_SPOT": ("EGG", "WHEAT", "STRAWBERRY"), "YARN_STORE": ("WOOL",),
  3785	    "ICE_CREAM_SHOP": ("STRAWBERRY", "MILK", "WHEAT"), "PET_CAFE": ("CARROT",),
  3786	    "SMOOTHIE_SHOP": ("STRAWBERRY", "MILK"),
  3787	    "FARMERS_MARKET": ("WHEAT", "CARROT", "TOMATO", "STRAWBERRY"),
  3788	}
  3789	_V9_RACE = {}
  3790	_V9_RACE_REPORT = dict(rival_sales=0, leads=0, race_errors=0)
  3791	
