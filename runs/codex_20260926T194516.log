  2587	def _r85_reserve(obs, state):
  2588	    step=int(obs['step']);player=int(obs['player']);native=_IMPL.chassis.players[player]
  2589	    route=native['route'];key=(route,step)
  2590	    cache=state.setdefault('native_reserves',{})
  2591	    if route not in cache:
  2592	        # Backward recurrence preserves field-before-market order within a turn.
  2593	        reserve=[0]*720
  2594	        for t in range(718,-1,-1):
  2595	            a=_IMPL.chassis.routes[2 if t>=648 else route][t]
  2596	            pickup=sum(max(0,int(c[2]) if len(c)>2 else 1) for c in [a.get('farmer') or ['PASS'],*(a.get('hands') or [])] if len(c)>1 and c[:2]==['PICKUP','FERTILIZER'])
  2597	            purchase=sum(max(0,int(o[2])) for o in a.get('market',[]) if len(o)>2 and o[:2]==['BUY_PRODUCT','FERTILIZER'])
  2598	            reserve[t]=pickup+max(0,reserve[t+1]-purchase)
  2599	        cache[route]=reserve
