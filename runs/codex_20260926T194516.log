  2741	    if not 10<=step//24<=11:return action
  2742	    orders=action.get('market') or []
  2743	    if not any(len(o)>2 and o[:2]==['BUY_PRODUCT','WHEAT'] and int(o[2])>0 for o in orders):return action
  2744	    # Preserve all same-turn grain trading/arbitrage sequences unchanged.
  2745	    if any(o[:2]==['SELL','WHEAT'] for o in orders):return action
  2746	    farm,private=_PLANNER_NS['_clone_state'](obs['farms'][obs['player']],obs['private'])
  2747	    commands=[action.get('farmer') or ['PASS'],*(action.get('hands') or [])]
