import json, os, subprocess
K='/workspace/shared/bin/kaggle'
threshold='2026-09-26T22:00:00'
for sid,src in ((56584540,'/tmp/es7_episodes.json'),(56580877,'/tmp/es6_episodes.json')):
    raw=open(src).read(); episodes=json.JSONDecoder().raw_decode(raw.lstrip())[0]
    selected=[x for x in episodes if x.get('state','').endswith('COMPLETED') and x['endTime']>=threshold]
    dest=f'/workspace/shared/replays/ours_final/{sid}'
    os.makedirs(dest,exist_ok=True)
    done=skip=0
    for i,e in enumerate(selected,1):
        gz=f\"{dest}/episode-{e['id']}-replay.json.gz\"; plain=gz[:-3]
        if os.path.exists(gz):
            skip+=1; continue
        cp=subprocess.run([K,'competitions','replay',str(e['id']),'-p',dest,'-q'], text=True, capture_output=True, timeout=600)
        if cp.returncode:
            raise RuntimeError(f\"replay {e['id']}: {cp.stderr[-1000:]}\")
        if not os.path.exists(plain):
            raise FileNotFoundError(plain)
        subprocess.run(['gzip','-f',plain],check=True)
        done+=1
        print(f'{sid} {i}/{len(selected)} {e[\"id\"]}',flush=True)
    print(f'COMPLETE {sid}: downloaded={done} existing={skip} total={len(selected)}',flush=True)
