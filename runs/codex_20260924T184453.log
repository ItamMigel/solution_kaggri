import argparse, base64, io, os, sys, zlib
import numpy as np, torch
HERE = os.path.dirname(os.path.abspath(__file__))

RUNTIME = r'''
# limit BLAS threads (thread thrash made 10 s/turn on a loaded box)
def _limit_threads():
    import ctypes, glob as _gl, os as _os
    try:
        import numpy as _np
        d = _os.path.join(_os.path.dirname(_np.__file__), "..", "numpy.libs")
        for lib in _gl.glob(_os.path.join(d, "*openblas*")):
            L = ctypes.CDLL(lib)
            for fn in ("scipy_openblas_set_num_threads64_", "openblas_set_num_threads64_", "openblas_set_num_threads", "scipy_openblas_set_num_threads"):
                if hasattr(L, fn):
