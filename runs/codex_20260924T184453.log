   102	    rec = dict(board=board, G=G, uv=uv, ux=ux.to(torch.int8), uy=uy.to(torch.int8), umask=umask, opm=opm, tm=tm)
   103	    t_choice, o_choice, at_t, need_op, mkt_b = sample(ul, tl, ml, opm, tm, ux, uy, greedy)
   104	    rec.update(t=t_choice.to(torch.int8), o=o_choice.to(torch.int8), need_op=need_op, mb=mkt_b.to(torch.int8))
   105	    logp, ent = logprob(ul, tl, ml, rec)
   106	    actions = build_actions(st, p, o_choice, umask, mkt_b)
