    69	def load(teams, root=os.environ.get("BC_DATA", "/workspace/shared/bc_data"), val_frac=0.1, seed=0):
    70	    rng = np.random.default_rng(seed); parts = {"train": [], "val": []}
    71	    for ti, t in enumerate(teams):
    72	        fs = sorted(glob.glob(f"{root}/{t}/*.npz")); rng.shuffle(fs)
    73	        nv = max(2, int(len(fs) * val_frac))
    74	        for k, f in enumerate(fs):
    75	            parts["val" if k < nv else "train"].append((ti, f))
    76	    out = {}
    77	    for split, lst in parts.items():
    78	        Bs, Gs, Qs, UT, UX, UY, UV, UA, W = [], [], [], [], [], [], [], [], []; TX, TY = [], []; off = 0
    79	        for ti, f in lst:
    80	            d = np.load(f); T = len(d["G"])
    81	            team = np.zeros((T, len(TEAMS)), np.float32); team[:, TEAMS.index(teams[ti])] = 1
    82	            Bs.append(d["B"]); Gs.append(np.concatenate([d["G"], team], 1)); Qs.append(d["Q"])
    83	            UT.append(d["ut"] + off); UX.append(d["ux"]); UY.append(d["uy"]); UV.append(d["uv"]); UA.append(d["ua"]); TX.append(d["tx"]); TY.append(d["ty"])
    84	            W.append(np.full(T, 1.0 if bool(d["won"]) else 0.3, np.float32)); off += T
    85	        o = dict(B=np.concatenate(Bs), G=np.concatenate(Gs), Q=np.concatenate(Qs).astype(np.int64), ut=np.concatenate(UT),
    86	                 ux=np.concatenate(UX).astype(np.int64), uy=np.concatenate(UY).astype(np.int64), uv=np.concatenate(UV), ua=np.concatenate(UA).astype(np.int64), w=np.concatenate(W),
    87	                 tc=(np.concatenate(TY).astype(np.int64) * 10 + np.concatenate(TX).astype(np.int64)))
    88	        start = np.searchsorted(o["ut"], np.arange(len(o["G"]) + 1)); o["ustart"] = start
    89	        out[split] = o; print(split, len(lst), "eps", len(o["G"]), "steps", len(o["ua"]), "units", flush=True)
