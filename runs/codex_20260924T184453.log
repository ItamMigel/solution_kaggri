   114	def sample(ul, tl, ml, opm, tm, ux, uy, greedy):
   115	    B, U = ux.shape
   116	    tlm = _masked(tl, tm[:, None, :])
   117	    t = tlm.argmax(-1) if greedy else torch.distributions.Categorical(logits=tlm).sample()
   118	    cur = uy.long() * 10 + ux.long(); at_t = t == cur
   119	    tx = t % 10; ty = t // 10
   120	    # greedy move toward target among legal moves, scored by op logits
   121	    want = torch.zeros_like(opm)
   122	    want[..., IDX["EAST"]] = tx > ux; want[..., IDX["WEST"]] = tx < ux; want[..., IDX["SOUTH"]] = ty > uy; want[..., IDX["NORTH"]] = ty < uy
   123	    mv_ok = want & opm
   124	    has_move = mv_ok.any(-1) & ~at_t
   125	    mv = _masked(ul, mv_ok).argmax(-1)
   126	    nonmove = opm.clone(); nonmove[..., MOVE_IDS] = False
   127	    need_op = ~has_move
   128	    op_mask = torch.where(at_t[..., None], nonmove, opm)  # at target: work ops; stuck: anything legal
   129	    olm = _masked(ul, op_mask)
   130	    o = olm.argmax(-1) if greedy else torch.distributions.Categorical(logits=olm).sample()
   131	    o = torch.where(has_move, mv, o)
   132	    mb = ml.argmax(-1) if greedy else torch.distributions.Categorical(logits=ml).sample()
   133	    return t, o, at_t, need_op, mb
