   136	def logprob(ul, tl, ml, rec):
   137	    """Recompute log-prob and entropy of recorded choices under current logits."""
   138	    ux = rec["ux"].long(); uy = rec["uy"].long(); umask = rec["umask"]; opm = rec["opm"]; tm = rec["tm"]
   139	    t = rec["t"].long() % 100; o = rec["o"].long(); need_op = rec["need_op"]
   140	    tlp = F.log_softmax(_masked(tl, tm[:, None, :]), -1)
   141	    lp_t = tlp.gather(-1, t[..., None]).squeeze(-1)
   142	    cur = uy * 10 + ux; at_t = t == cur
   143	    nonmove = opm.clone(); nonmove[..., MOVE_IDS] = False
   144	    op_mask = torch.where(at_t[..., None], nonmove, opm)
   145	    olp = F.log_softmax(_masked(ul, op_mask), -1)
   146	    lp_o = olp.gather(-1, o[..., None]).squeeze(-1)
   147	    unit_lp = (lp_t + torch.where(need_op, lp_o, torch.zeros_like(lp_o))) * umask
   148	    mlp = F.log_softmax(ml, -1); lp_m = mlp.gather(-1, rec["mb"].long()[..., None]).squeeze(-1).sum(-1)
   149	    ent_t = -(tlp.exp() * tlp.clamp(min=-30)).sum(-1); ent_m = -(mlp.exp() * mlp.clamp(min=-30)).sum((-1, -2))
   150	    ent = (ent_t * umask).sum(-1) + ent_m
   151	    return unit_lp.sum(-1) + lp_m, ent
