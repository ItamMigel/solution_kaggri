   154	def build_actions(st, p, o, umask, mb):
   155	    """-> gpuenv Actions for player p only: farmer [B,3], hands [B,MAX_HANDS,3], market [B,MAX_ORDERS,3]."""
   156	    dev = o.device; B, U = o.shape
   157	    opt = OPT.to(dev)[o]; a1 = ARG1.to(dev)[o]
   158	    shed = st.shed[:, p].long(); inv = st.inv[:, p].long()
   159	    item = a1.clamp(0, 11)
   160	    is_pick = opt == O.OP_PICKUP; is_place = opt == O.OP_PLACE
   161	    animal = item >= 9
   162	    pick_n = torch.where(animal, torch.ones_like(item), torch.where(item == O.ITEM_FERTILIZER, 4, 3))
   163	    pick_n = torch.minimum(pick_n, shed.gather(1, item)).clamp(min=1)
   164	    place_n = torch.where(animal | (item == O.ITEM_FERTILIZER), torch.ones_like(item), inv.gather(2, item[..., None]).squeeze(-1)).clamp(min=1)
   165	    a2 = torch.where(is_pick, pick_n, torch.where(is_place, place_n, torch.zeros_like(item)))
   166	    opt = torch.where(umask, opt, torch.zeros_like(opt))
   167	    trip = torch.stack([opt, a1, a2], -1)
   168	    farmer = trip[:, 0]; hands = trip[:, 1:]
   169	    # market
   170	    q = mb.long()  # [B,NK] quantity per key
   171	    orders = torch.zeros((B, O.MAX_ORDERS, 3), dtype=torch.long, device=dev); n = torch.zeros(B, dtype=torch.long, device=dev)
   172	    money = st.money[:, p].long().clone(); hires = st.hires_today[:, p].long().clone(); land = st.land[:, p].long().clone()
   173	    prices = st.market_price()[:, :].long()
   174	    mop = MOP.to(dev); mit = MIT.to(dev)
   175	    # expand every key into up to R single slots (HIRE/LAND/ANIMAL: one unit per order; others: one order with qty).
   176	    # Prefix-affordability rule (vectorised, no host syncs): slots in fixed order, accept slot j iff wanted and the
   177	    # cumulative cost of all wanted slots up to j fits the money; keep at most MAX_ORDERS accepted.
   178	    R = O.MAX_ORDERS
   179	    mop = MOP.to(dev); mit = MIT.to(dev); order = MORDER.to(dev)
   180	    kop = mop[order]; kit = mit[order]; K = len(order)
   181	    rep_key = (kop == O.MKT_HIRE) | (kop == O.MKT_BUY_LAND) | (kop == O.MKT_BUY_ANIMAL)
   182	    qo = q[:, order]; r = torch.arange(R, device=dev)
   183	    want = torch.where(rep_key[None, :, None], qo[..., None] > r, (qo[..., None] > 0) & (r == 0))            # [B,K,R]
   184	    qty = torch.where(rep_key[None, :, None], torch.ones_like(qo)[..., None].expand(-1, -1, R), qo[..., None].expand(-1, -1, R))
   185	    hires0 = st.hires_today[:, p].long(); land0 = st.land[:, p].long(); money = st.money[:, p].long()
   186	    prices = st.market_price().long()                                                                          # [B,9]
   187	    itc = kit.clamp(0, 11)
   188	    unit_cost = torch.zeros((B, K), dtype=torch.long, device=dev)
   189	    unit_cost = torch.where((kop == O.MKT_BUY_SEED)[None], SEED_COST.to(dev)[itc.clamp(max=4)][None].expand(B, -1), unit_cost)
   190	    unit_cost = torch.where((kop == O.MKT_BUY_ANIMAL)[None], ANIMAL_COST.to(dev)[(itc - 9).clamp(0, 2)][None].expand(B, -1), unit_cost)
   191	    unit_cost = torch.where((kop == O.MKT_BUY_PRODUCT)[None], prices[:, itc.clamp(max=8)] * 12 // 10, unit_cost)
   192	    cost = unit_cost[..., None] * qty                                                                          # [B,K,R]
   193	    cost = torch.where((kop == O.MKT_HIRE)[None, :, None], FIB.to(dev)[(hires0[:, None, None] + r).clamp(max=20)].expand(-1, K, -1), cost)
   194	    cost = torch.where((kop == O.MKT_BUY_LAND)[None, :, None], LAND_COST.to(dev)[(land0[:, None, None] + r).clamp(max=3)].expand(-1, K, -1), cost)
   195	    want = want.reshape(B, -1); cost = cost.reshape(B, -1); qty = qty.reshape(B, -1)
   196	    cum = torch.cumsum(cost * want, 1)
   197	    ok = want & (cum <= money[:, None])
   198	    rank = torch.cumsum(ok.long(), 1) - 1
   199	    ok = ok & (rank < O.MAX_ORDERS)
