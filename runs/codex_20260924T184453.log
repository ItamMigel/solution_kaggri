import base64 as _b64, io as _io, zlib as _zlib
_W = dict(np.load(_io.BytesIO(_zlib.decompress(_b64.b85decode(_WBLOB)))))
_TEAM_VEC = np.zeros(len(_TEAMS), np.float32); _TEAM_VEC[_TEAMS.index(_TEAM)] = 1

def _conv(x, w, b):
    c, H, Wd = x.shape; o = w.shape[0]
    xp = np.pad(x, ((0, 0), (1, 1), (1, 1)))
    cols = np.stack([xp[:, i:i + H, j:j + Wd] for i in range(3) for j in range(3)], 1)  # c,9,H,W
    cols = cols.reshape(c * 9, H * Wd)
    return (w.reshape(o, c * 9) @ cols).reshape(o, H, Wd) + b[:, None, None]

def _relu(x): return np.maximum(x, 0)

def _forward(Bd, g, units):
    x = np.concatenate([Bd, np.broadcast_to(g[:, None, None], (len(g), 10, 10))], 0).astype(np.float32)
    h = _relu(_conv(x, _W["inp.weight"], _W["inp.bias"]))
    for k in range(_NBLOCKS):
        a = _relu(_conv(h, _W[f"body.{k}.a.weight"], _W[f"body.{k}.a.bias"]))
        h = _relu(h + _conv(a, _W[f"body.{k}.b.weight"], _W[f"body.{k}.b.bias"]))
    outs = []; tls = []; hf = h.reshape(h.shape[0], -1)
    for (ux, uy, uv) in units:
        z0 = np.concatenate([h[:, uy, ux], uv, g])
        z = _relu(_W["unit.0.weight"] @ z0 + _W["unit.0.bias"]); outs.append(_W["unit.2.weight"] @ z + _W["unit.2.bias"])
        if "tq.0.weight" in _W:
            q = _W["tq.2.weight"] @ _relu(_W["tq.0.weight"] @ z0 + _W["tq.0.bias"]) + _W["tq.2.bias"]
            tls.append(q @ hf / np.sqrt(h.shape[0]))
    pooled = np.concatenate([h.mean((1, 2)), h.max((1, 2)), g])
    m = _relu(_W["mkt.0.weight"] @ pooled + _W["mkt.0.bias"]); m = (_W["mkt.2.weight"] @ m + _W["mkt.2.bias"]).reshape(len(MKT_KEYS), MKT_MAX + 1)
    return outs, m, tls

_MOVES = {"NORTH": (0, -1), "SOUTH": (0, 1), "EAST": (1, 0), "WEST": (-1, 0)}

_SEED_COST = {"WHEAT": 10, "CARROT": 20, "TOMATO": 50, "STRAWBERRY": 100, "MELON": 80}
_ANIMAL_COST = {"GOOSE": 300, "COW": 400, "SHEEP": 500}
_LAND_COST = [1000, 2000, 4000]

def _fib(n):
    a, b = 1, 1
    for _ in range(n): a, b = b, a + b
    return a

def _legal_mask(obs, p, x, y, inv, shed_left, seeds):
    farm = obs["farms"][p]; t = farm["tiles"][y][x]; m = np.ones(len(UNIT_OPS), bool)
    for mv, (dx, dy) in _MOVES.items():
        nx, ny = x + dx, y + dy
        if not (0 <= nx < 10 and 0 <= ny < 10) or farm["tiles"][ny][nx] == "LOCKED": m[UNIT_IDX[mv]] = False
    is_plant = isinstance(t, dict) and t.get("kind") == "PLANT"
    if not is_plant:
        for op in ("WATER", "HARVEST", "FERTILIZE"): m[UNIT_IDX[op]] = False
    if not (inv or {}).get("FERTILIZER"): m[UNIT_IDX["FERTILIZE"]] = False
    has_animal = isinstance(t, dict) and t.get("animal") in ANIMALS
    if not has_animal:
        for op in ("FEED", "CARE", "COLLECT_FERTILIZER"): m[UNIT_IDX[op]] = False
