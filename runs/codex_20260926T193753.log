        cands = [("c", centre)] + [(f"x{i}", np.asarray(x)) for i, x in enumerate(X)]
        gdir = f"{a.out}/gen_{g:03d}"; os.makedirs(gdir, exist_ok=True); t0 = time.time()
        mode = _mode_for_generation(schedule, g)
        weights = _fitness_panel(mode, g)
