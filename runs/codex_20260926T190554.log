+def tasks(obs: Mapping[str, Any], plan: Any) -> list[Task]:
+    """Expose generated tasks for diagnostics/tests; ``act`` also filters legality."""
+    world = _World(obs)
+    return _manual_tasks(plan, obs) + _generated_tasks(world, plan)
