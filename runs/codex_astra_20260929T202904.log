    59	def _filler(obs, p, x, y, inv, day, claimed, shed_left):
    60	    """Scripted fallback for a unit whose model choice was illegal (forced PASS): do useful maintenance work."""
    61	    tiles = obs["farms"][p]["tiles"]; inv = inv or {}
    62	    t = tiles[y][x]; d = t if isinstance(t, dict) else {}
    63	    wheat = int(inv.get("WHEAT", 0))
    64	    # 1) work on the current tile
    65	    if d.get("kind") == "PLANT":
    66	        age = day - int(d.get("planted_day", day)); fy = F.feat.FIRST_YIELD.get(d.get("crop"), 99)
    67	        if not d.get("watered_today"): return ["WATER"]
    68	        if age >= fy and int(d.get("yield_units", 0)) > 0: return ["HARVEST"]
    69	    if d.get("animal"):
    70	        if d.get("fertilizer_available"): return ["COLLECT_FERTILIZER"]
    71	        if int(d.get("yield_units", 0)) > 0: return ["HARVEST"]
    72	        if not d.get("fed_today") and wheat > 0: return ["FEED"]
    73	        if not d.get("cared_today"): return ["CARE"]
    74	    adj = (x, y) in SHED_ADJ
    75	    products = {k: v for k, v in inv.items() if v and k not in ("WHEAT", "FERTILIZER") and k not in _STRUCT}
    76	    if adj and products: return ["DROP"]
    77	    # 2) scan the farm
    78	    unfed, water, harvest, collect = [], [], [], []
    79	    for yy in range(10):
    80	        for xx in range(10):
    81	            tt = tiles[yy][xx]
    82	            if not isinstance(tt, dict) or (xx, yy) in claimed: continue
    83	            if tt.get("animal"):
    84	                if not tt.get("fed_today"): unfed.append((xx, yy))
    85	                if tt.get("fertilizer_available") or int(tt.get("yield_units", 0)) > 0: collect.append((xx, yy))
    86	            elif tt.get("kind") == "PLANT":
    87	                if not tt.get("watered_today"): water.append((xx, yy))
    88	                age = day - int(tt.get("planted_day", day))
    89	                if age >= F.feat.FIRST_YIELD.get(tt.get("crop"), 99) and int(tt.get("yield_units", 0)) > 0: harvest.append((xx, yy))
    90	    near = lambda cells: min(cells, key=lambda c: abs(c[0] - x) + abs(c[1] - y)) if cells else None
    91	    if unfed and wheat > 0:
    92	        c = near(unfed); claimed.add(c); return [_step_toward(x, y, *c)]
    93	    if unfed and wheat == 0 and shed_left.get("WHEAT", 0) > 0:
    94	        if adj:
    95	            n = max(1, min(len(unfed), shed_left["WHEAT"])); shed_left["WHEAT"] -= n; return ["PICKUP", "WHEAT", n]
    96	        c = near(sorted(SHED_ADJ)); return [_step_toward(x, y, *c)]
    97	    for cells in (water, harvest, collect):
    98	        c = near(cells)
    99	        if c is not None:
   100	            claimed.add(c); return [_step_toward(x, y, *c)]
   101	    if products:
   102	        c = near(sorted(SHED_ADJ)); m = _step_toward(x, y, *c)
   103	        if m: return [m]
   104	    return None
   105	
