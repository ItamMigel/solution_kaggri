    95	            price = max(1, int(((obs.get("market") or {}).get("prices") or {}).get("WHEAT", 30) or 30))
    96	            money = int(float(farm.get("money", 0)))
    97	            q = min(int(_HG["max_buy"]), deficit, max(0, (money - int(_HG["cash_keep"])) // (price + 2)))
    98	            has_buy = [o for o in market if isinstance(o, list) and len(o) >= 3 and o[0] == "BUY_PRODUCT" and o[1] == "WHEAT"]
    99	            if q > 0:
   100	                if has_buy:
   101	                    if int(has_buy[0][2]) < q:
