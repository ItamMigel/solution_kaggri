   165	
   166	def decode_unit(cls, qcls=None):
   167	    k = UNIT_OPS[int(cls)]
   168	    if ":" not in k:
   169	        return [k]
   170	    op, it = k.split(":")
   171	    if op == "PLANT":
   172	        return ["PLANT", it]
   173	    return [op, it, QTY_VALS[int(qcls)] if qcls is not None else 1]
