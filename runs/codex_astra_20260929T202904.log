   219	
   220	MS_DIM = len(ITEMS)
   221	SHED_ADJ = {(4, 4), (5, 4), (4, 5), (5, 5)}
   222	_STRUCT = {"GOOSE": "COOP", "COW": "PASTURE", "SHEEP": "PASTURE"}
   223	
