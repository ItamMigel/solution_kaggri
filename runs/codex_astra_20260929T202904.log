_AG = _a3.Agent({ckpt!r}, sample={sample!r}, temp={temp!r}, seed={seed!r}, persist={persist!r}, dedupe={dedupe!r}, msample={msample!r}, fill={fill!r}, smask={smask!r}, notrip={notrip!r}, team={team!r}, trustop={trustop!r})


