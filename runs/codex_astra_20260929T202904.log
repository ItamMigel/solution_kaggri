   128	    def market_tf(s, h, G, MS, MT, MQ):
   129	        """teacher-forced logits: tok [B,S,N_TOK], qty [B,S,QMAX]"""
   130	        Bn = G.shape[0]; ctx = s.m_context(h, G, MS); state = ctx
   131	        prev_t = torch.full((Bn,), F.N_TOK, dtype=torch.long, device=G.device)
   132	        prev_q = torch.full((Bn,), F.QMAX, dtype=torch.long, device=G.device)
   133	        tl, ql = [], []
   134	        for sl in range(F.N_SLOTS):
   135	            slot = torch.full((Bn,), sl, dtype=torch.long, device=G.device)
   136	            state, logit = s.m_step(state, ctx, prev_t, prev_q, slot); tl.append(logit)
   137	            cur = MT[:, sl].clamp(min=0); ql.append(s.m_qty(state, cur))
   138	            prev_t = cur; prev_q = torch.where(MQ[:, sl] >= 0, MQ[:, sl], torch.full_like(MQ[:, sl], F.QMAX))
   139	        return torch.stack(tl, 1), torch.stack(ql, 1)
