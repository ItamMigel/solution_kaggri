   144	    bi = torch.repeat_interleave(torch.arange(len(idx), device=idx.device), cnt)
   145	    ui = torch.repeat_interleave(st, cnt) + (torch.arange(int(cnt.sum()), device=idx.device) - torch.repeat_interleave(torch.cumsum(cnt, 0) - cnt, cnt))
   146	    return bi, ui
