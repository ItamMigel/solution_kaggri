   176	# ------------------------------------------------------------------ market codec
   177	def _order_token(o):
   178	    if not isinstance(o, list) or not o:
   179	        return "NOOP", None
   180	    if o[0] in ("HIRE", "BUY_LAND"):
   181	        return o[0], None
   182	    if o[0] in ("SELL", "BUY_PRODUCT", "BUY_SEED", "BUY_ANIMAL") and len(o) > 2:
   183	        try:
   184	            n = int(o[2])
   185	        except (TypeError, ValueError):
   186	            return "NOOP", None
   187	        key = o[0] + ":" + str(o[1])
   188	        if n <= 0 or key not in TOK_IDX:
   189	            return "NOOP", None
   190	        return key, max(1, min(n, QMAX))
   191	    return "NOOP", None
   192	
   193	
   194	def encode_market_seq(orders):
   195	    """-> tok[N_SLOTS], qty[N_SLOTS] (qty class = n-1; IGNORE where no qty / after END)"""
   196	    tok = np.full(N_SLOTS, IGNORE, np.int16); qty = np.full(N_SLOTS, IGNORE, np.int16)
   197	    orders = list(orders or [])[:N_SLOTS]
   198	    for s, o in enumerate(orders):
   199	        k, n = _order_token(o); tok[s] = TOK_IDX[k]
   200	        if n is not None:
   201	            qty[s] = n - 1
   202	    if len(orders) < N_SLOTS:
   203	        tok[len(orders)] = TOK_IDX["END"]
   204	    return tok, qty
   205	
   206	
   207	def decode_market_seq(toks, qtys):
   208	    out = []
   209	    for t, q in zip(toks, qtys):
   210	        k = TOKENS[int(t)]
   211	        if k == "END":
   212	            break
   213	        if k in ("NOOP", "HIRE", "BUY_LAND"):
   214	            out.append([k])
   215	        else:
   216	            op, it = k.split(":"); out.append([op, it, int(q) + 1])
   217	    return out[:N_SLOTS]
