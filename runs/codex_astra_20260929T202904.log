    16	        fs = sorted(glob.glob(f"{r}/*.npz")); rng = np.random.default_rng(seed); rng.shuffle(fs)
    17	        parts["val"] += [(ti, f) for f in fs[:val_eps]]; parts["train"] += [(ti, f) for f in fs[val_eps:]]
    18	    out = {}
    19	    for split, lst in parts.items():
    20	        keys = ("B", "G", "MS", "MT", "MQ", "ut", "ui", "ux", "uy", "uv", "ua", "uq", "tx", "ty")
    21	        step_keys = {"B", "G", "MS", "MT", "MQ"}
    22	        # pass 1: sizes and dtypes (reads only small arrays); pass 2: fill preallocated arrays (no 2x concatenate peak)
    23	        sizes = []; proto = {}
    24	        for ti, f in lst:
    25	            d = np.load(f); sizes.append((len(d["G"]), len(d["ut"])))
    26	            if not proto:
    27	                for k in keys:
    28	                    a = d[k]; proto[k] = (a.shape[1:], a.dtype)
    29	        NT = sum(s[0] for s in sizes); NU = sum(s[1] for s in sizes)
    30	        o = {}
    31	        for k in keys:
    32	            shp, dt = proto[k]
    33	            if k == "G" and multi:
    34	                shp = (shp[0] + len(roots),)
    35	            o[k] = np.empty(((NT if k in step_keys else NU),) + tuple(shp), dt)
    36	        off = 0; uoff = 0
    37	        for (ti, f), (T, U) in zip(lst, sizes):
    38	            d = np.load(f)
    39	            for k in keys:
    40	                v = d[k]
    41	                if k == "ut":
    42	                    v = v + off
    43	                if k == "G" and multi:
    44	                    oh = np.zeros((T, len(roots)), np.float32); oh[:, ti] = 1; v = np.concatenate([v, oh], 1)
    45	                if k in step_keys:
