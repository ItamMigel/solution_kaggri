   255	def merged_obs(d, t, p):
   256	    """Replay observation of player p at step t with shared fields filled in (replays store them only for p0)."""
   257	    import copy
   258	    o = copy.deepcopy(d["steps"][t][p]["observation"]); sh = d["steps"][t][0]["observation"]
   259	    for k in ("step", "day", "hour", "farms", "market", "town"):
   260	        if k not in o and k in sh:
   261	            o[k] = copy.deepcopy(sh[k])
   262	    o["player"] = p
   263	    if "step" not in o:
   264	        o["step"] = t
   265	    return o
