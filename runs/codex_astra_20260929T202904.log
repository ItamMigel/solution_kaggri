   119	class _One:
   120	    """One BC v3 network behind the decoding interface used by Agent (all outputs are log-probabilities).
   121	    G passed in is the base global vector; the member appends its own team one-hot (members may differ in teams)."""
   122	    def __init__(self, ckpt, torch, team=None):
   123	        from train3 import Net
   124	        ck = torch.load(ckpt, map_location="cpu", weights_only=False)
   125	        self.net = Net(**ck["cfg"]); sd = ck["state"]
   126	        w = sd["m_ctx.0.weight"]; need = self.net.m_ctx[0].weight.shape[1]
   127	        if w.shape[1] < need:  # checkpoint trained before the shed-after-units market input: zero weights = old behaviour
   128	            sd["m_ctx.0.weight"] = torch.cat([w, torch.zeros(w.shape[0], need - w.shape[1])], 1)
   129	        self.net.load_state_dict(sd); self.net.eval(); self.cfg = self.net.cfg; self.T = torch
   130	        self.tv = _team_vec(self.cfg, team)
   131	
   132	    def encode(self, B, G):
   133	        with self.T.no_grad():
   134	            return self.net.trunk(self.T.from_numpy(B), self.T.from_numpy(_with_team(G, self.tv)))
   135	
   136	    def units(self, h, G, ux, uy, uv):
   137	        T = self.T
   138	        with T.no_grad():
   139	            G = T.from_numpy(_with_team(G, self.tv)); ux = T.from_numpy(ux); uy = T.from_numpy(uy); uv = T.from_numpy(uv)
   140	            bi = T.zeros(len(ux), dtype=T.long)
   141	            z0 = T.cat([h[bi, :, uy, ux], uv, G[bi]], 1); z = self.net.unit(z0)
   142	            opl = T.log_softmax(self.net.u_op(z), 1).numpy()
   143	            tl = T.log_softmax(T.einsum("uc,ucp->up", self.net.tq(z0), h.flatten(2)[bi]) / (h.shape[1] ** 0.5), 1).numpy()
   144	        return opl, tl, z
   145	
   146	    def qty(self, z, i, cls):
   147	        with self.T.no_grad():
   148	            oh = self.T.zeros(1, len(F.UNIT_OPS)); oh[0, cls] = 1
   149	            return self.T.log_softmax(self.net.u_q(self.T.cat([z[i:i + 1], oh], 1)), 1).numpy()[0]
   150	
   151	    def m_start(self, h, G, MS):
   152	        with self.T.no_grad():
   153	            ctx = self.net.m_context(h, self.T.from_numpy(_with_team(G, self.tv)), self.T.from_numpy(MS)); return (ctx, ctx)
   154	
   155	    def m_step(self, st, prev_t, prev_q, sl):
   156	        T = self.T
   157	        with T.no_grad():
   158	            state, ctx = st
   159	            state, logit = self.net.m_step(state, ctx, T.tensor([prev_t]), T.tensor([prev_q]), T.tensor([sl]))
   160	            return (state, ctx), T.log_softmax(logit, 1).numpy()[0]
   161	
   162	    def m_qty(self, st, tok):
   163	        with self.T.no_grad():
   164	            return self.T.log_softmax(self.net.m_qty(st[0], self.T.tensor([tok])), 1).numpy()[0]
   165	
   166	
   167	def _make_model(ckpt, team=None):
   168	    import torch
   169	    torch.set_num_threads(1)
   170	    try:
   171	        torch.set_num_interop_threads(1)
   172	    except RuntimeError:
   173	        pass
   174	    cks = [c for c in str(ckpt).split(",") if c]
   175	    return _One(cks[0], torch, team) if len(cks) == 1 else _Ens([_One(c, torch, team) for c in cks])
   176	
   177	
   178	# ============================== BUNDLE START (torch-free; copied verbatim into the numpy Kaggle agent) ==============
   179	class _Ens:
   180	    """Ensemble of _One models with identical feature config: averages log-probabilities (geometric mean)."""
   181	    def __init__(self, members):
   182	        self.m = members; self.cfg = members[0].cfg
   183	        for x in members[1:]:  # unit features must match; team sets may differ (each member appends its own one-hot)
   184	            assert (x.cfg.get("u_dim"), x.cfg.get("uext")) == (self.cfg.get("u_dim"), self.cfg.get("uext"))
   185	
   186	    def encode(self, B, G):
   187	        return [x.encode(B, G) for x in self.m]
   188	
   189	    def units(self, hs, G, ux, uy, uv):
   190	        outs = [x.units(h, G, ux, uy, uv) for x, h in zip(self.m, hs)]
   191	        return np.mean([o[0] for o in outs], 0), np.mean([o[1] for o in outs], 0), [o[2] for o in outs]
   192	
   193	    def qty(self, zs, i, cls):
   194	        return np.mean([x.qty(z, i, cls) for x, z in zip(self.m, zs)], 0)
   195	
   196	    def m_start(self, hs, G, MS):
   197	        return [x.m_start(h, G, MS) for x, h in zip(self.m, hs)]
   198	
   199	    def m_step(self, sts, prev_t, prev_q, sl):
   200	        outs = [x.m_step(st, prev_t, prev_q, sl) for x, st in zip(self.m, sts)]
   201	        return [o[0] for o in outs], np.mean([o[1] for o in outs], 0)
   202	
   203	    def m_qty(self, sts, tok):
   204	        return np.mean([x.m_qty(st, tok) for x, st in zip(self.m, sts)], 0)
   205	
