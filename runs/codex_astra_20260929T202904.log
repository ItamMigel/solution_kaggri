    96	    steps since it, number of such actions today. Reset at every day boundary (hands are re-hired daily)."""
    97	    def __init__(self):
    98	        self.day = None; self.m = {}
    99	
   100	    def features(self, n_units, step, day):
   101	        if day != self.day:
   102	            self.day = day; self.m = {}
   103	        out = []
   104	        for i in range(n_units):
   105	            v = np.zeros(MEM_DIM, np.float32)
   106	            if i in self.m:
   107	                x, y, g, s, c = self.m[i]
   108	                v[0] = x / 9.0; v[1] = y / 9.0; v[2] = 1; v[3] = min(step - s, 24) / 24.0; v[4] = min(c, 24) / 24.0; v[5 + g] = 1
   109	            out.append(v)
   110	        return out
   111	
   112	    def update(self, actions, positions, step):
   113	        for i, a in enumerate(actions or []):
   114	            if not a or i >= len(positions) or a[0] not in MEM_GROUP:
   115	                continue
   116	            x, y = positions[i]; c = self.m.get(i, (0, 0, 0, 0, 0))[4] + 1
   117	            self.m[i] = (int(x), int(y), MEM_GROUP[a[0]], step, c)
