     3	# ================= HG: herd guard for the BC agent (lab/pavel, 2026-09-29) =================
     4	# Prevents animal escapes (engine: an animal unfed on two consecutive days leaves its structure).
     5	# 1) If an animal that was unfed yesterday is still unfed today, and the nearest unit only just has enough
     6	#    turns left to fetch wheat (shed-adjacent PICKUP) and walk to it, that unit is overridden to feed it.
     7	# 2) Keeps shed wheat >= herd size at the start of each day by an appended BUY_PRODUCT WHEAT (cash permitting);
     8	#    under an urgent shortage it also drops the policy's own WHEAT sales.
     9	_HG = {'on': True, 'slack': 3, 'buy_on': True, 'stock_hours': (0, 1, 2), 'stock_frac': 1.0, 'max_buy': 30,
    10	       'cash_keep': 0, 'last_day': 29}
    11	_HG_STATS = {'overrides': 0, 'buy_turns': 0, 'buy_units': 0, 'dropped_sells': 0, 'errors': 0}
    12	_HG_SHED = [(4, 4), (5, 4), (4, 5), (5, 5)]
    13	
    14	
    15	def _hg_d(a, b):
    16	    return abs(a[0] - b[0]) + abs(a[1] - b[1])
    17	
    18	
    19	def _hg_mv(x, y, tx, ty):
    20	    if tx > x: return "EAST"
    21	    if tx < x: return "WEST"
    22	    if ty > y: return "SOUTH"
    23	    if ty < y: return "NORTH"
    24	    return "PASS"
    25	
    26	
    27	def _hg_apply(obs, action):
    28	    p = int(obs["player"]); step = int(obs["step"]); day = step // 24; hour = step % 24
    29	    if step >= 718 or day > int(_HG.get("active_last_day", 29)):
    30	        return action
    31	    farm = obs["farms"][p]; tiles = farm["tiles"]; priv = obs.get("private") or {}
    32	    shed = priv.get("shed") or {}; invs = priv.get("inventories") or []
    33	    animals = [(x, y, tiles[y][x]) for y in range(10) for x in range(10)
    34	               if isinstance(tiles[y][x], dict) and tiles[y][x].get("animal")]
    35	    if not animals:
    36	        return action
    37	    pos = [tuple(farm["farmer"])] + [tuple(h) for h in (farm.get("hands") or [])]
    38	    acts = [list(action.get("farmer") or ["PASS"])] + [list(a) for a in (action.get("hands") or [])]
    39	    while len(acts) < len(pos):
    40	        acts.append(["PASS"])
    41	    carried = [int((invs[i] if i < len(invs) else {}).get("WHEAT", 0) or 0) for i in range(len(pos))]
    42	    shed_w = int(shed.get("WHEAT", 0) or 0)
    43	    urgent_all = [(x, y) for x, y, t in animals if int(t.get("consecutive_unfed", 0) or 0) >= 1 and not t.get("fed_today")]
    44	    urgent = list(urgent_all)
    45	    for i, a in enumerate(acts):
    46	        if a and a[0] == "FEED" and pos[i] in urgent and carried[i] > 0:
    47	            urgent.remove(pos[i]); carried[i] -= 1
    48	    changed = False
    49	    free = set(range(len(pos)))
    50	    for ax, ay in urgent:
    51	        best = None
    52	        for i in free:
    53	            if carried[i] > 0:
    54	                cost = _hg_d(pos[i], (ax, ay)) + 1
    55	            elif shed_w > 0:
    56	                s = min(_HG_SHED, key=lambda c: (_hg_d(pos[i], c) + _hg_d(c, (ax, ay)), c))
    57	                cost = _hg_d(pos[i], s) + 1 + _hg_d(s, (ax, ay)) + 1
    58	            else:
    59	                continue
    60	            if best is None or cost < best[0]:
    61	                best = (cost, i)
    62	        if best is None:
    63	            continue
    64	        cost, i = best
    65	        if hour + cost + int(_HG["slack"]) < 24:
    66	            continue
    67	        free.discard(i)
    68	        if carried[i] > 0:
    69	            new = ["FEED"] if pos[i] == (ax, ay) else [_hg_mv(pos[i][0], pos[i][1], ax, ay)]
    70	            carried[i] -= 1
    71	        elif pos[i] in _HG_SHED:
    72	            n = max(1, min(shed_w, len(urgent))); new = ["PICKUP", "WHEAT", n]; shed_w -= n
    73	        else:
    74	            s = min(_HG_SHED, key=lambda c: (_hg_d(pos[i], c) + _hg_d(c, (ax, ay)), c))
    75	            new = [_hg_mv(pos[i][0], pos[i][1], s[0], s[1])]
    76	        if new != acts[i]:
    77	            acts[i] = new; changed = True; _HG_STATS["overrides"] += 1
    78	    market = [list(o) if isinstance(o, (list, tuple)) else o for o in (action.get("market") or [])]
    79	    if _HG["buy_on"] and day <= int(_HG["last_day"]):
    80	        have = int(shed.get("WHEAT", 0) or 0) + sum(int((iv or {}).get("WHEAT", 0) or 0) for iv in invs)
    81	        need = 0
    82	        if hour in _HG["stock_hours"]:
    83	            need = int(len(animals) * float(_HG["stock_frac"]) + 0.999)
    84	        if urgent_all:
    85	            need = max(need, len(urgent_all))
    86	        deficit = need - have
    87	        if deficit > 0:
    88	            if urgent_all and have < len(urgent_all):
    89	                kept = []
    90	                for o in market:
    91	                    if isinstance(o, list) and len(o) >= 2 and o[0] == "SELL" and o[1] == "WHEAT":
    92	                        _HG_STATS["dropped_sells"] += 1; continue
    93	                    kept.append(o)
