   225	def shed_after_units(obs, p, unit_actions, capacity=100):
   226	    """Shed contents at market time: unit actions resolve before the market in the engine
   227	    (DROP moves the whole unit inventory, PLACE at a shed-access tile moves n, PICKUP takes n from the shed).
   228	    Mirrors kaggriculture._apply_unit_action for these three ops, farmer first then hands in order."""
   229	    priv = _g(obs, "private", {}) or {}
   230	    shed = {it: int((_g(priv, "shed", {}) or {}).get(it, 0)) for it in ITEMS}
   231	    invs = [dict(i or {}) for i in (_g(priv, "inventories", []) or [])]
   232	    farm = _g(obs, "farms")[p]
   233	    pos = [farm["farmer"]] + list(farm.get("hands") or [])
   234	    for i, a in enumerate(unit_actions or []):
   235	        if not a or i >= len(pos) or i >= len(invs):
   236	            continue
   237	        op = a[0]; x, y = pos[i]; adj = (int(x), int(y)) in SHED_ADJ; inv = invs[i]
   238	        if op == "DROP" and adj:
   239	            for it, n in inv.items():
   240	                room = max(0, capacity - sum(shed.values())); take = min(int(n), room)
   241	                if it in shed and take > 0:
   242	                    shed[it] += take
   243	        elif op == "PICKUP" and adj and len(a) > 1 and a[1] in shed:
   244	            n = int(a[2]) if len(a) > 2 else 1; n = min(max(n, 0), shed[a[1]]); shed[a[1]] -= n
