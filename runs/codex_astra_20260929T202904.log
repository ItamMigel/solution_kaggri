   120	    def m_step(s, state, ctx, prev_tok, prev_q, slot):
   121	        x = torch.cat([s.m_tok_emb(prev_tok), s.m_q_emb(prev_q), s.m_slot_emb(slot), ctx], 1)
   122	        state = s.m_gru(x, state)
   123	        return state, s.m_tok(state)
   124	
   125	    def m_qty(s, state, tok):
   126	        return s.m_q(torch.cat([state, s.m_tok_emb(tok)], 1))
