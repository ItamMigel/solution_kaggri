CROPS = {
    "WHEAT":      {"seed": 10, "first_yield_day": 2, "max_yield_day": 4, "interval": 0, "max_yield": 6, "ongoing": False},
    "CARROT":     {"seed": 20, "first_yield_day": 2, "max_yield_day": 3, "interval": 0, "max_yield": 4, "ongoing": False},
    "TOMATO":     {"seed": 50, "first_yield_day": 8, "max_yield_day": 8, "interval": 1, "max_yield": 4, "ongoing": True},
    "STRAWBERRY": {"seed": 100, "first_yield_day": 10, "max_yield_day": 10, "interval": 2, "max_yield": 4, "ongoing": True},
    "MELON":      {"seed": 80, "first_yield_day": 10, "max_yield_day": 12, "interval": 0, "max_yield": 6, "ongoing": False},
}

ANIMALS = {
    "GOOSE": {"cost": 300, "structure": "COOP",    "first_yield_day": 4, "interval": 1, "max_held": 4, "product": "EGG"},
    "COW":   {"cost": 400, "structure": "PASTURE", "first_yield_day": 8, "interval": 2, "max_held": 6, "product": "MILK"},
    "SHEEP": {"cost": 500, "structure": "PASTURE", "first_yield_day": 6, "interval": 3, "max_held": 6, "product": "WOOL"},
}

FARMER_MOVES = {
    "NORTH": (0, -1),
    "SOUTH": (0, 1),
    "EAST":  (1, 0),
    "WEST":  (-1, 0),
}

def _shed_access_tiles(board_size):
    """Four inner-corner tiles around the shed, in NWSE order."""
    half = board_size // 2
    return [(half - 1, half - 1), (half, half - 1), (half - 1, half), (half, half)]

def _is_shed_adjacent(pos, board_size):
    return tuple(pos) in {(x, y) for (x, y) in _shed_access_tiles(board_size)}

def _new_plant(crop, day, turns_per_day):
    cd = CROPS[crop]
    return {
        "kind": "PLANT",
        "crop": crop,
        "planted_day": day,
        "watered_today": False,
        "consecutive_unwatered": 1,  # planting day counts as unwatered
        "yield_units": 0 if cd["ongoing"] else 1,
        "max_lifespan_step": (-1 if cd["ongoing"] else (day + cd["max_yield_day"] + 1) * turns_per_day),
        "fertilized_until_day": -1,
    }

def _new_animal(animal, day):
    a = ANIMALS[animal]
    return {
        "kind": a["structure"],
        "animal": animal,
        "placed_day": day,
        "yield_units": 0,
        "consecutive_unfed": 0,
        "fed_today": False,
        "cared_today": False,
        "fertilizer_available": False,
        "pending_care_bonus": 0,
    }

def _farmer_position(farm, idx):
    """idx 0 = main farmer, 1+ = hand index."""
    if idx == 0:
        return farm["farmer"]
    return farm["hands"][idx - 1] if idx - 1 < len(farm["hands"]) else None

def _set_farmer_position(farm, idx, pos):
    if idx == 0:
        farm["farmer"] = list(pos)
    else:
        farm["hands"][idx - 1] = list(pos)

def _farmer_inventory(private, idx):
    """Inventories list is [main_farmer, *hands]; grow it if idx is past the end."""
    while len(private["inventories"]) <= idx:
        private["inventories"].append({})
    return private["inventories"][idx]

def _inv_add(inv, item, n=1):
    inv[item] = inv.get(item, 0) + n

def _inv_take(inv, item, n=1):
    if inv.get(item, 0) < n:
        return False
    inv[item] -= n
    if inv[item] == 0:
        del inv[item]
    return True

def _apply_unit_action(farm, private, idx, action, board_size, day, turns_per_day, shed_capacity=100):
    """Process one farmer/hand's action. Invalid / illegal actions are silent no-ops."""
    if not isinstance(action, list) or not action:
        return
    op = action[0]
    pos = _farmer_position(farm, idx)
    if pos is None:
        return
    fx, fy = pos[0], pos[1]
    inv = _farmer_inventory(private, idx)

    if op in FARMER_MOVES:
        dx, dy = FARMER_MOVES[op]
        nx, ny = fx + dx, fy + dy
        if not (0 <= nx < board_size and 0 <= ny < board_size):
            return
        # Movement onto LOCKED tiles is allowed: a hand can spawn on a locked
        # shed-access tile, and blocking movement would strand it there forever.
        # Tile operations (PLANT, WATER, etc.) still no-op on LOCKED tiles.
        _set_farmer_position(farm, idx, (nx, ny))
        return

    if op == "PASS":
        return

    tile = farm["tiles"][fy][fx]

    # Shed operations resolve before the LOCKED guard. They use the tile only as
    # a standing position -- the shed itself is always owned -- and three of the
    # four shed-access tiles start LOCKED, so guarding them first would make the
    # shed unreachable from those tiles.
    if op == "DROP":
        if not _is_shed_adjacent((fx, fy), board_size):
            return
        shed = private["shed"]
        for item, n in list(inv.items()):
            if n <= 0:
                del inv[item]
                continue
            room = max(0, shed_capacity - sum(shed.values()))
            take = min(n, room)
            if take > 0:
                shed[item] = shed.get(item, 0) + take
            del inv[item]
        return

    if op == "PICKUP":
        if not _is_shed_adjacent((fx, fy), board_size):
            return
        if len(action) < 2:
            return
        item = action[1]
        n = int(action[2]) if len(action) >= 3 else 1
        if n <= 0:
            return
        # Seeds live in private["seeds"] and are consumed directly by PLANT;
        # they never pass through farmer inventory or the shed.
        available = private["shed"].get(item, 0)
        n = min(n, available)
        if n <= 0:
            return
        private["shed"][item] -= n
        _inv_add(inv, item, n)
        return

#!/bin/bash
# T045: fresh (27-29.09) top-team replays -> canonical market -> BC3 NPZ (Pavel recipe: --canon --nonoop), per m15 team slot.
set -u
R=/workspace/shared/research/t045_fresh; P=/workspace/shared/pavel_lab/lab/pavel; PY=/workspace/solution_kaggri/.venv/bin/python
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
W=${W:-24}
while IFS='|' read -r sub slot name; do
  [ -z "$sub" ] && continue
  n=$(ls $R/replays/$sub/*.gz 2>/dev/null | wc -l)
  $PY $P/canon_market.py --glob "$R/replays/$sub/*.gz" --out $R/canon/$sub --workers $W > $R/logs_canon_$sub.txt 2>&1
  $PY $P/bc3/build3.py --team "$name" --glob "$R/replays/$sub/*.gz" --canon $R/canon/$sub --nonoop --out $R/bc3_fresh/$slot --workers $W > $R/logs_build_$sub.txt 2>&1
  ver=$(grep -l '"verified": true' $R/canon/$sub/*.json 2>/dev/null | wc -l)
  echo "$slot sub $sub replays $n canon_verified $ver built $(ls $R/bc3_fresh/$slot/*.npz 2>/dev/null | wc -l) :: $(tail -1 $R/logs_build_$sub.txt)"
done <<'MAP'
56671443|mgoose_cn|Unknown Mother-Goose
56658433|mgoose2_cn|Unknown Mother-Goose
56654377|decem_cn|DECEM
56679033|mmpq_cn|M & M & P & Q
56667936|vadim_vasilenko_cn|Vadim Vasilenko
56670106|fourth_quadrant_cn|Fourth Quadrant
56663513|majkel1337_cn|Majkel1337
56667132|smackaveli_cn|Smackaveli
56664470|kaggledew_valley_cn|Kaggledew Valley 🏆
56676967|mtmr_s1_cn|mtmr_s1
56674188|densike_cn|Densike
56651937|artem_the_farmer_cn|Artem The Farmer 🍅
56653134|third_farm_club_cn|THIRD FARM CLUB
56640149|boey_cn|Boey
MAP
echo PREP_DONE

diff --git a/lab/t046/engine_facts.py b/lab/t046/engine_facts.py
new file mode 100644
index 0000000000000000000000000000000000000000..81113ac033840e8d8e2fb7496142d2c04de415f2
--- /dev/null
+++ b/lab/t046/engine_facts.py
@@ -0,0 +1,75 @@
+"""Small deterministic counterexamples using the installed official engine source."""
+import ast
+import copy
+import hashlib
+import json
+from pathlib import Path
+from types import SimpleNamespace as NS
+
+SOURCE = Path('/workspace/solution_kaggri/.venv/lib/python3.12/site-packages/kaggle_environments/envs/kaggriculture/kaggriculture.py')
+
+
+def engine():
+    tree = ast.parse(SOURCE.read_text())
+    # Avoid package registration/import noise. All engine definitions are verbatim;
+    # only the unused environment seed resolver import is excluded.
+    tree.body = [n for n in tree.body if not (isinstance(n, ast.ImportFrom) and n.module == 'kaggle_environments.utils')]
+    ns = {'__file__': str(SOURCE), '__name__': 't046_official_engine'}
+    exec(compile(tree, str(SOURCE), 'exec'), ns)
+    return NS(**ns)
+
+
+def mirror(f):
+    f = copy.deepcopy(f)
+    f['tiles'] = [row[::-1] for row in f['tiles']]
+    f['farmer'][0] = 9-f['farmer'][0]
+    f['hands'] = [[9-x,y] for x,y in f['hands']]
+    f['unlocked_quadrants'] = [{'NW':'NE','NE':'NW','SW':'SE','SE':'SW'}[q] for q in f['unlocked_quadrants']]
+    return f
+
+
+def market(k, own_orders, rival_orders):
+    farms = [k._new_farm(10,10000) for _ in range(2)]
+    privates = [k._new_private() for _ in range(2)]
+    for p in privates:
+        p['shed']['STRAWBERRY'] = 2
+    m = k._new_market()
+    state = [NS(action={'market':orders}, observation=NS(farms=farms,market=m,private=privates[i]))
+             for i,orders in enumerate([own_orders,rival_orders])]
+    k._process_market(state, NS(configuration={}))
+    return dict(cash=[f['money'] for f in farms], shed=[p['shed']['STRAWBERRY'] for p in privates],
+                strawberry_inventory=m['inventory']['STRAWBERRY'])
+
+
+def main():
+    k = engine()
+    f = k._new_farm(10,10000)
+    mf = mirror(f)
+    a = copy.deepcopy(f); k._do_buy_land(a,10); a = mirror(a)
+    b = copy.deepcopy(mf); k._do_buy_land(b,10)
+    no_rival = market(k,[['SELL','STRAWBERRY',2]],[])
+    with_rival = market(k,[['SELL','STRAWBERRY',2]],[['SELL','STRAWBERRY',2]])
+    assert no_rival['cash'][0] != with_rival['cash'][0]
+    # Even with all quadrants unlocked, the preferred spawn is not equivariant.
+    ff = k._new_farm(10,10000)
+    for _ in range(3):
+        k._do_buy_land(ff,10)
+    ff['farmer'] = [0,0]
+    spawn = k._spawn_hand(ff,10)
+    mirrored_spawn = k._spawn_hand(mirror(ff),10)
+    assert mirrored_spawn != [9-spawn[0],spawn[1]]
+    assert a != b  # mirrored NW->NE isn't the fixed game's NW->NE unlock transition
+    facts = dict(engine_sha256=hashlib.sha256(SOURCE.read_bytes()).hexdigest(),
+                 mirror_initial=dict(original_spawn=f['farmer'], mirrored_spawn=mf['farmer'],
+                                     original_unlocked=f['unlocked_quadrants'],mirrored_unlocked=mf['unlocked_quadrants']),
+                 mirror_land=dict(mirror_after_buy=a['unlocked_quadrants'],buy_after_mirror=b['unlocked_quadrants'],commutes=False),
+                 fully_unlocked_hire=dict(original=spawn,reflected_expected=[9-spawn[0],spawn[1]],actual_mirrored=mirrored_spawn),
+                 market_no_rival=no_rival,market_with_rival=with_rival,
+                 conclusion='Own-only market simulation is exact conditional on zero rival flow, not an exact live quote.')
+    dst=Path('/workspace/shared/research/t046_engine_facts.json')
+    dst.write_text(json.dumps(facts,indent=2))
+    print(json.dumps(facts))
+
+
+if __name__ == '__main__':
+    main()
