   207	class Agent:
   208	    def __init__(self, ckpt, sample=False, temp=1.0, seed=12345, persist=False, dedupe=False, msample=False, fill=False,
   209	                 smask=False, notrip=False, team=None, trustop=False):
   210	        self.model = _make_model(ckpt, team)
   211	        self.sample = sample; self.temp = temp; self.rng = np.random.default_rng(seed)
   212	        self.snaps = []; self.last_step = None
   213	        uext = self.model.cfg.get("uext")
   214	        if uext is None:
   215	            uext = ["motion"] if self.model.cfg.get("u_dim", F.U_DIM_V1) > F.U_DIM_V1 else []
   216	        self.motion = "motion" in uext; self.memory = "memory" in uext; self.umem = F.UnitMemory()
   217	        self.pos_hist = []; self.day_hist = []
   218	        self.persist = persist; self.dedupe = dedupe; self.tgt = {}; self.tgt_day = -1; self.msample = msample; self.fill = fill; self.smask = smask; self.notrip = notrip; self.trustop = trustop
   219	        self.stats = {"n": 0, "pass": 0, "pass_forced": 0, "at_tgt_wants_move": 0, "top_masked": 0} if os.environ.get("BC3_STATS") else None
   220	
   221	    def _pick(self, logits, mask=None, market=False):
   222	        z = np.asarray(logits, np.float64)
   223	        if mask is not None:
   224	            z = np.where(mask, z, -1e9)
   225	        if not (self.sample or (market and self.msample)):
   226	            return int(z.argmax())
   227	        g = -np.log(-np.log(self.rng.random(z.shape) + 1e-20) + 1e-20)
   228	        return int((z / self.temp + g).argmax())
   229	
   230	    def __call__(self, obs, config=None):
   231	        p = int(obs.get("player", 0)); step = int(obs.get("step", 0)); day = int(obs.get("day", step // 24))
   232	        if self.last_step is None or step <= self.last_step:
   233	            self.snaps = []; self.tgt = {}; self.pos_hist = []; self.day_hist = []; self.umem = F.UnitMemory()
   234	        if day != self.tgt_day:
   235	            self.tgt = {}; self.tgt_day = day
   236	        self.last_step = step
   237	        self.snaps.append(F.snapshot(obs, p)); self.snaps = self.snaps[-(F.LAGS + 1):]
   238	        self.pos_hist.append(F.unit_positions(obs, p)); self.day_hist.append(day)
   239	        self.pos_hist = self.pos_hist[-3:]; self.day_hist = self.day_hist[-3:]
   240	        Bd = F.board3(obs, p); g = F.glob3(obs, p, F.hist_features(self.snaps))
   241	        memf = self.umem.features(len(self.pos_hist[-1]), step, day) if self.memory else None
   242	        ul = F.units3(obs, p, F.motion_context(self.pos_hist, self.day_hist) if self.motion else None, memf)
   243	        priv = obs.get("private") or {}; invs = priv.get("inventories") or []
   244	        farm = obs["farms"][p]
   245	        if True:
   246	            B = Bd[None].astype(np.float32); G = g[None].astype(np.float32)
   247	            h = self.model.encode(B, G)
   248	            acts = []
   249	            if ul:
   250	                ux = np.array([u[0] for u in ul], np.int64); uy = np.array([u[1] for u in ul], np.int64)
   251	                uv = np.stack([u[2] for u in ul]).astype(np.float32)
   252	                opl, tl, z = self.model.units(h, G, ux, uy, uv)
   253	                seeds_left = {c: int((priv.get("seeds") or {}).get(c, 0)) for c in F.CROPS}
   254	                shed_left = {it: int((priv.get("shed") or {}).get(it, 0)) for it in F.ITEMS}
   255	                claimed = set()
   256	                for i, (x, y, _v) in enumerate(ul):
   257	                    inv = invs[i] if i < len(invs) else {}
   258	                    mu, empty_ok, adj = _tile_mask(obs, p, x, y, inv, day)
   259	                    for c in F.CROPS:
   260	                        mu[F.UNIT_IDX["PLANT:" + c]] = empty_ok and seeds_left[c] > 0
   261	                    for it in F.ITEMS:
   262	                        mu[F.UNIT_IDX["PICKUP:" + it]] = adj and shed_left[it] > 0
   263	                    if self.persist and i in self.tgt and self.tgt[i] != (x, y):
   264	                        tx, ty = self.tgt[i]
   265	                    else:
   266	                        tlog = tl[i].copy()
   267	                        if self.dedupe:
   268	                            for (cx, cy) in claimed:
   269	                                if (cx, cy) not in SHED_ADJ and (cx, cy) != (x, y):
   270	                                    tlog[cy * 10 + cx] = -1e9
   271	                        tgt = self._pick(tlog); tx, ty = tgt % 10, tgt // 10
   272	                    claimed.add((tx, ty))
   273	                    if (tx, ty) != (x, y):
   274	                        self.tgt[i] = (tx, ty)
   275	                    else:
   276	                        self.tgt.pop(i, None)
   277	                    want = np.zeros(len(F.UNIT_OPS), bool)
   278	                    want[F.UNIT_IDX["EAST"]] = tx > x; want[F.UNIT_IDX["WEST"]] = tx < x
   279	                    want[F.UNIT_IDX["SOUTH"]] = ty > y; want[F.UNIT_IDX["NORTH"]] = ty < y
   280	                    mv = want & mu
   281	                    top_op = F.UNIT_OPS[int(np.argmax(opl[i]))]
   282	                    if (tx, ty) != (x, y) and mv.any():
   283	                        mask = mv
   284	                    elif self.trustop and (tx, ty) == (x, y) and top_op in _MOVES and mu[F.UNIT_IDX[top_op]]:
   285	                        mask = mu.copy()  # target head says "here" but the op head wants to move: trust the op head
   286	                    else:
   287	                        mask = mu.copy()
   288	                        for k in _MOVES:
   289	                            mask[F.UNIT_IDX[k]] = False
   290	                    cls = self._pick(opl[i], mask); k = F.UNIT_OPS[cls]
   291	                    if self.stats is not None:
   292	                        top = int(np.argmax(opl[i])); st = self.stats
   293	                        st["n"] += 1; st["pass"] += k == "PASS"
   294	                        st["pass_forced"] += (k == "PASS") and (F.UNIT_OPS[top] != "PASS")
   295	                        st["at_tgt_wants_move"] += ((tx, ty) == (x, y)) and (F.UNIT_OPS[top] in _MOVES)
   296	                        st["top_masked"] += not mask[top]
   297	                    if self.fill and k == "PASS" and F.UNIT_OPS[int(np.argmax(opl[i]))] != "PASS":
   298	                        fa = _filler(obs, p, x, y, inv, day, claimed, shed_left)
   299	                        if fa is not None and fa[0] is not None:
   300	                            acts.append(fa)
   301	                            if self.stats is not None: self.stats["filled"] = self.stats.get("filled", 0) + 1
   302	                            continue
   303	                    if k.startswith("PLANT:"):
   304	                        seeds_left[k[6:]] -= 1; acts.append(["PLANT", k[6:]])
   305	                    elif k.startswith("PICKUP:") or k.startswith("PLACE:"):
   306	                        ql = self.model.qty(z, i, cls)
   307	                        n = F.QTY_VALS[self._pick(ql)]; op, it = k.split(":")
   308	                        if op == "PICKUP":
   309	                            n = max(1, min(n, shed_left[it])); shed_left[it] -= n
   310	                        acts.append([op, it, n])
   311	                    else:
   312	                        acts.append([k])
   313	            # market: autoregressive slot decoding
   314	            n_hands = len(farm.get("hands") or []); hires = 0
   315	            lands_left = max(0, 3 - (len(farm.get("unlocked_quadrants") or []) - 1)); lands = 0
   316	            if self.memory:
   317	                self.umem.update(acts, self.pos_hist[-1], step)
   318	            ms = F.shed_after_units(obs, p, acts)
   319	            sell_left = {it: int(round(v * 50)) for it, v in zip(F.ITEMS, ms)}
   320	            MS = ms[None].astype(np.float32)
   321	            state = self.model.m_start(h, G, MS)
   322	            prev_t = F.N_TOK; prev_q = F.QMAX; orders = []; sold = set()
   323	            for sl in range(F.N_SLOTS):
   324	                state, logit = self.model.m_step(state, prev_t, prev_q, sl)
   325	                mask = np.ones(F.N_TOK, bool)
   326	                mask[F.TOK_IDX["HIRE"]] = n_hands + hires < _MAX_HANDS
   327	                mask[F.TOK_IDX["BUY_LAND"]] = lands < lands_left
   328	                if self.smask:  # SELL only what is in the shed at market time; units bought this turn are NOT sellable
   329	                    for it in F.PRODUCTS:
   330	                        mask[F.TOK_IDX["SELL:" + it]] = sell_left.get(it, 0) > 0
   331	                if self.notrip:  # no intra-turn round trips: no BUY of an item already sold this turn
   332	                    for it in ("WHEAT", "FERTILIZER"):
   333	                        if it in sold:
   334	                            mask[F.TOK_IDX["BUY_PRODUCT:" + it]] = False
   335	                tok = self._pick(logit, mask, market=True); key = F.TOKENS[tok]
   336	                if key == "END":
   337	                    break
   338	                if key in ("NOOP", "HIRE", "BUY_LAND"):
   339	                    orders.append([key]); q = F.QMAX
   340	                    hires += key == "HIRE"; lands += key == "BUY_LAND"
   341	                else:
   342	                    ql = self.model.m_qty(state, tok); q = self._pick(ql, market=True)
   343	                    op, it = key.split(":"); n = q + 1
   344	                    if op == "SELL":
   345	                        sold.add(it)
   346	                        if self.smask:
   347	                            n = max(1, min(n, sell_left.get(it, 0))); sell_left[it] -= n
   348	                    orders.append([op, it, n])
   349	                prev_t = tok; prev_q = q
   350	        return {"farmer": acts[0] if acts else ["PASS"], "hands": acts[1:], "market": orders}
   351	# ============================== BUNDLE END ============================================================================
