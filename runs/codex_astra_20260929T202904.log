   120	def units3(obs, p, motion=None, mem=None):
   121	    """motion=None: v1 features. motion=(prev1, prev2): lists of unit positions at t-1 and t-2 (same indexing; for hands
   122	    only valid within the same day — pass [] across a day boundary) -> adds (dx1, dy1, dx2, dy2, continued).
   123	    mem: list of per-unit UnitMemory feature vectors (appended last)."""
   124	    out = []
   125	    for i, (x, y, v) in enumerate(feat.unit_list(obs, p)):
   126	        oh = np.zeros(MAX_UNITS, np.float32); oh[min(i, MAX_UNITS - 1)] = 1
   127	        parts = [v, oh]
   128	        if motion is not None:
   129	            p1, p2 = motion; m = np.zeros(MOTION_DIM, np.float32)
   130	            if i < len(p1):
   131	                m[0] = x - p1[i][0]; m[1] = y - p1[i][1]; m[4] = 1
   132	                if i < len(p2):
   133	                    m[2] = p1[i][0] - p2[i][0]; m[3] = p1[i][1] - p2[i][1]
   134	            parts.append(np.clip(m, -1, 1))
   135	        if mem is not None:
   136	            parts.append(mem[i] if i < len(mem) else np.zeros(MEM_DIM, np.float32))
   137	        out.append((x, y, np.concatenate(parts)))
   138	    return out
