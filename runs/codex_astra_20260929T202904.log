    13	def one(args):
    14	    f, team, out, check, canon_dir, nonoop, motion, memory = args
    15	    dst = f"{out}/{os.path.basename(f).split('-replay')[0]}.npz"
    16	    if os.path.exists(dst):
    17	        return "skip"
    18	    try:
    19	        d = json.load(gzip.open(f, "rt") if f.endswith(".gz") else open(f))
    20	        names = d["info"].get("TeamNames", [])
    21	        if team not in names:
    22	            return "noteam"
    23	        p = names.index(team); T = len(d["steps"]) - 1
    24	        canon = None
    25	        if canon_dir:
    26	            cf = os.path.join(canon_dir, os.path.basename(f).replace("-replay.json.gz", ".json"))
    27	            cj = json.load(open(cf))
    28	            if not cj.get("verified"):
    29	                return f"ERR canon not verified {cf}"
    30	            canon = cj["canon"][p]
    31	        MS = np.zeros((T, F.MS_DIM), np.float32)
    32	        B = np.zeros((T, F.C_BOARD, 10, 10), np.float16); G = np.zeros((T, F.G_DIM), np.float32)
    33	        MT = np.zeros((T, F.N_SLOTS), np.int16); MQ = np.zeros((T, F.N_SLOTS), np.int16)
    34	        ut, ui, ux, uy, uv, ua, uq = [], [], [], [], [], [], []
    35	        snaps = []; bad = 0; pos_hist = []; day_hist = []; umem = F.UnitMemory() if memory else None
    36	        for t in range(T):
    37	            o = F.merged_obs(d, t, p); a = d["steps"][t + 1][p]["action"] or {}
    38	            snaps.append(F.snapshot(o, p)); snaps = snaps[-(F.LAGS + 1):]
    39	            B[t] = F.board3(o, p); G[t] = F.glob3(o, p, F.hist_features(snaps))
    40	            mk = canon[t] if canon is not None else a.get("market")
    41	            if nonoop:  # NOOP slot alignment measured worthless for Boey (codec_ceiling canon_nonoop): drop from labels
    42	                mk = [x for x in (mk or []) if x != ["NOOP"]]
    43	            MT[t], MQ[t] = F.encode_market_seq(mk)
    44	            if check and canon is None:
    45	                sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")); from codec_ceiling import market_seq
    46	                if F.decode_market_seq([x for x in MT[t] if x != F.IGNORE], [max(q, 0) for q in MQ[t]]) != market_seq(a.get("market")):
    47	                    bad += 1
    48	            acts = [a.get("farmer")] + list(a.get("hands") or [])
    49	            MS[t] = F.shed_after_units(o, p, acts)
    50	            pos_hist.append(F.unit_positions(o, p)); day_hist.append(int(o.get("day", t // 24)))
    51	            pos_hist = pos_hist[-3:]; day_hist = day_hist[-3:]
    52	            memf = umem.features(len(pos_hist[-1]), t, day_hist[-1]) if memory else None
    53	            for i, (x, y, vec) in enumerate(F.units3(o, p, F.motion_context(pos_hist, day_hist) if motion else None, memf)):
    54	                c, q = F.encode_unit(acts[i] if i < len(acts) else None)
    55	                ut.append(t); ui.append(i); ux.append(x); uy.append(y); uv.append(vec); ua.append(c); uq.append(q)
    56	            if memory:  # after this step's features: the memory only reflects actions of earlier steps
    57	                umem.update(acts, pos_hist[-1], t)
    58	        ut_a = np.array(ut); ui_a = np.array(ui); ux_a = np.array(ux); uy_a = np.array(uy); ua_a = np.array(ua)
    59	        key = {(int(t_), int(i_)): k for k, (t_, i_) in enumerate(zip(ut_a, ui_a))}
    60	        tx = ux_a.copy(); ty = uy_a.copy()
    61	        for k in range(len(ut_a)):  # target cell = where the unit does its next non-move action within the same day
    62	            if ua_a[k] not in MOVES:
    63	                continue
    64	            t_, i_ = int(ut_a[k]), int(ui_a[k]); day = t_ // 24; j = k
    65	            while True:
    66	                nk = key.get((t_ + 1, i_))
    67	                if nk is None or (t_ + 1) // 24 != day:
    68	                    break
    69	                t_ += 1; j = nk
    70	                if ua_a[j] not in MOVES:
    71	                    break
    72	            tx[k], ty[k] = ux_a[j], uy_a[j]
    73	        r = d["rewards"]
    74	        uext = np.array(["motion"] * bool(motion) + ["memory"] * bool(memory))
    75	        np.savez_compressed(dst, uext=uext, B=B, G=G, MT=MT, MQ=MQ, MS=MS, ut=ut_a.astype(np.int32), ui=ui_a.astype(np.int8),
    76	                            ux=ux_a.astype(np.int8), uy=uy_a.astype(np.int8), uv=np.array(uv, np.float32),
    77	                            ua=ua_a.astype(np.int16), uq=np.array(uq, np.int16), tx=tx.astype(np.int8), ty=ty.astype(np.int8),
    78	                            won=np.array(r[p] > r[1 - p]), margin=np.array(r[p] - r[1 - p]), seat=np.array(p))
    79	        return f"ok bad={bad}" if check else "ok"
    80	    except Exception as e:
    81	        import traceback
    82	        return f"ERR {f}: {e!r} {traceback.format_exc()[-600:]}"
