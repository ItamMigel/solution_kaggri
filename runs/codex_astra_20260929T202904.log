   371	def make_agent_dir(ckpt, out_dir, sample=False, temp=1.0, seed=12345, persist=False, dedupe=False, msample=False, fill=False,
   372	                   smask=False, notrip=False, team=None, trustop=False):
   373	    os.makedirs(out_dir, exist_ok=True)
   374	    cks = [c for c in str(ckpt).split(",") if c]; dsts = []
