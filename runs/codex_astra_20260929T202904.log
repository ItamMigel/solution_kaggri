   152	# ------------------------------------------------------------------ unit codec
   153	def qty_class(n):
   154	    return int(np.abs(QTY_ARR - int(n)).argmin())
   155	
   156	
   157	def encode_unit(a):
   158	    """-> (op class, qty class or IGNORE)"""
   159	    cls = feat.encode_unit_action(a)
   160	    k = UNIT_OPS[cls]
   161	    if (k.startswith("PICKUP:") or k.startswith("PLACE:")) and a and len(a) > 2:
   162	        return cls, qty_class(a[2])
   163	    return cls, IGNORE
