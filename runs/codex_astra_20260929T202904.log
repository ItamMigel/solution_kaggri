    85	if __name__ == "__main__":
    86	    ap = argparse.ArgumentParser(); ap.add_argument("--team"); ap.add_argument("--glob"); ap.add_argument("--out")
    87	    ap.add_argument("--workers", type=int, default=16); ap.add_argument("--check", action="store_true"); ap.add_argument("--limit", type=int, default=0)
    88	    ap.add_argument("--canon", default="", help="dir with canon_market.py outputs for these replays")
    89	    ap.add_argument("--nonoop", action="store_true", help="drop NOOP slots from market labels")
    90	    ap.add_argument("--motion", action="store_true", help="v2 unit features: unit displacement over the last 2 steps")
    91	    ap.add_argument("--memory", action="store_true", help="unit features: per-day memory of each unit's last work cell/type")
    92	    a = ap.parse_args(); os.makedirs(a.out, exist_ok=True)
    93	    fs = sorted(glob.glob(a.glob))
