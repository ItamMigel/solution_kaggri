   141	def motion_context(pos_hist, day_hist):
   142	    """pos_hist/day_hist: per-step unit position lists and days, current step last. Hands reset every day, the farmer
   143	    (index 0) persists. Returns (prev1, prev2) for units3."""
   144	    def prev(k):
   145	        if len(pos_hist) <= k:
   146	            return []
   147	        cur_day = day_hist[-1]; ps = pos_hist[-1 - k]
   148	        return ps if day_hist[-1 - k] == cur_day else ps[:1]
   149	    return prev(1), prev(2)
