+    for row in rows:
+        for name in row["names"]:
+            if (root / name.lower().replace(" ", "_")).exists(): groups[name].append(row)
+    # Folder slugs are not reliable for Cyrillic team names; target matching is
+    # instead explicit from each folder's first replay.
+    groups.clear()
