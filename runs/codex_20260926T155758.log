+    for r in records:
+        p = r["names"].index(target); q = 1 - p
+        total["final_margin"].append(_number(r["rewards"][p]) - _number(r["rewards"][q]))
+    total["mean_final_margin"] = sum(total["final_margin"]) / max(1, len(total["final_margin"]))
+    return total
