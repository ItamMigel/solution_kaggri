+    dest=Path(args.out); dest.parent.mkdir(parents=True,exist_ok=False); dest.write_text(json.dumps(out,indent=2,sort_keys=True)+"\n"); dest.with_suffix(".md").write_text(report(out)); print(dest.with_suffix(".md"))
+
