+            "opp_sell_units": len(sell), "opp_sell_revenue": sum(e["price"] for e in sell),
+            "cashflow_wheat": sum(e["price"] for e in sell)-sum(e["price"] for e in buy),
+            "buy_mean_price": sum((e["price"] for e in buy), 0)/max(1,len(buy)),
