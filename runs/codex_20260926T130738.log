+                                    "shed_delta": moved})
+
+    def town(env, state, step):
+        m = state[0].observation.market
+        bi, bp = m["inventory"]["WHEAT"], m["prices"]["WHEAT"]
+        ot(env, state, step)
+        ai, ap = m["inventory"]["WHEAT"], m["prices"]["WHEAT"]
+        if ai != bi:
