+                          "after_inv": ai, "before_price": bp, "after_price": ap})
+
+    K._commit_unit, K._apply_unit_action, K._end_of_day, K._town_consume = commit, unit, eod, town
+    try:
+        env = make("kaggriculture", configuration=cfg, debug=False); env.reset(2)
