SHARED = Path("/workspace/shared")
RUNS = SHARED / "runs"
CONTROL = SHARED / "candidates/es6_c4g15/pkg/main.py"
OPPONENTS = {
    "mirror": CONTROL,
    "parthenos": SHARED / "opponents/pool/parthenos_robust/main.py",
    "metav4": SHARED / "opponents/pool/tschinkel_metav4_v13/main.py",
    "yhay0913": SHARED / "opponents/pool/yhay_router0913/main.py",
    "t2945": SHARED / "opponents/pool/tschinkel2945/main.py",
    "ozer_v45": SHARED / "opponents/pool/ozer_v45/main.py",
    "yaxon": SHARED / "opponents/pool/yaxon_reactive_v5/main.py",
    "pilkwang": SHARED / "opponents/pool/pilkwang_struct/main.py",
    "es1_g9": SHARED / "candidates/es1_g9/pkg/main.py",
    "v5_market": ROOT / "agents/horizon_v5_market.py",
}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def values(node):
    if isinstance(node, dict):
        out = set()
        for key, value in node.items():
            if key == "seed" and type(value) is int and 0 <= value < 2**31:
                out.add(value)
            elif key == "seeds" and isinstance(value, list):
                out.update(v for v in value if type(v) is int and 0 <= v < 2**31)
            else:
                out |= values(value)
        return out
    if isinstance(node, list):
        return set().union(*(values(value) for value in node)) if node else set()
    return set()


def prior_seeds():
    artifacts = sorted(set(RUNS.rglob("manifest.json")) | set(RUNS.rglob("*seeds*.json")))
    excluded = set()
    for path in artifacts:
        try:
            excluded |= values(json.loads(path.read_text()))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise RuntimeError(f"unreadable seed artifact: {path}") from exc
    return excluded, [str(path) for path in artifacts]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--gen", type=int, required=True, help="completed CMA generation label")
    ap.add_argument("--workers", type=int, default=4)
    a = ap.parse_args()
    if a.gen < 0 or a.gen % 5:
        ap.error("--gen must be a non-negative multiple of five")
    if not 1 <= a.workers <= 4:
        ap.error("gate workers must be 1..4")
    candidate = RUNS / f"cma4/gen_{a.gen:03d}/c/main.py"
    out = RUNS / f"t025_cma4_g{a.gen:03d}_full_panel_vs_es6"
    if out.exists():
        raise RuntimeError(f"refusing to overwrite {out}")
    inputs = [candidate, CONTROL, *OPPONENTS.values()]
    if any(not path.is_file() for path in inputs):
        raise RuntimeError("missing frozen candidate, control, or opponent input")
    excluded, artifacts = prior_seeds()
    seeds = []
    while len(seeds) < 16:
        seed = secrets.randbelow(2**31)
        if seed not in excluded and seed not in seeds:
            seeds.append(seed)
    out.mkdir(parents=True)
    (out / "seeds.json").write_text(json.dumps({"seeds": seeds,
        "excluded_seed_count": len(excluded), "seed_artifacts": artifacts}, indent=2) + "\n")
    frozen = {"generation": a.gen, "candidate": {"path": str(candidate), "sha256": sha(candidate)},
              "control": {"path": str(CONTROL), "sha256": sha(CONTROL)},
              "opponents": {name: {"path": str(path), "sha256": sha(path)} for name, path in OPPONENTS.items()},
              "workers": a.workers, "expected_games": 640,
              "criterion": "9 equal-weight strata; joint 16-world bootstrap lower > 0; no named opponent below -10pp"}
    (out / "frozen_inputs.json").write_text(json.dumps(frozen, indent=2) + "\n")
    candidate_name, control_name = f"cma4_g{a.gen:03d}", "es6_c4g15"
    command = ["/workspace/solution_kaggri/.venv/bin/python", str(ROOT / "compare.py"),
               "--agent", f"{candidate_name}={candidate}", "--agent", f"{control_name}={CONTROL}", "--baselines"]
    for name, path in OPPONENTS.items():
        command += ["--opponent", f"{name}={path}"]
    command += ["--seeds", *(str(seed) for seed in seeds), "--workers", str(a.workers),
                "--out", str(out / "arena"), "--decision-note",
                "T025 periodic fresh full-panel gate against promoted es6_c4g15; no Kaggle submission."]
    subprocess.run(command, cwd=ROOT, check=True)
    report = out / "gate_report.json"
    subprocess.run(["/workspace/solution_kaggri/.venv/bin/python", str(ROOT / "lab/tools/t025_fresh_full_panel_report.py"),
                    "--games", str(out / "arena/games.jsonl"), "--candidate", candidate_name,
                    "--control", control_name, "--out", str(report)], cwd=ROOT, check=True)
    result = json.loads(report.read_text())
    summary = json.loads((out / "arena/summary.json").read_text())
    result["compare_evaluation_valid"] = summary.get("evaluation_valid")
    result["candidate_hash_unchanged"] = sha(candidate) == frozen["candidate"]["sha256"]
    result["control_hash_unchanged"] = sha(CONTROL) == frozen["control"]["sha256"]
    result["passes_gate"] = bool(result["passes_gate"] and result["compare_evaluation_valid"]
                                 and result["candidate_hash_unchanged"] and result["control_hash_unchanged"])
    report.write_text(json.dumps(result, indent=2) + "\n")
    wip = None
    if result["passes_gate"]:
        wip = SHARED / f"candidates_wip/es7_cma4_g{a.gen:03d}_fullpanel"
        if wip.exists():
            raise RuntimeError(f"refusing to overwrite candidate evidence {wip}")
        wip.mkdir()
        for path in (candidate, out / "seeds.json", out / "frozen_inputs.json", report, out / "arena/manifest.json"):
            shutil.copy2(path, wip / ("main.py" if path == candidate else path.name))
        (wip / "sha256.txt").write_text(f"{sha(candidate)}  main.py\n")
    message = (f"T025 CMA4 g{a.gen:03d} fresh full-panel vs es6_c4g15: "
               f"{'PASS' if result['passes_gate'] else 'FAIL'} paired={result['point_score_gain']*100:+.3f}pp "
               f"lower={result['score_one_sided_lower_95']*100:+.3f}pp; evidence={out}"
               + (f"; WIP={wip}" if wip else ""))
    subprocess.run([str(SHARED / "bin/say"), "claude", message], check=True)
    print(message)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Fail-closed report for T025's predeclared fresh full-panel gate.

The 16 worlds are the resampling blocks.  Each block contains the same named
opponents in both seats, so every bootstrap draw retains cross-opponent world
correlation.  ``es1_g9`` and ``v5_market`` form one equal-weight family unit.
"""
import argparse
import json
from pathlib import Path

import numpy as np

CORE = ("mirror", "parthenos", "metav4", "yhay0913", "t2945", "ozer_v45", "yaxon", "pilkwang")
FAMILY = ("es1_g9", "v5_market")
ALL = CORE + FAMILY


def point(row):
    seat = row["seat"]
    margin = row["rewards"][seat] - row["rewards"][1 - seat]
    return 1.0 if margin > 0 else 0.5 if margin == 0 else 0.0


def load(path, agents, keep_agents):
    rows = {}
    for line in Path(path).read_text().splitlines():
        row = json.loads(line)
        if (row.get("error") or row.get("status") != ["DONE", "DONE"]
                or row.get("invalid_steps") or "rewards" not in row):
            raise RuntimeError(f"invalid game row: {row}")
        if row["candidate"] not in agents or row["opponent"] not in ALL:
            raise RuntimeError(f"unexpected candidate/opponent: {row}")
        # A shared fresh-world run may contain a second predeclared candidate.
        # Validate every one of its rows above, but pair only the requested
        # candidate with the common frozen control below.
        if row["candidate"] not in keep_agents:
            continue
        key = (row["candidate"], row["opponent"], row["seed"], row["seat"])
        if key in rows:
            raise RuntimeError(f"duplicate paired row: {key}")
        rows[key] = (point(row), row["rewards"][row["seat"]] - row["rewards"][1 - row["seat"]])
    return rows


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--games", required=True)
    ap.add_argument("--candidate", required=True)
    ap.add_argument("--control", default="es5_c3g15")
    ap.add_argument("--allowed-agent", action="append", default=[],
                    help="additional candidate label whose rows are validated but excluded from this pair")
    ap.add_argument("--out", required=True)
    ap.add_argument("--resamples", type=int, default=200000)
    ap.add_argument("--rng-seed", type=int, default=230923)
    a = ap.parse_args()
    allowed = {a.candidate, a.control, *a.allowed_agent}
    rows = load(a.games, allowed, {a.candidate, a.control})
    seeds = sorted({key[2] for key in rows})
    per_world, by_opponent = [], {op: [] for op in ALL}
    for seed in seeds:
        per_op = {}
        for opponent in ALL:
            values = []
            for seat in (0, 1):
                kc = (a.candidate, opponent, seed, seat)
                kb = (a.control, opponent, seed, seat)
                if kc not in rows or kb not in rows:
                    raise RuntimeError(f"missing paired row: seed={seed}, opponent={opponent}, seat={seat}")
                values.append((rows[kc][0] - rows[kb][0], rows[kc][1] - rows[kb][1]))
            per_op[opponent] = np.mean(values, axis=0)
            by_opponent[opponent].append(per_op[opponent])
        strata = [per_op[op] for op in CORE] + [np.mean([per_op[op] for op in FAMILY], axis=0)]
        per_world.append({"seed": seed, "score": float(np.mean([x[0] for x in strata])),
                          "cash": float(np.mean([x[1] for x in strata]))})
    expected = len(seeds) * len(ALL) * 2 * 2
    if len(rows) != expected:
        raise RuntimeError(f"wrong game count: got {len(rows)}, expected {expected}")
    score = np.array([row["score"] for row in per_world])
    cash = np.array([row["cash"] for row in per_world])
    rng = np.random.default_rng(a.rng_seed)
    ix = rng.integers(0, len(seeds), size=(a.resamples, len(seeds)))
    boot = score[ix].mean(axis=1)
    result = {
        "worlds": len(seeds), "expected_valid_games": expected, "valid_games": len(rows),
        "core_strata": list(CORE), "family_stratum": list(FAMILY), "equal_weight_strata": len(CORE) + 1,
        "point_score_gain": float(score.mean()), "cash_gain": float(cash.mean()),
        "score_one_sided_lower_95": float(np.quantile(boot, .05)),
        "score_two_sided_95": [float(np.quantile(boot, .025)), float(np.quantile(boot, .975))],
        "cash_two_sided_95": [float(np.quantile(cash[ix].mean(axis=1), .025)), float(np.quantile(cash[ix].mean(axis=1), .975))],
        "by_opponent": {op: {"score_gain": float(np.mean(values, axis=0)[0]),
                               "cash_gain": float(np.mean(values, axis=0)[1])}
                        for op, values in by_opponent.items()},
        "per_world": per_world, "resamples": a.resamples, "rng_seed": a.rng_seed,
    }
    result["passes_lower_gt_zero"] = result["score_one_sided_lower_95"] > 0
    result["passes_no_opponent_below_minus_10pp"] = all(
        value["score_gain"] >= -.10 for value in result["by_opponent"].values())
    result["passes_gate"] = result["passes_lower_gt_zero"] and result["passes_no_opponent_below_minus_10pp"]
    Path(a.out).write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({key: result[key] for key in ("worlds", "valid_games", "point_score_gain", "score_one_sided_lower_95", "passes_lower_gt_zero", "passes_no_opponent_below_minus_10pp", "passes_gate")}))


if __name__ == "__main__":
    main()

