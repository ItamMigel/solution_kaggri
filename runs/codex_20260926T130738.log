+    return matches
+
+
+def game_summary(g):
+    us, op = g["us"], 1-g["us"]
+    pe = g["events"][op]; ue = g["events"][us]
+    buy = [e for e in pe if e["op"] == "BUY_PRODUCT"]
+    sell = [e for e in pe if e["op"] == "SELL"]
+    ours = [e for e in ue if e["op"] == "BUY_PRODUCT"]
