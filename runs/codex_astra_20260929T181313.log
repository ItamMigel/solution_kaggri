   107	def _team_vec(cfg, team):
   108	    teams = cfg.get("teams") or []
   109	    if not teams:
   110	        return None
   111	    v = np.zeros(len(teams), np.float32); v[teams.index(team) if team in teams else 0] = 1
   112	    return v
