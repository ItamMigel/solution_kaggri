+        K._process_market(state, SimpleNamespace(configuration=d['configuration']))
+        return [f['money'] for f in farms], act, [p['shed'] for p in priv]
+
+    money, _, _ = run()
+    assert money == d['rewards'], (replay_path, money, d['rewards'])
