    19	def _tile_mask(obs, p, x, y, inv, day):
    20	    """Copy of lab/bc/export.py _tile_mask (engine _apply_unit_action semantics); PLANT/PICKUP set by caller."""
    21	    t = obs["farms"][p]["tiles"][y][x]; m = np.zeros(len(F.UNIT_OPS), bool); inv = inv or {}
    22	    for mv, (dx, dy) in _MOVES.items():
    23	        m[F.UNIT_IDX[mv]] = 0 <= x + dx < 10 and 0 <= y + dy < 10
    24	    locked = t == "LOCKED"; empty = t is None
    25	    d = t if isinstance(t, dict) else {}
    26	    plant = d.get("kind") == "PLANT"; animal = "animal" in d and d.get("animal") is not None
    27	    if plant:
    28	        age = day - int(d.get("planted_day", day)); fy = F.feat.FIRST_YIELD.get(d.get("crop"), 99)
    29	        m[F.UNIT_IDX["WATER"]] = not d.get("watered_today")
    30	        m[F.UNIT_IDX["HARVEST"]] = age >= fy and int(d.get("yield_units", 0)) > 0
    31	        m[F.UNIT_IDX["FERTILIZE"]] = inv.get("FERTILIZER", 0) > 0
    32	    if animal:
    33	        m[F.UNIT_IDX["HARVEST"]] = int(d.get("yield_units", 0)) > 0
    34	        m[F.UNIT_IDX["FEED"]] = (not d.get("fed_today")) and inv.get("WHEAT", 0) > 0
    35	        m[F.UNIT_IDX["CARE"]] = not d.get("cared_today")
    36	        m[F.UNIT_IDX["COLLECT_FERTILIZER"]] = bool(d.get("fertilizer_available"))
    37	    m[F.UNIT_IDX["BUILD_COOP"]] = m[F.UNIT_IDX["BUILD_PASTURE"]] = empty
    38	    m[F.UNIT_IDX["DIG"]] = (not empty) and (not locked) and (not animal)
    39	    adj = (x, y) in SHED_ADJ
    40	    m[F.UNIT_IDX["DROP"]] = adj and sum(inv.values()) > 0
    41	    for it in F.ITEMS:
    42	        has = inv.get(it, 0) > 0
    43	        if it in _STRUCT:
    44	            m[F.UNIT_IDX["PLACE:" + it]] = has and ((d.get("kind") == _STRUCT[it] and not animal) or adj)
    45	        else:
    46	            m[F.UNIT_IDX["PLACE:" + it]] = has and adj
    47	    m[F.UNIT_IDX["PASS"]] = True
    48	    return m, (empty and not locked), adj
