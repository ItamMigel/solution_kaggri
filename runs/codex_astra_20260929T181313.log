     1	"""Canonical (execution-equivalent) market tapes.
     2	Re-simulates a replay with both recorded tapes while instrumenting the engine's market processing, then rewrites
     3	each player's market list: SELL/BUY_* orders that filled 0 units -> NOOP, partially filled -> filled quantity,
     4	unknown ops -> NOOP, trailing NOOPs dropped. HIRE/BUY_LAND are kept as issued.
     5	Verification: re-running the canonical tapes must reproduce the recorded rewards exactly.
     6	
     7	usage: python canon_market.py --glob '../../../replays/56521745/*.gz' --out ../../../canon/56521745 --workers 24
     8	Writes <out>/<episode>.json = {"episode", "seed", "canon": [tape_p0_market, tape_p1_market], "verified": bool, stats}"""
     9	import argparse, contextlib, glob, gzip, io, json, os
    10	from concurrent.futures import ProcessPoolExecutor
    11	
    12	
    13	def simulate(d, market_override=None, instrument=False):
    14	    from kaggle_environments import make
    15	    import kaggle_environments.envs.kaggriculture.kaggriculture as K
    16	    tapes = [[d["steps"][k + 1][s]["action"] for k in range(len(d["steps"]) - 1)] for s in (0, 1)]
    17	    if market_override is not None:
    18	        tapes = [[dict(a or {}, market=market_override[s][k]) for k, a in enumerate(tapes[s])] for s in (0, 1)]
    19	    log = []  # per market call: list of (player, slot, order, ostate)
    20	    orig_pm, orig_po = K._process_market, K._parse_order
    21	    cur = {"calls": None, "counts": None, "queues": None}
    22	
    23	    def parse(order):
    24	        o = orig_po(order)
    25	        if cur["calls"] is not None:
    26	            # _process_market parses slot i for player 0 then player 1 (only players with a slot i)
    27	            cur["calls"].append((order, o))
    28	        return o
    29	
    30	    def pm(state, env):
    31	        cur["calls"] = []
    32	        orig_pm(state, env)
    33	        log.append(cur["calls"]); cur["calls"] = None
    34	
    35	    if instrument:
    36	        K._process_market, K._parse_order = pm, parse
    37	    try:
    38	        cfg = {k: v for k, v in d["configuration"].items() if k not in ("agents", "seed")}; cfg["seed"] = d["info"]["seed"]
    39	
    40	        def mk(s):
    41	            def ag(obs, config=None):
    42	                k = int(obs.get("step", 0)); return tapes[s][k] if k < len(tapes[s]) else {}
    43	            return ag
    44	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
    45	            env = make("kaggriculture", configuration=cfg, debug=False); env.run([mk(0), mk(1)])
    46	    finally:
    47	        K._process_market, K._parse_order = orig_pm, orig_po
    48	    return env, tapes, log
    49	
    50	
    51	def canon_one(args):
    52	    path, out = args
    53	    dst = os.path.join(out, os.path.basename(path).replace("-replay.json.gz", ".json"))
    54	    if os.path.exists(dst):
    55	        return "skip"
    56	    d = json.load(gzip.open(path, "rt"))
    57	    env, tapes, log = simulate(d, instrument=True)
    58	    rec = d["rewards"]
    59	    if [s.reward for s in env.state] != rec:
    60	        return f"ERR not reproducing {path}"
    61	    maxo = int(d["configuration"].get("maxMarketOrdersPerTurn", 10))
    62	    canon = [[None] * len(tapes[0]) for _ in (0, 1)]
    63	    stats = {"orders": 0, "noop_in": 0, "failed": 0, "partial": 0}
    64	    assert len(log) == len(tapes[0]), (len(log), len(tapes[0]))
    65	    for k, calls in enumerate(log):
    66	        queues = [list(((tapes[s][k] or {}).get("market") or []))[:maxo] for s in (0, 1)]
    67	        # reconstruct (player, slot) for each parse call: slot-major, player-minor, only where slot exists
    68	        order_seq = [(s, i) for i in range(max(len(q) for q in queues) if any(queues) else 0) for s in (0, 1) if i < len(queues[s])]
    69	        assert len(order_seq) == len(calls), (k, len(order_seq), len(calls))
    70	        res = {(s, i): o for (s, i), (_order, o) in zip(order_seq, calls)}
    71	        for s in (0, 1):
    72	            new = []
    73	            for i, order in enumerate(queues[s]):
    74	                stats["orders"] += 1
    75	                o = res[(s, i)]
    76	                if o is None:
    77	                    stats["noop_in"] += 1; new.append(["NOOP"]); continue
    78	                if o["type"] in ("HIRE", "BUY_LAND"):
    79	                    new.append([o["type"]]); continue
    80	                n = int(order[2]); filled = n - int(o["remaining"])
    81	                if filled <= 0:
    82	                    stats["failed"] += 1; new.append(["NOOP"])
    83	                else:
    84	                    stats["partial"] += filled < n; new.append([order[0], order[1], filled])
    85	            while new and new[-1] == ["NOOP"]:
    86	                new.pop()
    87	            canon[s][k] = new
    88	    env2, _, _ = simulate(d, market_override=canon)
    89	    ok = [s.reward for s in env2.state] == rec
    90	    json.dump({"episode": d["info"]["EpisodeId"], "names": d["info"]["TeamNames"], "canon": canon, "verified": ok, "stats": stats},
    91	              open(dst, "w"))
    92	    return f"ok verified={ok} {json.dumps(stats)}"
    93	
    94	
    95	def main():
    96	    ap = argparse.ArgumentParser(); ap.add_argument("--glob", required=True); ap.add_argument("--out", required=True)
    97	    ap.add_argument("--workers", type=int, default=16); ap.add_argument("--limit", type=int, default=0)
    98	    a = ap.parse_args(); os.makedirs(a.out, exist_ok=True)
    99	    fs = sorted(glob.glob(a.glob))
   100	    if a.limit:
   101	        fs = fs[: a.limit]
   102	    with ProcessPoolExecutor(a.workers) as ex:
   103	        res = list(ex.map(canon_one, [(f, a.out) for f in fs]))
   104	    import collections
   105	    print(collections.Counter(r.split(" ")[0] + " " + (r.split(" ")[1] if len(r.split(" ")) > 1 else "") for r in res))
   106	    print([r for r in res if r.startswith("ERR")][:3])
   107	    tot = collections.Counter()
   108	    for r in res:
   109	        if r.startswith("ok"):
   110	            tot.update(json.loads(r.split(" ", 2)[2]))
   111	    print("totals:", dict(tot))
   112	
   113	
   114	if __name__ == "__main__":
   115	    main()

