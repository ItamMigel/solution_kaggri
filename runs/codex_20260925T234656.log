import hashlib, json
from pathlib import Path
roots=[Path('/workspace/shared/runs/panel_c3g5'), Path('/workspace/shared/runs')]
used=set(); files=[]
for p in roots[1].rglob('*'):
    if not p.is_file() or p.suffix not in {'.json','.jsonl'}: continue
    try:
        obj=json.loads(p.read_text()) if p.suffix=='.json' else [json.loads(x) for x in p.read_text().splitlines() if x.strip()]
    except Exception: continue
    def walk(x):
        if isinstance(x,dict):
            for k,v in x.items():
                if k in {'seed','seeds'} or 'seed' in k.lower(): walk(v)
                else: walk(v)
        elif isinstance(x,list):
            for v in x: walk(v)
        elif type(x) is int and 0 <= x < 2**31: used.add(x)
    walk(obj); files.append(p)
print('used',len(used),'files',len(files))
new=[]; n=0
while len(new)<32:
    x=int.from_bytes(hashlib.sha256(f'T025-2026-09-25-fresh-world-{n}'.encode()).digest()[:4],'big') & 0x7fffffff
    n+=1
    if x not in used and x not in new: new.append(x)
print('parthenos24',new[:24])
print('cma8',new[24:])
print('overlap',set(new)&used)
