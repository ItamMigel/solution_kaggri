# Local patch, 2026-09-24. Not part of the upstream source verified above.
#
# Finding: for these 10 first-two-shop patterns, the router's own table
# (_R108_SHOP_ROUTES / _R110_OLD_SHOPS / _V92_TABLE) picks a route that a
# forced-replay test showed losing to a DIFFERENT route already present in
# this SAME agent's own baked route library (id 0) -- confirmed on the real
# game engine, checked by margin sign (not just win-rate), not by assumption.
# This only remaps 10 specific shop-pairs; every other decision, layer and
# byte of the verified SOURCE above is unchanged.
_PATCH_MARKER = "_HH_REMAP_20260924"
_text = SOURCE.decode("utf-8")
if _PATCH_MARKER not in _text:
    _anchor1 = "_V93_ROUTE_BY_RIVAL = {(229.0, 9989): 128}\ndef _router(observation,step,state):"
    _replacement1 = (
        "_V93_ROUTE_BY_RIVAL = {(229.0, 9989): 128}\n"
        "_HH_REMAP_20260924 = {\n"
        "    ('FARMERS_MARKET','FARMERS_MARKET'): 0, ('FARMERS_MARKET','PET_CAFE'): 0,\n"
        "    ('FARMERS_MARKET','PIZZA_SHOP'): 0, ('PET_CAFE','BAKERY'): 0,\n"
        "    ('PET_CAFE','FARMERS_MARKET'): 0, ('PIZZA_SHOP','PIZZA_SHOP'): 0,\n"
        "    ('SMOOTHIE_SHOP','BRUNCH_SPOT'): 0, ('YARN_STORE','ICE_CREAM_SHOP'): 0,\n"
        "    ('BAKERY','FARMERS_MARKET'): 0, ('ICE_CREAM_SHOP','PET_CAFE'): 0,\n"
        "}\n"
        "def _router(observation,step,state):"
    )
    assert _anchor1 in _text, "anchor1 not found -- SOURCE shape changed upstream"
    _text = _text.replace(_anchor1, _replacement1)
    # Inserted AFTER the _V93_ROUTE_BY_RIVAL check (not before) -- matches the
    # exact statement order of the already-validated HERO_V4_ROUTEFIX build,
    # so this notebook reproduces byte-for-byte what was actually tested on
    # the 1920-game panel, not a reordered lookalike.
    _anchor2 = (
        "        if 'YARN_STORE' in shops and state.get('rkey') in _V93_ROUTE_BY_RIVAL:\n"
        "            state['route']=_V93_ROUTE_BY_RIVAL[state['rkey']]\n"
        "        state['day6']=True\n"
    )
    _replacement2 = (
        "        if 'YARN_STORE' in shops and state.get('rkey') in _V93_ROUTE_BY_RIVAL:\n"
