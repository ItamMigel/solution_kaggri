#!/usr/bin/env python3
"""PBT controller = evolution over PPO agents.

Every member (runs/pbt/mI, one per GPU) trains PPO in rounds of K iterations (scripts/pbt_member.sh).
This controller, on CPU:
  1. evaluates the newest round checkpoint of every member in the OFFICIAL engine
     (one compare.py call, common worlds for all members) vs es3_g5 / es1_g9 / v5_market;
  2. fitness = mean score rate + mean margin / 40000, smoothed over the member's last 2 evals;
  3. exploit/explore: the worst member copies the best member's evaluated weights and gets
     perturbed hyper-parameters (written as mI/EXPLOIT.json, applied by the member between rounds);
  4. hall of fame: best evaluated checkpoint -> runs/pbt/best/ (+ Kaggle tar for the HUMAN; agents never submit).
"""
import argparse, glob, json, os, random, re, shutil, subprocess, sys, tarfile, time

HP_BOUNDS = {"lr": (1e-6, 4e-5), "ent": (1e-4, 1e-2), "clip": (.06, .25), "kl_floor": (0.0, .05), "target_kl": (.005, .05)}


def perturb(hp, rng):
    hp = dict(hp)
    for k, (lo, hi) in HP_BOUNDS.items():
        if k == "kl_floor":
            v = hp[k] * rng.choice([.5, 1.5]) if hp[k] > 0 else rng.choice([0.0, 0.0, .005])
        else:
            v = hp[k] * rng.choice([.7, .8, 1.25, 1.4])
        hp[k] = float(min(hi, max(lo, v)))
    if rng.random() < .2:
        hp["epochs"] = 3 - hp["epochs"] if hp["epochs"] in (1, 2) else 1
    return hp


def newest_ckpt(mdir):
    cks = sorted(glob.glob(f"{mdir}/it*.pt"), key=lambda p: int(re.search(r"it(\d+)\.pt$", p).group(1)))
    return cks[-1] if cks else None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", required=True)          # runs/pbt
    ap.add_argument("--pkg", required=True)
    ap.add_argument("--py", default=sys.executable)
    ap.add_argument("--members", type=int, default=4)
    ap.add_argument("--team", default="dsm")
    ap.add_argument("--worlds", type=int, default=6)
    ap.add_argument("--workers", type=int, default=32)
    ap.add_argument("--timeout", type=int, default=900)
    ap.add_argument("--margin-delta", type=float, default=.03, help="exploit only if best-worst fitness gap exceeds this")
    ap.add_argument("--start", default="", help="also evaluate this checkpoint once as the reference")
    ap.add_argument("--poll", type=int, default=60)
    a = ap.parse_args()
    rng = random.Random(12345)
    lab, harness = f"{a.pkg}/code/lab", f"{a.pkg}/code/harness"
    fit_path = f"{a.root}/fitness.jsonl"
    done = set()
    hist = {}  # member -> list of fitness
    if os.path.exists(fit_path):
        for line in open(fit_path):
            r = json.loads(line)
            done.add(r["ckpt"])
            if r["member"].startswith("m"):
                hist.setdefault(r["member"], []).append(r["fitness"])
    seeds = json.load(open(f"{harness}/seeds/v5_development.json"))["seeds"][:a.worlds]
    gen = len(glob.glob(f"{a.root}/eval/gen_*"))
    while True:
        todo = {}
        for i in range(a.members):
            ck = newest_ckpt(f"{a.root}/m{i}")
            if ck and ck not in done and not os.path.exists(f"{a.root}/m{i}/EXPLOIT.json"):
                todo[f"m{i}"] = ck
        if a.start and a.start not in done:
            todo["start"] = a.start
        fresh = [m for m in todo if m != "start"]
        oldest = min((os.path.getmtime(todo[m]) for m in fresh), default=time.time())
        if not fresh or (len(fresh) < min(2, a.members) and time.time() - oldest < 900):
            time.sleep(a.poll); continue  # prefer evaluating >=2 members on the same worlds
        gdir = f"{a.root}/eval/gen_{gen:03d}"; os.makedirs(gdir, exist_ok=True)
        # snapshot the evaluated weights (members keep training and may overwrite their files)
        agents, pool = [], {}
        for m, ck in todo.items():
            it = re.search(r"it(\d+)\.pt$", ck); tag = f"{m}_it{it.group(1)}" if it else m
            snap = f"{a.root}/pool/{tag}.pt"; os.makedirs(os.path.dirname(snap), exist_ok=True); shutil.copy(ck, snap)
            os.makedirs(f"{gdir}/{tag}", exist_ok=True)
            subprocess.run([a.py, f"{lab}/bc/export.py", "--ckpt", snap, "--team", a.team, "--out", f"{gdir}/{tag}/main.py", "--sample"], check=True)
            agents += ["--agent", f"{tag}={gdir}/{tag}/main.py"]; pool[m] = (tag, snap, ck)
        cmd = [a.py, "compare.py", *agents, "--baselines", "v5_market",
               "--opponent", "es3_g5=candidates/es3_g5/main.py", "--opponent", "es1_g9=candidates/es1_g9/main.py",
               "--seeds", *map(str, seeds), "--workers", str(a.workers), "--game-timeout", str(a.timeout), "--out", f"{gdir}/arena"]
        t0 = time.time()
        subprocess.run(cmd, cwd=harness, check=False, stdout=open(f"{gdir}/compare.log", "w"), stderr=subprocess.STDOUT)
        try:
            summ = json.load(open(f"{gdir}/arena/summary.json"))
        except Exception as exc:
            print(f"gen {gen}: compare failed ({exc}), see {gdir}/compare.log", flush=True); gen += 1; time.sleep(a.poll); continue
        results = {}
        for m, (tag, snap, ck) in pool.items():
            byo = summ["candidates"].get(tag, {}).get("by_opponent", {})
            rates = [v["score_rate"] for v in byo.values() if "score_rate" in v]
            margins = [v["mean_margin"] for v in byo.values() if "mean_margin" in v]
            if not rates:
                continue
            fit = sum(rates) / len(rates) + sum(margins) / len(margins) / 40000
            row = {"gen": gen, "member": m, "tag": tag, "ckpt": ck, "snap": snap, "fitness": fit, "secs": round(time.time() - t0),
                   "by_opp": {o: {"wdl": [v.get("wins"), v.get("draws"), v.get("losses")], "rate": v.get("score_rate"),
                                  "margin": v.get("mean_margin"), "errors": v.get("errors")} for o, v in byo.items()}}
            results[m] = row; done.add(ck)
            with open(fit_path, "a") as fh: fh.write(json.dumps(row) + "\n")
            if m.startswith("m"):
                hist.setdefault(m, []).append(fit)
            best_path = f"{a.root}/best/best.json"
            best = json.load(open(best_path)) if os.path.exists(best_path) else {"fitness": -1e9}
            if fit > best["fitness"]:
                os.makedirs(f"{a.root}/best", exist_ok=True)
                shutil.copy(snap, f"{a.root}/best/best.pt"); shutil.copy(f"{gdir}/{tag}/main.py", f"{a.root}/best/main.py")
                with tarfile.open(f"{a.root}/best/submission_pbt_best.tar.gz", "w:gz") as t: t.add(f"{gdir}/{tag}/main.py", arcname="main.py")
                json.dump(row, open(best_path, "w"), indent=1)
            print(f"gen {gen} {tag}: fitness {fit:.3f} " + " ".join(
                f"{o}:{r['wdl'][0]}/{r['wdl'][1]}/{r['wdl'][2]} {r['margin']:+.0f}" for o, r in row["by_opp"].items()), flush=True)
        # exploit / explore among members with at least one eval
        smooth = {m: sum(h[-2:]) / len(h[-2:]) for m, h in hist.items() if h}
        if len(smooth) >= 2:
            order = sorted(smooth, key=smooth.get)
            worst, best_m = order[0], order[-1]
            donor = results.get(best_m) or next((json.loads(l) for l in reversed(open(fit_path).readlines())
                                                 if json.loads(l)["member"] == best_m), None)
            if donor and smooth[best_m] - smooth[worst] > a.margin_delta:
                hp = json.load(open(f"{a.root}/{best_m}/hp.json"))
                new = perturb(hp, rng)
                json.dump({"donor": best_m, "ckpt": donor["snap"], "hp": new, "gen": gen},
                          open(f"{a.root}/{worst}/EXPLOIT.json", "w"), indent=1)
                hist[worst] = []  # fresh start for the replaced member
                print(f"gen {gen}: EXPLOIT {worst} ({smooth[worst]:.3f}) <- {best_m} ({smooth[best_m]:.3f}) {donor['tag']}; new hp {new}", flush=True)
        gen += 1


if __name__ == "__main__":
    main()
#!/bin/bash
# pbt_member.sh I GPU — one PBT member: PPO rounds of K iterations; between rounds applies EXPLOIT.json from the controller
# (copy the donor's weights + new hyper-parameters). League = own previous snapshot + the other members' newest
# checkpoints + frozen doubles $FROZEN ("ckpt:team ...").
source "$(dirname "$0")/_env.sh"
I=$1; GPU=${2:-$1}; ROOT="$RUNS/pbt"; M="$ROOT/m$I"; REF="$ROOT/ref.pt"
K=${K:-10}; ENVS=${ENVS:-6256}; MB=${MB:-16384}; TEAM=${TEAM:-dsm}; KL=${KL:-0.02}; HORIZON=${HORIZON:-400}
r=0
while true; do
  if [ -f "$M/EXPLOIT.json" ]; then
    $PY - "$M" <<'PY'
import json, shutil, sys
m = sys.argv[1]; e = json.load(open(f"{m}/EXPLOIT.json"))
shutil.copy(e["ckpt"], f"{m}/last.pt"); json.dump(e["hp"], open(f"{m}/hp.json", "w"), indent=1)
open(f"{m}/exploit.log", "a").write(json.dumps(e) + "\n")
PY
    rm -f "$M/EXPLOIT.json"; echo "$(date +%F_%T) exploited: $(tail -1 $M/exploit.log)"
  fi
  HP=$($PY -c "import json;h=json.load(open('$M/hp.json'));print(h['lr'],h['ent'],h['clip'],h['epochs'],h['kl_floor'],h['target_kl'])")
  read LR ENT CLIP EP FLOOR TKL <<< "$HP"
  OWN=$(ls -t "$M"/it*.pt 2>/dev/null | sed -n 2p); [ -z "$OWN" ] && OWN="$REF"
  LEAGUE=(--league-snapshot "$OWN:$TEAM")
  for j in $(seq 0 $((${MEMBERS:-4} - 1))); do [ "$j" = "$I" ] && continue
    c=$(ls -t "$ROOT/m$j"/it*.pt 2>/dev/null | head -1); [ -n "$c" ] && LEAGUE+=(--league-double "$c:$TEAM"); done
  for spec in $FROZEN; do [ -f "${spec%:*}" ] && LEAGUE+=(--league-double "$spec"); done
  echo "$(date +%F_%T) round $r hp lr=$LR ent=$ENT clip=$CLIP ep=$EP floor=$FLOOR tkl=$TKL league=${#LEAGUE[@]}"
  CUDA_VISIBLE_DEVICES=$GPU $PY "$LAB/bcppo/ppo.py" --init "$REF" --out "$M" --team $TEAM --envs $ENVS --iters $HORIZON --run-iters $K \
     --mb $MB --amp bf16 --kl $KL --kl-floor $FLOOR --lr $LR --ent $ENT --clip $CLIP --epochs $EP --target-kl $TKL \
     --value-warmup 0 --seed $((1000 * I + r)) --resume "${LEAGUE[@]}" >> "$M/stdout.log" 2>&1 \
     || { echo "round $r failed, see $M/stdout.log"; sleep 60; }
  r=$((r + 1))
done
#!/bin/bash
# PBT = evolution over PPO: 4 members (one per GPU) start from the SAME strongest checkpoint with different hyper-parameters,
# play each other in the league, and every round the CPU controller exams them in the official engine vs es3_g5/es1_g9/v5;
# the worst copies the best's weights with mutated hyper-parameters.
#   START=runs/v3_cont/it034.pt ./scripts/pbt.sh
#   optional: FROZEN="$OLD/bc_v3_all/best.pt:mgoose $OLD/bc_v3_all/best.pt:mmpq"  ENVS=6256 MB=16384 K=10 WORLDS=6 WORKERS=32
set -e; source "$(dirname "$0")/_env.sh"; S="$(dirname "$0")"
START=${START:?set START=path/to/strongest.pt}; ROOT="$RUNS/pbt"; MEMBERS=${MEMBERS:-4}; export MEMBERS
[ -d "$ROOT" ] && [ -z "$RESUME" ] && { echo "$ROOT exists: RESUME=1 to continue, or move it away"; exit 1; }
mkdir -p "$ROOT"
if [ -z "$RESUME" ]; then
  cp "$START" "$ROOT/ref.pt"   # KL anchor (--init) and starting weights of every member
  HPS=('{"lr":5e-6,"ent":0.001,"clip":0.12,"epochs":1,"kl_floor":0.0,"target_kl":0.015}'
       '{"lr":1e-5,"ent":0.001,"clip":0.12,"epochs":1,"kl_floor":0.0,"target_kl":0.02}'
       '{"lr":5e-6,"ent":0.003,"clip":0.15,"epochs":2,"kl_floor":0.005,"target_kl":0.015}'
       '{"lr":3e-6,"ent":0.0005,"clip":0.10,"epochs":2,"kl_floor":0.0,"target_kl":0.01}')
  for i in $(seq 0 $((MEMBERS - 1))); do mkdir -p "$ROOT/m$i"; cp "$START" "$ROOT/m$i/last.pt"; echo "${HPS[$((i % 4))]}" > "$ROOT/m$i/hp.json"; done
fi
GPUS=(${GPUS:-0 1 2 3})
for i in $(seq 0 $((MEMBERS - 1))); do nohup "$S/pbt_member.sh" $i ${GPUS[$((i % ${#GPUS[@]}))]} > "$ROOT/m$i.log" 2>&1 & done
nohup $PY "$LAB/pbt/pbt_ctl.py" --root "$ROOT" --pkg "$PKG" --py "$PY" --members $MEMBERS --worlds ${WORLDS:-6} --workers ${WORKERS:-32} \
  $([ -z "$RESUME" ] && echo --start "$ROOT/ref.pt") > "$ROOT/ctl.log" 2>&1 &
echo "PBT launched: tail -f $ROOT/ctl.log ; ./scripts/pbt_status.sh"
#!/bin/bash
source "$(dirname "$0")/_env.sh"; ROOT="$RUNS/pbt"
for m in "$ROOT"/m*/; do n=$(basename $m); [ -f "$m/log.jsonl" ] || { echo "$n: starting"; continue; }
  $PY - "$m" "$n" <<'PY'
import json, sys
L = [json.loads(l) for l in open(sys.argv[1] + "log.jsonl") if l.strip()]; l = L[-1]; h = json.load(open(sys.argv[1] + "hp.json"))
g = lambda k: l.get(k, float("nan"))
print(f"{sys.argv[2]} it {l['iter']:4d} money {l['money_mean']:.0f} EV {g('explained_variance'):.2f} kl_bc {g('kl_bc'):.4f} clip {g('clipfrac'):.3f} {l['secs']}s/it | hp {h}")
PY
done
echo "--- official-engine exams (fitness = score rate + margin/40k; vs es3_g5 / es1_g9 / v5_market)"; grep -E "^gen" "$ROOT/ctl.log" | tail -${1:-12}
[ -f "$ROOT/best/best.json" ] && $PY -c "import json;b=json.load(open('$ROOT/best/best.json'));print('BEST', b['tag'], round(b['fitness'],3), {o:(v['wdl'],round(v['margin'])) for o,v in b['by_opp'].items()})"
nvidia-smi --query-gpu=index,utilization.gpu,memory.used --format=csv,noheader

exec
/bin/bash -lc "sed -n '1,260p' /workspace/shared/h100_pkg/kaggri_bcppo_v3/scripts/_env.sh; sed -n '1,260p' /workspace/shared/h100_pkg/kaggri_bcppo_v3/README.md; find /tmp/claude-0/-workspace/94c4a2cc-e50b-475a-a250-1ec4ea3e762d/scratchpad/pbttest -maxdepth 3 -type f -printf '%p %s\\n' | sort | tail -100; ps -eo pid,ppid,etimes,cmd | rg 'pbttest|pbt_|ppo.py|compare.py' || true" in /workspace/wt/codex
 succeeded in 0ms:
PKG="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -n "$PY" ]; then :; elif [ -f "$PKG/.python_path" ]; then PY="$(cat "$PKG/.python_path")"; [ -x "$PKG/$PY" ] && PY="$PKG/$PY"; else PY=python3; fi
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4} BC_DATA="$PKG/data/bc_data"
LAB="$PKG/code/lab"; HARNESS="$PKG/code/harness"; RUNS="$PKG/runs"; INIT="${INIT:-$PKG/data/bc_ckpt/bc_v2_final.pt}"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Kaggriculture BC→PPO v3 (4×H100) — T027, Claude + Codex
## Что нового по сравнению с v2.1
- **Исправления по аудиту Codex:** P0 — рынок сэмплируется последовательно с потолком по оставшимся слотам (записанное действие == исполненное,
  log-prob/KL честные); P1 — энтропия только по реально возможным ключам; P2 — ранняя остановка PPO по target-KL (0.015).
- **Скорость:** соперники из лиги считаются только на своих играх (раньше каждый — на всём батче); векторизованный распределитель юнитов.
- **Масштаб:** по умолчанию 2048 игр/GPU, minibatch 65536, 1 эпоха, lr 5e-6, clip .12, λ .99 (память ≈ 25–40 ГБ/GPU вместо 10).
- **Телеметрия:** approx_kl_max, early_stopped, blocked_plant, hire_overflow, выпущенные ордера.
- **Данные:** 13 топ-команд + **es3** (774 партии нашего лучшего агента es3_g5) + **es3dart** (2000 партий es3_g5 с шумом исполнения ε=.05–.3 и
  чистыми метками — лечит провал чистого BC-двойника: без DART он давал 0/96).
- Проверено здесь: greedy e2e numpy↔GPU 0 расхождений; тест потолков рынка; все 4 линии `run_all_v3.sh` отработали (tiny-режим).
## Требования
Как в v2 (+ wheel kaggle-environments лежит в корне: `pip install --no-deps kaggle_environments-1.32.7-py3-none-any.whl`).
RAM: BC на всех данных держит ~15–20 ГБ на процесс.
## Запуск (нужны чекпойнты прошлого прогона v2 на сервере)
```bash
unzip kaggri_bcppo_v3.zip && cd kaggri_bcppo_v3
USE_SYSTEM_PYTHON=1 PYBIN=$(cat ../kaggri_bcppo_v2/.python_path) ./scripts/setup.sh   # или обычный setup.sh
NVIDIA_TF32_OVERRIDE=0 ./scripts/check.sh                                            # 3 проверки
OLD=/путь/к/kaggri_bcppo_v2/runs ./scripts/run_all_v3.sh                             # все 4 GPU в фоне
./scripts/status.sh
```
| GPU | этап 1 | этап 2 |
|---|---|---|
| 0 | BC mix (13 команд + es3 + DART, 10×128) → экзамен | PPO `strong_mix` (стиль es3, KL-пол .01) |
| 1 | — | PPO `v3_cont` от лучшего strong_v3 (it319 или last) |
| 2 | — | PPO `v3_fresh` от bc_v3_all с настройками v3 |
| 3 | BC Horizon-двойник (es3 + DART, 8×128) → экзамен | PPO `double_es3` (KL-пол .05 — держит стиль Horizon) |
Экзамены и автооценка — в официальном движке против es3_g5 (наш лучший), es1_g9, v5, клона yhay и parthenos, 8 миров.
Если OOM — `ENVS=1024 OLD=... ./scripts/run_all_v3.sh`.
## Что прислать
Вывод `./scripts/status.sh` и строки экзаменов/оценок:
```bash
for f in runs/eval/*/arena_*/README.md; do echo "== $(basename $(dirname $(dirname $f)))"; grep -E "^\| " "$f" | grep -E "es3_g5|es1_g9|v5_market|yhay0913|parthenos" | cut -d'|' -f3,4,8; done
```
