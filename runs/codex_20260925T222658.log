def _league_from_args(a, ck, net, bc, dev):
    """Return name -> (net, probability, team_vec). --league-snapshot/--league-double accept CKPT or CKPT:TEAM
    (TEAM = the team the opponent imitates; defaults to the learner's team)."""
    def load(spec):
        path, _, team = spec.partition(":")
        oc = torch.load(path, map_location=dev)
        return _new_net(oc, dev).eval(), _team_vec(oc, team or a.team, dev)
    snapshots = [load(s_) for s_ in a.league_snapshot]
    doubles = [load(s_) for s_ in a.league_double]
    own = _team_vec(ck, a.team, dev)
    if not snapshots and not doubles:
        return {"current": (net, 1.0, own)}
    entries = [("current", net, .30, own)]
    for i, (m, tv) in enumerate(snapshots):
        entries.append((f"snapshot{i}", m, .35 / len(snapshots), tv))
    for i, (m, tv) in enumerate(doubles):
        entries.append((f"double{i}", m, .25 / len(doubles), tv))
    entries.append(("bc_fallback", bc, .10, own))
    total = sum(x[2] for x in entries)
    return {name: (model, weight / total, tv) for name, model, weight, tv in entries}


def _restore_resume(path, net, opt, dev):
    ck = torch.load(path, map_location=dev)
    net.load_state_dict(ck["state"])
    if "optimizer" in ck:
        opt.load_state_dict(ck["optimizer"])
    if "rng_cpu" in ck:
        torch.set_rng_state(ck["rng_cpu"].cpu())
    if dev.startswith("cuda") and "rng_cuda" in ck:
        torch.cuda.set_rng_state_all([x.cpu() for x in ck["rng_cuda"]])
    return int(ck["iter"]) + 1


def _save(path, net, opt, source_ck, teams, iteration):
    payload = {
        "state": net.state_dict(), "gdim": source_ck["gdim"], "teams": teams, "iter": iteration,
        "optimizer": opt.state_dict(), "rng_cpu": torch.get_rng_state(),
        "ch": source_ck.get("ch", 96), "blocks": source_ck.get("blocks", 6),
    }
    if torch.cuda.is_available():
        payload["rng_cuda"] = torch.cuda.get_rng_state_all()
    torch.save(payload, path + ".tmp")
    os.replace(path + ".tmp", path)  # atomic: other runs/PBT read these files while we train


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--init", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--envs", type=int, default=2048)
    ap.add_argument("--iters", type=int, default=50)
    ap.add_argument("--lr", type=float, default=5e-6)
    ap.add_argument("--epochs", type=int, default=1)
    ap.add_argument("--mb", type=int, default=65536)
    ap.add_argument("--gamma", type=float, default=1.0)
    ap.add_argument("--lam", type=float, default=.99)
    ap.add_argument("--clip", type=float, default=.12)
    ap.add_argument("--ent", type=float, default=.001)
    ap.add_argument("--kl", type=float, default=.05); ap.add_argument("--target-kl", type=float, default=.015, help="stop PPO updates when rollout-policy KL exceeds 1.5x this value"); ap.add_argument("--stop-at", type=int, default=0, help="stop after this iteration index (rounds keep one KL horizon = --iters)"); ap.add_argument("--run-iters", type=int, default=0, help="stop after this many iterations from the resume point (PBT rounds)"); ap.add_argument("--kl-floor", type=float, default=0.0, help="minimum KL-to-BC coefficient (style preservation for team doubles)")
    ap.add_argument("--team", default="dsm")
    ap.add_argument("--vf", type=float, default=.5)
    ap.add_argument("--value-warmup", type=int, default=0, help="value-only iterations before policy updates")
    ap.add_argument("--device", default="cuda")
    ap.add_argument("--amp", default="none", choices=["none", "bf16"])
    ap.add_argument("--resume", action="store_true")
    ap.add_argument("--seed", type=int, default=0)
    ap.add_argument("--league-snapshot", action="append", default=[], metavar="CKPT")
    ap.add_argument("--league-double", action="append", default=[], metavar="CKPT")
    a = ap.parse_args()
    os.makedirs(a.out, exist_ok=True)
    if not 0 < a.gamma <= 1 or not 0 <= a.lam <= 1 or a.target_kl < 0:
        ap.error("gamma must be in (0,1], lambda in [0,1], and target-kl non-negative")
    dev = a.device
    torch.manual_seed(a.seed)
    if a.amp == "bf16":
        policy.AMP = torch.bfloat16
    source_ck = torch.load(a.init, map_location=dev)
    net = _new_net(source_ck, dev)
    bc = _new_net(source_ck, dev).eval()
    for parameter in bc.parameters():
        parameter.requires_grad_(False)
    teams = source_ck.get("teams", ["mmpq", "dsm", "mgoose"])
    if a.team not in teams:
        ap.error(f"team {a.team!r} absent from checkpoint teams={teams}")
    team = torch.zeros((1, len(teams)), device=dev)
    team[0, teams.index(a.team)] = 1
    opt = torch.optim.Adam(net.parameters(), lr=a.lr)
    start = 0
    last = f"{a.out}/last.pt"
    if a.resume and os.path.exists(last):
        start = _restore_resume(last, net, opt, dev)
        for group in opt.param_groups:
            group["lr"] = a.lr  # optimizer state keeps the old lr; PBT mutates it between rounds
        print("resumed at iter", start, flush=True)
    league = _league_from_args(a, source_ck, net, bc, dev)
    ve = VecKaggriculture(a.envs, device=dev)
    with open(f"{a.out}/args.json", "w") as fh:
        json.dump({**vars(a), "league_effective": {k: v[1] for k, v in league.items()}}, fh, indent=1)
    log = open(f"{a.out}/log.jsonl", "a")
    end = min(a.iters, a.stop_at) if a.stop_at else a.iters
    if a.run_iters:
        end = min(end, start + a.run_iters)
    for it in range(start, end):
        t0 = time.time()
        net.eval()
        buf, final, action_metric, league_counts = rollout(
            net, ve, a.envs, dev, team, seed_base=1_000_003 * (it + 1) + 7_919 * a.seed,
            league=league,
        )
        roll_seconds = time.time() - t0
        flat = buf.flat()
        reward = buf.data["r"]
        values = buf.data["v"]
        adv, ret = gae(reward, values, a.gamma, a.lam)
        data = {k: flat[k] for k in REC_KEYS + ("logp",)}
        data["adv"] = adv.reshape(-1)
        data["ret"] = ret.reshape(-1)
        data["v"] = values.reshape(-1)
        data["adv"] = (data["adv"] - data["adv"].mean()) / (data["adv"].std() + 1e-8)
        del buf
        samples = data["adv"].numel()
        stats = Counter()
        n_updates = 0
        net.train()
        value_only = it < a.value_warmup
        _set_value_warmup_trainable(net, value_only)
        early_stop = False
        max_approx_kl = 0.0
        for epoch in range(a.epochs):
            permutation = torch.randperm(samples, device=dev)
            for offset in range(0, samples, a.mb):
                idx = permutation[offset:offset + a.mb]
                rec = {k: data[k][idx] for k in REC_KEYS}
                board = rec["board"].float()
                ul, tl, ml, value = net.full(board, rec["G"], rec["uv"], rec["ux"].long(), rec["uy"].long(), rec["umask"])
                logp, raw_entropy = policy.logprob(ul, tl, ml, rec)
                entropy = _entropy_parts(raw_entropy)
                ent_total = _entropy_total(entropy)
                log_ratio = logp - data["logp"][idx]
                ratio = torch.exp(log_ratio)
                approx_kl = _nonnegative_approx_kl(log_ratio)
                max_approx_kl = max(max_approx_kl, float(approx_kl))
                if (not value_only and a.target_kl > 0
                        and approx_kl > 1.5 * a.target_kl):
                    early_stop = True
                    break
                advantage = data["adv"][idx]
                policy_loss = -torch.min(ratio * advantage, ratio.clamp(1 - a.clip, 1 + a.clip) * advantage).mean()
                value_loss = F.smooth_l1_loss(value, data["ret"][idx])
                with torch.no_grad():
                    bul, btl, bml, _ = bc.full(board, rec["G"], rec["uv"], rec["ux"].long(), rec["uy"].long(), rec["umask"])
                unit_mask = rec["umask"].float()
                def kl(p_logits, q_logits, mask=None):
                    lp, lq = F.log_softmax(p_logits, -1), F.log_softmax(q_logits, -1)
                    val = (lp.exp() * (lp - lq)).sum(-1)
                    return (val * mask).sum() / mask.sum().clamp(min=1) if mask is not None else val.mean()
                mm = lambda x: policy.market_mask(x, rec["mcap"].long())
                kl_bc = (kl(btl, tl, unit_mask) +
                         kl(policy._masked(bul, rec["opm"]), policy._masked(ul, rec["opm"]), unit_mask) + kl(mm(bml), mm(ml)))
                kl_coef = max(a.kl_floor, a.kl * max(0.0, 1 - it / max(1, a.iters)))
                loss = a.vf * value_loss if value_only else policy_loss + a.vf * value_loss - a.ent * ent_total.mean() + kl_coef * kl_bc
                opt.zero_grad(set_to_none=True)
                loss.backward()
                torch.nn.utils.clip_grad_norm_(net.parameters(), 1.0)
                opt.step()
                with torch.no_grad():
                    stats["pg"] += float(policy_loss)
                    stats["vloss"] += float(value_loss)
                    stats["kl_bc"] += float(kl_bc)
                    stats["approx_kl"] += float(approx_kl)
                    stats["clipfrac"] += float(((ratio - 1).abs() > a.clip).float().mean())
                    for key, val in entropy.items():
                        stats[f"entropy_{key}"] += float(val.mean())
                n_updates += 1
            if early_stop:
                break
        unit_hist = action_metric["unit_hist"].tolist()
        market_hist = action_metric["market_hist"].tolist()
        active_units = max(1, int(action_metric["active_units"]))
        market_slots = max(1, a.envs * STEPS * O.MAX_ORDERS)
        record = {
            "iter": it,
            "money_mean": final.mean().item(),
            "money_p90": final.flatten().quantile(.9).item(),
            "money_max": final.max().item(),
            "equity_reward_mean": reward.mean().item(),
            "explained_variance": _explained_variance(data["v"], data["ret"]).item(),
            "value_only": value_only,
            "secs_roll": round(roll_seconds),
            "secs": round(time.time() - t0),
            "samples": samples,
            "ppo_updates": n_updates,
            "updates": n_updates,
            "approx_kl_max": max_approx_kl,
            "target_kl": a.target_kl,
            "target_kl_early_stop": early_stop,
            "early_stopped": early_stop,
            "league_envs": league_counts,
            "unit_op_distribution": [x / active_units for x in unit_hist],
            "market_op_distribution": [x / market_slots for x in market_hist],
            "unit_noop_fraction": int(action_metric["unit_noop"]) / active_units,
            "market_noop_fraction": int(action_metric["market_noop"]) / market_slots,
            "unit_requested": int(action_metric["unit_requested"]),
            "plant_requested": int(action_metric["plant_requested"]),
            "plant_rejected_engine": int(action_metric["plant_rejected"]),
            "blocked_plant": int(action_metric["plant_rejected"]),
            "plant_rejected_fraction": int(action_metric["plant_rejected"]) / max(1, int(action_metric["plant_requested"])),
            "market_orders_emitted": int(action_metric["market_orders_emitted"]),
            "hire_overflow_engine": int(action_metric["hire_overflow"]),
            "hire_overflow": int(action_metric["hire_overflow"]),
        }
        record.update({key: value / max(1, n_updates) for key, value in stats.items()})
        print(json.dumps(record), flush=True)
        log.write(json.dumps(record) + "\n")
        log.flush()
        _save(last, net, opt, source_ck, teams, it)
        if it % 5 == 4 or (a.run_iters and it == end - 1):
            _save(f"{a.out}/it{it:03d}.pt", net, opt, source_ck, teams, it)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""PBT controller = evolution over PPO agents.

Every member (runs/pbt/mI, one per GPU) trains PPO in rounds of K iterations (scripts/pbt_member.sh).
This controller, on CPU:
  1. evaluates the newest round checkpoint of every member in the OFFICIAL engine
     (one compare.py call, common worlds for all members) vs es3_g5 / es1_g9 / v5_market;
  2. fitness = mean score rate + mean margin / 40000, smoothed over the member's last 2 evals;
  3. exploit/explore: the worst member copies the best member's evaluated weights and gets
     perturbed hyper-parameters (written as mI/EXPLOIT.json, applied by the member between rounds);
  4. hall of fame: best evaluated checkpoint -> runs/pbt/best/ (+ Kaggle tar for the HUMAN; agents never submit).
"""
import argparse, glob, json, os, random, re, shutil, subprocess, sys, tarfile, time

HP_BOUNDS = {"lr": (1e-6, 4e-5), "ent": (1e-4, 1e-2), "clip": (.06, .25), "kl_floor": (0.0, .05), "target_kl": (.005, .05)}


def perturb(hp, rng):
    hp = dict(hp)
    for k, (lo, hi) in HP_BOUNDS.items():
        if k == "kl_floor":
            v = hp[k] * rng.choice([.5, 1.5]) if hp[k] > 0 else rng.choice([0.0, 0.0, .005])
        else:
            v = hp[k] * rng.choice([.7, .8, 1.25, 1.4])
        hp[k] = float(min(hi, max(lo, v)))
    if rng.random() < .2:
        hp["epochs"] = 3 - hp["epochs"] if hp["epochs"] in (1, 2) else 1
    return hp


def newest_ckpt(mdir):
    cks = sorted(glob.glob(f"{mdir}/it*.pt"), key=lambda p: int(re.search(r"it(\d+)\.pt$", p).group(1)))
    return cks[-1] if cks else None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", required=True)          # runs/pbt
    ap.add_argument("--pkg", required=True)
    ap.add_argument("--py", default=sys.executable)
    ap.add_argument("--members", type=int, default=4)
    ap.add_argument("--team", default="dsm")
    ap.add_argument("--worlds", type=int, default=6)
    ap.add_argument("--workers", type=int, default=32)
    ap.add_argument("--timeout", type=int, default=900)
    ap.add_argument("--margin-delta", type=float, default=.03, help="exploit only if best-worst fitness gap exceeds this")
    ap.add_argument("--start", default="", help="also evaluate this checkpoint once as the reference")
    ap.add_argument("--poll", type=int, default=60)
    a = ap.parse_args()
    rng = random.Random(12345)
    lab, harness = f"{a.pkg}/code/lab", f"{a.pkg}/code/harness"
    fit_path = f"{a.root}/fitness.jsonl"
    done = set()
    hist = {}  # member -> list of fitness
    if os.path.exists(fit_path):
        for line in open(fit_path):
            r = json.loads(line)
            done.add(r["ckpt"])
            if r["member"].startswith("m"):
                hist.setdefault(r["member"], []).append(r["fitness"])
    seeds = json.load(open(f"{harness}/seeds/v5_development.json"))["seeds"][:a.worlds]
    gen = len(glob.glob(f"{a.root}/eval/gen_*"))
    while True:
        todo = {}
        for i in range(a.members):
            ck = newest_ckpt(f"{a.root}/m{i}")
            if ck and ck not in done and not os.path.exists(f"{a.root}/m{i}/EXPLOIT.json"):
                todo[f"m{i}"] = ck
        if a.start and a.start not in done:
            todo["start"] = a.start
        fresh = [m for m in todo if m != "start"]
        oldest = min((os.path.getmtime(todo[m]) for m in fresh), default=time.time())
        if not fresh or (len(fresh) < min(2, a.members) and time.time() - oldest < 900):
            time.sleep(a.poll); continue  # prefer evaluating >=2 members on the same worlds
        gdir = f"{a.root}/eval/gen_{gen:03d}"; os.makedirs(gdir, exist_ok=True)
        # snapshot the evaluated weights (members keep training and may overwrite their files)
        agents, pool = [], {}
        for m, ck in todo.items():
            it = re.search(r"it(\d+)\.pt$", ck); tag = f"{m}_it{it.group(1)}" if it else m
            snap = f"{a.root}/pool/{tag}.pt"; os.makedirs(os.path.dirname(snap), exist_ok=True); shutil.copy(ck, snap)
            os.makedirs(f"{gdir}/{tag}", exist_ok=True)
            subprocess.run([a.py, f"{lab}/bc/export.py", "--ckpt", snap, "--team", a.team, "--out", f"{gdir}/{tag}/main.py", "--sample"], check=True)
            agents += ["--agent", f"{tag}={gdir}/{tag}/main.py"]; pool[m] = (tag, snap, ck)
        cmd = [a.py, "compare.py", *agents, "--baselines", "v5_market",
               "--opponent", "es3_g5=candidates/es3_g5/main.py", "--opponent", "es1_g9=candidates/es1_g9/main.py",
               "--seeds", *map(str, seeds), "--workers", str(a.workers), "--game-timeout", str(a.timeout), "--out", f"{gdir}/arena"]
        t0 = time.time()
        subprocess.run(cmd, cwd=harness, check=False, stdout=open(f"{gdir}/compare.log", "w"), stderr=subprocess.STDOUT)
        try:
            summ = json.load(open(f"{gdir}/arena/summary.json"))
        except Exception as exc:
            print(f"gen {gen}: compare failed ({exc}), see {gdir}/compare.log", flush=True); gen += 1; time.sleep(a.poll); continue
        results = {}
        for m, (tag, snap, ck) in pool.items():
            byo = summ["candidates"].get(tag, {}).get("by_opponent", {})
            rates = [v["score_rate"] for v in byo.values() if "score_rate" in v]
            margins = [v["mean_margin"] for v in byo.values() if "mean_margin" in v]
            if not rates:
                continue
            fit = sum(rates) / len(rates) + sum(margins) / len(margins) / 40000
            row = {"gen": gen, "member": m, "tag": tag, "ckpt": ck, "snap": snap, "fitness": fit, "secs": round(time.time() - t0),
                   "by_opp": {o: {"wdl": [v.get("wins"), v.get("draws"), v.get("losses")], "rate": v.get("score_rate"),
                                  "margin": v.get("mean_margin"), "errors": v.get("errors")} for o, v in byo.items()}}
            results[m] = row; done.add(ck)
            with open(fit_path, "a") as fh: fh.write(json.dumps(row) + "\n")
            if m.startswith("m"):
                hist.setdefault(m, []).append(fit)
            best_path = f"{a.root}/best/best.json"
            best = json.load(open(best_path)) if os.path.exists(best_path) else {"fitness": -1e9}
            if fit > best["fitness"]:
                os.makedirs(f"{a.root}/best", exist_ok=True)
                shutil.copy(snap, f"{a.root}/best/best.pt"); shutil.copy(f"{gdir}/{tag}/main.py", f"{a.root}/best/main.py")
                with tarfile.open(f"{a.root}/best/submission_pbt_best.tar.gz", "w:gz") as t: t.add(f"{gdir}/{tag}/main.py", arcname="main.py")
                json.dump(row, open(best_path, "w"), indent=1)
            print(f"gen {gen} {tag}: fitness {fit:.3f} " + " ".join(
                f"{o}:{r['wdl'][0]}/{r['wdl'][1]}/{r['wdl'][2]} {r['margin']:+.0f}" for o, r in row["by_opp"].items()), flush=True)
        # exploit / explore among members with at least one eval
        smooth = {m: sum(h[-2:]) / len(h[-2:]) for m, h in hist.items() if h}
        if len(smooth) >= 2:
            order = sorted(smooth, key=smooth.get)
            worst, best_m = order[0], order[-1]
            donor = results.get(best_m) or next((json.loads(l) for l in reversed(open(fit_path).readlines())
                                                 if json.loads(l)["member"] == best_m), None)
            if donor and smooth[best_m] - smooth[worst] > a.margin_delta:
                hp = json.load(open(f"{a.root}/{best_m}/hp.json"))
                new = perturb(hp, rng)
                json.dump({"donor": best_m, "ckpt": donor["snap"], "hp": new, "gen": gen},
                          open(f"{a.root}/{worst}/EXPLOIT.json", "w"), indent=1)
                hist[worst] = []  # fresh start for the replaced member
                print(f"gen {gen}: EXPLOIT {worst} ({smooth[worst]:.3f}) <- {best_m} ({smooth[best_m]:.3f}) {donor['tag']}; new hp {new}", flush=True)
        gen += 1


if __name__ == "__main__":
    main()

