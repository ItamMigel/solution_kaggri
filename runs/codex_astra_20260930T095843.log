+"""Behavioral differential tests for money-moving wrappers; no model tuning."""
+import os
+for key in ('OPENBLAS_NUM_THREADS','OMP_NUM_THREADS','MKL_NUM_THREADS'):
+    os.environ[key]='1'
+import contextlib
+import copy
+import io
+import json
+import random
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+HERE=Path(__file__).resolve().parent
+sys.path.insert(0,str(HERE))
+import build
+from postprocess import Postprocessor, SALE_PRODUCTS
+
+def run():
+    log=io.StringIO()
+    with contextlib.redirect_stdout(log),contextlib.redirect_stderr(log):
+        from kaggle_environments import make
+        env=make('kaggriculture',configuration={'seed':93048299},debug=False)
+        env.reset(2)
+    engine=env.interpreter.__globals__
+    extracted={};exec((HERE/'market_engine.py').read_text(),extracted)
+    term={};exec((HERE.parent/'t045/execution/terminal.py').read_text(),term)
+    units={};exec(build.source_closure(build.ENGINE.read_text(),['_apply_unit_action']),units)
+    rng=random.Random(4801);checks=[]
+    template=copy.deepcopy(env.state)
+    for k in range(120):
+        s=copy.deepcopy(template);o=s[0].observation
+        for item in engine['PRODUCTS']:
+            o.market['inventory'][item]=10000+rng.randint(-800,800)
+        for i in (0,1):
+            s[i].observation.market=o.market;s[i].observation.farms=o.farms
+            o.farms[i]['money']=rng.choice([0,25,100,10000])
+            sd=s[i].observation.private['shed']
+            sd.update({it:0 for it in sd})
+            for _ in range(rng.randint(0,100)):
+                sd[rng.choice(engine['PRODUCTS'])]+=1
+            s[i].action={'market':[]}
+            for _ in range(rng.randint(0,10)):
+                op=rng.choice(['SELL','SELL','BUY_PRODUCT','BUY_SEED','HIRE','NOOP','BUY_LAND'])
+                it=rng.choice(('WHEAT','FERTILIZER')) if op=='BUY_PRODUCT' else rng.choice(engine['PRODUCTS'])
+                s[i].action['market'].append([op,it,rng.randint(0,120)] if op not in ('HIRE','NOOP','BUY_LAND') else [op])
+        a,b=copy.deepcopy(s),copy.deepcopy(s)
+        engine['_process_market'](a,env);extracted['_process_market'](b,env)
+        assert a==b,(k,'official/extracted market mismatch')
+    checks.append('120 randomized official/extracted complete market transitions exact')
+    obs=copy.deepcopy(template[0].observation);obs['player']=0;obs['step']=672
+    action={'farmer':['PASS'],'hands':[],'market':[['SELL','MILK',5],['HIRE'],['SELL','WOOL',4],['SELL','WHEAT',8]]}
+    off=Postprocessor(extracted,units,term)
+    before=copy.deepcopy((obs,action));assert off.apply(obs,action,env.configuration) is action
+    assert before==(obs,action)
+    checks.append('default-off returns identical object without mutation')
+    obs.private.shed.update(MILK=5,WOOL=4,WHEAT=8)
+    beam=Postprocessor(extracted,units,term,'sale_beam')
+    before=copy.deepcopy((obs,action));new=beam.apply(obs,action,env.configuration)
+    assert before==(obs,action)
+    assert new['market'][:2]==action['market'][:2]
+    assert sorted(new['market'][2:])==sorted(action['market'][2:])
+    assert new['farmer']==action['farmer'] and new['hands']==action['hands']
+    checks.append('beam preserves units, funding prefix, suffix multiset; inputs immutable')
+    # Floor sales stop supply; product buy is quoted at post-buy inventory.
+    obs.market.inventory['WOOL']=11000
+    late=Postprocessor(extracted,units,term,'late_ev')
+    assert late.batch_value(obs,'WOOL',11000,80)==80
+    obs.town.unlocked_shops=['YARN_STORE','YARN_STORE','SMOOTHIE_SHOP']
+    assert late.demand(obs,env.configuration,672,673,'WOOL')==5
+    assert late.demand(obs,env.configuration,672,673,'MILK')==2
+    assert late.demand(obs,env.configuration,673,676,'WOOL')==0
+    checks.append('price floor and duplicate-town/boundary consumption exact')
+    # Empty rival flow + a milk demand tick: postpone exactly eight units,
+    # preserve NOOP index and explicitly release next turn even with empty BC queue.
+    obs.market.inventory['MILK']=10010;engine['_refresh_prices'](obs.market)
+    obs.private.shed.update({it:0 for it in obs.private.shed});obs.private.shed['MILK']=8
+    obs.farms[0]['money']=10000
+    late.flow={it:[0]*24 for it in SALE_PRODUCTS}
+    native={'farmer':['PASS'],'hands':[],'market':[['SELL','MILK',8]]}
+    new=late.schedule(obs,native,env.configuration,dict(obs.private.shed))
+    assert new['market']==[['NOOP']],new
+    assert late.pending=={'MILK':(673,8)}
+    obs['step']=673
+    release=late.schedule(obs,{'farmer':['PASS'],'hands':[],'market':[]},env.configuration,dict(obs.private.shed))
+    assert release['market']==[['SELL','MILK',8]] and not late.pending,release
+    checks.append('one-turn hold preserves slot, next-turn release explicitly executes')
+    # Full shed or cash requirement forbids suppressing financing sales.
+    for cash,stock in ((0,8),(10000,80)):
+        late.pending={};obs['step']=672;obs.farms[0]['money']=cash;obs.private.shed['MILK']=stock
+        new=late.schedule(obs,native,env.configuration,dict(obs.private.shed))
+        assert new['market'][0]==native['market'][0]
+    checks.append('holds fail open under cash/space pressure')
+    # Known negative drift allows a bounded append, with existing orders intact.
+    obs['step']=673;obs.farms[0]['money']=10000;obs.private.shed['MILK']=20
+    late.flow['MILK']=[4]*24;late.pending={}
+    native={'farmer':['PASS'],'hands':[],'market':[['HIRE'],['SELL','MILK',2]]}
+    new=late.schedule(obs,native,env.configuration,dict(obs.private.shed))
+    assert new['market'][:2]==native['market'] and new['market'][2]==['SELL','MILK',8],new
+    checks.append('negative-flow EV appends at most8 after protected prefix')
+    result={'passed':True,'checks':checks}
+    (HERE/'fixtures.json').write_text(json.dumps(result,indent=2));print(json.dumps(result,indent=2))
+
+if __name__=='__main__':run()
diff --git a/lab/t048/gate.py b/lab/t048/gate.py
new file mode 100644
index 0000000000000000000000000000000000000000..1e894cf9d5f51b0af95a0b776b89636208d094c4
--- /dev/null
+++ b/lab/t048/gate.py
@@ -0,0 +1,130 @@
+"""Fresh paired official full games; no replay/identity shortcuts."""
+import os
+for key in ('OPENBLAS_NUM_THREADS','OMP_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS'):
+    os.environ[key] = '1'
+os.environ['BC3_STATS']='1'
+import argparse
+import contextlib
+import gc
+import hashlib
+import importlib.util
+import io
+import json
+import random
+import signal
+import time
+import traceback
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from pathlib import Path
+import numpy as np
+
+HERE = Path(__file__).resolve().parent
+BASE = Path('/workspace/shared/candidates/t047_m26_terminal/pkg/main.py')
+OPPS = {'base': BASE, **{n: HERE.parent/'t045/execution/frozen'/f'{n}.py' for n in ('tetsu','ozer44')}}
+
+def load(path, name):
+    spec=importlib.util.spec_from_file_location(name,path)
+    mod=importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
+    return mod
+
+def game(job):
+    variant,opp,seed,seat=job
+    r=dict(variant=variant,opp=opp,seed=seed,seat=seat)
+    log=io.StringIO(); latencies=[[],[]]; errors=[0,0]; start=time.monotonic()
+    def alarm(*args):
+        raise TimeoutError('host guard 1200s')
+    signal.signal(signal.SIGALRM,alarm); signal.alarm(1200)
+    try:
+        with contextlib.redirect_stdout(log),contextlib.redirect_stderr(log):
+            from kaggle_environments import make
+            random.seed(seed); np.random.seed(seed)
+            mods=[None,None]
+            mods[1-seat]=load(OPPS[opp],'t048_opponent')
+            path=BASE if variant=='base' else HERE/'exports'/variant/'main.py'
+            mods[seat]=load(path,'t048_candidate')
+            agents=[]
+            for i,mod in enumerate(mods):
+                if hasattr(mod,'_AG'):
+                    core_stats=getattr(mod._AG,'stats',{})
+                    def core(*args,_core=mod._AG,_i=i,**kwargs):
+                        try:
+                            return _core(*args,**kwargs)
+                        except Exception:
+                            errors[_i]+=1
+                            raise
+                    core.stats=core_stats
+                    mod._AG=core
+                def measured(obs,config=None,_mod=mod,_i=i):
+                    t=time.perf_counter()
+                    try:
+                        return _mod.agent(obs,config)
+                    finally:
+                        latencies[_i].append(time.perf_counter()-t)
+                agents.append(measured)
+            env=make('kaggriculture',configuration={'seed':seed},debug=False)
+            env.run(agents)
+            r.update(status=[s.status for s in env.state],rewards=[s.reward for s in env.state],
+                     calls=list(map(len,latencies)),remaining_overage=[s.observation.remainingOverageTime for s in env.state],
+                     errors=[{'bc':errors[i],'hg':getattr(m,'_HG_STATS',{}).get('errors',0),
+                              **getattr(m,'_T047_ERRORS',{}),'t048':getattr(getattr(m,'_T048',None),'stats',{}).get('errors',0)}
+                             for i,m in enumerate(mods)],
+                     telemetry=[{'hg':getattr(m,'_HG_STATS',{}),'bc':getattr(getattr(m,'_AG',None),'stats',{}),
+                                 't048':getattr(getattr(m,'_T048',None),'stats',{})} for m in mods],
+                     latency=[{'max':max(x,default=0),'p50':float(np.quantile(x,.5)) if x else 0,
+                               'p99':float(np.quantile(x,.99)) if x else 0,'overage':sum(max(0,t-1) for t in x)} for x in latencies])
+            assert r['status']==['DONE','DONE'],r['status']
+            assert r['calls']==[719,719],r['calls']
+            assert not any(v for e in r['errors'] for v in e.values()),r['errors']
+            assert all(x['overage']<55 for x in r['latency']),r['latency']
+            r['margin']=r['rewards'][seat]-r['rewards'][1-seat]
+            r['points']=float(r['margin']>0)+.5*float(r['margin']==0)
+            r['valid']=True
+    except BaseException:
+        r.update(valid=False,exception=traceback.format_exc())
+    finally:
+        signal.alarm(0)
+    r.update(seconds=time.monotonic()-start,log_tail=log.getvalue()[-1400:])
+    gc.collect()
+    return r
+
+def main():
+    ap=argparse.ArgumentParser(); ap.add_argument('--out',type=Path,required=True)
+    ap.add_argument('--stage',choices=['screen','gate'],default='gate')
+    ap.add_argument('--workers',type=int,default=6)
+    a=ap.parse_args(); assert 1<=a.workers<=6
+    variants=('sale_beam','late_ev')
+    if a.stage=='screen':
+        jobs=[(v,o,s,p) for s in (93048203,93048204) for o in OPPS for v in variants for p in (0,1)]
+    else:
+        jobs=[(v,'base',s,p) for s in range(93048501,93048517) for v in variants for p in (0,1)]
+        jobs += [(v,o,s,p) for s in range(93048601,93048609) for o in ('tetsu','ozer44')
+                 for v in (*variants,'base') for p in (0,1)]
+    build=json.loads((HERE/'manifest.json').read_text())
+    for rec in [build['base'],*build['exports'].values()]:
+        assert hashlib.sha256(Path(rec['path']).read_bytes()).hexdigest()==rec['sha256']
+    manifest=dict(build=build,jobs=jobs,stage=a.stage,workers=a.workers,
+                  opponents={k:{'path':str(p),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for k,p in OPPS.items()},
+                  rule='Each: 16 NEW worlds both seats h2h points>=.65 AND two-sided95 whole-world-bootstrap margin lower>0; '
+                       '8 different worlds both seats each tetsu/ozer44 with paired unchanged-base control, no points regression '
+                       'and mean margin no worse on either sanity opponent; all errors/timeouts0. '
+                       'No variant tuning after gate starts. Bootstrap100000,RNG48020260930. '
+                       'The sanity rule is a finite-panel screen, not a proof of non-inferiority.')
+    a.out.mkdir(parents=True,exist_ok=True); mf=a.out/'manifest.json'
+    if mf.exists():
+        assert json.loads(mf.read_text())==json.loads(json.dumps(manifest))
+    else:
+        mf.write_text(json.dumps(manifest,indent=2))
+    results=a.out/'games.jsonl'; done=set()
+    if results.exists():
+        for line in results.read_text().splitlines():
+            r=json.loads(line); assert r['valid'],'Investigate invalid record before resuming'
+            done.add((r['variant'],r['opp'],r['seed'],r['seat']))
+    todo=[j for j in jobs if j not in done]
+    with results.open('a') as f, ProcessPoolExecutor(max_workers=a.workers) as pool:
+        fs=[pool.submit(game,j) for j in todo]
+        for i,fut in enumerate(as_completed(fs),1):
+            r=fut.result();f.write(json.dumps(r)+'\n');f.flush()
+            print(i+len(done),'/',len(jobs),r['variant'],r['opp'],r['seed'],r['seat'],r.get('margin'),r['valid'],round(r['seconds'],1),flush=True)
+
+if __name__=='__main__':
+    main()
diff --git a/lab/t048/loader_smoke.py b/lab/t048/loader_smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..c21674a87aed1dc695d8b5d02ecd2b50e67144bc
--- /dev/null
+++ b/lab/t048/loader_smoke.py
@@ -0,0 +1,62 @@
+"""Official file-loader parity and full-episode off identity. <=6 workers."""
+import os
+for k in ('OPENBLAS_NUM_THREADS','OMP_NUM_THREADS','MKL_NUM_THREADS'):
+    os.environ[k]='1'
+import contextlib
+import copy
+import hashlib
+import io
+import json
+import random
+import signal
+import time
+from pathlib import Path
+from concurrent.futures import ProcessPoolExecutor
+import numpy as np
+from gate import load, HERE, BASE
+OUT=Path('/workspace/shared/runs/t048_ev_gate')
+
+def game(job):
+    variant,seat=job;seed=93048501;log=io.StringIO();t0=time.monotonic()
+    with contextlib.redirect_stdout(log),contextlib.redirect_stderr(log):
+        from kaggle_environments import make
+        random.seed(seed);np.random.seed(seed)
+        path=HERE/'exports'/variant/'main.py'
+        pair=[str(BASE),str(BASE)];pair[seat]=str(path)
+        env=make('kaggriculture',configuration={'seed':seed},debug=False);env.run(pair)
+        r=dict(variant=variant,seat=seat,seed=seed,status=[s.status for s in env.state],
+               rewards=[s.reward for s in env.state],remaining_overage=[s.observation.remainingOverageTime for s in env.state])
+        if variant=='off':
+            random.seed(seed);np.random.seed(seed)
+            wrapper=load(path,'off_shadow');base=load(BASE,'off_parent');opp=load(BASE,'off_opp')
+            diffs=[];calls=0
+            def measured(obs,config=None):
+                nonlocal calls
+                before=copy.deepcopy(obs)
+                a=base.agent(obs,config);b=wrapper.agent(obs,config)
+                assert obs==before,'Observation mutated'
+                if a!=b:diffs.append(int(obs['step']))
+                calls+=1
+                return b
+            agents=[opp.agent,opp.agent];agents[seat]=measured
+            ref=make('kaggriculture',configuration={'seed':seed},debug=False);ref.run(agents)
+            expected=[s.reward for s in ref.state]
+            r.update(identity_calls=calls,identity_diffs=diffs,reference_status=[s.status for s in ref.state])
+            assert calls==719 and not diffs and r['reference_status']==['DONE','DONE']
+        else:
+            rows=[json.loads(x) for x in (OUT/'games.jsonl').read_text().splitlines()]
+            match=[x for x in rows if (x['variant'],x['opp'],x['seed'],x['seat'])==(variant,'base',seed,seat)]
+            assert len(match)==1 and match[0]['valid']
+            expected=match[0]['rewards']
+        r.update(parity=r['status']==['DONE','DONE'] and r['rewards']==expected,
+                 seconds=time.monotonic()-t0,log_tail=log.getvalue()[-1200:])
+    return r
+
+if __name__=='__main__':
+    manifest=json.loads((OUT/'manifest.json').read_text())['build']
+    for rec in [manifest['base'],*manifest['exports'].values()]:
+        assert hashlib.sha256(Path(rec['path']).read_bytes()).hexdigest()==rec['sha256']
+    with ProcessPoolExecutor(max_workers=6) as pool:
+        rows=list(pool.map(game,[(v,p) for v in ('off','sale_beam','late_ev') for p in (0,1)]))
+    (OUT/'loader_smoke.json').write_text(json.dumps(rows,indent=2));print(json.dumps(rows,indent=2))
+    assert all(r['parity'] for r in rows)
diff --git a/lab/t048/postprocess.py b/lab/t048/postprocess.py
new file mode 100644
index 0000000000000000000000000000000000000000..00ea1f4eef14c0a9505a731219e4ab9410b7fa53
--- /dev/null
+++ b/lab/t048/postprocess.py
@@ -0,0 +1,250 @@
+"""Default-off EV overlays. Only live own-private / public state is consumed.
+
+sale_beam searches permutations of existing suffix SELL slots using exact
+official market execution against explicit, uncalibrated opponent scenarios.
+late_ev trades at most eight units per item around the next known town tick.
+"""
+import copy
+import itertools
+from types import SimpleNamespace
+
+SALE_PRODUCTS = ('CARROT', 'TOMATO', 'STRAWBERRY', 'MELON', 'EGG', 'MILK', 'WOOL')
+
+
+class Postprocessor:
+    def __init__(self, engine, unit_engine, terminal, mode='off'):
+        assert mode in ('off', 'sale_beam', 'late_ev')
+        self.engine, self.unit_engine, self.terminal = engine, unit_engine, terminal
+        self.mode = mode
+        self.stats = dict(errors=0, changed=0, searched=0, scored=0, added=0,
+                          held=0, released=0, expected_gain=0.0)
+        self.last_step = None
+        self.previous = None
+        self.flow = {it: [] for it in SALE_PRODUCTS}
+        self.pending = {}
+
+    def post_units(self, obs, action, config):
+        # Official unit rules, including the atomic PLANT guard.
+        return self.terminal['post_unit_shed'](obs, action, config, self.unit_engine)
+
+    @staticmethod
+    def boundary(orders):
+        return max((i for i, o in enumerate(orders)
+                    if not (isinstance(o, list) and o and o[0] in ('SELL', 'NOOP'))), default=-1)
+
+    def sale_beam(self, obs, action, config):
+        if int(obs['step']) < 336:
+            return action
+        orders = action.get('market', [])
+        if not isinstance(orders, list) or len(orders) > int(config.get('maxMarketOrdersPerTurn', 10)):
+            return action
+        bound = self.boundary(orders)
+        slots = [i for i, o in enumerate(orders) if i > bound and isinstance(o, list)
+                 and len(o) >= 3 and o[0] == 'SELL' and int(o[2]) > 0]
+        if len(slots) < 2:
+            return action
+        # Duplicate-item rows have deliberate interleaving semantics; retain them.
+        items = [orders[i][1] for i in slots]
+        if len(set(items)) != len(items):
+            return action
+        shed = self.post_units(obs, action, config)
+        base_farm = copy.deepcopy(obs['farms'][obs['player']])
+        own_private = copy.deepcopy(obs['private'])
+        own_private['shed'] = shed
+        # Scenario assumptions are explicit: a mirror-like sale queue, quantities
+        # at 0.5 / 1 / 1.5 times ours. No rival private state or second NN forward.
+        # Purchases in the rival prefix remain fixed; its money starts at public cash.
+        scenarios = []
+        for scale, weight in ((0.5, .25), (1.0, .5), (1.5, .25)):
+            rival = copy.deepcopy(orders)
+            stocked = {it: max(0, int(round(n*scale))) for it,n in shed.items()}
+            for o in rival:
+                if len(o) >= 3 and o[0] == 'SELL':
+                    o[2] = max(1, int(round(int(o[2]) * scale)))
+            # Match capacity: proportional synthetic stock would otherwise invent
+            # an impossible shed. All quantities still clip in the exact scorer.
+            cap = int(config.get('shedCapacity', 100))
+            excess = max(0, sum(stocked.values())-cap)
+            for it in sorted(stocked, key=lambda x: (-stocked[x], x)):
+                take = min(excess, stocked[it]); stocked[it] -= take; excess -= take
+            rf = copy.deepcopy(obs['farms'][1-int(obs['player'])])
+            rp = {'shed': stocked, 'seeds': {}, 'inventories': [{}] * (1+len(rf.get('hands', [])))}
+            scenarios.append((rival, rf, rp, weight))
+
+        def score(candidate):
+            value = 0.0
+            for rival, rf, rp, weight in scenarios:
+                # Canonical player order is retained for exact atomic/capacity rules.
+                seat = int(obs['player'])
+                farms = [None, None]; privates = [None, None]; queues = [None, None]
+                farms[seat] = copy.deepcopy(base_farm); farms[1-seat] = copy.deepcopy(rf)
+                privates[seat] = copy.deepcopy(own_private); privates[1-seat] = copy.deepcopy(rp)
+                queues[seat] = candidate; queues[1-seat] = rival
+                market = copy.deepcopy(obs['market'])
+                state = [SimpleNamespace(observation=SimpleNamespace(market=market, farms=farms, private=privates[i]),
+                                         action={'market': queues[i]}) for i in (0,1)]
+                self.engine['_process_market'](state, SimpleNamespace(configuration=config))
+                value += weight * (farms[seat]['money'] - farms[1-seat]['money'])
+            self.stats['scored'] += 1
+            return value
+
+        native = tuple(slots)
+        # A bounded permutation beam: all permutations for <=3 sells; otherwise
+        # base plus single swaps, capped deterministically at 16 candidates.
+        if len(slots) <= 3:
+            perms = list(itertools.permutations(slots))
+        else:
+            perms = [native]
+            for i in range(len(slots)):
+                for j in range(i+1, len(slots)):
+                    p = list(slots); p[i], p[j] = p[j], p[i]; perms.append(tuple(p))
+            perms = perms[:16]
+        baseline = score(orders)
+        best, best_value = orders, baseline
+        self.stats['searched'] += 1
+        for perm in perms:
+            if perm == native:
+                continue
+            candidate = list(orders)
+            for i, j in zip(slots, perm):
+                candidate[i] = orders[j]
+            value = score(candidate) - .25 * sum(i != j for i, j in zip(slots, perm))
+            if value > best_value + 2.0:
+                best, best_value = candidate, value
+        if best is orders:
+            return action
+        self.stats['expected_gain'] += best_value-baseline
+        return {**action, 'market': best}
+
+    def demand(self, obs, config, start, stop, item):
+        shop_int = max(1, int(config.get('townShopSellInterval', 4)))
+        center_int = max(1, int(config.get('townCenterSellInterval', 24)))
+        shops = obs.get('town', {}).get('unlocked_shops', [])
+        per_tick = sum((2 if len(self.engine['SHOPS'][s]) == 1 else 1)
+                       for s in shops if item in self.engine['SHOPS'][s])
+        return sum(per_tick*(t % shop_int == 0) + (t % center_int == 0)
+                   for t in range(start, stop))
+
+    def batch_value(self, obs, item, inv, quantity):
+        value = 0.0
+        for _ in range(quantity):
+            p = self.engine['market_price'](item, inv, obs['market'].get('params'))
+            value += p
+            if p > 1:
+                inv += 1
+        return value
+
+    def late_ev(self, obs, action, config):
+        step = int(obs['step'])
+        if step < 624 or step > 717:
+            return action
+        orders = action.get('market', [])
+        if not isinstance(orders, list) or len(orders) > int(config.get('maxMarketOrdersPerTurn',10)):
+            return action
+        inv = obs['market']['inventory']
+        prices = obs['market']['prices']
+        if self.previous is not None and self.previous['step'] == step-1:
+            prev = self.previous
+            for it in SALE_PRODUCTS:
+                # Away from the floor, own sales have an exact public footprint.
+                # At $1 sales stop adding inventory; do not infer gross volume there.
+                consumed = self.demand(prev['obs'], config, step-1, step, it)
+                post_market_price = self.engine['market_price'](it,inv[it]+consumed,obs['market'].get('params'))
+                if prices[it] > 10 and prev['prices'][it] > 10 and post_market_price > 1:
+                    q = inv[it] - prev['inv'][it] + consumed - prev['own'][it]
+                    self.flow[it].append(max(0, int(q)))
+                else:
+                    self.flow[it].append(None)
+                self.flow[it] = self.flow[it][-48:]
+        shed = self.post_units(obs, action, config)
+        result = action
+        if step >= 672:
+            result = self.schedule(obs, action, config, shed)
+        own = {it: 0 for it in SALE_PRODUCTS}
+        for o in result.get('market', []):
+            if isinstance(o, list) and len(o) >= 3 and o[0] == 'SELL' and o[1] in own:
+                own[o[1]] = min(int(shed.get(o[1], 0)), own[o[1]]+max(0,int(o[2])))
+        self.previous = dict(step=step, inv=dict(inv), prices=dict(prices), own=own,
+                             obs={'town': copy.deepcopy(obs.get('town', {}))})
+        return result
+
+    def schedule(self, obs, action, config, shed):
+        step = int(obs['step']); orders = copy.deepcopy(action.get('market', []))
+        limit = int(config.get('maxMarketOrdersPerTurn', 10))
+        boundary = self.boundary(orders)
+        left = {it: int(shed.get(it, 0)) for it in SALE_PRODUCTS}
+        sold = {it: 0 for it in SALE_PRODUCTS}
+        for o in orders:
+            if len(o) >= 3 and o[0] == 'SELL' and o[1] in left:
+                q = min(left[o[1]], max(0,int(o[2]))); left[o[1]] -= q; sold[o[1]] += q
+        # A postponed sale is explicitly released next turn, even if BC omits it.
+        released = set()
+        for it, (due, q) in list(self.pending.items()):
+            if step < due:
+                continue
+            q = min(max(0, q-sold[it]), left[it])
+            if q and len(orders) < limit:
+                orders.append(['SELL', it, q]); left[it] -= q
+                self.stats['released'] += q
+                q = 0
+            if not q:
+                del self.pending[it]
+            else:
+                self.pending[it] = (due,q)
+            released.add(it)
+        if step >= 717:
+            return {**action, 'market': orders} if orders != action.get('market', []) else action
+        capacity = int(config.get('shedCapacity', 100))
+        safe_hold = sum(shed.values()) <= capacity-24 and float(obs['farms'][obs['player']]['money']) >= 2000
+        for it in SALE_PRODUCTS:
+            if it in released or it in self.pending or obs['market']['prices'][it] <= 10:
+                continue
+            history = self.flow[it][-24:]
+            if len(history) < 16 or any(x is None for x in history):
+                continue
+            shop_int = max(1,int(config.get('townShopSellInterval',4)))
+            horizon = min(718-step, 1+(-step) % shop_int)
+            demand = self.demand(obs, config, step, step+horizon, it)
+            # Empirical contiguous flow blocks preserve bursts; future town demand
+            # is known exactly. This is a local scenario estimate, not calibrated V.
+            flows = [sum(history[i:i+horizon]) for i in range(len(history)-horizon+1)]
+            inv = obs['market']['inventory'][it]
+            slots = [i for i,o in enumerate(orders) if i>boundary and len(o)>=3 and o[:2]==['SELL',it] and int(o[2])>0]
+            # Holding is only one turn immediately before deterministic town demand.
+            if safe_hold and horizon == 1 and demand > 0 and slots:
+                i = slots[-1]; q = min(8, int(orders[i][2]), sold[it])
+                now = self.batch_value(obs,it,inv,q)
+                deltas = [self.batch_value(obs,it,inv+flow-demand,q)-now for flow in flows]
+                mean = sum(deltas)/len(deltas)
+                if q and mean > max(8., .02*now) and min(deltas) >= 0:
+                    orders[i][2] -= q
+                    if orders[i][2] == 0:
+                        orders[i] = ['NOOP']
+                    self.pending[it] = (step+1,q)
+                    self.stats['held'] += q; self.stats['expected_gain'] += mean
+                    continue
+            # Additional sales occur after every original order, preserving funding.
+            q = min(8, left[it])
+            if q <= 0 or len(orders) >= limit:
+                continue
+            # Native own sales happen first and depress the extra units' quote.
+            inv += sold[it]
+            now = self.batch_value(obs,it,inv,q)
+            deltas = [now-self.batch_value(obs,it,inv+flow-demand,q) for flow in flows]
+            mean = sum(deltas)/len(deltas)
+            if mean > max(8., .02*now):
+                orders.append(['SELL',it,q]); left[it] -= q
+                self.stats['added'] += q; self.stats['expected_gain'] += mean
+        return {**action, 'market': orders} if orders != action.get('market', []) else action
+
+    def apply(self, obs, action, config=None):
+        if self.mode == 'off':
+            return action
+        step = int(obs['step'])
+        if self.last_step is None or step <= self.last_step:
+            self.previous = None; self.pending = {}; self.flow = {it: [] for it in SALE_PRODUCTS}
+        self.last_step = step
+        result = getattr(self, self.mode)(obs, action, config or {})
+        if result != action:
+            self.stats['changed'] += 1
+        return result
