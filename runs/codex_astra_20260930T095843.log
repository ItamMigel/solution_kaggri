+"""Summarize development trajectories; forecast inputs remain public-only."""
+import collections
+import gzip
+import json
+from pathlib import Path
+import numpy as np
+HERE=Path(__file__).resolve().parent
+OUT=Path('/workspace/shared/runs/t048_dev_probe')
+engine={};exec((HERE/'market_engine.py').read_text(),engine)
+PRODUCTS=('CARROT','TOMATO','STRAWBERRY','MELON','EGG','MILK','WOOL')
+
+def demand(record,item):
+    t=record['step'];d=int(t%24==0)
+    if t%4==0:
+        for s in record['town']['unlocked_shops']:
+            items=engine['SHOPS'][s]
+            if item in items:d+=2 if len(items)==1 else 1
+    return d
+
+def main():
+    games=[]; forecasts=[]; hist=collections.Counter(); errors=[]
+    for path in sorted(OUT.glob('*_0.json.gz')):
+        data=json.load(gzip.open(path,'rt'));rr=data['records'];counts=collections.Counter()
+        for r in rr:
+            orders=r['orders'][0]
+            boundary=max((i for i,o in enumerate(orders) if o[0] not in ('SELL','NOOP')),default=-1)
+            suffix=[o for o in orders[boundary+1:] if o[0]=='SELL']
+            counts['multi_suffix_after14']+=int(r['step']>=336 and len(suffix)>=2)
+            counts['late28_orders']+=int(r['step']>=672)*len(orders)
+        for it in PRODUCTS:
+            flow=[]
+            for j,r in enumerate(rr):
+                own=r['shed'][0][it]-r['shed_after'][0][it]
+                observed=r['market_after']['inventory'][it]-r['market']['inventory'][it]-own
+                valid=(r['market']['prices'][it]>10 and r['market_after']['prices'][it]>1)
+                if valid:
+                    actual=r['shed'][1][it]-r['shed_after'][1][it]
+                    if observed!=actual:errors.append((path.name,r['step'],it,observed,actual))
+                if j>=672 and j+4<len(rr) and len(flow)>=24 and all(x is not None for x in flow[-24:]):
+                    history=flow[-24:]
+                    predicted=np.mean([sum(history[k:k+4]) for k in range(21)])
+                    future=rr[j:j+4]
+                    actual=sum(x['shed'][1][it]-x['shed_after'][1][it] for x in future)
+                    forecasts.append(dict(game=path.name,item=it,step=r['step'],predicted=float(predicted),actual=actual,
+                                          known_town=sum(demand(x,it) for x in future),stock=r['shed'][0][it]))
+                flow.append(max(0,observed) if valid else None)
+        games.append(dict(game=path.name,status=data['status'],rewards=data['rewards'],**counts))
+    report=dict(games=games,public_flow_mismatches=errors,forecast={})
+    for it in PRODUCTS:
+        rows=[x for x in forecasts if x['item']==it]
+        if rows:
+            report['forecast'][it]=dict(n=len(rows),predicted=float(np.mean([x['predicted'] for x in rows])),
+                actual=float(np.mean([x['actual'] for x in rows])),mae=float(np.mean([abs(x['predicted']-x['actual']) for x in rows])),
+                demand=float(np.mean([x['known_town'] for x in rows])))
+    (OUT/'analysis.json').write_text(json.dumps(report,indent=2))
+    print(json.dumps(report,indent=2))
+
+if __name__=='__main__':main()
diff --git a/lab/t048/attribution.py b/lab/t048/attribution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7c1fc4537b86cda7f20d0a2713385f324a430de3
--- /dev/null
+++ b/lab/t048/attribution.py
@@ -0,0 +1,69 @@
+"""Post-gate diagnostic: factual-state, one-step exact market counterfactuals.
+
+These local deltas are not a decomposition of an alternative full trajectory.
+No policy parameters are selected using these diagnostics.
+"""
+import os
+for key in ('OPENBLAS_NUM_THREADS','OMP_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS'):
+    os.environ[key]='1'
+import contextlib
+import copy
+import io
+import json
+import random
+from pathlib import Path
+from concurrent.futures import ProcessPoolExecutor
+import numpy as np
+from gate import load,HERE,BASE
+OUT=Path('/workspace/shared/runs/t048_ev_gate')
+
+def game(seed):
+    log=io.StringIO();events=[];last={}
+    with contextlib.redirect_stdout(log),contextlib.redirect_stderr(log):
+        from kaggle_environments import make
+        random.seed(seed);np.random.seed(seed)
+        mod=load(HERE/'exports/sale_beam/main.py','attribution_beam')
+        opp=load(BASE,'attribution_base')
+        apply=mod._T048.apply
+        def capture(obs,action,config=None):
+            before=mod._T048.stats['expected_gain']
+            result=apply(obs,action,config)
+            last.update(step=int(obs['step']),native=copy.deepcopy(action),changed=result!=action,
+                        predicted=mod._T048.stats['expected_gain']-before)
+            return result
+        mod._T048.apply=capture
+        env=make('kaggriculture',configuration={'seed':seed},debug=False)
+        engine=env.interpreter.__globals__;market=engine['_process_market']
+        def hook(state,env):
+            alternate=None
+            if last['changed']:
+                assert last['step']==int(state[0].observation.step)
+                assert state[0].action['farmer']==last['native']['farmer']
+                assert state[0].action['hands']==last['native']['hands']
+                alternate=copy.deepcopy(state)
+                alternate[0].action=last['native']
+                market(alternate,env)
+            market(state,env)
+            if alternate is not None:
+                ours=state[0].observation.farms[0]['money']-alternate[0].observation.farms[0]['money']
+                theirs=state[0].observation.farms[1]['money']-alternate[0].observation.farms[1]['money']
+                assert state[0].observation.private['shed']==alternate[0].observation.private['shed']
+                events.append(dict(step=last['step'],predicted=last['predicted'],local_own_delta=ours,
+                                   local_rival_delta=theirs,local_margin_delta=ours-theirs,
+                                   native=last['native']['market'],selected=copy.deepcopy(state[0].action['market'])))
+        engine['_process_market']=hook
+        try:env.run([mod.agent,opp.agent])
+        finally:engine['_process_market']=market
+    rows=[json.loads(x) for x in (OUT/'games.jsonl').read_text().splitlines()]
+    ref=next(r for r in rows if (r['variant'],r['opp'],r['seed'],r['seat'])==('sale_beam','base',seed,0))
+    result=dict(seed=seed,status=[s.status for s in env.state],rewards=[s.reward for s in env.state],events=events,
+                sum_predicted=sum(r['predicted'] for r in events),
+                sum_local_margin_delta=sum(r['local_margin_delta'] for r in events),
+                negative_local_decisions=sum(r['local_margin_delta']<0 for r in events))
+    assert result['status']==['DONE','DONE'] and result['rewards']==ref['rewards']
+    return result
+
+if __name__=='__main__':
+    with ProcessPoolExecutor(max_workers=2) as pool:
+        rows=list(pool.map(game,[93048501,93048513]))
+    (OUT/'attribution.json').write_text(json.dumps(rows,indent=2));print(json.dumps(rows,indent=2))
