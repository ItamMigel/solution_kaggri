x=json.load(open('/workspace/shared/runs/t028_income_mined.json'))
TOP={'Boey':1,'M & M & P & Q':2,'DSM':3,'Fourth Quadrant':4,'DECEM':5,'Unknown Mother-Goose':6,'Azat Akhtyamov':7,'🐚seek inspiration🐚':8,'吃白饭的大肥鱼':9,'Majkel1337':10,'THIRD FARM CLUB':11,'Pii':12,'Smackaveli':13,'mtmr_s1':14,'TheEggman':15,'Russell Kirk':16,'Densike':17,'kigasudayooo':18,'tetsuya & yuanzhe & guoqin':19,'Arda Ceylan':20}
def picks():
 for z in x:
  if 'error'in z: continue
  r=z['result']; lab=z['label']
  if lab=='ours': yield 'ours',r, r['names'].index('misis biznessmenlb')
  elif lab.startswith('top'):
   n=int(lab[3:]); team=next(k for k,v in TOP.items() if v==n)
   if team in r['names']: yield 'top',r,r['names'].index(team)
   else: print('MISSING',lab,r['names'])
D=collections.defaultdict(list); U=collections.defaultdict(list); A=collections.defaultdict(list); F=collections.defaultdict(list); n=collections.Counter()
for grp,r,p in picks():
 n[grp]+=1
 ss=collections.defaultdict(float)
 for k,v in r['sells'][p].items():
  cat='animal_product' if k in {'MILK','WOOL','EGG'} else 'fertilizer' if k=='FERTILIZER' else 'animal_sale' if k in {'COW','SHEEP','GOOSE','CHICKEN'} else 'crop'
  ss[cat]+=v[1]
 for c in ('crop','animal_product','fertilizer','animal_sale'):D[(grp,c)].append(ss[c])
 for c in ('seed_buy','animal_buy','product_buy','hire','land'):
  if c=='hire':v=r['hire_cost'][p]
  elif c=='land':v=sum(a[2] for a in r['land'][p])
  else:
   pref={'seed_buy':'BUY_SEED:','animal_buy':'BUY_ANIMAL:','product_buy':'BUY_PRODUCT:'}[c];v=sum(a[1] for k,a in r['buys'][p].items() if k.startswith(pref))
  D[(grp,c)].append(v)
 D[(grp,'final')].append(r['rewards'][p])
 for op,c in r['unit_ops'][p].items():U[(grp,op)].append(c)
 for d,v in r['sell_by_day'][p].items():
  for item,q in v.items():
   cat='animal_product' if item in {'MILK','WOOL','EGG'} else 'fertilizer' if item=='FERTILIZER' else 'crop'
   F[(grp,cat,int(d))].append(q)
 for ti in r['tiles_hist'][-1][1][p].items(): A[(grp,ti[0])].append(ti[1])
print('N',n)
for c in ['final','crop','animal_product','fertilizer','animal_sale','seed_buy','animal_buy','product_buy','hire','land']:
 o=statistics.mean(D['ours',c]);t=statistics.mean(D['top',c]);print(c,round(t),round(o),round(t-o))
print('\\nops top-minus-ours')
for op in sorted({op for g,op in U},key=lambda q: statistics.mean(U['top',q])-statistics.mean(U['ours',q]),reverse=True):print(op,round(statistics.mean(U['top',op])),round(statistics.mean(U['ours',op])),round(statistics.mean(U['top',op])-statistics.mean(U['ours',op])))
print('\\nfinal animals top/ours')
for a in ['A_COW','A_SHEEP','A_GOOSE','P_STRAWBERRY','P_MELON','P_CARROT']:
 print(a,round(statistics.mean(A['top',a]),1),round(statistics.mean(A['ours',a]),1),round(statistics.mean(A['top',a])-statistics.mean(A['ours',a]),1))
print('\\ndaily sale unit diffs top-ours')
for c in ['crop','animal_product','fertilizer']:
 print(c,[(d,round(statistics.mean(F['top',c,d]) if F['top',c,d] else 0,1),round(statistics.mean(F['ours',c,d]) if F['ours',c,d] else 0,1)) for d in range(30)])
