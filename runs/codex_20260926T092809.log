--- fetch top ---
"""Download recent replays of top-N LB teams (read-only Kaggle).
usage: python fetch_top.py --top 30 --per-sub 12 --out /workspace/shared/replays/top
Writes index.jsonl (team, rank, score, sub_id, episode_id, file). Skips existing files."""
import argparse, csv, glob, io, json, os, subprocess, zipfile
K = "/workspace/shared/bin/kaggle"

def run(*a):
    return subprocess.run([K, *a], capture_output=True, text=True, timeout=600).stdout

def jl(txt):
    txt = (txt or "").lstrip()
    if not txt.startswith("["): return []
    return json.JSONDecoder().raw_decode(txt)[0]

def main():
    ap = argparse.ArgumentParser(); ap.add_argument("--top", type=int, default=30)
    ap.add_argument("--per-sub", type=int, default=12); ap.add_argument("--out", default="/workspace/shared/replays/top")
    a = ap.parse_args(); os.makedirs(a.out, exist_ok=True)
    tmp = a.out + "/_lb"; os.makedirs(tmp, exist_ok=True)
    run("competitions", "leaderboard", "-c", "kaggriculture", "-d", "-p", tmp)
    z = sorted(glob.glob(tmp + "/*.zip"))[-1]
    with zipfile.ZipFile(z) as zf:
        name = zf.namelist()[0]; rows = list(csv.DictReader(io.TextIOWrapper(zf.open(name), "utf-8-sig")))
    idx = open(a.out + "/index.jsonl", "a")
    for r in rows[: a.top]:
        subs = jl(run("competitions", "team-submissions", r["TeamId"], "--format", "json"))
        for s in subs:
            eps = jl(run("competitions", "episodes", str(s["id"]), "--format", "json"))
            eps = [e for e in eps if "COMPLETED" in e["state"]][: a.per_sub]
            for e in eps:
                f = f"{a.out}/episode-{e['id']}-replay.json.gz"
                if not os.path.exists(f):
                    run("competitions", "replay", str(e["id"]), "-p", a.out, "-q")
                    raw = f[:-3]
                    if os.path.exists(raw): subprocess.run(["gzip", "-f", raw])
                idx.write(json.dumps({"team": r["TeamName"], "team_id": r["TeamId"], "rank": r["Rank"], "score": r["Score"],
                                      "sub_id": s["id"], "sub_score": s.get("publicScore"), "episode_id": e["id"],
                                      "end": e["endTime"], "file": f}) + "\n"); idx.flush()
            print(r["Rank"], r["TeamName"], s["id"], len(eps), flush=True)

if __name__ == "__main__":
    main()

--- census CLI ---
"""Fingerprint every downloaded replay (both players) -> compact JSON per episode, then aggregate.
usage: python census.py mine --index /workspace/shared/replays/top/index.jsonl --out /workspace/shared/research/census --workers 16
       python census.py report --out /workspace/shared/research/census"""
import argparse, glob, json, os, sys
from concurrent.futures import ProcessPoolExecutor
from collections import defaultdict

def fp_one(path):
    from replay_mine import mine
    r = mine(path, verbose=False)
    out = {"episode": r["episode"], "names": r["names"], "rewards": r["rewards"], "seed": r["seed"], "players": []}
    for p in range(2):
        sells = {k: [v[0], round(v[1])] for k, v in r["sells"][p].items()}
        buys = {k: [v[0], round(v[1])] for k, v in r["buys"][p].items()}
        hands = [h[p] for (_, _, _, _, h, _, _) in r["tiles_hist"]]
        out["players"].append({
            "name": r["names"][p], "final": r["rewards"][p], "sells": sells, "buys": buys,
            "animals": {k.split(":")[1]: v[0] for k, v in buys.items() if k.startswith("BUY_ANIMAL")},
            "seeds": {k.split(":")[1]: v[0] for k, v in buys.items() if k.startswith("BUY_SEED")},
            "hire_cost": round(r["hire_cost"][p]), "hands_by_day": hands, "hires_by_day": [r["hires"][p].get(dd, 0) for dd in range(30)], "land": r["land"][p],
            "first_sell_day": r["first_sell_day"][p], "unit_ops": r["unit_ops"][p], "order_lane": r["order_lane"][p],
            "money_by_day": [r["money"][p][min(len(r["money"][p]) - 1, d * 24 + 23)] for d in range(30)],
        })
    out["shops"] = r["tiles_hist"][-1][6]
    out["daily"] = [{"day": day, "tiles": tiles, "hands": hands, "shops": shops} for (day, tiles, _pr, _inv, hands, _q, shops) in r["tiles_hist"]]
    out["v"] = 3
    return out

def _job(args):
    path, dst = args
    if os.path.exists(dst) and json.load(open(dst)).get("v") == 3: return "skip"
    try:
        import io, contextlib
        with contextlib.redirect_stdout(io.StringIO()):
            res = fp_one(path)
        json.dump(res, open(dst, "w")); return "ok"
    except Exception as e:
        return f"ERR {path}: {e!r}"

def cmd_mine(a):
    os.makedirs(a.out + "/fp", exist_ok=True)
    seen, jobs = set(), []
    for l in open(a.index):
        d = json.loads(l)
        if d["episode_id"] in seen or not os.path.exists(d["file"]): continue
        seen.add(d["episode_id"]); jobs.append((d["file"], f"{a.out}/fp/{d['episode_id']}.json"))
    with ProcessPoolExecutor(a.workers) as ex:
        res = list(ex.map(_job, jobs))
    print({k: sum(1 for r in res if r.startswith(k)) for k in ("ok", "skip", "ERR")})
    for r in res:
        if r.startswith("ERR"): print(r)


def cmd_report(a):
    import statistics as st
    rows = defaultdict(list)
    for f in glob.glob(a.out + "/fp/*.json"):
        d = json.load(open(f))
        for p in range(2):
            me, op = d["players"][p], d["players"][1 - p]
            rows[me["name"]].append((me, op, d))
    lines = ["| team | n | W-L | mean $ | mean opp $ | animals (c/s/g/ch) | straw seeds | melon | carrot | tomato | max hires/day | land days | top sells |", "|" + "---|" * 13]
    for name, lst in sorted(rows.items(), key=lambda kv: -st.mean(x[0]["final"] for x in kv[1])):
        if len(lst) < a.min_n: continue
        w = sum(me["final"] > op["final"] for me, op, _ in lst); l = sum(me["final"] < op["final"] for me, op, _ in lst)
        m = lambda f: st.mean(f(me) for me, _, _ in lst)
        an = lambda k: m(lambda me: me["animals"].get(k, 0))
        sd = lambda k: m(lambda me: me["seeds"].get(k, 0))
        rev = defaultdict(float)
        for me, _, _ in lst:
            for k, v in me["sells"].items(): rev[k] += v[1] / len(lst)
        top = ", ".join(f"{k[:5]} {v/1000:.0f}k" for k, v in sorted(rev.items(), key=lambda kv: -kv[1])[:5])
        lands = "/".join(f"{st.mean(x[0]['land'][i][0] for x in lst if len(x[0]['land']) > i):.0f}" for i in range(3) if any(len(x[0]['land']) > i for x in lst))
        lines.append(f"| {name[:24]} | {len(lst)} | {w}-{l} | {m(lambda me: me['final'])/1000:.0f}k | {st.mean(op['final'] for _, op, _ in lst)/1000:.0f}k | "
                     f"{an('COW'):.1f}/{an('SHEEP'):.1f}/{an('GOOSE'):.1f}/{an('CHICKEN'):.1f} | {sd('STRAWBERRY'):.0f} | {sd('MELON'):.0f} | {sd('CARROT'):.0f} | {sd('TOMATO'):.0f} | "
                     f"{m(lambda me: max(me.get('hires_by_day') or [0])):.1f} | {lands} | {top} |")
    txt = "\n".join(lines); open(a.out + "/report.md", "w").write(txt + "\n"); print(txt)

if __name__ == "__main__":
    ap = argparse.ArgumentParser(); ap.add_argument("cmd"); ap.add_argument("--index", default="/workspace/shared/replays/top/index.jsonl")
    ap.add_argument("--out", default="/workspace/shared/research/census"); ap.add_argument("--workers", type=int, default=16); ap.add_argument("--min-n", type=int, default=3)
    a = ap.parse_args(); sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    {"mine": cmd_mine, "report": cmd_report}[a.cmd](a)

--- replay mine options ---
"""Mine a Kaggle replay by re-running it bit-exactly in the real engine with
instrumentation on _commit_unit / _do_hire / _do_buy_land / unit actions.

Usage: python -m src.replay_mine replays_top/episode-XXXX-replay.json [--json out.json]
"""
import gzip
import json
import sys
from collections import Counter, defaultdict

from kaggle_environments import make
from kaggle_environments.envs.kaggriculture import kaggriculture as K


def mine(path, verbose=True):
    _open = gzip.open if path.endswith(".gz") else open
    with _open(path, "rt") as _f:
        d = json.load(_f)
    cfg = dict(d["configuration"])
    cfg["seed"] = d["info"]["seed"]
    names = d["info"].get("TeamNames", ["p0", "p1"])
    steps = d["steps"]

    # ---- instrumentation state -------------------------------------------
    cur = {"step": 0}
    farms_ref = {}
    sells = [defaultdict(lambda: [0, 0.0]), defaultdict(lambda: [0, 0.0])]  # item -> [units, revenue]
    buys = [defaultdict(lambda: [0, 0.0]), defaultdict(lambda: [0, 0.0])]
    sell_by_day = [defaultdict(lambda: defaultdict(int)), defaultdict(lambda: defaultdict(int))]
    sell_price_by_day = [defaultdict(list), defaultdict(list)]
    hires = [Counter(), Counter()]  # day -> n
    hire_cost = [0.0, 0.0]
    land = [[], []]
    unit_ops = [Counter(), Counter()]
    unit_ops_ok = [Counter(), Counter()]
    market_ops = [Counter(), Counter()]
    order_lane = [Counter(), Counter()]  # (op, index) counts
    first_sell_day = [{}, {}]

    orig_commit = K._commit_unit
    orig_hire = K._do_hire
    orig_land = K._do_buy_land
    orig_unit = K._apply_unit_action

    def commit(op, item, price, farm, private, market, *extra):
        pid = farms_ref.get(id(farm), 0)
        ok = orig_commit(op, item, price, farm, private, market, *extra)
        if ok:
            day = cur["step"] // 24
            if op == "SELL":
                sells[pid][item][0] += 1
                sells[pid][item][1] += price
                sell_by_day[pid][day][item] += 1
                sell_price_by_day[pid][day].append((item, price))
                first_sell_day[pid].setdefault(item, day)
            elif op in ("BUY_PRODUCT", "BUY_SEED", "BUY_ANIMAL"):
                key = op + ":" + item
                buys[pid][key][0] += 1
                buys[pid][key][1] += price
                if op == "BUY_PRODUCT":
                    sell_by_day[pid][day]["BUY_" + item] -= 1
                    sell_price_by_day[pid][day].append(("BUY_" + item, price))
        return ok

    def hire(farm, private, board_size, mult):
        pid = farms_ref.get(id(farm), 0)
        before = farm["money"]
        n0 = len(farm["hands"])
        orig_hire(farm, private, board_size, mult)
        if len(farm["hands"]) > n0:
            hires[pid][cur["step"] // 24] += 1
            hire_cost[pid] += before - farm["money"]

    def buyland(farm, board_size):
        pid = farms_ref.get(id(farm), 0)
        n0 = len(farm["unlocked_quadrants"])
        before = farm["money"]
        orig_land(farm, board_size)
        if len(farm["unlocked_quadrants"]) > n0:
            land[pid].append((cur["step"] // 24, farm["unlocked_quadrants"][-1], before - farm["money"]))

    def unit(farm, private, idx, action, board_size, day, turns_per_day, shed_capacity=100):
        pid = farms_ref.get(id(farm), 0)
        op = action[0] if isinstance(action, list) and action else "?"
        unit_ops[pid][op] += 1
        snap = (farm["money"], json.dumps(private["shed"], sort_keys=True),
                str(_farmer_pos(farm, idx)), json.dumps(private["inventories"], sort_keys=True))
        orig_unit(farm, private, idx, action, board_size, day, turns_per_day, shed_capacity)
        snap2 = (farm["money"], json.dumps(private["shed"], sort_keys=True),
                 str(_farmer_pos(farm, idx)), json.dumps(private["inventories"], sort_keys=True))
        # crude but sufficient: tile mutations not caught -> handle separately
        if snap != snap2:
            unit_ops_ok[pid][op] += 1

    def _farmer_pos(farm, idx):
        return farm["farmer"] if idx == 0 else (farm["hands"][idx - 1] if idx - 1 < len(farm["hands"]) else None)

    orig_interp = K.interpreter

    def interp(state, env):
        fs = state[0].observation.farms
        farms_ref.clear()
        for i, f in enumerate(fs):
            farms_ref[id(f)] = i
        return orig_interp(state, env)

    K._commit_unit = commit
    K._do_hire = hire
    K._do_buy_land = buyland
    K._apply_unit_action = unit
    K.interpreter = interp
    import kaggle_environments as _ke
    _ke.core.environments["kaggriculture"]["interpreter"] = interp

    try:
        env = make("kaggriculture", configuration=cfg, debug=False)
        env.reset(2)

        money = [[], []]
        tiles_hist = []
        for t in range(1, len(steps)):
            cur["step"] = t
            f0 = env.state[0]["observation"]["farms"]
            farms_ref.clear()
            farms_ref[id(f0[0])] = 0
            farms_ref[id(f0[1])] = 1
            # Ladder replays may encode a timed-out/no-op turn as `"action": null`.
            # The engine accepts the equivalent empty action object.
            acts = [steps[t][p].get("action") or {} for p in range(2)]
            for p in range(2):
                m = acts[p].get("market") or []
                for i, o in enumerate(m[:10]):
                    if isinstance(o, list) and o:
                        market_ops[p][o[0]] += 1
                        order_lane[p][(o[0], i)] += 1
            env.step(acts)
            obs = env.steps[-1][0]["observation"]
            for p in range(2):
                money[p].append(obs["farms"][p]["money"])
            if t % 24 == 0 or t == len(steps) - 1:
                tiles_hist.append((t // 24, [_tile_census(obs["farms"][p]) for p in range(2)],
                                   dict(obs["market"]["prices"]),
                                   {k: 10000 - v for k, v in obs["market"]["inventory"].items()},
                                   [len(obs["farms"][p]["hands"]) for p in range(2)],
                                   [list(obs["farms"][p]["unlocked_quadrants"]) for p in range(2)],
                                   list(obs["town"]["unlocked_shops"])))
    finally:
        K._commit_unit = orig_commit
        K._do_hire = orig_hire
        K._do_buy_land = orig_land
        K._apply_unit_action = orig_unit

    res = {
        "episode": d["id"], "names": names, "rewards": d["rewards"], "seed": cfg["seed"],
        "sells": [{k: v for k, v in s.items()} for s in sells],
        "buys": [{k: v for k, v in b.items()} for b in buys],
        "hires": [dict(h) for h in hires], "hire_cost": hire_cost,
        "land": land,
        "unit_ops": [dict(u) for u in unit_ops], "unit_ops_ok": [dict(u) for u in unit_ops_ok],
        "market_ops": [dict(m) for m in market_ops],
        "order_lane": [{f"{k[0]}@{k[1]}": v for k, v in o.items()} for o in order_lane],
        "first_sell_day": first_sell_day,
        "money": money,
        "tiles_hist": tiles_hist,
        "sell_by_day": [{d_: dict(v) for d_, v in s.items()} for s in sell_by_day],
        "sell_price_by_day": [{d_: v for d_, v in s.items()} for s in sell_price_by_day],
    }
    if verbose:
        report(res)
    return res


def _tile_census(farm):
    c = Counter()
    for row in farm["tiles"]:
        for tl in row:
            if tl is None:
                c["EMPTY"] += 1
            elif tl == "LOCKED":
                c["LOCKED"] += 1
            elif isinstance(tl, dict):
                if tl.get("kind") == "PLANT":
                    c["P_" + tl["crop"]] += 1
                elif tl.get("kind") == "WEED":
                    c["WEED"] += 1
                elif tl.get("animal"):
                    c["A_" + tl["animal"]] += 1
                else:
                    c["B_" + str(tl.get("kind"))] += 1
    return dict(c)


def report(r):
    print(f"=== episode {r['episode']} seed={r['seed']} ===")
    for p in range(2):
        print(f"\n--- P{p} {r['names'][p]}  FINAL ${r['rewards'][p]:,.0f} ---")
        s = r["sells"][p]
        tot = sum(v[1] for v in s.values())
        print(f"  REVENUE ${tot:,.0f}")
        for k, v in sorted(s.items(), key=lambda kv: -kv[1][1]):
            print(f"    {k:11s} {v[0]:5d} u  ${v[1]:10,.0f}   avg ${v[1]/max(1,v[0]):7.1f}  first sell d{r['first_sell_day'][p].get(k)}")
        b = r["buys"][p]
        tb = sum(v[1] for v in b.values()) + r["hire_cost"][p] + sum(l[2] for l in r["land"][p])
        print(f"  COSTS ${tb:,.0f}  (hires ${r['hire_cost'][p]:,.0f}, land ${sum(l[2] for l in r['land'][p]):,.0f})")
        for k, v in sorted(b.items(), key=lambda kv: -kv[1][1]):
            print(f"    buy {k:11s} {v[0]:5d} u  ${v[1]:10,.0f}")
        print(f"  land: {r['land'][p]}")
        hs = r["hires"][p]
        print(f"  hires by day: {dict(sorted(hs.items()))} total {sum(hs.values())}")
        print(f"  market ops: {r['market_ops'][p]}")
        print(f"  order lanes: {dict(sorted(r['order_lane'][p].items()))}")
        print(f"  unit ops: {dict(sorted(r['unit_ops'][p].items(), key=lambda kv:-kv[1]))}")


if __name__ == "__main__":
    mine(sys.argv[1])

