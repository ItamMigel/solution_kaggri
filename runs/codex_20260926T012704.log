import json, os
from pathlib import Path
used=set(); files=[]
for root in (Path('/workspace/shared/runs'), Path('/workspace/wt/codex/runs')):
    if not root.exists(): continue
    for p in root.rglob('*.json'):
        try:
            x=json.loads(p.read_text())
        except Exception:
            continue
        vals = x.get('seeds') if isinstance(x, dict) else None
        if isinstance(vals, list) and all(isinstance(v,int) for v in vals):
            used.update(vals); files.append(str(p))
        elif isinstance(x, dict) and isinstance(x.get('seed'),int):
            used.add(x['seed']); files.append(str(p))
print(f'seed_artifacts={len(files)} unique_used={len(used)}')
new=[]
while len(new)<24:
    n=int.from_bytes(os.urandom(4),'big') & ((1<<31)-1)
    if n not in used and n not in new:
        new.append(n)
print(json.dumps({'seeds':new}, indent=2))
