@@ -0,0 +1,52 @@
+# T040 — ladder snapshot and top-RE execution audit
+
+Owner: codex. Status: in progress. Never submit to Kaggle.
+
+## Scope
+
+Read-only snapshot of all completed episodes since 2026-09-26 18:30Z for
+`es7_wm` (56584540) and `es6_c4g15` (56580877), storing compressed replays
+under `replays/ours_final/<submission>/`.  Classify opponent behaviour by the
+share of d9–29 turns whose farmer+hand positions equal ours (tape-clone at
+least 50%; otherwise reactive), and report per-class W-L and mean margin with
+the current ratings.
+
+Separately audit `lab/re/top_re` execution: at the first land purchase which
+creates 25–40 empty tiles, test whether plant targets and seeds exist, whether
+the units dispatcher receives and emits executable plant work, and report unit
+move share.  Any score conclusion needs at least eight fresh seeds in both
+seats for every claimed comparison.  At most eight workers; no Kaggle write.
+
+## Result (2026-09-26 22:0xZ)
+
+Read-only ladder snapshot has 45 completed `es7_wm` and 17 `es6_c4g15`
+episodes ending after 18:30Z. Replays are gzip files in
+`replays/ours_final/es7_wm/` and `replays/ours_final/es6_c4g15/`; the
+reproducible position classifier and outcomes are in
+`runs/t040_ladder_snapshot.json`.
+
+| submission | class | n | W-D-L | mean own margin |
+|---|---:|---:|---:|---:|
+| es7_wm | tape-clone | 44 | 32-0-12 | +$725.93 |
+| es7_wm | reactive | 1 | 1-0-0 | +$5,882.00 |
+| es6_c4g15 | tape-clone | 14 | 8-0-6 | +$65.79 |
+| es6_c4g15 | reactive | 3 | 1-0-2 | +$172.67 |
+
+The rating snapshot taken with the same read-only API was es7 **1968.6** and
+es6 **2458.5**.  The reactive samples are too small for an inference.
+
+Top-RE was rebuilt with `TOPRE_PLAN=plan_fm`, the current Hungarian units and
+the day-zero harvest fix, then run against frozen es7 on seeds 777--784 in
+both seats (16/16 DONE, eight processes): mean own cash $46,692.69 versus
+$151,381.75, so mean margin **-$104,689.06** (0--16). This is a diagnosis,
+not a candidate comparison.  Mean unit move share is **42.51%**.
+
+The land#2 observation has 25--29 empty cells in all 16 games.  It has only
+1--7 desired empty crop cells (mean 4.06) and 0--7 immediately seed-qualified
+plant targets (mean 3.69); no immediate PLANT command is emitted because each
+worker is elsewhere. Across all 4,891 observations with 25--40 empties, there
+are 8.55 immediately seed-qualified plant targets per turn but only 0.382
+PLANT commands/turn.  Thus targets are generated and often seed-funded, but
+are starved by the globally re-matched service/navigation queue; it is not an
+absent-target or all-seeds-missing bug. Raw per-game logs:
+`runs/t040_topre_planfm_8x2/`.
diff --git a/lab/re/top_re/audit_run.py b/lab/re/top_re/audit_run.py
new file mode 100644
index 0000000000000000000000000000000000000000..2669f2e801a1974d995fdfd74fefa5205e9ee4dc
--- /dev/null
+++ b/lab/re/top_re/audit_run.py
@@ -0,0 +1,104 @@
+"""Trace top-RE plan execution around land purchases; diagnostic only.
+
+Usage: python audit_run.py AGENT OPPONENT SEED SEAT OUT.json
+The wrapped agent is unchanged; this records its observed input and returned
+action before the official engine applies it.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from collections import Counter, defaultdict
+from pathlib import Path
+
+from kaggle_environments import make
+
+
+def load(path):
+    ns = {"__name__": "top_re_audit_agent"}
+    exec(compile(Path(path).read_text(), path, "exec"), ns)
+    return ns
+
+
+def empty_tiles(farm):
+    return sum(tile is None for row in farm["tiles"] for tile in row)
+
+
+def land_count(farm):
+    return len(farm.get("unlocked_quadrants") or ["NW"])
+
+
+def inspect(ns, obs, action):
+    player = int(obs["player"])
+    farm = obs["farms"][player]
+    want = ns["plan_desired"](obs, player)
+    unit_plan = ns["_unit_plan"](obs, player, want)
+    plants = unit_plan["plant_targets"]
+    crop_want_empty = Counter(
+        role for (x, y), role in want.items()
+        if ":" not in role and farm["tiles"][y][x] is None
+    )
+    cmds = [action.get("farmer") or ["PASS"]] + list(action.get("hands") or [])
+    ops = [cmd[0] if cmd else "PASS" for cmd in cmds]
+    return {
+        "step": int(obs.get("step", 0)), "day": int(obs["day"]),
+        "land": land_count(farm), "empty": empty_tiles(farm),
+        "crop_want_empty": dict(crop_want_empty),
+        "plant_targets": dict(Counter(plants.values())),
+        "seed": dict((obs.get("private") or {}).get("seeds") or {}),
+        "market": action.get("market") or [],
+        "ops": dict(Counter(ops)), "units": len(ops),
+        "moves": sum(op in {"NORTH", "SOUTH", "EAST", "WEST"} for op in ops),
+        "plant_cmds": sum(op == "PLANT" for op in ops),
+    }
+
+
+def main(agent_path, opponent_path, seed, seat, out):
+    ns = load(agent_path); real_agent = ns["agent"]
+    records = []
+
+    def wrapped(obs, config=None):
+        action = real_agent(obs, config)
+        records.append(inspect(ns, obs, action))
+        return action
+
+    agents = [wrapped, load(opponent_path)["agent"]]
+    if seat:
+        agents.reverse()
+    env = make("kaggriculture", configuration={"seed": seed})
+    env.run(agents)
+    mine = int(seat)
+    rewards = [float(s.reward or 0) for s in env.state]
+    first = []
+    previous = 1
+    for row in records:
+        if row["land"] > previous:
+            first.append(row)
+            previous = row["land"]
+    band = [r for r in records if r["land"] >= 2 and 25 <= r["empty"] <= 40]
+    all_ops = Counter(); units = moves = 0
+    for row in records:
+        all_ops.update(row["ops"]); units += row["units"]; moves += row["moves"]
+    result = {
+        "seed": seed, "seat": seat, "rewards": rewards,
+        "mine": rewards[mine], "opp": rewards[1 - mine],
+        "margin": rewards[mine] - rewards[1 - mine],
+        "status": [str(s.status) for s in env.state],
+        "land_events": first,
+        "empty_band": {
+            "turns": len(band),
+            "mean_want_empty": (sum(sum(r["crop_want_empty"].values()) for r in band) / len(band)) if band else 0,
+            "mean_plant_targets": (sum(sum(r["plant_targets"].values()) for r in band) / len(band)) if band else 0,
+            "mean_plant_cmds": (sum(r["plant_cmds"] for r in band) / len(band)) if band else 0,
+            "sample": band[:8],
+        },
+        "ops": dict(all_ops), "units": units, "moves": moves,
+        "move_share": moves / units if units else 0,
+    }
+    Path(out).parent.mkdir(parents=True, exist_ok=True)
+    Path(out).write_text(json.dumps(result, indent=2, sort_keys=True))
+    print(json.dumps({k: result[k] for k in ("seed", "seat", "margin", "status", "move_share")}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), sys.argv[5])

