+++ b/lab/t047/loader_smoke.py
@@ -0,0 +1,47 @@
+"""Official file loading versus the matching audited callable gate games."""
+import os
+for k in ('OPENBLAS_NUM_THREADS','OMP_NUM_THREADS','MKL_NUM_THREADS'):
+    os.environ[k]='1'
+import contextlib
+import io
+import json
+import random
+import time
+from concurrent.futures import ProcessPoolExecutor
+from pathlib import Path
+
+HERE=Path(__file__).resolve().parent
+OUT=Path('/workspace/shared/runs/t047_m26_post')
+
+
+def game(job):
+    variant,seat=job
+    seed=93047001
+    start=time.monotonic()
+    log=io.StringIO()
+    with contextlib.redirect_stdout(log),contextlib.redirect_stderr(log):
+        import numpy as np
+        from kaggle_environments import make
+        random.seed(seed)
+        np.random.seed(seed)
+        pair=[str(HERE/'exports/m26/main.py')]*2
+        pair[seat]=str(HERE/'exports'/variant/'main.py')
+        env=make('kaggriculture',configuration={'seed':seed},debug=False)
+        env.run(pair)
+    r=dict(variant=variant,seed=seed,seat=seat,status=[s.status for s in env.state],
+           rewards=[s.reward for s in env.state],seconds=time.monotonic()-start,
+           remaining_overage=[s.observation.remainingOverageTime for s in env.state],log_tail=log.getvalue()[-1000:])
+    rows=[json.loads(x) for x in (OUT/'games.jsonl').read_text().splitlines()]
+    match=[x for x in rows if (x['variant'],x['opp'],x['seed'],x['seat'])==(variant,'m26',seed,seat)]
+    assert len(match)==1 and match[0]['valid']
+    r['parity']=r['status']==['DONE','DONE'] and r['rewards']==match[0]['rewards']
+    return r
+
+
+if __name__=='__main__':
+    jobs=[(v,p) for v in ('terminal','a1','dsm75_mg25') for p in (0,1)]
+    with ProcessPoolExecutor(max_workers=6) as pool:
+        rows=list(pool.map(game,jobs))
+    (OUT/'loader_smoke.json').write_text(json.dumps(rows,indent=2))
+    print(json.dumps(rows,indent=2))
+    assert all(x['parity'] for x in rows)
diff --git a/lab/t047/package.py b/lab/t047/package.py
new file mode 100644
index 0000000000000000000000000000000000000000..65932916d3d5ea7619926aff309798ea69c804ef
--- /dev/null
+++ b/lab/t047/package.py
@@ -0,0 +1,78 @@
+"""Freeze only passing, independently reviewed T047 variants. Never submit."""
+import argparse
+import gzip
+import hashlib
+import io
+import json
+import shutil
+import tarfile
+from pathlib import Path
+
+HERE=Path(__file__).resolve().parent
+OUT=Path('/workspace/shared/runs/t047_m26_post')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    ap=argparse.ArgumentParser()
+    ap.add_argument('--review',type=Path,required=True)
+    a=ap.parse_args()
+    assert a.review.is_file()
+    summary=json.loads((OUT/'summary.json').read_text())
+    assert summary['complete'] and summary['errors']==0
+    smoke=json.loads((OUT/'loader_smoke.json').read_text())
+    assert len(smoke)==6 and all(r['parity'] for r in smoke)
+    manifest=json.loads((HERE/'manifest.json').read_text())
+    result={}
+    for variant,stats in summary['variants'].items():
+        if not stats['pass']:
+            continue
+        name='t047_m26_'+variant
+        target=Path('/workspace/shared/candidates')/name
+        assert not target.exists(), 'Frozen candidate already exists'
+        source=HERE/'exports'/variant/'main.py'
+        assert sha(source)==manifest['exports'][variant]['sha256']
+        (target/'pkg').mkdir(parents=True)
+        shutil.copyfile(source,target/'pkg/main.py')
+        (target/'evidence').mkdir()
+        for path in (OUT/'manifest.json',OUT/'summary.json',OUT/'games.jsonl',OUT/'loader_smoke.json',HERE/'fixtures.json',a.review):
+            shutil.copyfile(path,target/'evidence'/path.name)
+        # Reproducible archive with main.py at its root.
+        archive=target/(name+'.tar.gz')
+        data=source.read_bytes()
+        with archive.open('wb') as f, gzip.GzipFile(fileobj=f,mode='wb',mtime=0,filename='') as gz, tarfile.open(fileobj=gz,mode='w') as tar:
+            ti=tarfile.TarInfo('main.py')
+            ti.size=len(data)
+            ti.mode=0o644
+            ti.mtime=0
+            tar.addfile(ti,io.BytesIO(data))
+        with tarfile.open(archive) as tar:
+            assert tar.getnames()==['main.py'] and tar.extractfile('main.py').read()==data
+        h=stats['opponents']['m26']
+        text=f'''# {name}
+
+Пройден заданный T047 гейт; никаких отправок в Kaggle.
+
+Основа: Pavel m26dsm, o28_dsm_cn, HG d13, fill. Единственное изменение: T045 liquidation на шаге 718, после native unit actions; сохраняет рыночный префикс и лимит 10 ордеров. До шага 718 поведение родителя сохранено. Переобучения нет. Исходный fallback сохранён; terminal при исключении возвращает действие родителя.
+
+Против неизменённого m26: {h['wins']}/{h['draws']}/{h['losses']} W/D/L, {h['points']}/32 points, средний margin ${h['mean_margin']:+.2f}, whole-world 95% CI [{h['world95'][0]:+.2f}, {h['world95'][1]:+.2f}]. Миры 93047001–93047016, оба места; 100000 фиксированных bootstrap resamples.
+
+Sanity, миры 93047101–93047108, оба места: tetsu {stats['opponents']['tetsu']['points']}/16 points; ozer44 {stats['opponents']['ozer44']['points']}/16. В полном гейте 192/192 игр без ошибок/таймаутов; 6/6 повторов через официальный file loader совпадают с callable rewards. Независимый review: evidence/{a.review.name}.
+
+Это небольшое улучшение реализации последнего хода. Высокая доля побед в зеркале не доказывает большой прирост рейтинга или побед против всего поля.
+
+Архив: {archive.name}; внутри только main.py. Файлы evidence фиксируют исходники, миры, результаты и проверки. Человек принимает решение о возможной отправке самостоятельно.
+'''
+        (target/'README.md').write_text(text)
+        hashes={str(p.relative_to(target)):sha(p) for p in sorted(target.rglob('*')) if p.is_file()}
+        (target/'sha256.json').write_text(json.dumps(hashes,indent=2))
+        result[variant]={'path':str(target),'archive':str(archive),'sha256':sha(archive),'source_sha256':sha(source)}
+    (OUT/'packages.json').write_text(json.dumps(result,indent=2))
+    print(json.dumps(result,indent=2))
+
+
+if __name__=='__main__':
+    main()
diff --git a/lab/t047/summarize.py b/lab/t047/summarize.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b9deaa2147d85b6658a8d7138f7747f72d6cb0b
--- /dev/null
+++ b/lab/t047/summarize.py
@@ -0,0 +1,47 @@
+"""Frozen whole-world bootstrap; no tuning or optional stopping."""
+import json
+from pathlib import Path
+import numpy as np
+
+OUT = Path('/workspace/shared/runs/t047_m26_post')
+
+
+def main():
+    rows = [json.loads(x) for x in (OUT/'games.jsonl').read_text().splitlines()]
+    manifest = json.loads((OUT/'manifest.json').read_text())
+    keys = [(r['variant'],r['opp'],r['seed'],r['seat']) for r in rows]
+    expected = {tuple(j) for j in manifest['jobs']}
+    assert len(keys)==len(set(keys)) and set(keys)<=expected
+    result = {'records':len(rows), 'complete':set(keys)==expected,
+              'errors':sum(not r['valid'] for r in rows), 'variants':{}}
+    for variant in ('terminal','a1','dsm75_mg25'):
+        groups = {}
+        for opp in ('m26','tetsu','ozer44'):
+            rr = [r for r in rows if r['variant']==variant and r['opp']==opp]
+            good = [r for r in rr if r['valid']]
+            seeds = sorted({r['seed'] for r in good})
+            worlds = [[r for r in good if r['seed']==s] for s in seeds]
+            complete = [x for x in worlds if len(x)==2 and {r['seat'] for r in x}=={0,1}]
+            ci = None
+            if complete:
+                means = np.array([np.mean([r['margin'] for r in x]) for x in complete])
+                rng = np.random.default_rng(47020260930)
+                boot = means[rng.integers(len(means),size=(100000,len(means)))].mean(1)
+                ci = list(map(float,np.quantile(boot,[.025,.975])))
+            groups[opp] = {'n':len(rr), 'valid':len(good), 'worlds':len(complete),
+                           'points':sum(r['points'] for r in good),
+                           'wins':sum(r['margin']>0 for r in good),
+                           'draws':sum(r['margin']==0 for r in good),
+                           'losses':sum(r['margin']<0 for r in good),
+                           'mean_margin':float(np.mean([r['margin'] for r in good])) if good else None,
+                           'world95':ci}
+        h = groups['m26']
+        passed = (h['n']==h['valid']==32 and h['worlds']==16 and h['points']/32>=.65 and h['mean_margin']>0 and h['world95'][0]>0
+                  and all(groups[o]['n']==groups[o]['valid']==16 and groups[o]['worlds']==8 for o in ('tetsu','ozer44')))
+        result['variants'][variant] = {'opponents':groups, 'pass':bool(passed)}
+    (OUT/'summary.json').write_text(json.dumps(result,indent=2))
+    print(json.dumps(result,indent=2))
+
+
+if __name__ == '__main__':
+    main()

diff --git a/lab/t047/README.md b/lab/t047/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..2bb6298528425f93e86e290199f85aa54ad4140c
--- /dev/null
+++ b/lab/t047/README.md
@@ -0,0 +1,21 @@
+# T047 — m26, три независимых изменения
+
+Никакого обучения или Kaggle submit. Исходный m26 копируется побайтно.
+
+- `terminal`: ровно T045 t718 liquidation, только последний рыночный ход.
+- `a1`: native urgent FEED резервирует своего работника в HG.
+- `dsm75_mg25`: тот же ансамбль весов, weighted log-prob смесь DSM 75% / MG 25%; четыре члена, веса .375/.375/.125/.125. Новые члены разделяют веса с родителями, отдельны только one-hot tv.
+
+Python: `/workspace/solution_kaggri/.venv/bin/python`.
+
+```bash
+python lab/t047/build.py
+python lab/t047/check.py
+python lab/t047/gate.py --workers 11
+python lab/t047/summarize.py
+python lab/t047/loader_smoke.py
+```
+
+`loader_smoke.py` запускать после завершения основного пула. Артефакты: `/workspace/shared/runs/t047_m26_post/`. Полные 192 игры: 16 новых миров × 2 места против m26 и 8 других новых миров × 2 места против каждого tetsu/ozer44, каждый вариант. Никаких identity shortcuts. Всего 100000 world bootstrap resamples, двусторонний percentile 95% CI. PASS требует >=65% h2h points, положительный mean margin и нижнюю границу CI>0, полный объём/0 ошибок во всех трёх матчапах. Проверки учитывают скрытые BC/HG/terminal fallback errors и временной бюджет обоих игроков.
+
+Код сохраняет исходные fallback. Terminal при исключении возвращает действие родителя. Любое такое исключение дисквалифицирует локальный гейт.
