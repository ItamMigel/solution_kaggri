+        existing=[json.loads(x) for x in (SHARED/'ledger.jsonl').read_text().splitlines() if x.strip()]
+        assert not any(r.get('task')=='T047' for r in existing), 'Ledger already written'
+        with (SHARED/'ledger.jsonl').open('a') as f:
