+    (SHARED/'research/t047_m26_post.md').write_text('\n'.join(rows)+'\n')
+    if a.ledger:
+        mf=json.loads((HERE/'manifest.json').read_text())
+        now=datetime.datetime.now(datetime.timezone.utc).isoformat()
