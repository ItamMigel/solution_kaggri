@@ -0,0 +1,20 @@
+"""Unchanged m26 controls on the already fixed sanity worlds; no retuning."""
+import json
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from gate import game, OUT
+
+
+if __name__=='__main__':
+    rows=[]
+    jobs=[('m26',o,s,p) for s in range(93047101,93047109) for o in ('tetsu','ozer44') for p in (0,1)]
+    path=OUT/'sanity_control.jsonl'
+    assert not path.exists()
+    with path.open('w') as f, ProcessPoolExecutor(max_workers=11) as pool:
+        futures=[pool.submit(game,j) for j in jobs]
+        for fut in as_completed(futures):
+            r=fut.result()
+            rows.append(r)
+            f.write(json.dumps(r)+'\n')
+            f.flush()
+            print(len(rows), '/32',r['opp'],r['seed'],r['seat'],r.get('margin'),r['valid'],flush=True)
+    assert len(rows)==32 and all(r['valid'] for r in rows)
diff --git a/lab/t047/summarize.py b/lab/t047/summarize.py
new file mode 100644
index 0000000000000000000000000000000000000000..b4a188868bacff2e7abf865e64d19faa7b184888
--- /dev/null
+++ b/lab/t047/summarize.py
@@ -0,0 +1,65 @@
+"""Frozen whole-world bootstrap; no tuning or optional stopping."""
+import json
+from pathlib import Path
+import numpy as np
+
+OUT = Path('/workspace/shared/runs/t047_m26_post')
+
+
+def main():
+    rows = [json.loads(x) for x in (OUT/'games.jsonl').read_text().splitlines()]
+    manifest = json.loads((OUT/'manifest.json').read_text())
+    keys = [(r['variant'],r['opp'],r['seed'],r['seat']) for r in rows]
+    expected = {tuple(j) for j in manifest['jobs']}
+    assert len(keys)==len(set(keys)) and set(keys)<=expected
+    result = {'records':len(rows), 'complete':set(keys)==expected,
+              'errors':sum(not r['valid'] for r in rows), 'variants':{}}
+    for variant in ('terminal','a1','dsm75_mg25'):
+        groups = {}
+        for opp in ('m26','tetsu','ozer44'):
+            rr = [r for r in rows if r['variant']==variant and r['opp']==opp]
+            good = [r for r in rr if r['valid']]
+            seeds = sorted({r['seed'] for r in good})
+            worlds = [[r for r in good if r['seed']==s] for s in seeds]
+            complete = [x for x in worlds if len(x)==2 and {r['seat'] for r in x}=={0,1}]
+            ci = None
+            if complete:
+                means = np.array([np.mean([r['margin'] for r in x]) for x in complete])
+                rng = np.random.default_rng(47020260930)
+                boot = means[rng.integers(len(means),size=(100000,len(means)))].mean(1)
+                ci = list(map(float,np.quantile(boot,[.025,.975])))
+            groups[opp] = {'n':len(rr), 'valid':len(good), 'worlds':len(complete),
+                           'points':sum(r['points'] for r in good),
+                           'wins':sum(r['margin']>0 for r in good),
+                           'draws':sum(r['margin']==0 for r in good),
+                           'losses':sum(r['margin']<0 for r in good),
+                           'mean_margin':float(np.mean([r['margin'] for r in good])) if good else None,
+                           'world95':ci}
+        h = groups['m26']
+        passed = (h['n']==h['valid']==32 and h['worlds']==16 and h['points']/32>=.65 and h['mean_margin']>0 and h['world95'][0]>0
+                  and all(groups[o]['n']==groups[o]['valid']==16 and groups[o]['worlds']==8 for o in ('tetsu','ozer44')))
+        result['variants'][variant] = {'opponents':groups, 'pass':bool(passed)}
+    control_path=OUT/'sanity_control.jsonl'
+    if control_path.exists():
+        control=[json.loads(x) for x in control_path.read_text().splitlines()]
+        if len(control)==32:
+            assert all(r['valid'] for r in control)
+            lookup={(r['opp'],r['seed'],r['seat']):r for r in control}
+            assert len(lookup)==32
+            result['sanity_control']={}
+            for opp in ('tetsu','ozer44'):
+                cr=[r for r in control if r['opp']==opp]
+                assert len(cr)==16
+                result['sanity_control'][opp]={'n':16,'points':sum(r['points'] for r in cr),
+                                              'mean_margin':float(np.mean([r['margin'] for r in cr]))}
+                for variant,stats in result['variants'].items():
+                    rr=[r for r in rows if r['variant']==variant and r['opp']==opp and r['valid']]
+                    delta=[r['margin']-lookup[(opp,r['seed'],r['seat'])]['margin'] for r in rr]
+                    stats['opponents'][opp]['delta_vs_parent_margin']=float(np.mean(delta))
+                    stats['opponents'][opp]['delta_vs_parent_points']=sum(r['points']-lookup[(opp,r['seed'],r['seat'])]['points'] for r in rr)
+    (OUT/'summary.json').write_text(json.dumps(result,indent=2))
+    print(json.dumps(result,indent=2))
+
+
+if __name__ == '__main__':
+    main()

