CROP_MAX_YIELD = [6, 4, 4, 4, 6]
CROP_ONGOING = [0, 0, 1, 1, 0]
# WATER bonus window: (max_yield_day + 1) // 2 <= age <= max_yield_day
CROP_WATER_WINDOW_START = [(m + 1) // 2 for m in CROP_MAX_YIELD_DAY]

