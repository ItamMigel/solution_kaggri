+    def _rival_mature_supply(self, view, step, horizon):
+        """Conservative public-farm supply estimate, without guessing actions.
+
+        Positive ``yield_units`` is already harvestable; for a zero-yield tile we
+        count only one unit if its documented first-yield day arrives within the
+        short sale horizon.  The latter is deliberately a lower bound because
+        watering/feeding and the opponent's path remain unknown.
+        """
+        day, hour = divmod(step, self.cfg["turns_per_day"])
+        last_day = day + (hour + horizon) // self.cfg["turns_per_day"]
+        crop_first = {"STRAWBERRY": 10, "MELON": 10}
+        animal_first = {"COW": 8, "SHEEP": 6}
+        animal_product = {"COW": "MILK", "SHEEP": "WOOL"}
+        actual, imminent = {}, {}
+        for row in view.rival_tiles:
+            for tile in row or []:
+                if not isinstance(tile, dict):
+                    continue
+                crop, animal = _get(tile, "crop"), _get(tile, "animal")
+                item = crop if crop in crop_first else animal_product.get(animal)
+                if item not in FRONT_RUN_ITEMS:
+                    continue
+                yield_now = max(0, _int(_get(tile, "yield_units", 0)))
+                if yield_now:
+                    actual[item] = actual.get(item, 0) + yield_now
+                    continue
+                placed = _int(_get(tile, "planted_day", _get(tile, "placed_day", _get(tile, "day0", 10**6))), 10**6)
+                first = crop_first.get(crop, animal_first.get(animal, 10**6))
+                if placed + first <= last_day:
+                    imminent[item] = imminent.get(item, 0) + 1
+        return actual, imminent
+
+    def _opponent_harvest_forecast(self, action, view, history, projected, route, step, next_sup):
+        """Advance an already planned sale before public rival supply can land.
+
+        A rival cash increase is the only behavioural signal used: it proves a
+        recent opponent sale (rather than assuming every mature farm dumps).  No
+        order is added unless (a) the rival currently exposes a material mature
+        volume, (b) that sale signal is recent, and (c) our route itself sells
+        the same item within 12 turns.  Unit actions, buys and route selection
