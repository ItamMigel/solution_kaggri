+    def _rival_mature_supply(self, view, step, horizon):
+        """Conservative public-farm supply estimate, without guessing actions.
+
+        Positive ``yield_units`` is already harvestable; for a zero-yield tile we
+        count only one unit if its documented first-yield day arrives within the
+        short sale horizon.  The latter is deliberately a lower bound because
+        watering/feeding and the opponent's path remain unknown.
+        """
+        day, hour = divmod(step, self.cfg["turns_per_day"])
+        last_day = day + (hour + horizon) // self.cfg["turns_per_day"]
+        crop_first = {"STRAWBERRY": 10, "MELON": 10}
+        animal_first = {"COW": 8, "SHEEP": 6}
+        animal_product = {"COW": "MILK", "SHEEP": "WOOL"}
+        actual, imminent = {}, {}
+        for row in view.rival_tiles:
+            for tile in row or []:
+                if not isinstance(tile, dict):
+                    continue
+                crop, animal = _get(tile, "crop"), _get(tile, "animal")
+                item = crop if crop in crop_first else animal_product.get(animal)
+                if item not in FRONT_RUN_ITEMS:
+                    continue
+                yield_now = max(0, _int(_get(tile, "yield_units", 0)))
+                if yield_now:
+                    actual[item] = actual.get(item, 0) + yield_now
+                    continue
+                placed = _int(_get(tile, "planted_day", _get(tile, "placed_day", _get(tile, "day0", 10**6))), 10**6)
+                first = crop_first.get(crop, animal_first.get(animal, 10**6))
+                if placed + first <= last_day:
+                    imminent[item] = imminent.get(item, 0) + 1
+        return actual, imminent
+
+    def _opponent_harvest_forecast(self, action, view, history, projected, route, step, next_sup):
+        """Advance an already planned sale before public rival supply can land.
+
+        A rival cash increase is the only behavioural signal used: it proves a
+        recent opponent sale (rather than assuming every mature farm dumps).  No
+        order is added unless (a) the rival currently exposes a material mature
+        volume, (b) that sale signal is recent, and (c) our route itself sells
+        the same item within 12 turns.  Unit actions, buys and route selection
+        are untouched.
+        """
+        prev_money = history.get("money")
+        if prev_money is not None and view.rival is not None:
+            # Money can rise only through a successful SELL in the normal game.
+            # Keep the evidence window short so opening income cannot trigger it.
+            if float(_get(view.rival, "money", 0.0) or 0.0) > prev_money + 100:
+                history["seller_until"] = step + 48
+        history["money"] = float(_get(view.rival, "money", 0.0) or 0.0)
+        if step >= history.get("seller_until", -1):
+            return
+        horizon = 12
+        mature, imminent = self._rival_mature_supply(view, step, horizon)
+        # Current yield is trusted.  A first-yield-date-only forecast requires
+        # two independent tiles because their feed/water state is unobserved.
+        supply = {item: mature.get(item, 0) + (imminent.get(item, 0) if imminent.get(item, 0) >= 2 else 0)
+                  for item in FRONT_RUN_ITEMS}
+        minimum = {"STRAWBERRY": 8, "MELON": 6, "MILK": 5, "WOOL": 5}
+        tape = self.routes[route]
+        already = {o[1] for o in action.get("market") or [] if o and o[0] == "SELL" and len(o) > 1}
+        for due in range(step + 1, min(step + horizon + 1, len(tape))):
+            future = tape[due] if isinstance(tape[due], dict) else {}
+            for order in future.get("market") or []:
+                if not (order and order[0] == "SELL" and len(order) >= 3):
+                    continue
+                item = order[1]
+                if item not in FRONT_RUN_ITEMS or item in already or supply.get(item, 0) < minimum[item]:
+                    continue
+                if (next_sup.get("scheduled", {}).get(due, {}) or {}).get(item, 0):
+                    continue
+                qty = min(max(0, _int(order[2])), projected.get(item, 0), supply[item])
+                if qty <= 0 or view.prices.get(item, 0) < self.cfg["min_sell_price"]:
+                    continue
+                if not self._add_sell(action, item, qty, self.cfg["max_orders"], merge=False):
+                    return
+                projected[item] -= qty
+                already.add(item)
+                pending = next_sup.setdefault("scheduled", {}).setdefault(due, {})
+                pending[item] = pending.get(item, 0) + qty
+
