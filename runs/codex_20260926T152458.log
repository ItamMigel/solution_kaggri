+    def _rival_mature_supply(self, view, step, horizon):
+        """Conservative public-farm supply estimate, without guessing actions.
+
+        Positive ``yield_units`` is already harvestable; for a zero-yield tile we
+        count only one unit if its documented first-yield day arrives within the
+        short sale horizon.  The latter is deliberately a lower bound because
+        watering/feeding and the opponent's path remain unknown.
+        """
+        day, hour = divmod(step, self.cfg["turns_per_day"])
+        last_day = day + (hour + horizon) // self.cfg["turns_per_day"]
+        crop_first = {"STRAWBERRY": 10, "MELON": 10}
+        animal_first = {"COW": 8, "SHEEP": 6}
+        animal_product = {"COW": "MILK", "SHEEP": "WOOL"}
+        actual, imminent = {}, {}
+        for row in view.rival_tiles:
+            for tile in row or []:
+                if not isinstance(tile, dict):
