+        if name not in rows:
+            raise RuntimeError(f"unexpected candidate in compare output: {name}")
+        seat = d["seat"]
+        margin = d["rewards"][seat] - d["rewards"][1 - seat]
+        rows[name].setdefault(opponent, []).append((1.0 if margin > 0 else .5 if margin == 0 else 0.0) + margin / 40000)
