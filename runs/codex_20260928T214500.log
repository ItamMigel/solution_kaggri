+                    byday[(key, name, e["day"], e["op"], e["item"])]["units"] += 1
+                    byday[(key, name, e["day"], e["op"], e["item"])]["cash"] += sign * e["price"]
+                    byday[(key, name, e["day"], e["op"], e["item"])]["price_sum"] += e["price"]
