+        if len(farms) >= 2:
+            refs.clear(); refs.update({id(farms[0]): 0, id(farms[1]): 1})
+        return original[3](state, env)
+
+    K._commit_unit, K._do_hire, K._do_buy_land, K.interpreter = commit, hire, land, interp
