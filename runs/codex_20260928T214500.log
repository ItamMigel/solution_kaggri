+        else: out[e["kind"]] += e["money_delta"]
+    out["initial"] = 3000.0
+    out["final"] = game["final"][pid]
+    out["residual"] = out["final"] - sum(v for k, v in out.items() if k not in ("final", "residual"))
+    return dict(out)
+
+
+def summarise(games):
