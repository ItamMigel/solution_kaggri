+        for day in range(30):
+            items={e['item'] for es in g['events'] for e in es if e['kind']=='market' and e['day']==day}
+            for it in items:
+                x=[[e for e in es if e['kind']=='market' and e['day']==day and e['item']==it] for es in g['events']]
