P='/workspace/shared/research/re/boey.jsonl.gz'
with gzip.open(P,'rt') as f:R=[json.loads(x) for x in f]
# split trajectories at each step==0, preserving duplicate numeric ids
E=[]; cur=[]
for r in R:
 if r['step']==0 and cur: E.append(cur);cur=[]
 cur.append(r)
if cur:E.append(cur)
print('trajectories',len(E),'lengths',collections.Counter(map(len,E)))
C=['STRAWBERRY','CARROT','MELON','TOMATO','WHEAT']; O=['PLANT','WATER','HARVEST','CARE','FEED','FERTILIZE','COLLECT_FERTILIZER']
tr=E[:86]; va=E[86:]
# training calendar modal counts: exact (day,hour) since shops depends macro and changes mid-game
D=collections.defaultdict(lambda:collections.defaultdict(collections.Counter))
for ep in tr:
 for r in ep:
  k=(r['day'],r['hour'])
  for o in O:D[k][o][r['ops'].get(o,0)]+=1
M={k:{o:v[o].most_common(1)[0][0] for o in O} for k,v in D.items()}
print('\\nHELDOUT calendar-rule counts, trajectories 87-108')
for o in O:
 ys=[]; ps=[]
 for ep in va:
  for r in ep:
   ys.append(r['ops'].get(o,0));ps.append(M[(r['day'],r['hour'])][o])
 print(o,'presence_acc',f'{sum((a>0)==(b>0) for a,b in zip(ys,ps))/len(ys):.3f}','exact_count',f'{sum(a==b for a,b in zip(ys,ps))/len(ys):.3f}','mae',f'{sum(abs(a-b) for a,b in zip(ys,ps))/len(ys):.3f}','actual_active',f'{sum(a>0 for a in ys)/len(ys):.3f}')
# operating co-occurrence and equal counts
allr=[r for ep in E for r in ep]
for a,b in [('CARE','FEED'),('CARE','COLLECT_FERTILIZER'),('FEED','COLLECT_FERTILIZER'),('WATER','HARVEST'),('HARVEST','PLANT')]:
 z=[r for r in allr if r['ops'].get(a,0)>0 or r['ops'].get(b,0)>0]
 print(a,b,'either',len(z),'both',sum(r['ops'].get(a,0)>0 and r['ops'].get(b,0)>0 for r in z)/len(z),'equalcount',sum(r['ops'].get(a,0)==r['ops'].get(b,0) for r in z)/len(z))
# daily starts/medians, TRAIN only; daily max event positive deltas within each traj
print('\\nTRAIN daily start medians [crops; herd; pasture/coop; fertile]:')
for d in range(30):
 rr=[r for ep in tr for r in ep if r['day']==d and r['hour']==0]
 def md(fn):return int(statistics.median([fn(r) for r in rr]))
 crops='/'.join(str(md(lambda r,c=c:r['me']['tiles'].get('plant_'+c,0))) for c in C)
 herd='/'.join(str(md(lambda r,a=a:r['me']['animals'].get(a,0))) for a in ['COW','SHEEP','GOOSE'])
 print(f'd{d:02}: {crops}; {herd}; {md(lambda r:r[\"me\"][\"structs\"].get(\"PASTURE\",0))}/{md(lambda r:r[\"me\"][\"structs\"].get(\"COOP\",0))}; f{md(lambda r:r[\"me\"][\"fert_tiles\"])}')
# sum positive add change by day, per trajectory then median / % event
print('\\nPLANT add schedule train (median positive net addition among all 86 games; episodes with add):')
for d in range(29):
 arr={c:[] for c in C}
 for ep in tr:
  sums={c:0 for c in C}
  for a,b in zip(ep,ep[1:]):
   if a['day']==d:
    for c in C:sums[c]+=max(0,b['me']['tiles'].get('plant_'+c,0)-a['me']['tiles'].get('plant_'+c,0))
  for c in C:arr[c].append(sums[c])
 s=' '.join(f'{c[:3]}={int(statistics.median(v))}({sum(x>0 for x in v)}/{len(v)})' for c,v in arr.items() if sum(v))
 print('d',d,s)
# one state-condition: allocation chain independent of phase, only cases total animals>0: average ops per turn by animal bins and plant ripe bins
print('\\nops mean by totals at observed row')
for lab,pred in [('animal=0',lambda r:sum(r['me']['animals'].values())==0),('animal1-9',lambda r:0<sum(r['me']['animals'].values())<10),('animal10+',lambda r:sum(r['me']['animals'].values())>=10),('ripe>=20',lambda r:sum(r['me']['ripe'].values())>=20),('fert<plants/2',lambda r:r['me']['fert_tiles']<sum(v for k,v in r['me']['tiles'].items() if k.startswith('plant_'))/2)]:
 rr=[r for r in allr if pred(r)]
