import gzip,json,collections,statistics
team='dsm'; P=f'/workspace/shared/research/re/{team}.jsonl.gz'
with gzip.open(P,'rt') as f:R=[json.loads(x) for x in f]
E=[];cur=[]
for r in R:
 if r['step']==0 and cur:E.append(cur);cur=[]
 cur.append(r)
if cur:E.append(cur)
print(team,'rows',len(R),'trajectories',len(E),collections.Counter(map(len,E)))
C=['STRAWBERRY','CARROT','MELON','TOMATO','WHEAT']; O=['PLANT','WATER','HARVEST','CARE','FEED','FERTILIZE','COLLECT_FERTILIZER']
n=int(len(E)*.8);tr=E[:n];va=E[n:];D=collections.defaultdict(lambda:collections.defaultdict(collections.Counter))
for ep in tr:
 for r in ep:
  for o in O:D[(r['day'],r['hour'])][o][r['ops'].get(o,0)]+=1
M={k:{o:x[o].most_common(1)[0][0]for o in O}for k,x in D.items()}
print('heldout',len(va),'exact/pres/mae')
for o in O:
 y=[r['ops'].get(o,0) for ep in va for r in ep];p=[M[(r['day'],r['hour'])][o]for ep in va for r in ep]
 print(o,round(sum(a==b for a,b in zip(y,p))/len(y),3),round(sum((a>0)==(b>0)for a,b in zip(y,p))/len(y),3),round(sum(abs(a-b)for a,b in zip(y,p))/len(y),3))
print('daily d crop(S/C/M/T/W) herd(C/S/G) P/CO fert')
for d in range(30):
 rr=[r for ep in tr for r in ep if r['day']==d and r['hour']==0]
 def md(fn):return int(statistics.median([fn(r)for r in rr]))
 cs='/'.join(map(str,[md(lambda r,c=c:r['me']['tiles'].get('plant_'+c,0))for c in C]));hs='/'.join(map(str,[md(lambda r,a=a:r['me']['animals'].get(a,0))for a in ['COW','SHEEP','GOOSE']]))
 print(d,cs,hs,f'{md(lambda r:r[\"me\"][\"structs\"].get(\"PASTURE\",0))}/{md(lambda r:r[\"me\"][\"structs\"].get(\"COOP\",0))}',md(lambda r:r['me']['fert_tiles']))
print('event coverage')
for d in range(29):
 out=[]
 for c in C:
  vals=[]
  for ep in tr:
   z=sum(max(0,b['me']['tiles'].get('plant_'+c,0)-a['me']['tiles'].get('plant_'+c,0)) for a,b in zip(ep,ep[1:])if a['day']==d)
   if z:vals.append(z)
  if vals:out.append(f'{c[:3]} {len(vals)}/{n} med{int(statistics.median(vals))}')
 if out:print(d,'; '.join(out))
allr=[r for ep in E for r in ep]
for tag,pr in [('herd>=10',lambda r:sum(r['me']['animals'].values())>=10),('herd1-9',lambda r:0<sum(r['me']['animals'].values())<10)]:
 x=[r for r in allr if pr(r)];print(tag,'n',len(x),' '.join(f'{o}={sum(r[\"ops\"].get(o,0) for r in x)/len(x):.2f}'for o in O))
