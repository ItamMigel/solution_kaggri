+# T036 — production reverse engineering
+
+Owner: codex. Scope: infer explicit, teacher-forced production rules from `research/re/*.jsonl.gz` for Boey, M&M&P&Q, DSM, and fuxi: crop/planting/fertilizer policy; per-turn unit allocation and priority; herd/structure timeline. Excludes market and macro decision logic (Claude).
+
+Method: use state/action decision logs, derive state-gated rules on a development episode subset, and report held-out action agreement by rule and action class. Record episode identifiers and coverage; avoid claiming a rule where action fields do not expose the needed state.
+
+Status: in progress. No candidate, gate, training, or Kaggle submission action.

exec
/bin/bash -lc "/workspace/solution_kaggri/.venv/bin/python - <<'PY'
import gzip,json,glob,collections
configs=[('mmpq','/workspace/shared/replays/top10v4/mmpq/*.gz','M & M & P & Q'),('dsm','/workspace/shared/replays/top10v4/dsm/*.gz','DSM'),('fuxi','/workspace/shared/replays/reactive/fuxi/*.gz','fuxi')]
for label,pat,name in configs:
 rows=[];eps=0
 for f in sorted(glob.glob(pat))[:10]:
  d=json.load(gzip.open(f,'rt'));names=d['info'].get('TeamNames',[])
  if name not in names:continue
  eps+=1;p=names.index(name)
  for t in range(len(d['steps'])-1):
   ob=d['steps'][t][p]['observation'];a=d['steps'][t+1][p].get('action')or{};us=[a.get('farmer')]+list(a.get('hands')or[]);ps=[ob['farms'][p]['farmer']]+list(ob['farms'][p]['hands'])
   for x,xy in zip(us,ps):
    if x and x[0]=='PLANT':rows.append((ob['day'],x[1],tuple(xy)))
 print('\\n',label,'eps',eps)
 for d in [0,2,3,4,6,8]:
  z=[x for x in rows if x[0]==d]
  print('d',d,'crop',dict(collections.Counter(x[1]for x in z)),'pos',collections.Counter((x[2],x[1])for x in z).most_common(12))
