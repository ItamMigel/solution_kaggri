import gzip,json,glob,collections,os
fam='mmpq';team='M & M & P & Q';rec=[]
for f in glob.glob(f'/workspace/shared/replays/top10v4/{fam}/*.gz'):
 d=json.load(gzip.open(f,'rt'));p=d['info']['TeamNames'].index(team)
 acts=[d['steps'][t+1][p].get('action') or {} for t in range(264)]
 units=[json.dumps({'farmer':a.get('farmer',['PASS']),'hands':a.get('hands',[])},sort_keys=True,separators=(',',':')) for a in acts]
 rec.append((f,d,p,units))
n=len(rec);print('n',n)
for day in range(8):
 lo=day*24; per=[collections.Counter(x[3][t] for x in rec).most_common(1)[0][1] for t in range(lo,lo+24)]; seq=collections.Counter(tuple(x[3][lo:lo+24]) for x in rec)
 print('day',day,'modal-day',seq.most_common(1)[0][1],'exact',sum(z==n for z in per),'mean',round(sum(per)/24,2),'min',min(per))
sup=[collections.Counter(x[3][t] for x in rec).most_common(1)[0][1] for t in range(192)]
for q in [100,99,95,90,75,50]:
 t=next((i for i,v in enumerate(sup) if v<q),None); print('support',q,'first-below',t, None if t is None else f'd{t//24}h{t%24}')
print('initial modes:')
for t in range(16):
 c=collections.Counter(x[3][t] for x in rec); print(t,c.most_common(1)[0][1],json.loads(c.most_common(1)[0][0]))
# map signature at d10 end/start d11 state step264

def sig(ob,p):
 farm=ob['farms'][p]; out=[]
 for y,row in enumerate(farm['tiles']):
  for x,z in enumerate(row):
   if isinstance(z,dict):out.append((x,y,z.get('kind'),z.get('animal'),z.get('crop')))
 return tuple(out)
cs=collections.Counter(sig(d['steps'][264][p]['observation'],p) for _,d,p,_ in rec); print('d11-start modal map',cs.most_common(1)[0][1], 'variants',len(cs))
modal=cs.most_common(1)[0][0]; e=next((x for x in rec if sig(x[1]['steps'][264][x[2]]['observation'],x[2])==modal));f,d,p,u=e
print('representative',os.path.basename(f),d['info']['seed'])
for day in range(7,12):
 ob=d['steps'][day*24][p]['observation']; farm=ob['farms'][p]; arr=[]
 for y,row in enumerate(farm['tiles']):
  for x,z in enumerate(row):
   if isinstance(z,dict):
    label=(z.get('animal') or z.get('crop') or z.get('kind','?')[0])
    arr.append(f'{x},{y}:{z.get(\"kind\")[0]}-{label}')
 print('D',day,'q',farm['unlocked_quadrants'],'money',round(farm['money']),' | ',' '.join(arr))
print('GOOSE build/pickup/place + FEED events d7-d11 representative')
for t in range(168,264):
 a=d['steps'][t+1][p].get('action') or {}; ob=d['steps'][t][p]['observation']; farm=ob['farms'][p]; workers=[a.get('farmer') or ['PASS'],*(a.get('hands') or [])]; pos=[farm['farmer'],*farm['hands']]
 ev=[]
 for i,(cmd,xy) in enumerate(zip(workers,pos)):
  if cmd and (cmd[0] in ('FEED','BUILD_COOP') or (len(cmd)>1 and cmd[1]=='GOOSE')):
   tile=farm['tiles'][xy[1]][xy[0]];ev.append((i,xy,cmd, tile.get('kind') if isinstance(tile,dict) else tile,tile.get('animal') if isinstance(tile,dict) else None,ob['private']['inventories'][i]))
 mo=[x for x in a.get('market',[]) if len(x)>1 and (x[1]=='GOOSE' or x[0]=='BUY_LAND')]
 if ev or mo: print(t,f'd{t//24}h{t%24}','market',mo,'events',ev)
