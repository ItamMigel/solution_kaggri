     if z.get('kind')=='COOP':g.append((x,y,z.get('animal')))
     elif z.get('kind')=='PLANT' and z.get('crop')=='WHEAT':w.append((x,y))
     elif z.get('kind')=='PLANT' and z.get('crop')=='STRAWBERRY':s.append((x,y))
  print('start-d',day,'quads',farm['unlocked_quadrants'],'coop',g,'W',w,'S',s)
