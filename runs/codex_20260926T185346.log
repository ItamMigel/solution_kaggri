import gzip,json,glob,collections,os
teams={'dsm':'DSM','mmpq':'M & M & P & Q'}
for fam,team in teams.items():
 rows=[]
 for f in glob.glob(f'/workspace/shared/replays/top10v4/{fam}/*.gz'):
  d=json.load(gzip.open(f,'rt'));p=d['info']['TeamNames'].index(team)
  a=[d['steps'][t+1][p].get('action') or {} for t in range(216)]
  unit=[json.dumps({'farmer':x.get('farmer',['PASS']),'hands':x.get('hands',[])},sort_keys=True,separators=(',',':')) for x in a]
  market=[json.dumps(x.get('market',[]),separators=(',',':')) for x in a]
  rows.append((unit,market,os.path.basename(f)))
 n=len(rows);print('\\n###',fam,n)
 for day in range(9):
  lo,hi=day*24,(day+1)*24
  joint=sum(1 for r in rows if r[0][lo:hi]==rows[0][0][lo:hi]) # vs ep0
  per=[collections.Counter(r[0][t] for r in rows).most_common(1)[0][1] for t in range(lo,hi)]
  full=collections.Counter(tuple(r[0][lo:hi]) for r in rows).most_common(1)
  identical_steps=sum(x==n for x in per)
  print('d',day,'mode day seq',full[0][1],'/n variants',len(full),'exact steps',identical_steps,'mean modal',round(sum(per)/24,1),'min',min(per),'firstweak', next((lo+i for i,x in enumerate(per) if x<n),None))
 # exact shared prefix units
 for t in range(216):
  c=collections.Counter(r[0][t] for r in rows); m=c.most_common(1)[0][1]
  if m<n:
   print('unit first nonunanimous t',t,'d/h',t//24,t%24,'support',m,'variants',len(c));break
 # detailed nonunanimous keys early and majority variants
 for t in range(216):
  c=collections.Counter(r[0][t] for r in rows)
  if c.most_common(1)[0][1]<n and t<192:
   print(' t',t, f'{t//24}:{t%24}',c.most_common(2));
