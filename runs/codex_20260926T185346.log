def _e334_compact(obs,action):
    market=action.get('market') or []
    if int(obs['step'])<144 or len(market)<2:return action
    segments=[];i=0
    while i<len(market):
        if len(market[i])>=3 and market[i][0]=='SELL' and market[i][1] in _E334_ITEMS:
            j=i+1
            while j<len(market) and len(market[j])>=3 and market[j][0]=='SELL' and market[j][1] in _E334_ITEMS:j+=1
            if j-i>=2:segments.append((i,j))
            i=j
        else:i+=1
    if not segments:return action
    _,private=_r127_fields(obs,action);remaining=dict(private['shed']);new=[list(o) for o in market];removed=0
    for start,end in segments:
        quantities={};order=[]
        for o in market[start:end]:
            p=o[1]
            if p not in quantities:order.append(p);quantities[p]=0
                total=value+gain;score=total/(n+len(back)+2)**_FD_POWER
                route=commands+walk+[list(o) for o in ops];coords=chosen+(xy,)
                if score>best[0]:best=(score,total,route+back,coords)
                candidates.append((score,xy,n,total,route,coords))
        if not candidates:break
        candidates.sort(key=lambda a:a[0],reverse=True)
        beam=[(xy,n,total,route,coords) for _,xy,n,total,route,coords in candidates[:_FD_WIDTH]]
    return best


def _fd_action(obs,st):
    step=int(obs['step']);seat=int(obs['player']);farm=obs['farms'][seat]
    positions=[farm['farmer'],*farm['hands']];inventories=obs['private']['inventories']
    plans=st['plans']
    # At a completed delivery release its claims; facts come from the new obs.
    for actor in list(plans):
        if not plans[actor]['commands']:del plans[actor]
    reserved={xy for plan in plans.values() for xy in plan['coords']}
    commands=[]
    for actor,pos in enumerate(positions):
        if actor not in plans:
            score,value,route,coords=_fd_route(obs,pos,inventories[actor],reserved)
            plans[actor]=dict(commands=route,coords=coords)
            reserved.update(coords)
            if route:_FD_REPORT['trips']+=1
        command=plans[actor]['commands'].pop(0) if plans[actor]['commands'] else ['PASS']
        commands.append(command)
    action={'farmer':commands[0],'hands':commands[1:],'market':[]}
    # Exact own-unit projection respects decay-independent unit order and shed cap.
    projected,private=_r127_fields(obs,action)
    sales=[['SELL',k,int(n)] for k,n in private['shed'].items() if k in PRODUCTS and n>0]
    sales.sort(key=lambda o:-(obs['market']['prices'].get(o[1],0)*o[2]))
    action['market']=sales
    # Auction new labor against unreserved, currently visible profitable trips.
    cash=projected['money'];hired=int(farm.get('hires_today',0));added=0
    occupied=[projected['farmer'],*projected['hands']]
    while step<710 and hired+added<_FD_MAX_HIRES and len(action['market'])<10 and added<6:
        pos=min(_FD_HOME,key=lambda h:(sum(tuple(p)==h for p in occupied),_FD_HOME.index(h)))
        _,value,route,coords=_fd_route(obs,pos,{},reserved,step+1)
        cost=_y_fib(hired+added)
        if not route or value<cost*_FD_HIRE_RATIO or cash<cost:break
        actor=len(positions)+added
        plans[actor]=dict(commands=route,coords=coords)
        reserved.update(coords);occupied.append(pos);cash-=cost;added+=1
        action['market'].append(['HIRE'])
        _FD_REPORT['hires']+=1
    # Existing quote-order optimizer only permutes contiguous SELL blocks.
    if len(sales)>1:action=_v44y_reorder(obs,action)
    return action


def agent(observation,configuration=None):
    step=int(observation['step']);seat=int(observation['player'])
    if step<696:return _FD_PARENT(observation,configuration)
    begun=_fd_time.perf_counter()
    st=_FD_STATE.get(seat)
    if st is None or step<=st['last']:st=_FD_STATE[seat]=dict(last=-1,plans={})
    st['last']=step
    try:return _fd_action(observation,st)
    except Exception:
        _FD_REPORT['errors']+=1
        raise
    finally:_FD_REPORT['max_ms']=max(_FD_REPORT['max_ms'],(_fd_time.perf_counter()-begun)*1000)

