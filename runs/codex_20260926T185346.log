_WM = {'wm_on': True, 'wm_buy_day0': 6, 'wm_buy_day1': 17, 'wm_buy_price_max': 30, 'wm_feed_floor': 20, 'wm_buy_cap': 8, 'wm_cash_reserve': 2000, 'wm_sell_day0': 10, 'wm_sell_day1': 28, 'wm_sell_price_min': 40, 'wm_sell_reserve': 35, 'wm_sell_cap': 8}
