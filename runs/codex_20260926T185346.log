import gzip,json,glob,collections,os
teams={'dsm':'DSM','mmpq':'M & M & P & Q'}
for fam,team in teams.items():
 files=glob.glob('/workspace/shared/replays/top10v4/'+fam+'/*.gz')
 rec=[]
 for f in files:
  d=json.load(gzip.open(f,'rt')); p=d['info']['TeamNames'].index(team)
  acts=[d['steps'][t+1][p].get('action') or {} for t in range(min(193,len(d['steps'])-1))]
  # normalize JSON
  ss=[json.dumps(a,sort_keys=True,separators=(',',':')) for a in acts]
  rec.append((os.path.basename(f),d['info']['seed'],ss,d,p))
 print('\\n###',fam,'n=',len(rec))
 for stop in [24,48,72,96,120,144,168,192]:
  c=collections.Counter(tuple(x[2][:stop]) for x in rec)
  print('prefix steps',stop,'modal',c.most_common(3)[0][1],'unique',len(c))
 # per action modal and support
 for t in range(0,193):
  c=collections.Counter(x[2][t] for x in rec)
  n=c.most_common(1)[0][1]
  if n<len(rec):
   print('first deviation step',t,'dayhour',t//24,t%24,'modal',n,'/',len(rec),'variants',len(c));break
 # Pick globally exact model first prefix d8
 c=collections.Counter(tuple(x[2][:192]) for x in rec); modal=c.most_common(1)[0][0]
 e=next(x for x in rec if tuple(x[2][:192])==modal)
 print('modal early ep/seed',e[0],e[1],'support',c[modal])
 # state layouts start day d1...d11; tile initials and coordinate sets
 d,p=e[3],e[4]
 for day in range(0,12):
  t=day*24
  ob=d['steps'][t][p]['observation']; farm=ob['farms'][p]
  items=collections.defaultdict(list)
  for y,row in enumerate(farm['tiles']):
   for x,z in enumerate(row):
    if isinstance(z,dict):
     if z.get('kind') in ('PASTURE','COOP'):
      items[(z['kind'],z.get('animal') or '-')].append((x,y))
     elif z.get('kind')=='PLANT':items[('P',z['crop'])].append((x,y))
  print('D',day,'money',round(farm['money']),'hands',len(farm['hands']),'quads',farm['unlocked_quadrants'],' | '.join(f'{k}:{v}' for k,v in sorted(items.items())))
