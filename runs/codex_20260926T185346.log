/bin/bash -lc "/workspace/solution_kaggri/.venv/bin/python - <<'PY'
import gzip,json,collections
for fam in ['mmpq','dsm']:
 eps=collections.defaultdict(list)
 with gzip.open('/workspace/shared/research/re/'+fam+'.jsonl.gz','rt') as f:
  for line in f:
   x=json.loads(line);eps[x['ep']].append(x)
 print('\\n',fam,len(eps))
 for event in ['land','goose','straw']:
  out=[]
  for ep,rs in eps.items():
   e=[]
   for r in rs:
    if event=='land': q=sum(1 for o in r['market'] if o and o[0]=='BUY_LAND')
    elif event=='goose':q=sum(int(o[2]) for o in r['market'] if len(o)>2 and o[:2]==['BUY_ANIMAL','GOOSE'])
    else:q=sum(int(o[2]) for o in r['market'] if len(o)>2 and o[:2]==['BUY_SEED','STRAWBERRY'])
    if q:e.append((r['day'],r['hour'],r['step'],q))
   out.append(e)
  print(event,'events dayhour frequency',collections.Counter((d,h,q) for a in out for d,h,s,q in a).most_common(20))
  print(event,'per-game totals',collections.Counter(sum(q for d,h,s,q in a) for a in out).most_common(10))
  print(event,'first',collections.Counter((a[0][0],a[0][1]) if a else None for a in out).most_common(12))
 # daily plants inferred transitions perhaps use state crop count
 for crop in ['STRAWBERRY','WHEAT']:
  plantdays=collections.Counter()
  finaladd=collections.Counter()
  for ep,rs in eps.items():
   byday=collections.defaultdict(list)
   for r in rs:byday[r['day']].append(r)
   for d,dayrs in byday.items():
    n=sum(int(r['ops'].get('PLANT',0)) for r in dayrs) # cannot crop
    # seeds buy only result
    b=sum(int(o[2]) for r in dayrs for o in r['market'] if len(o)>2 and o[:2]==['BUY_SEED',crop])
    if b:plantdays[d]+=1;finaladd[d]+=b
  print('seed-buy',crop,[(d,plantdays[d],finaladd[d]) for d in sorted(plantdays)])
