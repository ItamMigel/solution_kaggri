for fam,team in [('dsm','DSM'),('mmpq','M & M & P & Q')]:
 f=glob.glob(f'/workspace/shared/replays/top10v4/{fam}/*.gz')[0];d=json.load(gzip.open(f,'rt'));p=d['info']['TeamNames'].index(team)
 print('\\n#',fam,os.path.basename(f),d['info']['seed'])
 for t in range(0,264):
  a=d['steps'][t+1][p].get('action') or {}; ob=d['steps'][t][p]['observation'];farm=ob['farms'][p]
  mo=[o for o in a.get('market',[]) if o and (o[0]=='BUY_LAND' or (len(o)>1 and o[1]=='GOOSE'))]
  ev=[];workers=[a.get('farmer') or ['PASS'],*(a.get('hands') or [])];pos=[farm['farmer'],*farm['hands']]
  for i,(c,xy) in enumerate(zip(workers,pos)):
   if c and (c[0]=='BUILD_COOP' or (len(c)>1 and c[1]=='GOOSE')):ev.append((i,xy,c))
  if mo or ev:print(t,f'd{t//24}h{t%24}','M',mo,'U',ev)
 for day in [8,9,10,11]:
  ob=d['steps'][day*24][p]['observation']; farm=ob['farms'][p];g=[];w=[];s=[]
  for y,row in enumerate(farm['tiles']):
   for x,z in enumerate(row):
