import gzip,json,glob,collections
for fam,team in [('mmpq','M & M & P & Q'),('dsm','DSM')]:
 rows=[]
 for f in glob.glob(f'/workspace/shared/replays/top10v4/{fam}/*.gz'):
  d=json.load(gzip.open(f,'rt'));p=d['info']['TeamNames'].index(team)
  a=[d['steps'][t+1][p].get('action') or {} for t in range(192)]
  u=[json.dumps({'farmer':x.get('farmer',['PASS']),'hands':x.get('hands',[])},sort_keys=True,separators=(',',':')) for x in a]
  rows.append(u)
 n=len(rows);print('\\n',fam,n)
 for d in range(8):
  lo=d*24; per=[collections.Counter(r[t] for r in rows).most_common(1)[0][1] for t in range(lo,lo+24)]
  seq=collections.Counter(tuple(r[lo:lo+24]) for r in rows)
  print(f'd{d}: modal full-day sequence {seq.most_common(1)[0][1]}/{n}; exact steps {sum(x==n for x in per)}/24; mean modal support {sum(per)/24:.1f}/{n}; min {min(per)}/{n}')
 # initial high-support uninterrupted route (>=95%)
 support=[collections.Counter(r[t] for r in rows).most_common(1)[0][1] for t in range(192)]
 for threshold in [n, int(.99*n+.999),int(.95*n+.999),int(.9*n+.999)]:
  bad=next((t for t,s in enumerate(support) if s<threshold),None)
  print('threshold',threshold,'first below',bad, (bad//24,bad%24) if bad is not None else None)
 # mode at d0 actions relevant first 15 and exact modal support
 for t in range(16):
  c=collections.Counter(r[t] for r in rows)
  if t==0 or c.most_common(1)[0][1]<n:
   print(t,c.most_common(1)[0][1],json.loads(c.most_common(1)[0][0]))
