def agent(obs, config=None):
    action = _HP_BASE_AGENT(obs, config)
    try:
        if _HP.get("land_on"):
            action = _hp_land(obs, action)
    except Exception:
        pass
    try:
        if not _HP.get("m1_on"):
            return action
        step = int(obs["step"]); day = step // 24
        if not (_HP["m1_day0"] <= day <= _HP["m1_day1"]) or step >= 718:
            return action
        p = int(obs["player"]); farm = obs["farms"][p]; priv = obs.get("private") or {}
        invs = priv.get("inventories") or []
        pos = [farm["farmer"]] + list(farm.get("hands") or [])
        units = [action.get("farmer") or ["PASS"]] + list(action.get("hands") or [])
        allowed = set(_HP["m1_ops"])
        for i, u in enumerate(units):
            if i >= len(pos) or (u and u[0] != "PASS"):
                continue
            x, y = pos[i]
            op = _hp_tile_op(farm["tiles"][y][x], invs[i] if i < len(invs) else {}, day, allowed)
            if op:
                units[i] = op; _HP_STATS["m1_fills"] += 1
        action = dict(action, farmer=units[0], hands=units[1:])
    except Exception:
        pass
    return action

# ================= T031 market-only WHEAT timing layer (lab/hplus/wheat_market.py) =================
_WM = {'wm_on': True, 'wm_buy_day0': 6, 'wm_buy_day1': 17, 'wm_buy_price_max': 30, 'wm_feed_floor': 20, 'wm_buy_cap': 8, 'wm_cash_reserve': 2000, 'wm_sell_day0': 10, 'wm_sell_day1': 28, 'wm_sell_price_min': 40, 'wm_sell_reserve': 35, 'wm_sell_cap': 8}
_WM_PARENT = agent
del agent
_WM_STATS = {"buy_turns": 0, "buy_units": 0, "sell_turns": 0, "sell_units": 0,
             "abstain_parent_wheat": 0, "abstain_slots": 0, "errors": 0}

def agent(obs, config=None):
    action = _WM_PARENT(obs, config)
    if not _WM["wm_on"]:
        return action
    try:
        # No unit-action authority: only make a shallow action copy after a
        # fully qualified market decision; inherited farmer/hands stay intact.
        step = int(obs["step"]); day = step // 24
        if not 0 <= day <= 29 or step >= 718:
            return action
        market = action.get("market") or []
        if len(market) >= 10:
            _WM_STATS["abstain_slots"] += 1
            return action
        if any(isinstance(o, list) and len(o) >= 2 and o[1] == "WHEAT" and o[0] in ("SELL", "BUY_PRODUCT") for o in market):
            _WM_STATS["abstain_parent_wheat"] += 1
            return action
        player = int(obs["player"])
        private = obs.get("private") or {}
        shed = private.get("shed") or {}
        held = max(0, int(shed.get("WHEAT", 0)))
        room = max(0, 100 - sum(max(0, int(v)) for v in shed.values()))
        price = max(1, int((obs.get("market") or {}).get("prices", {}).get("WHEAT", 1)))
        money = max(0, int(obs["farms"][player]["money"]))
        order = None
        # Early cheap physical feed reserve.  The cap/room/cash checks are
        # explicit because BUY_PRODUCT deposits directly into the shared shed.
        if (int(_WM["wm_buy_day0"]) <= day <= int(_WM["wm_buy_day1"]) and price <= int(_WM["wm_buy_price_max"]) and held < int(_WM["wm_feed_floor"])):
            q = min(int(_WM["wm_buy_cap"]), int(_WM["wm_feed_floor"]) - held, room,
                    max(0, (money - int(_WM["wm_cash_reserve"])) // price))
            if q > 0:
                order = ["BUY_PRODUCT", "WHEAT", q]
                _WM_STATS["buy_turns"] += 1; _WM_STATS["buy_units"] += q
        # Only sell owned physical surplus; never replace a parent sale.
        if order is None and (int(_WM["wm_sell_day0"]) <= day <= int(_WM["wm_sell_day1"]) and price >= int(_WM["wm_sell_price_min"]) and held > int(_WM["wm_sell_reserve"])):
            q = min(int(_WM["wm_sell_cap"]), held - int(_WM["wm_sell_reserve"]))
            if q > 0:
                order = ["SELL", "WHEAT", q]
                _WM_STATS["sell_turns"] += 1; _WM_STATS["sell_units"] += q
        if order is None:
            return action
        result = dict(action)
        result["market"] = [list(o) if isinstance(o, list) else o for o in market] + [order]
        return result
    except Exception:
        _WM_STATS["errors"] += 1
        return action

agent.telemetry = _WM_STATS
#!/usr/bin/env python3
"""Official-engine T038 identity and activation audit; never submits."""
from __future__ import annotations

import argparse
import json
from pathlib import Path


def load(path: Path) -> dict:
    ns = {"__file__": str(path), "__name__": f"t038_{path.stem}"}
    exec(compile(path.read_text(), str(path), "exec"), ns)
    return ns


def run(base_path: Path, candidate_path: Path, opponent: Path, seeds: list[int], *, identity: bool) -> list[dict]:
    from kaggle_environments import make

    rows = []
    for seed in seeds:
        base, candidate = load(base_path), load(candidate_path)
        diffs: list[int] = []

        def audited(obs, cfg=None):
            left, right = base["agent"](obs, cfg), candidate["agent"](obs, cfg)
            if json.dumps(left, sort_keys=True, separators=(",", ":")) != json.dumps(right, sort_keys=True, separators=(",", ":")):
                diffs.append(int(obs["step"]))
            return left if identity else right

        env = make("kaggriculture", configuration={"seed": seed}, debug=False)
        env.run([audited, str(opponent)])
        rows.append({"seed": seed, "status": [state.status for state in env.state], "diffs": diffs,
                     "candidate_stats": dict(candidate.get("_OFW_STATS", {})),
                     "reward": [state.reward for state in env.state]})
    return rows


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--base", type=Path, required=True); p.add_argument("--candidate", type=Path, required=True)
    p.add_argument("--opponent", type=Path, required=True); p.add_argument("--seeds", nargs="+", type=int, required=True)
    p.add_argument("--enabled", action="store_true"); p.add_argument("--out", type=Path, required=True)
    a = p.parse_args()
    rows = run(a.base.resolve(), a.candidate.resolve(), a.opponent.resolve(), a.seeds, identity=not a.enabled)
    done = all(row["status"] == ["DONE", "DONE"] for row in rows)
    result = {"mode": "enabled" if a.enabled else "identity", "valid": done,
              "action_identical": not any(row["diffs"] for row in rows), "rows": rows}
    a.out.parent.mkdir(parents=True, exist_ok=True)
    a.out.write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({key: result[key] for key in ("mode", "valid", "action_identical")}))
    if not done or (not a.enabled and not result["action_identical"]):
        raise SystemExit(2)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Official-engine identity/activation audit for T035; never submits."""
from __future__ import annotations

import argparse
import json
from pathlib import Path


def load(path: Path) -> dict:
    ns = {"__file__": str(path), "__name__": f"audit_{path.stem}"}
    exec(compile(path.read_text(), str(path), "exec"), ns)
    return ns


def identity(base_path: Path, candidate_path: Path, opponent: Path, seeds: list[int]) -> list[dict]:
    from kaggle_environments import make
    rows = []
    for seed in seeds:
        base, candidate = load(base_path), load(candidate_path); diffs = []
        def audited(obs, cfg=None):
            left, right = base["agent"](obs, cfg), candidate["agent"](obs, cfg)
            if json.dumps(left, sort_keys=True, separators=(",", ":")) != json.dumps(right, sort_keys=True, separators=(",", ":")):
                diffs.append(int(obs["step"]))
            return left
        env = make("kaggriculture", configuration={"seed": seed}, debug=False)
        env.run([audited, str(opponent)])
        rows.append({"seed": seed, "status": [s.status for s in env.state], "diffs": diffs,
                     "report": dict(candidate.get("_RLN_REPORT", {}))})
    return rows


def activation(candidate_path: Path, opponent: Path, seeds: list[int]) -> list[dict]:
    from kaggle_environments import make
    rows = []
    for seed in seeds:
        candidate = load(candidate_path)
        env = make("kaggriculture", configuration={"seed": seed}, debug=False)
        env.run([candidate["agent"], str(opponent)])
        rows.append({"seed": seed, "status": [s.status for s in env.state],
                     "report": dict(candidate.get("_RLN_REPORT", {})), "rewards": [s.reward for s in env.state]})
    return rows


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--base", type=Path, required=True); p.add_argument("--candidate", type=Path, required=True)
    p.add_argument("--mirror", type=Path, required=True); p.add_argument("--tape", action="append", required=True, metavar="NAME=PATH")
    p.add_argument("--reactive", action="append", required=True, metavar="NAME=PATH"); p.add_argument("--seeds", type=int, nargs="+", required=True)
    p.add_argument("--out", type=Path, required=True)
    a = p.parse_args(); base, cand = a.base.resolve(), a.candidate.resolve()
    def named(value: str) -> tuple[str, Path]:
        name, raw = value.split("=", 1)
        if not name or not Path(raw).is_file(): raise ValueError(f"invalid NAME=PATH: {value}")
        return name, Path(raw).resolve()
    mirrors = identity(base, cand, a.mirror.resolve(), a.seeds)
    tapes = {name: identity(base, cand, path, a.seeds) for name, path in map(named, a.tape)}
    reactive = {name: activation(cand, path, a.seeds) for name, path in map(named, a.reactive)}
    done = lambda rows: all(row["status"] == ["DONE", "DONE"] for row in rows)
    identity_ok = done(mirrors) and not any(r["diffs"] for r in mirrors) and all(done(rows) and not any(r["diffs"] for r in rows) for rows in tapes.values())
    activation_ok = all(done(rows) and all(r["report"].get("nonclone", 0) >= 1 for r in rows) for rows in reactive.values())
    result = {"identity_ok": identity_ok, "activation_ok": activation_ok, "mirror": mirrors, "tapes": tapes, "reactive": reactive}
    a.out.parent.mkdir(parents=True, exist_ok=True); a.out.write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({"identity_ok": identity_ok, "activation_ok": activation_ok}))
    if not (identity_ok and activation_ok): raise SystemExit(2)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Official-engine audit for G1 identity and route completion; never submits."""
from __future__ import annotations

import argparse
import json
from pathlib import Path


def load(path: Path):
    ns = {"__file__": str(path), "__name__": "__g1_audit_agent__"}
    exec(compile(path.read_text(), str(path), "exec"), ns)
    return ns


def geese(obs: dict) -> int:
    farm = obs["farms"][int(obs["player"])]
    return sum(1 for row in farm["tiles"] for tile in row
               if isinstance(tile, dict) and tile.get("animal") == "GOOSE")


def run_identity(base_path: Path, default_path: Path, seeds: list[int]) -> dict:
    from kaggle_environments import make

    all_rows = []
    for seed in seeds:
        base, default = load(base_path), load(default_path)
        mismatches = []

        def audited(obs, cfg=None):
            left = base["agent"](obs, cfg)
            right = default["agent"](obs, cfg)
            if json.dumps(left, sort_keys=True, separators=(",", ":")) != json.dumps(right, sort_keys=True, separators=(",", ":")):
                mismatches.append(int(obs["step"]))
            return left

        env = make("kaggriculture", configuration={"seed": seed}, debug=False)
        env.run([audited, str(base_path)])
        all_rows.append({"seed": seed, "status": [state.status for state in env.state],
                         "calls": len(env.logs), "mismatch_steps": mismatches})
    ok = all(row["status"] == ["DONE", "DONE"] and not row["mismatch_steps"] for row in all_rows)
    return {"ok": ok, "worlds": all_rows}


def run_target(base_path: Path, candidate_path: Path, target: int, seeds: list[int]) -> dict:
    from kaggle_environments import make

    rows = []
    for seed in seeds:
        candidate = load(candidate_path)
        parent = candidate["agent"]
        by_day: list[tuple[int, int]] = []

        def audited(obs, cfg=None):
            if int(obs["step"]) % 24 == 0:
                by_day.append((int(obs["step"]) // 24, geese(obs)))
            return parent(obs, cfg)

        env = make("kaggriculture", configuration={"seed": seed}, debug=False)
        env.run([audited, str(base_path)])
        report = candidate.get("_G1_REPORT", {})
        final_geese = geese(env.state[0].observation)
        rows.append({"seed": seed, "status": [state.status for state in env.state],
                     "daily_geese": by_day, "final_geese": final_geese, "report": report})
    ok = all(row["status"] == ["DONE", "DONE"] and row["report"].get("mismatches") == 0
             and row["report"].get("errors") == 0 and row["report"].get("confirmed_sites") == target
             and row["final_geese"] == target for row in rows)
    return {"ok": ok, "target": target, "worlds": rows}


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", type=Path, required=True)
    parser.add_argument("--default", type=Path, required=True)
    parser.add_argument("--candidate", action="append", default=[], metavar="TARGET=PATH")
    parser.add_argument("--seeds", type=int, nargs="+", required=True)
    parser.add_argument("--out", type=Path, required=True)
    args = parser.parse_args()
    base, default = args.base.resolve(), args.default.resolve()
    result = {"identity": run_identity(base, default, args.seeds), "targets": {}}
    for item in args.candidate:
        raw_target, raw_path = item.split("=", 1)
        target = int(raw_target)
        result["targets"][str(target)] = run_target(base, Path(raw_path).resolve(), target, args.seeds)
    result["ok"] = result["identity"]["ok"] and all(value["ok"] for value in result["targets"].values())
    args.out.parent.mkdir(parents=True, exist_ok=True)
    args.out.write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({"ok": result["ok"], "identity": result["identity"]["ok"],
                      "targets": {key: value["ok"] for key, value in result["targets"].items()}}))
    if not result["ok"]:
        raise SystemExit(2)


if __name__ == "__main__":
    main()

