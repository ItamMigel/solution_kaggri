"""Finite-horizon feed decisions after the final shop is known.

Compare feed/skip continuations for visibly oversupplied cow/sheep products,
including pending care bonuses, starvation and the actual season boundary.
Existing harvest-bearing animals are protected until their crop is collected.
"""
_HH_PARENT=agent
_HH_REPORT=dict(skipped=0,considered=0,errors=0)
_HH_CAP=globals().get('_HH_CAP',40.)
_HH_MARGIN=globals().get('_HH_MARGIN',2.)
_HH_FERT=globals().get('_HH_FERT',1.)
_HH_PROTECT=globals().get('_HH_PROTECT',True)


def _hh_choice(tile,day,product_price,feed_price,fert_price):
    animal=tile['animal'];first,interval,cap={'COW':(8,2,6),'SHEEP':(6,3,6)}[animal]
    placed=int(tile['placed_day']);memo={}
    def value(d,unfed,pending):
        key=(d,unfed,pending)
        if key in memo:return memo[key]
        if d>=29:return 0.
        options=[]
        for feed in (0,1):
            starvation=0 if feed else unfed+1
            if starvation>=2:
                options.append(0.);continue
            age=d+1-placed-first;due=age>=0 and age%interval==0
            produced=min(cap,1+(pending if feed else 0)) if due else 0
            later=(0 if due else pending)+(1 if feed else 0)
            options.append(-feed*feed_price+produced*product_price+fert_price+value(d+1,starvation,later))
        memo[key]=max(options);return memo[key]
    if day>=29:return False
    vals=[]
    for feed in (0,1):
        unfed=0 if feed else int(tile.get('consecutive_unfed',0))+1
        if unfed>=2:vals.append(0.);continue
        pending=int(tile.get('pending_care_bonus',0));age=day+1-placed-first
        due=age>=0 and age%interval==0
        produced=min(cap,1+(pending if feed else 0)) if due else 0
        later=(0 if due else pending)+(1 if feed else 0)
        vals.append(-feed*feed_price+produced*product_price+fert_price+value(day+1,unfed,later))
    return vals[1]>=vals[0]-_HH_MARGIN


def agent(observation,configuration=None):
    action=_HH_PARENT(observation,configuration)
    step=int(observation['step']);day=step//24
    if not 24<=day<=28:return action
    seat=int(observation['player']);farm=observation['farms'][seat]
    positions=[farm['farmer'],*farm['hands']]
    commands=[action.get('farmer') or ['PASS'],*(action.get('hands') or [])]
    shops=observation.get('town',{}).get('unlocked_shops',[])
    market=observation['market'];draw={k:0 for k in PRODUCTS}
    for t in range(step,718):
        if t%4==0:
            for shop in shops:
                items=_RACE_SHOPS.get(shop,())
                for k in items:draw[k]+=2 if len(items)==1 else 1
        if t%24==0:
            for k in PRODUCTS:
                if k!='FERTILIZER':draw[k]+=1
    changed=False
    for actor,command in enumerate(commands[:len(positions)]):
        if not command or command[0]!='FEED':continue
        x,y=positions[actor];tile=farm['tiles'][y][x]
        if not isinstance(tile,dict) or tile.get('animal') not in ('COW','SHEEP'):continue
        if tile.get('fed_today'):continue
        item='MILK' if tile['animal']=='COW' else 'WOOL'
        future=_r37_market_price(item,market['inventory'][item]-draw[item],market.get('params'))
        if future>_HH_CAP:continue
        if tile.get('yield_units',0)>0 and (_HH_PROTECT or tile['yield_units']*future>market['prices']['WHEAT']*.9):continue
        _HH_REPORT['considered']+=1
        if not _hh_choice(tile,day,future,max(1,market['prices']['WHEAT']*.9),market['prices']['FERTILIZER']*_HH_FERT):
            commands[actor]=['PASS'];changed=True;_HH_REPORT['skipped']+=1
    if changed:return dict(action,farmer=commands[0],hands=commands[1:])
    return action

"""Observation-driven final-day collection, routing and marginal labor auction.

Original local extension. No future shops, opponent private state or world seed.
The planner uses small beam searches over short trips; every trip returns to the
shed before the actual last action (718). It replans from observed stock after
each delivery. Earlier days retain the frozen production controller.
"""
import time as _fd_time
_FD_PARENT = agent
_FD_STATE = {}
_FD_REPORT = dict(trips=0, hires=0, errors=0, max_ms=0.)
_FD_POWER = globals().get('_FD_POWER', .7)
_FD_HIRE_RATIO = globals().get('_FD_HIRE_RATIO', 1.4)
_FD_MAX_HIRES = globals().get('_FD_MAX_HIRES', 14)
_FD_DEPTH = globals().get('_FD_DEPTH', 3)
_FD_WIDTH = globals().get('_FD_WIDTH', 8)
_FD_HOME = ((4, 4), (5, 4), (4, 5), (5, 5))
_FD_PROD = {'COW': 'MILK', 'SHEEP': 'WOOL', 'GOOSE': 'EGG'}
_FD_CROP = {'WHEAT': (2, 4, 6), 'CARROT': (2, 3, 4), 'MELON': (10, 12, 6)}


def _fd_dist(a, b):
    return abs(a[0]-b[0])+abs(a[1]-b[1])


def _fd_walk(a, b):
    return ([['EAST']] * max(0, b[0]-a[0]) + [['WEST']] * max(0, a[0]-b[0])
            + [['SOUTH']] * max(0, b[1]-a[1]) + [['NORTH']] * max(0, a[1]-b[1]))


def _fd_tasks(obs, reserved):
    tasks=[];step=int(obs['step']);farm=obs['farms'][int(obs['player'])]
    for y,row in enumerate(farm['tiles']):
        for x,t in enumerate(row):
            xy=(x,y)
            if xy in reserved or not isinstance(t,dict):continue
            animal=t.get('animal');item=t.get('crop') or _FD_PROD.get(animal)
            q=int(t.get('yield_units',0));ops=[];loot={}
            age=29-int(t.get('planted_day',29))
            mature=animal or item not in _FD_CROP or age>=_FD_CROP[item][0]
            water=(item in _FD_CROP and mature and not t.get('watered_today')
                   and (_FD_CROP[item][1]+1)//2<=age<=_FD_CROP[item][1]
                   and q<_FD_CROP[item][2])
            if water:
                ops.append(['WATER']);q=min(_FD_CROP[item][2],q+(2 if t.get('fertilized_until_day',-1)>=29 else 1))
            if item and q>0 and mature:
                ops.append(['HARVEST']);loot[item]=q
            if animal and t.get('fertilizer_available'):
                ops.append(['COLLECT_FERTILIZER']);loot['FERTILIZER']=1
            if ops:
                tasks.append((xy,ops,loot,int(t.get('max_lifespan_step',-1))))
                if len(ops)>1 and ops[-1]==['COLLECT_FERTILIZER']:
                    tasks.append((xy,ops[:-1],{k:v for k,v in loot.items() if k!='FERTILIZER'},int(t.get('max_lifespan_step',-1))))
    return tasks


def _fd_prices(obs):
    # Quote scarce goods conservatively; account for our already-held stock.
    inv=obs['market']['inventory'];prices={};own=obs['private']['shed']
    for item in PRODUCTS:
        prices[item]=max(1.,(_r37_market_price(item,inv[item]+own.get(item,0),obs['market'].get('params'))
                            +obs['market']['prices'][item])*.5)
    return prices


def _fd_route(obs,pos,carried,reserved,step=None):
    step=int(obs['step']) if step is None else step
    horizon=719-step;tasks=_fd_tasks(obs,reserved);prices=_fd_prices(obs)
    value0=sum(prices.get(k,0)*v for k,v in carried.items())
    home=min(_FD_HOME,key=lambda h:_fd_dist(pos,h));closing=_fd_walk(pos,home)+[['DROP']]
    best=(value0/(len(closing)+2)**_FD_POWER,value0,closing,()) if value0 and len(closing)<=horizon else (0.,0.,[],())
    # State: cursor, elapsed, accumulated value, commands, selected coordinates.
    beam=[(tuple(pos),0,value0,[],())]
    for depth in range(_FD_DEPTH):
        candidates=[]
        for cursor,elapsed,value,commands,chosen in beam:
            for xy,ops,loot,decay in tasks:
                if xy in chosen:continue
                walk=_fd_walk(cursor,xy);arrival=step+elapsed+len(walk)
                n=elapsed+len(walk)+len(ops)
                home=min(_FD_HOME,key=lambda h:_fd_dist(xy,h))
                back=_fd_walk(xy,home)+[['DROP']]
                if n+len(back)>horizon:continue
                gain=0.
                for item,q in loot.items():
                    if item!='FERTILIZER' and decay>=0 and arrival>=decay:
                        q=max(0,q-_ca_decays(decay,step,arrival))
                    gain+=prices.get(item,0)*q
                if gain<=0:continue
                total=value+gain;score=total/(n+len(back)+2)**_FD_POWER
                route=commands+walk+[list(o) for o in ops];coords=chosen+(xy,)
                if score>best[0]:best=(score,total,route+back,coords)
                candidates.append((score,xy,n,total,route,coords))
        if not candidates:break
        candidates.sort(key=lambda a:a[0],reverse=True)
        beam=[(xy,n,total,route,coords) for _,xy,n,total,route,coords in candidates[:_FD_WIDTH]]
    return best


def _fd_action(obs,st):
    step=int(obs['step']);seat=int(obs['player']);farm=obs['farms'][seat]
    positions=[farm['farmer'],*farm['hands']];inventories=obs['private']['inventories']
    plans=st['plans']
    # At a completed delivery release its claims; facts come from the new obs.
    for actor in list(plans):
        if not plans[actor]['commands']:del plans[actor]
    reserved={xy for plan in plans.values() for xy in plan['coords']}
    commands=[]
    for actor,pos in enumerate(positions):
        if actor not in plans:
            score,value,route,coords=_fd_route(obs,pos,inventories[actor],reserved)
            plans[actor]=dict(commands=route,coords=coords)
            reserved.update(coords)
            if route:_FD_REPORT['trips']+=1
        command=plans[actor]['commands'].pop(0) if plans[actor]['commands'] else ['PASS']
        commands.append(command)
    action={'farmer':commands[0],'hands':commands[1:],'market':[]}
    # Exact own-unit projection respects decay-independent unit order and shed cap.
    projected,private=_r127_fields(obs,action)
    sales=[['SELL',k,int(n)] for k,n in private['shed'].items() if k in PRODUCTS and n>0]
    sales.sort(key=lambda o:-(obs['market']['prices'].get(o[1],0)*o[2]))
    action['market']=sales
    # Auction new labor against unreserved, currently visible profitable trips.
    cash=projected['money'];hired=int(farm.get('hires_today',0));added=0
    occupied=[projected['farmer'],*projected['hands']]
    while step<710 and hired+added<_FD_MAX_HIRES and len(action['market'])<10 and added<6:
        pos=min(_FD_HOME,key=lambda h:(sum(tuple(p)==h for p in occupied),_FD_HOME.index(h)))
        _,value,route,coords=_fd_route(obs,pos,{},reserved,step+1)
        cost=_y_fib(hired+added)
        if not route or value<cost*_FD_HIRE_RATIO or cash<cost:break
        actor=len(positions)+added
        plans[actor]=dict(commands=route,coords=coords)
        reserved.update(coords);occupied.append(pos);cash-=cost;added+=1
        action['market'].append(['HIRE'])
        _FD_REPORT['hires']+=1
    # Existing quote-order optimizer only permutes contiguous SELL blocks.
    if len(sales)>1:action=_v44y_reorder(obs,action)
    return action


def agent(observation,configuration=None):
    step=int(observation['step']);seat=int(observation['player'])
    if step<696:return _FD_PARENT(observation,configuration)
    begun=_fd_time.perf_counter()
    st=_FD_STATE.get(seat)
    if st is None or step<=st['last']:st=_FD_STATE[seat]=dict(last=-1,plans={})
    st['last']=step
    try:return _fd_action(observation,st)
    except Exception:
        _FD_REPORT['errors']+=1
        raise
    finally:_FD_REPORT['max_ms']=max(_FD_REPORT['max_ms'],(_fd_time.perf_counter()-begun)*1000)

