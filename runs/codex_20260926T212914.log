from pathlib import Path
from kaggle_environments import make
p=Path('/workspace/shared/candidates/es7_wm/pkg/main.py')
def load():
 ns={'__file__':str(p),'__name__':'base_trace'};exec(compile(p.read_text(),str(p),'exec'),ns);return ns['agent']
for seed in (777,778):
 agent=load(); rows=[]
 def traced(obs,cfg=None):
  a=agent(obs,cfg); step=int(obs['step']); u=[a.get('farmer')]+list(a.get('hands') or [])
  s=[(i,c[1]) for i,c in enumerate(u) if c and c[0]=='PLANT' and c[1]=='STRAWBERRY']
  b=[o for o in a.get('market',[]) if o and o[0]=='BUY_SEED']
  if s or b:
   rows.append({'t':step,'d':step//24,'s_plants':s,'seed_buys':b,'seeds':dict(obs['private']['seeds'])})
  return a
 env=make('kaggriculture',configuration={'seed':seed},debug=False);env.run([traced,str(p)])
 print('SEED',seed,'status',[x.status for x in env.state])
 for r in rows: print(r)
