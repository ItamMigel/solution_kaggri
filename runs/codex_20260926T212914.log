_PG_PARENT=agent
def final_price_guard(observation, configuration=None):
    action=_PG_PARENT(observation, configuration)
    try:
        if int(observation["step"])==91:
            price=float(observation.get("market",{}).get("prices",{}).get("WHEAT",0))
