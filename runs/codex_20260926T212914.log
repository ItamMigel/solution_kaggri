_HP = {'m1_on': True, 'm1_day0': 0, 'm1_day1': 29, 'm1_ops': ['COLLECT_FERTILIZER'], 'm1_fert_crops': ['STRAWBERRY', 'TOMATO'], 'land_on': False, 'land_k': 24, 'land_buffer': 300}
_HP_FIRST_YIELD = {"WHEAT": 2, "CARROT": 2, "TOMATO": 8, "STRAWBERRY": 10, "MELON": 10}
_HP_STATS = {"m1_fills": 0, "land_early": 0, "land_absorbed": 0}
_HP_LAND = {}   # player -> {"owed": int, "done": set(tape steps accelerated)}
_HP_LAND_COST = [1000, 2000, 4000]

def _hp_land(obs, action):
    """Macro L: buy a quadrant up to land_k steps before the current Horizon tape plans it (if cash stays >= buffer);
    then drop the next Horizon BUY_LAND (from tape or any layer) so the total number of quadrants is unchanged."""
    p = int(obs["player"]); step = int(obs["step"])
    st = _HP_LAND.setdefault(p, {"owed": 0, "done": set(), "pending": None})
    if step == 0:
        st["owed"] = 0; st["done"] = set(); st["pending"] = None
    nq_now = len(obs["farms"][p].get("unlocked_quadrants") or [])
    if st["pending"] is not None:   # confirm last step's early purchase actually executed
        if nq_now > st["pending"]:
            st["owed"] += 1; _HP_STATS["land_early"] += 1
        st["pending"] = None
    orders = [list(o) for o in (action.get("market") or [])]
    if st["owed"] > 0:
        kept = []
        for o in orders:
            if o and o[0] == "BUY_LAND" and st["owed"] > 0:
                st["owed"] -= 1; _HP_STATS["land_absorbed"] += 1
            else:
                kept.append(o)
        orders = kept
    try:
        cst = _IMPL.chassis.players.get(p) or {}
        tape = _IMPL.chassis.routes.get(cst.get("route"))
    except Exception:
        tape = None
    if tape and len(orders) < 10 and not any(o and o[0] == "BUY_LAND" for o in orders):
        for t in range(step + 1, min(len(tape), step + 1 + int(_HP["land_k"]))):
            a = tape[t] if isinstance(tape[t], dict) else {}
            if t not in st["done"] and any(o and o[0] == "BUY_LAND" for o in (a.get("market") or [])):
                farm = obs["farms"][p]; nq = len(farm.get("unlocked_quadrants") or []) - 1
                if nq < 3 and float(farm["money"]) - _HP_LAND_COST[nq] >= float(_HP["land_buffer"]):
                    orders.append(["BUY_LAND"]); st["pending"] = nq_now; st["done"].add(t)
                break
    return dict(action, market=orders)

def _hp_tile_op(tile, inv, day, allowed):
    """Best productive in-place op on this tile (M1), following engine semantics; None if nothing useful."""
    if not isinstance(tile, dict):
        return None
    inv = inv or {}
    if tile.get("kind") == "PLANT":
        age = day - int(tile.get("planted_day", day))
        if "HARVEST_PLANT" in allowed and age >= _HP_FIRST_YIELD.get(tile.get("crop"), 99) and int(tile.get("yield_units", 0)) > 0:
            return ["HARVEST"]
        if "FERTILIZE" in allowed and inv.get("FERTILIZER", 0) > 0 and tile.get("crop") in _HP["m1_fert_crops"] \
                and int(tile.get("fertilized_until_day", -1)) < day:
            return ["FERTILIZE"]
        if "WATER" in allowed and not tile.get("watered_today"):
            return ["WATER"]
        return None
    if "animal" in tile:
        if "HARVEST_ANIMAL" in allowed and int(tile.get("yield_units", 0)) > 0:
            return ["HARVEST"]
        if "COLLECT_FERTILIZER" in allowed and tile.get("fertilizer_available"):
            return ["COLLECT_FERTILIZER"]
        if "CARE" in allowed and not tile.get("cared_today"):
            return ["CARE"]
        if "FEED" in allowed and not tile.get("fed_today") and inv.get("WHEAT", 0) > 0:
            return ["FEED"]
    return None

_HP_BASE_AGENT = agent
del agent  # kaggle loader takes the LAST-inserted callable: re-insert `agent` at the end


def agent(obs, config=None):
    action = _HP_BASE_AGENT(obs, config)
    try:
        if _HP.get("land_on"):
            action = _hp_land(obs, action)
    except Exception:
        pass
    try:
        if not _HP.get("m1_on"):
            return action
        step = int(obs["step"]); day = step // 24
        if not (_HP["m1_day0"] <= day <= _HP["m1_day1"]) or step >= 718:
            return action
        p = int(obs["player"]); farm = obs["farms"][p]; priv = obs.get("private") or {}
        invs = priv.get("inventories") or []
        pos = [farm["farmer"]] + list(farm.get("hands") or [])
        units = [action.get("farmer") or ["PASS"]] + list(action.get("hands") or [])
        allowed = set(_HP["m1_ops"])
        for i, u in enumerate(units):
            if i >= len(pos) or (u and u[0] != "PASS"):
                continue
            x, y = pos[i]
            op = _hp_tile_op(farm["tiles"][y][x], invs[i] if i < len(invs) else {}, day, allowed)
            if op:
                units[i] = op; _HP_STATS["m1_fills"] += 1
        action = dict(action, farmer=units[0], hands=units[1:])
    except Exception:
        pass
    return action

# ================= T031 market-only WHEAT timing layer (lab/hplus/wheat_market.py) =================
_WM = {'wm_on': True, 'wm_buy_day0': 6, 'wm_buy_day1': 17, 'wm_buy_price_max': 30, 'wm_feed_floor': 20, 'wm_buy_cap': 8, 'wm_cash_reserve': 2000, 'wm_sell_day0': 10, 'wm_sell_day1': 28, 'wm_sell_price_min': 40, 'wm_sell_reserve': 35, 'wm_sell_cap': 8}
_WM_PARENT = agent
del agent
_WM_STATS = {"buy_turns": 0, "buy_units": 0, "sell_turns": 0, "sell_units": 0,
             "abstain_parent_wheat": 0, "abstain_slots": 0, "errors": 0}

def agent(obs, config=None):
    action = _WM_PARENT(obs, config)
    if not _WM["wm_on"]:
        return action
    try:
        # No unit-action authority: only make a shallow action copy after a
        # fully qualified market decision; inherited farmer/hands stay intact.
        step = int(obs["step"]); day = step // 24
        if not 0 <= day <= 29 or step >= 718:
            return action
        market = action.get("market") or []
        if len(market) >= 10:
            _WM_STATS["abstain_slots"] += 1
            return action
        if any(isinstance(o, list) and len(o) >= 2 and o[1] == "WHEAT" and o[0] in ("SELL", "BUY_PRODUCT") for o in market):
            _WM_STATS["abstain_parent_wheat"] += 1
            return action
        player = int(obs["player"])
        private = obs.get("private") or {}
        shed = private.get("shed") or {}
        held = max(0, int(shed.get("WHEAT", 0)))
        room = max(0, 100 - sum(max(0, int(v)) for v in shed.values()))
        price = max(1, int((obs.get("market") or {}).get("prices", {}).get("WHEAT", 1)))
        money = max(0, int(obs["farms"][player]["money"]))
        order = None
        # Early cheap physical feed reserve.  The cap/room/cash checks are
        # explicit because BUY_PRODUCT deposits directly into the shared shed.
        if (int(_WM["wm_buy_day0"]) <= day <= int(_WM["wm_buy_day1"]) and price <= int(_WM["wm_buy_price_max"]) and held < int(_WM["wm_feed_floor"])):
            q = min(int(_WM["wm_buy_cap"]), int(_WM["wm_feed_floor"]) - held, room,
                    max(0, (money - int(_WM["wm_cash_reserve"])) // price))
            if q > 0:
                order = ["BUY_PRODUCT", "WHEAT", q]
                _WM_STATS["buy_turns"] += 1; _WM_STATS["buy_units"] += q
        # Only sell owned physical surplus; never replace a parent sale.
        if order is None and (int(_WM["wm_sell_day0"]) <= day <= int(_WM["wm_sell_day1"]) and price >= int(_WM["wm_sell_price_min"]) and held > int(_WM["wm_sell_reserve"])):
            q = min(int(_WM["wm_sell_cap"]), held - int(_WM["wm_sell_reserve"]))
            if q > 0:
                order = ["SELL", "WHEAT", q]
                _WM_STATS["sell_turns"] += 1; _WM_STATS["sell_units"] += q
        if order is None:
            return action
        result = dict(action)
        result["market"] = [list(o) if isinstance(o, list) else o for o in market] + [order]
        return result
    except Exception:
        _WM_STATS["errors"] += 1
        return action

agent.telemetry = _WM_STATS

