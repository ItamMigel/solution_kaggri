"""Frozen-fold, paired Horizon+ capability and racing harness.

This is a thin, reproducible front-end to the official local ``compare.py``.
It never submits to Kaggle and never promotes automatically.  Genome zero must be
the first agent; every candidate is played on the same worlds, opponents and seats,
so ``summary.json`` contains paired deltas against it.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import random
import subprocess
import sys
from datetime import datetime, timezone


ROOT = pathlib.Path("/workspace/solution_kaggri")
PYTHON = ROOT / ".venv/bin/python"
COMPARE_ROOT = pathlib.Path(__file__).resolve().parents[2]
COMPARE = COMPARE_ROOT / "compare.py"
G9 = pathlib.Path("/workspace/shared/candidates/es1_g9/pkg/main.py")
V5 = ROOT / "agents/horizon_v5_market.py"
STAGES = {
    "capability": {"worlds": 2, "opponents": 2, "description": "2 worlds × g9 + one hard opponent × both seats"},
    "race": {"worlds": 4, "opponents": 3, "description": "4 worlds × g9 + v5 + one hard opponent × both seats"},
    "final": {"worlds": 8, "opponents": 5, "description": "8 worlds × g9 + v5 + three hard opponents × both seats"},
}


def _sha(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def parse_named(values: list[str]) -> dict[str, pathlib.Path]:
    result: dict[str, pathlib.Path] = {}
    for value in values:
        if "=" not in value:
            raise ValueError(f"expected NAME=PATH, got {value!r}")
        name, raw = value.split("=", 1)
        path = pathlib.Path(raw).expanduser().resolve()
        if not name or name in result or not path.is_file():
            raise ValueError(f"invalid or duplicate agent {value!r}")
        result[name] = path
    return result


def _seeds(path: pathlib.Path) -> set[int]:
    value = json.loads(path.read_text())
    return set(value["seeds"] if isinstance(value, dict) else value)


def locked_fold(path: pathlib.Path, *, name: str, worlds: int, salt: int, excluded: set[int]) -> list[int]:
    """Create once or verify an immutable seed fold; exclusion prevents overlap."""
    if path.exists():
        saved = json.loads(path.read_text())
        if saved.get("name") != name or saved.get("worlds") != worlds or saved.get("salt") != salt:
            raise ValueError(f"locked fold parameters differ: {path}")
        seeds = saved["seeds"]
        if len(seeds) != worlds or len(set(seeds)) != worlds or set(seeds) & excluded:
            raise ValueError(f"locked fold is invalid or overlaps excluded seeds: {path}")
        return seeds
    rng = random.Random(salt)
    seeds: list[int] = []
    while len(seeds) < worlds:
        seed = rng.randrange(1, 2**31 - 1)
        if seed not in excluded and seed not in seeds:
            seeds.append(seed)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"name": name, "worlds": worlds, "salt": salt, "seeds": seeds}, indent=2) + "\n")
    return seeds


def _paired_markdown(summary: dict, baseline: str) -> str:
    pairs = summary.get("pairwise", {}).get(baseline, {})
    lines = ["| Candidate | Paired score Δ | 95% CI | Paired margin Δ | 95% CI |", "|---|---:|---:|---:|---:|"]
    for name, value in pairs.items():
        if name == baseline:
            continue
        score_ci = value["paired_score_gain_95"]
        margin_ci = value["paired_margin_gain_95"]
        lines.append("| %s | %+.4f | [%+.4f, %+.4f] | %+.1f | [%+.1f, %+.1f] |" % (
            name, value["paired_score_gain"], score_ci[0], score_ci[1],
            value["paired_margin_gain"], margin_ci[0], margin_ci[1]))
    return "\n".join(lines)


def run(args: argparse.Namespace) -> None:
    stage = STAGES[args.stage]
    agents = parse_named(args.agent)
    if not agents or next(iter(agents)) != "genome0":
        raise ValueError("the first --agent must be genome0=... for paired deltas")
    if len(agents) > args.max_candidates:
        raise ValueError(f"stage permits at most {args.max_candidates} candidates including genome0")
    opponents = parse_named(args.opponent)
    if len(opponents) != stage["opponents"]:
        raise ValueError(f"{args.stage} requires exactly {stage['opponents']} opponents; got {len(opponents)}")
    if args.workers < 1 or args.workers > 22:
        raise ValueError("workers must be in [1, 22]")
    out = pathlib.Path(args.out).resolve()
    if out.exists():
        raise FileExistsError(f"refuse to overwrite {out}")

    excluded: set[int] = set()
    for item in args.exclude_seeds_file:
        excluded |= _seeds(pathlib.Path(item))
    fold = locked_fold(pathlib.Path(args.fold).resolve(), name=args.stage, worlds=stage["worlds"], salt=args.fold_salt, excluded=excluded)
    # Refuse accidental reuse of one named stage fold for another stage.
    if set(fold) & excluded:
        raise ValueError("fold overlaps excluded seeds")
    out.mkdir(parents=True)
    plan = {
        "created_utc": datetime.now(timezone.utc).isoformat(),
        "stage": args.stage,
        "stage_contract": stage,
        "fold": str(pathlib.Path(args.fold).resolve()),
        "seeds": fold,
        "agents": {name: {"path": str(path), "sha256": _sha(path)} for name, path in agents.items()},
        "opponents": {name: {"path": str(path), "sha256": _sha(path)} for name, path in opponents.items()},
        "expected_games": len(agents) * len(opponents) * len(fold) * 2,
        "decision": "Paired delta vs genome0 only. No automatic selection or promotion.",
    }
    (out / "plan.json").write_text(json.dumps(plan, indent=2) + "\n")
    command = [str(PYTHON), str(COMPARE)]
    for name, path in agents.items():
        command += ["--agent", f"{name}={path}"]
    # The explicit empty option is intentional: every stage declares its full
    # opponent panel (including v5 when required), rather than inheriting the
    # compare.py default panel.
    command += ["--baselines"]
    for name, path in opponents.items():
        command += ["--opponent", f"{name}={path}"]
    command += ["--seeds", *map(str, fold), "--workers", str(args.workers), "--out", str(out / "compare")]
    env = dict(os.environ, OMP_NUM_THREADS="1", OPENBLAS_NUM_THREADS="1", MKL_NUM_THREADS="1")
    with (out / "command.txt").open("x") as log:
        log.write(" ".join(command) + "\n")
    proc = subprocess.run(command, cwd=COMPARE_ROOT, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    (out / "compare.log").write_text(proc.stdout)
    if proc.returncode:
        raise RuntimeError(f"compare.py failed ({proc.returncode}); see {out/'compare.log'}")
    summary = json.loads((out / "compare" / "summary.json").read_text())
    (out / "PAIRED.md").write_text(
        "# Paired deltas against genome0\n\n" + _paired_markdown(summary, "genome0") + "\n\n"
        "This is a screening result, not a promotion decision.\n")
    print(out / "PAIRED.md")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--stage", choices=STAGES, required=True)
    parser.add_argument("--agent", action="append", default=[], required=True)
    parser.add_argument("--opponent", action="append", default=[], required=True)
    parser.add_argument("--fold", required=True)
    parser.add_argument("--fold-salt", type=int, required=True)
    parser.add_argument("--exclude-seeds-file", action="append", default=[])
    parser.add_argument("--out", required=True)
    parser.add_argument("--workers", type=int, default=20)
    parser.add_argument("--max-candidates", type=int, default=24)
    args = parser.parse_args()
    run(args)


if __name__ == "__main__":
    main()
"""Build-time M4 configuration for the frozen ``es1_g9`` source.

The Horizon chassis consumes ``_SETTINGS`` and its route/opening constants while
the source is imported.  A globals update appended at EOF is therefore too late.
This module changes only audited source anchors before import.  With the default
genes it copies the input byte-for-byte; that is the genome-zero contract.

This deliberately does *not* permit an earlier final-day takeover.  The inherited
FD planner is a terminal liquidator, not a mid-season production controller.
"""
from __future__ import annotations

import argparse
import ast
import hashlib
import json
import pathlib
import re
from typing import Any


DEFAULT_GENES: dict[str, Any] = {
    "settings": {},
    "opening_qty": None,
    "router_switch_step": None,
    "fd_takeover_step": None,
}

_SETTINGS_RE = re.compile(r"(?m)^_SETTINGS=(\{[^\n]+\})$")
_R4_RE = re.compile(r"(?m)^_R4_CONFIG=(\{[^\n]+\})$")
_ROUTER_RE = "if step>=648 and not state.get('day27'):"
_FD_RE = "if step<696:return _FD_PARENT(observation,configuration)"
_ROUTE_HELPER_RE = "t >= 648"


class BuildError(ValueError):
    """The frozen source is not the version whose anchors were reviewed."""


def _literal_assignment(source: str, pattern: re.Pattern[str], name: str) -> tuple[dict[str, Any], re.Match[str]]:
    matches = list(pattern.finditer(source))
    if len(matches) != 1:
        raise BuildError(f"expected one {name} assignment, found {len(matches)}")
    value = ast.literal_eval(matches[0].group(1))
    if not isinstance(value, dict):
        raise BuildError(f"{name} is not a dict literal")
    return value, matches[0]


def normalise(genes: dict[str, Any] | None) -> dict[str, Any]:
    """Validate a candidate M4 genome without silently accepting typoed genes."""
    if genes is None:
        genes = {}
    if not isinstance(genes, dict):
        raise BuildError("genes must be a JSON object")
    unknown = set(genes) - set(DEFAULT_GENES)
    if unknown:
        raise BuildError(f"unknown genes: {sorted(unknown)}")
    out = dict(DEFAULT_GENES)
    out.update(genes)
    if not isinstance(out["settings"], dict):
        raise BuildError("settings must be an object")
    if out["opening_qty"] is not None and (type(out["opening_qty"]) is not int or not 5 <= out["opening_qty"] <= 30):
        raise BuildError("opening_qty must be an integer in [5, 30] or null")
    if out["router_switch_step"] is not None and (type(out["router_switch_step"]) is not int or not 600 <= out["router_switch_step"] <= 696):
        raise BuildError("router_switch_step must be an integer in [600, 696] or null")
    # The FD planner hard-codes day-29/terminal assumptions.  Delaying it is an
    # auditable terminal ablation; starting it early is not an M4 capability.
    if out["fd_takeover_step"] is not None and (type(out["fd_takeover_step"]) is not int or not 696 <= out["fd_takeover_step"] <= 718):
        raise BuildError("fd_takeover_step must be an integer in [696, 718] or null")
    return out


def build_text(source: str, genes: dict[str, Any] | None = None) -> tuple[str, dict[str, Any]]:
    """Return configured source and canonical genes; defaults preserve source bytes."""
    g = normalise(genes)
    if g == DEFAULT_GENES:
        return source, g

    text = source
    if g["settings"]:
        current, match = _literal_assignment(text, _SETTINGS_RE, "_SETTINGS")
        invalid = set(g["settings"]) - set(current)
        if invalid:
            raise BuildError(f"unknown _SETTINGS keys: {sorted(invalid)}")
        if any(type(v) is not bool for v in g["settings"].values()):
            raise BuildError("_SETTINGS values must be booleans")
        current.update(g["settings"])
        text = text[:match.start(1)] + repr(current) + text[match.end(1):]

    if g["opening_qty"] is not None:
        current, match = _literal_assignment(text, _R4_RE, "_R4_CONFIG")
        if set(current) != {"opening"} or type(current["opening"]) is not int:
            raise BuildError("unexpected final opening config")
        current["opening"] = g["opening_qty"]
        text = text[:match.start(1)] + repr(current) + text[match.end(1):]

    if g["router_switch_step"] is not None:
        if text.count(_ROUTER_RE) != 1:
            raise BuildError("router switch anchor changed")
        # Future-tape consumers must agree with the live router or their market
        # reservations are computed from a different tape.
        helper_count = text.count(_ROUTE_HELPER_RE)
        if helper_count != 7:
            raise BuildError(f"expected 7 route helper anchors, found {helper_count}")
        step = g["router_switch_step"]
        text = text.replace(_ROUTER_RE, f"if step>={step} and not state.get('day27'):")
        text = text.replace(_ROUTE_HELPER_RE, f"t >= {step}")

    if g["fd_takeover_step"] is not None:
        if text.count(_FD_RE) != 1:
            raise BuildError("FD takeover anchor changed")
        text = text.replace(_FD_RE, f"if step<{g['fd_takeover_step']}:return _FD_PARENT(observation,configuration)")

    try:
        compile(text, "configured_horizon.py", "exec")
    except SyntaxError as exc:  # pragma: no cover - defensive source gate
        raise BuildError(f"generated source does not compile: {exc}") from exc
    return text, g


def build(base_main_py: str | pathlib.Path, genes: dict[str, Any] | None, out_main_py: str | pathlib.Path) -> dict[str, Any]:
    """Write a self-contained configured agent and a JSON sidecar with its digest."""
    base = pathlib.Path(base_main_py)
    out = pathlib.Path(out_main_py)
    source = base.read_text()
    text, canonical = build_text(source, genes)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text)
    info = {
        "base": str(base.resolve()),
        "base_sha256": hashlib.sha256(source.encode()).hexdigest(),
        "genes": canonical,
        "output_sha256": hashlib.sha256(text.encode()).hexdigest(),
        "genome_zero_byte_identical": text == source,
    }
    out.with_suffix(out.suffix + ".build.json").write_text(json.dumps(info, indent=2, sort_keys=True) + "\n")
    return info


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", required=True)
    parser.add_argument("--genes", required=True, help="JSON file or inline JSON object")
    parser.add_argument("--out", required=True)
    args = parser.parse_args()
    candidate = pathlib.Path(args.genes)
    raw = candidate.read_text() if candidate.is_file() else args.genes
    print(json.dumps(build(args.base, json.loads(raw), args.out), indent=2))


if __name__ == "__main__":
    main()
