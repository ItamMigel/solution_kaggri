"""Round-four research extension. Appended to the immutable Horizon v4 source.

_R4_CONFIG is supplied by the reproducible builder. No Kaggle-specific imports,
network, files, opponent IDs, replay seeds, or hidden future shops are used.
"""
_R4_PARENT=agent
_R4_REPORT={'opening_changes':0,'tracking_updates':0,'confidence_rejections':0}
_R4_FORECAST_PARENT=_v92_p_forecast


def _r4_forecast(obs,st):
    best=_R4_FORECAST_PARENT(obs,st)
    if not _R4_CONFIG.get('confidence') or not best:return best
    step=int(obs['step']);lo=step-240;seen=st['obs'];ev=best[0]
    recent=[(t,i) for (t,i) in seen if lo<=t<step-1]
    m=f=0
    for (t,i) in ev:
        if lo<=t<step-1:
            if any((t+d,i) in seen for d in (-1,0,1)):m+=1
            else:f+=1
    miss=sum(not any((t+d,i) in ev for d in (-1,0,1)) for t,i in recent)
    if m<8 or 2*m/max(1,2*m+f+miss)<.6:
        _R4_REPORT['confidence_rejections']+=1
        return []
    return best


_v92_p_forecast=_r4_forecast
globals().update(_R4_CONFIG.get('settings',{}))


def _r4_track_final(observation,action):
    """The rival-sale estimator must subtract the orders we actually returned.

    The inherited layer recorded an inner action before later sale extensions.
    Only cash products enter this estimate; no product purchases can consume
    those stocks. Skip inference if our sales alone could reach the price floor.
    """
    player=int(observation['player']);step=int(observation['step'])
    st=_V9_RACE.get(player)
    if st is None:return
    stock=projected_shed(action,FarmView(observation));own={}
    prices=dict(observation['market']['prices']);inv=observation['market']['inventory']
    for order in action.get('market') or []:
        if len(order)>=3 and order[0]=='SELL' and order[1] in V9_RACE_ITEMS:
            item=order[1]
            n=min(max(0,int(order[2])),max(0,int(stock.get(item,0))-own.get(item,0)))
            own[item]=own.get(item,0)+n
    for item,n in own.items():
        if _r37_market_price(item,inv[item]+n,observation['market'].get('params'))<=3:prices[item]=0
    st['prev']={'step':step,'inventory':dict(inv),'prices':prices,'own':own,
                'left':{item:max(0,stock.get(item,0)-own.get(item,0)) for item in V9_RACE_ITEMS},
                'shops':list(observation['town']['unlocked_shops'])}
    _R4_REPORT['tracking_updates']+=1


def round4_submission_agent(observation,configuration=None):
    action=_R4_PARENT(observation,configuration)
    step=int(observation['step'])
    if step==0 and _R4_CONFIG.get('opening'):
        qty=int(_R4_CONFIG['opening'])
        orders=[['BUY_PRODUCT','WHEAT',qty]]
        if qty>5:orders.append(['SELL','WHEAT',qty-5])
        orders.append(['BUY_SEED','WHEAT',1])
        action=dict(action,market=orders)
        _R4_REPORT['opening_changes']+=1
    if _R4_CONFIG.get('track_final'):_r4_track_final(observation,action)
    # Keep the other inherited detector consistent with final emitted orders.
    race=_RACE_STATE.get(int(observation['player']))
    if race is not None and race.get('step')==step:race['prev_action']=action
    return action


agent=round4_submission_agent

