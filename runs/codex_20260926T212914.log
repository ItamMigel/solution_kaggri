from pathlib import Path
p=Path('/workspace/shared/candidates/es7_wm/pkg/main.py')
ns={'__file__':str(p),'__name__':'crop_audit'}
exec(compile(p.read_text(),str(p),'exec'),ns)
routes=ns['_IMPL'].chassis.routes
for rid,tape in sorted(routes.items()):
    plants=[]
    for step,a in enumerate(tape):
        us=[a.get('farmer')]+list(a.get('hands') or []) if isinstance(a,dict) else []
        for i,c in enumerate(us):
            if c and c[0]=='PLANT': plants.append((step,step//24,step%24,i,c[1]))
    from collections import Counter
    print('ROUTE',rid,'length',len(tape),'plants',len(plants),'counts',dict(Counter(x[-1] for x in plants)))
    print(plants[:150])
