def clip(name, v):
    b, lo, hi, k = SPACE[name]
    v = min(hi, max(lo, v))
    return int(round(v)) if k == "int" else float(v)

def base_params():
    return {k: v[0] for k, v in SPACE.items()}

def make_agent_file(params, out, base=BASE):
