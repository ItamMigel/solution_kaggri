index 0000000000000000000000000000000000000000..25531d788c93c8d810be76ef9a2e9fda434d0d6d
--- /dev/null
+++ b/lab/tools/t025_resume_cma4.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# Resume CMA4 in five-generation chunks and apply the declared fresh gate.
+set -euo pipefail
+
+repo=/workspace/wt/codex
+shared=/workspace/shared
+python=/workspace/solution_kaggri/.venv/bin/python
+out="$shared/runs/cma4"
+last_label=${1:-29}
+
+while true; do
+  completed=$($python -c 'import json; print(len(json.load(open("/workspace/shared/runs/cma4/history.json"))))')
+  gen=$completed
+  if (( gen > last_label )); then
+    break
+  fi
+  if (( gen % 5 != 0 )); then
+    target=$((gen + 1))
+    $python "$repo/lab/tools/knob_cma.py" --init "$out/init_gen15_params.json" --out "$out" \
+      --gens "$target" --pop 10 --sigma 0.015 --worlds 8 --workers 14 --collect \
+      --mirror "$shared/candidates/es5_c3g15/pkg/main.py"
+    continue
+  fi
+  $python "$repo/lab/tools/knob_cma.py" --init "$out/init_gen15_params.json" --out "$out" \
+    --gens "$((gen + 1))" --pop 10 --sigma 0.015 --worlds 8 --workers 14 --collect \
+    --mirror "$shared/candidates/es5_c3g15/pkg/main.py"
+  $python "$repo/lab/tools/t025_periodic_full_panel_gate.py" --gen "$gen" --workers 4
+done

exec
/bin/bash -lc "sleep 30; ps -eo pid,ppid,pgid,etimes,cmd | grep -E '[k]nob_cma|[g]ame_worker.py|[t]025_periodic|[t]025_resume' | head -n 40; wc -l /workspace/shared/runs/cma4/gen_020/run/games.jsonl; tail -n 12 /workspace/shared/runs/cma4/resume_g20_g25.log; /workspace/solution_kaggri/.venv/bin/python - <<'PY'
import json
h=json.load(open('/workspace/shared/runs/cma4/history.json'))
print('completed',len(h),'last',h[-1]['gen'])
