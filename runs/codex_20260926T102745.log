+    --gens "$((gen + 1))" --pop 10 --sigma 0.015 --worlds 8 --workers 14 --collect \
+    --mirror "$shared/candidates/es5_c3g15/pkg/main.py"
+  $python "$repo/lab/tools/t025_periodic_full_panel_gate.py" --gen "$gen" --workers 4
+done

