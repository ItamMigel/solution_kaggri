   219	def combine(a0, a1):
   220	    """two players' (farmer, hands, market) -> gpuenv Actions."""
   221	    f = torch.stack([a0[0], a1[0]], 1).to(torch.int16); h = torch.stack([a0[1], a1[1]], 1).to(torch.int16); m = torch.stack([a0[2], a1[2]], 1).to(torch.int16)
   222	    return Actions(f, h, m)
