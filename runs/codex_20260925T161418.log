   127	def encode_unit_action(a):
   128	    if not a:
   129	        return UNIT_IDX["PASS"]
   130	    op = a[0]
   131	    if op in ("PLANT", "PICKUP", "PLACE") and len(a) > 1:
   132	        return UNIT_IDX.get(op + ":" + str(a[1]), UNIT_IDX["PASS"])
