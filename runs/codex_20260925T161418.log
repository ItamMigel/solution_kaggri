   147	def _league_labels(batch, dev, seed, names, probs):
   148	    generator = torch.Generator(device=dev)
   149	    generator.manual_seed(seed)
   150	    p = torch.tensor(probs, dtype=torch.float32, device=dev)
   151	    return torch.multinomial(p.expand(batch, -1), 1, generator=generator).squeeze(1)
