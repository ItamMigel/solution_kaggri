    73	class StreamingBuffer:
    74	    """Fixed [time, env, ...] device storage for a single trainable player."""
    75	    def __init__(self, steps, batch):
    76	        self.steps, self.batch, self.pos = steps, batch, 0
    77	        self.data = {}
    78	
    79	    def put(self, rec, logp, value, reward):
    80	        if self.pos >= self.steps:
    81	            raise RuntimeError("rollout buffer overflow")
    82	        row = dict(rec)
    83	        row.update(logp=logp, v=value, r=reward)
    84	        if not self.data:
    85	            for key, val in row.items():
    86	                self.data[key] = torch.empty((self.steps, *val.shape), device=val.device,
    87	                                             dtype=_tensor_dtype(key, val))
    88	        for key, val in row.items():
    89	            self.data[key][self.pos].copy_(val)
    90	        self.pos += 1
    91	
    92	    def terminal_add(self, correction):
    93	        if self.pos != self.steps:
    94	            raise RuntimeError("terminal correction before a complete rollout")
    95	        self.data["r"][-1].add_(correction)
    96	
    97	    def flat(self):
    98	        if self.pos != self.steps:
    99	            raise RuntimeError(f"incomplete rollout: {self.pos}/{self.steps}")
   100	        return {k: v.reshape(self.steps * self.batch, *v.shape[2:]) for k, v in self.data.items()}
