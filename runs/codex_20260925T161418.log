   165	
   166	def decode_unit(cls, unit_inv, shed):
   167	    k = UNIT_OPS[int(cls)]
   168	    if ":" not in k:
   169	        return [k]
   170	    op, it = k.split(":")
   171	    if op == "PLANT":
   172	        return ["PLANT", it]
   173	    if op == "PICKUP":
   174	        return ["PICKUP", it, max(1, int(shed.get(it, 1)))]
   175	    return ["PLACE", it, max(1, int((unit_inv or {}).get(it, 1)))]

