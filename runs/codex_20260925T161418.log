   319	def main():
   320	    ap = argparse.ArgumentParser()
   321	    ap.add_argument("--init", required=True)
   322	    ap.add_argument("--out", required=True)
   323	    ap.add_argument("--envs", type=int, default=256)
   324	    ap.add_argument("--iters", type=int, default=50)
   325	    ap.add_argument("--lr", type=float, default=3e-5)
   326	    ap.add_argument("--epochs", type=int, default=2)
   327	    ap.add_argument("--mb", type=int, default=8192)
   328	    ap.add_argument("--gamma", type=float, default=1.0)
   329	    ap.add_argument("--lam", type=float, default=.995)
   330	    ap.add_argument("--clip", type=float, default=.2)
   331	    ap.add_argument("--ent", type=float, default=.001)
   332	    ap.add_argument("--kl", type=float, default=.05); ap.add_argument("--stop-at", type=int, default=0, help="stop after this iteration index (rounds keep one KL horizon = --iters)"); ap.add_argument("--kl-floor", type=float, default=0.0, help="minimum KL-to-BC coefficient (style preservation for team doubles)")
   333	    ap.add_argument("--team", default="dsm")
   334	    ap.add_argument("--vf", type=float, default=.5)
   335	    ap.add_argument("--value-warmup", type=int, default=0, help="value-only iterations before policy updates")
   336	    ap.add_argument("--device", default="cuda")
   337	    ap.add_argument("--amp", default="none", choices=["none", "bf16"])
   338	    ap.add_argument("--resume", action="store_true")
   339	    ap.add_argument("--seed", type=int, default=0)
   340	    ap.add_argument("--league-snapshot", action="append", default=[], metavar="CKPT")
   341	    ap.add_argument("--league-double", action="append", default=[], metavar="CKPT")
   342	    a = ap.parse_args()
   343	    os.makedirs(a.out, exist_ok=True)
   344	    if not 0 < a.gamma <= 1 or not 0 <= a.lam <= 1:
   345	        ap.error("gamma must be in (0,1] and lambda in [0,1]")
   346	    dev = a.device
   347	    torch.manual_seed(a.seed)
   348	    if a.amp == "bf16":
   349	        policy.AMP = torch.bfloat16
   350	    source_ck = torch.load(a.init, map_location=dev)
   351	    net = _new_net(source_ck, dev)
   352	    bc = _new_net(source_ck, dev).eval()
   353	    for parameter in bc.parameters():
   354	        parameter.requires_grad_(False)
   355	    teams = source_ck.get("teams", ["mmpq", "dsm", "mgoose"])
   356	    if a.team not in teams:
   357	        ap.error(f"team {a.team!r} absent from checkpoint teams={teams}")
   358	    team = torch.zeros((1, len(teams)), device=dev)
   359	    team[0, teams.index(a.team)] = 1
   360	    opt = torch.optim.Adam(net.parameters(), lr=a.lr)
   361	    start = 0
   362	    last = f"{a.out}/last.pt"
   363	    if a.resume and os.path.exists(last):
   364	        start = _restore_resume(last, net, opt, dev)
   365	        print("resumed at iter", start, flush=True)
   366	    league = _league_from_args(a, source_ck, net, bc, dev)
   367	    ve = VecKaggriculture(a.envs, device=dev)
   368	    with open(f"{a.out}/args.json", "w") as fh:
   369	        json.dump({**vars(a), "league_effective": {k: v[1] for k, v in league.items()}}, fh, indent=1)
   370	    log = open(f"{a.out}/log.jsonl", "a")
   371	    for it in range(start, min(a.iters, a.stop_at) if a.stop_at else a.iters):
   372	        t0 = time.time()
   373	        net.eval()
   374	        buf, final, action_metric, league_counts = rollout(
   375	            net, ve, a.envs, dev, team, seed_base=1_000_003 * (it + 1) + 7_919 * a.seed,
   376	            league=league,
   377	        )
   378	        roll_seconds = time.time() - t0
   379	        flat = buf.flat()
   380	        reward = buf.data["r"]
   381	        values = buf.data["v"]
   382	        adv, ret = gae(reward, values, a.gamma, a.lam)
   383	        data = {k: flat[k] for k in REC_KEYS + ("logp",)}
   384	        data["adv"] = adv.reshape(-1)
   385	        data["ret"] = ret.reshape(-1)
   386	        data["v"] = values.reshape(-1)
   387	        data["adv"] = (data["adv"] - data["adv"].mean()) / (data["adv"].std() + 1e-8)
   388	        del buf
   389	        samples = data["adv"].numel()
   390	        stats = Counter()
   391	        n_updates = 0
   392	        net.train()
   393	        value_only = it < a.value_warmup
   394	        _set_value_warmup_trainable(net, value_only)
   395	        for epoch in range(a.epochs):
   396	            permutation = torch.randperm(samples, device=dev)
   397	            for offset in range(0, samples, a.mb):
   398	                idx = permutation[offset:offset + a.mb]
   399	                rec = {k: data[k][idx] for k in REC_KEYS}
   400	                board = rec["board"].float()
   401	                ul, tl, ml, value = net.full(board, rec["G"], rec["uv"], rec["ux"].long(), rec["uy"].long(), rec["umask"])
   402	                logp, raw_entropy = policy.logprob(ul, tl, ml, rec)
   403	                entropy = _entropy_parts(raw_entropy)
   404	                ent_total = _entropy_total(entropy)
   405	                log_ratio = logp - data["logp"][idx]
   406	                ratio = torch.exp(log_ratio)
   407	                advantage = data["adv"][idx]
   408	                policy_loss = -torch.min(ratio * advantage, ratio.clamp(1 - a.clip, 1 + a.clip) * advantage).mean()
   409	                value_loss = F.smooth_l1_loss(value, data["ret"][idx])
   410	                with torch.no_grad():
   411	                    bul, btl, bml, _ = bc.full(board, rec["G"], rec["uv"], rec["ux"].long(), rec["uy"].long(), rec["umask"])
   412	                unit_mask = rec["umask"].float()
   413	                def kl(p_logits, q_logits, mask=None):
   414	                    lp, lq = F.log_softmax(p_logits, -1), F.log_softmax(q_logits, -1)
   415	                    val = (lp.exp() * (lp - lq)).sum(-1)
   416	                    return (val * mask).sum() / mask.sum().clamp(min=1) if mask is not None else val.mean()
   417	                mm = lambda x: policy.market_mask(x, rec["hire_max"].long(), rec["land_max"].long())
   418	                kl_bc = (kl(btl, tl, unit_mask) +
   419	                         kl(policy._masked(bul, rec["opm"]), policy._masked(ul, rec["opm"]), unit_mask) + kl(mm(bml), mm(ml)))
   420	                kl_coef = max(a.kl_floor, a.kl * max(0.0, 1 - it / max(1, a.iters)))
