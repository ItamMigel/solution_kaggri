   146	
   147	MKT_ORDER = (["SELL:" + p for p in PRODUCTS] + ["HIRE"] + ["BUY_ANIMAL:" + a for a in ANIMALS]
   148	             + ["BUY_SEED:" + c for c in CROPS] + ["BUY_PRODUCT:WHEAT", "BUY_PRODUCT:FERTILIZER", "BUY_LAND"])
   149	
   150	
   151	def decode_market(q):
   152	    orders = []
   153	    for key in MKT_ORDER:
   154	        n = int(q[MKT_IDX[key]])
   155	        if n <= 0:
   156	            continue
   157	        if key in ("HIRE", "BUY_LAND"):
   158	            orders += [[key]] * n
   159	        elif key.startswith("BUY_ANIMAL"):
   160	            orders += [["BUY_ANIMAL", key.split(":")[1], 1]] * n
   161	        else:
   162	            op, it = key.split(":"); orders.append([op, it, n])
   163	    return orders[:10]
