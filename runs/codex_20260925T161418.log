   169	
   170	def logprob(ul, tl, ml, rec):
   171	    """Recompute log-prob / entropies of recorded choices. Unit: log p(target) + log p(op | recorded mask).
   172	    Market: sum over keys that were decision-relevant (bucket 0 or actually emitted; truncated keys excluded)."""
   173	    umask = rec["umask"]; t = rec["t"].long() % 100; o = rec["o"].long() % NOP
   174	    tlp = F.log_softmax(tl, -1); lp_t = tlp.gather(-1, t[..., None]).squeeze(-1)
   175	    olp = F.log_softmax(ul.masked_fill(~rec["opm"], -1e9), -1); lp_o = olp.gather(-1, o[..., None]).squeeze(-1)
   176	    unit_lp = ((lp_t + lp_o) * umask).sum(-1)
   177	    mlp = F.log_softmax(market_mask(ml, rec["hire_max"].long(), rec["land_max"].long()), -1)
   178	    lp_m = (mlp.gather(-1, rec["mb"].long()[..., None]).squeeze(-1) * rec["minc"]).sum(-1)
   179	    ent_t = (-(tlp.exp() * tlp).sum(-1) * umask).sum(-1)
   180	    ent_o = (-(olp.exp() * olp.clamp(min=-30)).sum(-1) * umask).sum(-1)
   181	    ent_m = -(mlp.exp() * mlp.clamp(min=-30)).sum(-1).sum(-1)
   182	    return unit_lp + lp_m, dict(target=ent_t, op=ent_o, market=ent_m, total=ent_t + ent_o + ent_m)
   183	
