   197	def build_market(mb):
   198	    """Fixed key order; HIRE/LAND/ANIMAL one unit per order; others one order with qty; first MAX_ORDERS kept.
   199	    No client-side affordability: the engine fills partially / funds buys from earlier sells exactly.
   200	    Returns orders [B,10,3] and inc [B,NK] = key is decision-relevant (bucket 0, or >=1 order emitted)."""
   201	    dev = mb.device; B = mb.shape[0]; q = mb.long()
   202	    R = O.MAX_ORDERS; mop = MOP.to(dev); mit = MIT.to(dev); order = MORDER.to(dev)
   203	    kop = mop[order]; kit = mit[order]; K = len(order)
   204	    rep_key = (kop == O.MKT_HIRE) | (kop == O.MKT_BUY_LAND) | (kop == O.MKT_BUY_ANIMAL)
   205	    qo = q[:, order]; r = torch.arange(R, device=dev)
   206	    want = torch.where(rep_key[None, :, None], qo[..., None] > r, (qo[..., None] > 0) & (r == 0))
   207	    qty = torch.where(rep_key[None, :, None], torch.ones_like(qo)[..., None].expand(-1, -1, R), qo[..., None].expand(-1, -1, R))
   208	    wf = want.reshape(B, -1); rank = torch.cumsum(wf.long(), 1) - 1; ok = wf & (rank < O.MAX_ORDERS)
   209	    val = torch.stack([kop[:, None].expand(-1, R).reshape(1, -1).expand(B, -1), kit[:, None].expand(-1, R).reshape(1, -1).expand(B, -1), qty.reshape(B, -1)], -1)
   210	    dst = torch.where(ok, rank, torch.full_like(rank, O.MAX_ORDERS))
   211	    buf = torch.zeros((B, O.MAX_ORDERS + 1, 3), dtype=torch.long, device=dev)
   212	    buf.scatter_(1, dst[..., None].expand(-1, -1, 3), val * ok[..., None])
   213	    emitted_o = ok.view(B, K, R).any(-1)                      # per key in emission order
   214	    inc_o = (qo == 0) | emitted_o
   215	    inc = torch.zeros((B, NK), dtype=torch.bool, device=dev); inc[:, order] = inc_o
   216	    return buf[:, :O.MAX_ORDERS], inc
   217	
