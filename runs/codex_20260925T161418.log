    56	def batch(D, idx, dev):
    57	    B = torch.from_numpy(D["B"][idx].astype(np.float32)).to(dev); G = torch.from_numpy(D["G"][idx]).to(dev)
    58	    Q = torch.from_numpy(D["Q"][idx]).to(dev); W = torch.from_numpy(D["w"][idx]).to(dev)
    59	    us = [np.arange(D["ustart"][i], D["ustart"][i + 1]) for i in idx]
    60	    bi = np.concatenate([np.full(len(u), k) for k, u in enumerate(us)]); ui = np.concatenate(us)
    61	    t = lambda a: torch.from_numpy(a).to(dev)
    62	    return B, G, Q, W, t(bi), t(D["ux"][ui]), t(D["uy"][ui]), t(D["uv"][ui]), t(D["ua"][ui]), t(D["tc"][ui])
    63	
    64	def evaluate(net, D, dev, bs=512):
    65	    net.eval(); uc = un = 0; mc = mn = 0; mall = 0; tcc = 0; nzc = nzn = 0
    66	    with torch.no_grad():
    67	        for s in range(0, len(D["G"]), bs):
    68	            idx = np.arange(s, min(len(D["G"]), s + bs))
    69	            B, G, Q, W, bi, ux, uy, uv, ua, tc = batch(D, idx, dev)
    70	            ul, ml, tl = net(B, G, bi, ux, uy, uv)
    71	            uc += (ul.argmax(1) == ua).sum().item(); un += len(ua); tcc += (tl.argmax(1) == tc).sum().item()
    72	            mp = ml.argmax(2); nz = Q > 0; nzc += ((mp == Q) & nz).sum().item(); nzn += nz.sum().item(); mc += (mp == Q).sum().item(); mn += Q.numel(); mall += (mp == Q).all(1).sum().item()
    73	    net.train(); return dict(mkt_nz_acc=nzc / max(1, nzn), unit_acc=uc / un, target_acc=tcc / un, mkt_key_acc=mc / mn, mkt_exact=mall / len(D["G"]))
    74	
    75	if __name__ == "__main__":
    76	    ap = argparse.ArgumentParser(); ap.add_argument("--data", default="mmpq,dsm,mgoose"); ap.add_argument("--out", required=True)
    77	    ap.add_argument("--ch", type=int, default=96); ap.add_argument("--blocks", type=int, default=6)
    78	    ap.add_argument("--root", default=os.environ.get("BC_DATA", "/workspace/shared/bc_data")); ap.add_argument("--epochs", type=int, default=20); ap.add_argument("--bs", type=int, default=256); ap.add_argument("--lr", type=float, default=1e-3)
    79	    a = ap.parse_args(); os.makedirs(a.out, exist_ok=True); dev = "cuda"
    80	    D = load(a.data.split(","), root=a.root); gdim = D["train"]["G"].shape[1]
    81	    teams = a.data.split(","); net = Net(gdim, a.ch, a.blocks).to(dev); opt = torch.optim.AdamW(net.parameters(), a.lr, weight_decay=1e-4)
    82	    n = len(D["train"]["G"]); steps = a.epochs * (n // a.bs); sched = torch.optim.lr_scheduler.OneCycleLR(opt, a.lr, total_steps=steps)
    83	    log = open(f"{a.out}/log.jsonl", "w"); it = 0; best = -1
    84	    for ep in range(a.epochs):
    85	        perm = np.random.permutation(n); t0 = time.time()
    86	        for s in range(0, n - a.bs + 1, a.bs):
    87	            B, G, Q, W, bi, ux, uy, uv, ua, tc = batch(D["train"], perm[s:s + a.bs], dev)
    88	            ul, ml, tl = net(B, G, bi, ux, uy, uv)
    89	            lt = (F.cross_entropy(tl, tc, reduction="none") * W[bi]).mean()
    90	            lu = (F.cross_entropy(ul, ua, reduction="none") * W[bi]).mean()
    91	            lm = (F.cross_entropy(ml.reshape(-1, feat.MKT_MAX + 1), Q.reshape(-1), reduction="none").view(Q.shape).sum(1) * W).mean()
    92	            loss = lu + lt + 0.3 * lm; opt.zero_grad(); loss.backward(); nn.utils.clip_grad_norm_(net.parameters(), 1.0); opt.step(); sched.step(); it += 1
    93	        ev = evaluate(net, D["val"], dev); rec = dict(epoch=ep, lu=lu.item(), lm=lm.item(), secs=round(time.time() - t0), **ev)
    94	        print(json.dumps(rec), flush=True); log.write(json.dumps(rec) + "\n"); log.flush()
    95	        if ev["unit_acc"] + ev["target_acc"] > best:
    96	            best = ev["unit_acc"] + ev["target_acc"]; torch.save({"state": net.state_dict(), "gdim": gdim, "teams": teams, "ch": a.ch, "blocks": a.blocks}, f"{a.out}/best.pt")
     1	"""Observation -> tensors for behavioural cloning (numpy only; embedded verbatim into the BC agent).
     2	board: (C, 10, 10) own farm; glob: (G,) global vector; units: list of (x, y, unit_vec).
     3	Also the action vocabularies and encode/decode helpers."""
     4	import numpy as np
     5	
     6	N = 10
     7	CROPS = ["WHEAT", "CARROT", "TOMATO", "STRAWBERRY", "MELON"]
     8	FIRST_YIELD = {"WHEAT": 2, "CARROT": 2, "TOMATO": 8, "STRAWBERRY": 10, "MELON": 10}
     9	PRODUCTS = ["WHEAT", "CARROT", "TOMATO", "STRAWBERRY", "MELON", "EGG", "MILK", "WOOL", "FERTILIZER"]
    10	ANIMALS = ["GOOSE", "COW", "SHEEP"]
    11	ITEMS = PRODUCTS + ANIMALS
    12	SHOPS = ["BAKERY", "BRUNCH_SPOT", "FARMERS_MARKET", "ICE_CREAM_SHOP", "PET_CAFE", "PIZZA_SHOP", "SMOOTHIE_SHOP", "YARN_STORE"]
    13	SHED_ADJ = {(4, 4), (5, 4), (4, 5), (5, 5)}
    14	BASE_PRICE = {"WHEAT": 30, "CARROT": 45, "TOMATO": 90, "STRAWBERRY": 200, "MELON": 250, "EGG": 60, "MILK": 150, "WOOL": 200, "FERTILIZER": 100}
    15	
    16	UNIT_OPS = (["PASS", "NORTH", "SOUTH", "EAST", "WEST", "WATER", "HARVEST", "FERTILIZE", "DROP", "DIG",
    17	             "BUILD_COOP", "BUILD_PASTURE", "FEED", "COLLECT_FERTILIZER", "CARE"]
    18	            + ["PLANT:" + c for c in CROPS] + ["PICKUP:" + i for i in ITEMS] + ["PLACE:" + i for i in ITEMS])
    19	UNIT_IDX = {k: i for i, k in enumerate(UNIT_OPS)}
    20	MKT_KEYS = (["HIRE", "BUY_LAND"] + ["SELL:" + p for p in PRODUCTS] + ["BUY_SEED:" + c for c in CROPS]
    21	            + ["BUY_ANIMAL:" + a for a in ANIMALS] + ["BUY_PRODUCT:WHEAT", "BUY_PRODUCT:FERTILIZER"])
    22	MKT_IDX = {k: i for i, k in enumerate(MKT_KEYS)}
    23	MKT_MAX = 40  # quantity buckets 0..MKT_MAX (clipped)
    24	C_BOARD = 30
    25	
    26	
    27	def _g(d, k, default=None):
    28	    try:
    29	        v = d.get(k, default)
    30	    except AttributeError:
    31	        v = getattr(d, k, default)
    32	    return default if v is None else v
    33	
    34	
    35	def board_tensor(obs, p):
    36	    farm = obs["farms"][p]; day = int(_g(obs, "day", 0))
    37	    B = np.zeros((C_BOARD, N, N), np.float32)
    38	    tiles = farm["tiles"]
    39	    for y in range(N):
    40	        for x in range(N):
    41	            t = tiles[y][x]
    42	            if t is None:
    43	                B[0, y, x] = 1
    44	            elif t == "LOCKED":
    45	                B[1, y, x] = 1
    46	            elif isinstance(t, dict):
    47	                k = t.get("kind")
    48	                if k == "WEED":
    49	                    B[2, y, x] = 1
    50	                elif k == "PLANT":
    51	                    c = t.get("crop")
    52	                    if c in CROPS:
    53	                        B[3 + CROPS.index(c), y, x] = 1
    54	                        age = day - int(_g(t, "planted_day", day))
    55	                        B[8, y, x] = age / 10.0
    56	                        B[29, y, x] = 1.0 if age >= FIRST_YIELD[c] else 0.0
    57	                    B[9, y, x] = 1.0 if t.get("watered_today") else 0.0
    58	                    B[10, y, x] = float(_g(t, "yield_units", 0)) / 10.0
    59	                    B[11, y, x] = 1.0 if int(_g(t, "fertilized_until_day", -1)) >= day else 0.0
    60	                    B[12, y, x] = float(_g(t, "consecutive_unwatered", 0))
    61	                elif k in ("COOP", "PASTURE"):
    62	                    B[13 if k == "COOP" else 14, y, x] = 1
    63	                    a = t.get("animal")
    64	                    if a in ANIMALS:
    65	                        B[15 + ANIMALS.index(a), y, x] = 1
    66	                        B[18, y, x] = 1.0 if t.get("fed_today") else 0.0
    67	                        B[19, y, x] = 1.0 if t.get("cared_today") else 0.0
    68	                        B[20, y, x] = float(_g(t, "yield_units", 0)) / 10.0
    69	                        B[21, y, x] = float(_g(t, "fertilizer_available", 0)) / 5.0
    70	                        B[22, y, x] = float(_g(t, "pending_care_bonus", 0)) / 5.0
    71	                        B[23, y, x] = float(_g(t, "consecutive_unfed", 0))
    72	    fx, fy = farm["farmer"]; B[24, fy, fx] = 1
    73	    for h in farm.get("hands") or []:
    74	        B[25, h[1], h[0]] += 1
    75	    for (x, y) in SHED_ADJ:
    76	        B[26, y, x] = 1
    77	    B[27] = np.arange(N)[None, :] / 9.0
    78	    B[28] = np.arange(N)[:, None] / 9.0
    79	    return B
    80	
    81	
    82	def glob_vec(obs, p):
    83	    farm = obs["farms"][p]; opp = obs["farms"][1 - p]; m = obs["market"]; priv = obs.get("private") or {}
    84	    step = int(_g(obs, "step", 0))
    85	    v = [step / 719.0, int(_g(obs, "hour", step % 24)) / 23.0, int(_g(obs, "day", step // 24)) / 29.0,
    86	         float(farm["money"]) / 5e4, float(opp["money"]) / 5e4, np.log1p(max(0.0, float(farm["money"]))) / 12.0]
    87	    pr = m.get("prices") or {}; inv = m.get("inventory") or {}
    88	    v += [float(pr.get(i, 0)) / BASE_PRICE[i] for i in PRODUCTS]
    89	    v += [(10000.0 - float(inv.get(i, 10000))) / 500.0 for i in PRODUCTS]
    90	    shed = priv.get("shed") or {}; seeds = priv.get("seeds") or {}
    91	    v += [float(shed.get(i, 0)) / 50.0 for i in ITEMS]
    92	    v += [float(seeds.get(c, 0)) / 20.0 for c in CROPS]
    93	    v += [float(_g(farm, "hires_today", 0)) / 15.0, len(farm.get("hands") or []) / 15.0,
    94	          len(_g(farm, "unlocked_quadrants", [])) / 4.0, len(opp.get("hands") or []) / 15.0]
    95	    shops = list((_g(obs, "town", {}) or {}).get("unlocked_shops") or [])
    96	    v += [shops.count(s) / 2.0 for s in SHOPS]
    97	    v += [1.0 if shops[:2].count("YARN_STORE") else 0.0]
    98	    for f in (farm, opp):
    99	        cnt = {a: 0 for a in ANIMALS}; plants = {c: 0 for c in CROPS}
   100	        for row in f["tiles"]:
   101	            for t in row:
   102	                if isinstance(t, dict):
   103	                    if t.get("animal") in cnt: cnt[t["animal"]] += 1
   104	                    if t.get("kind") == "PLANT" and t.get("crop") in plants: plants[t["crop"]] += 1
   105	        v += [cnt[a] / 10.0 for a in ANIMALS] + [plants[c] / 20.0 for c in CROPS]
   106	    return np.asarray(v, np.float32)
   107	
   108	
   109	def unit_list(obs, p):
   110	    farm = obs["farms"][p]; priv = obs.get("private") or {}
   111	    invs = priv.get("inventories") or []
   112	    pos = [farm["farmer"]] + list(farm.get("hands") or [])
   113	    out = []
   114	    for i, (x, y) in enumerate(pos):
   115	        inv = invs[i] if i < len(invs) else {}
   116	        u = [1.0 if i == 0 else 0.0, x / 9.0, y / 9.0, 1.0 if (x, y) in SHED_ADJ else 0.0]
   117	        u += [float((inv or {}).get(it, 0)) / 10.0 for it in ITEMS]
   118	        u += [sum((inv or {}).values()) / 20.0 if inv else 0.0]
