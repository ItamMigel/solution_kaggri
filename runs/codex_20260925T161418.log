   103	def conservative_equity(st):
   104	    """Cash plus deliberately discounted immediately/liquidly usable assets.
   105	
   106	    It is a training shaping signal, never a claim about official terminal
   107	    money.  The last reward below corrects it exactly to the cash margin.
   108	    """
   109	    dev = st.money.device
   110	    prices = st.market_price().float()                         # [B, 9]
   111	    product = (st.shed[:, :, :O.N_PRODUCTS].float() +
   112	               st.inv[:, :, :, :O.N_PRODUCTS].float().sum(2))
   113	    # Selling an inventory moves the market curve and costs a market order;
   114	    # value it below the displayed marginal price.
   115	    assets = (product * prices[:, None, :] * 0.55).sum(-1)
   116	    seed_cost = torch.tensor(C.CROP_SEED_COST, device=dev, dtype=torch.float32)
   117	    animal_cost = torch.tensor(C.ANIMAL_COST, device=dev, dtype=torch.float32)
   118	    assets = assets + (st.seeds.float() * seed_cost[None, None, :] * 0.45).sum(-1)
   119	    animals_in_inv = st.inv[:, :, :, 9:12].float().sum(2)
   120	    assets = assets + (animals_in_inv * animal_cost[None, None, :] * 0.45).sum(-1)
   121	    # Mature crops have already produced an observable yield.  Their value is
   122	    # discounted further because collection/pathing can still fail.
   123	    day = int(st.step) // C.TURNS_PER_DAY
   124	    crop_first = torch.tensor(C.CROP_FIRST_YIELD_DAY, device=dev)
   125	    plant = st.kind == O.TILE_PLANT
   126	    mature = plant & ((day - st.tday.long()) >= crop_first[st.species.long().clamp(0, 4)])
   127	    crop_price = prices[:, None, None, :5].expand(-1, 2, st.kind.shape[-1], -1)
   128	    crop_unit_price = crop_price.gather(-1, st.species.long().clamp(0, 4).unsqueeze(-1)).squeeze(-1)
   129	    assets = assets + (mature.float() * st.tyield.float().clamp(min=0) * crop_unit_price * 0.20).sum(-1)
   130	    return st.money.float() + assets
