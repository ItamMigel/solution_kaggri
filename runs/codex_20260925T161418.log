    44	class PolicyNet(bctrain.Net):
    45	    def __init__(self, gdim, ch=96, blocks=6):
    46	        super().__init__(gdim, ch, blocks)
    47	        self.value = nn.Sequential(nn.Linear(2 * ch + gdim, 256), nn.ReLU(), nn.Linear(256, 1))
    48	
    49	    def full(self, B, G, uv, ux, uy, umask):
    50	        """B[N,C,10,10] G[N,g] uv[N,U,d] ux/uy[N,U] -> unit op logits [N,U,NOP], target logits [N,U,100], market [N,NK,NB], value [N]"""
    51	        if AMP is not None and B.is_cuda:
    52	            with torch.autocast("cuda", dtype=AMP):
    53	                h = self.trunk(B, G)
    54	            h = h.float()
    55	        else:
    56	            h = self.trunk(B, G)
    57	        N_, C = h.shape[:2]; U = ux.shape[1]
    58	        hu = h.flatten(2).gather(2, (uy * 10 + ux)[:, None, :].expand(N_, C, U)).transpose(1, 2)  # [N,U,C]
    59	        uin = torch.cat([hu, uv, G[:, None, :].expand(N_, U, G.shape[1])], -1)
    60	        ul = self.unit(uin)
    61	        tl = torch.einsum("nuc,ncp->nup", self.tq(uin), h.flatten(2)) / (C ** 0.5)
    62	        pooled = torch.cat([h.mean((2, 3)), h.amax((2, 3)), G], 1)
    63	        ml = self.mkt(pooled).view(-1, NK, NB)
    64	        return ul, tl, ml, self.value(pooled).squeeze(-1)
    65	
