    31	def _mkt_table():
    32	    op = torch.zeros(NK, dtype=torch.long); it = torch.zeros(NK, dtype=torch.long)
    33	    for i, k in enumerate(feat.MKT_KEYS):
    34	        name, _, item = k.partition(":")
    35	        op[i] = O.MARKET_OP_ID[name]; it[i] = O.ITEM_ID[item] if item else 0
