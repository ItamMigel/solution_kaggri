   428	                    stats["vloss"] += float(value_loss)
   429	                    stats["kl_bc"] += float(kl_bc)
   430	                    stats["approx_kl"] += float((data["logp"][idx] - logp).mean())
   431	                    stats["clipfrac"] += float(((ratio - 1).abs() > a.clip).float().mean())
