   154	def _balanced_seats(batch, dev, seed):
   155	    """Return a deterministic, exactly half player-one learner assignment."""
   156	    generator = torch.Generator(device=dev)
   157	    generator.manual_seed(seed)
   158	    seat_one = torch.zeros(batch, dtype=torch.bool, device=dev)
   159	    seat_one[torch.randperm(batch, device=dev, generator=generator)[:batch // 2]] = True
   160	    return seat_one
   161	
   162	
   163	def _swap_player_tensor(value, seat_one):
   164	    """For selected batch rows, exchange the player axis of a State/action tensor."""
   165	    if value.ndim < 2 or value.shape[0] != seat_one.numel() or value.shape[1] != 2:
   166	        return value
   167	    swapped = value[:, [1, 0]]
   168	    return torch.where(seat_one.view(-1, *([1] * (value.ndim - 1))), swapped, value)
   169	
   170	
   171	def _learner_view(state, seat_one):
   172	    """Present each learner as player zero without changing the real environment state."""
   173	    return replace(state, **{
   174	        field.name: _swap_player_tensor(getattr(state, field.name), seat_one)
   175	        for field in fields(state)
   176	    })
   177	
   178	
   179	def _world_actions(actions, seat_one):
   180	    """Map player-zero/player-one actions from learner coordinates back to world seats."""
   181	    return Actions(*(_swap_player_tensor(value, seat_one) for value in
   182	                     (actions.farmer, actions.hands, actions.market)))
   183	
   184	
   185	def _learner_margin(values, seat_one):
   186	    """Own-minus-opponent values for a [batch, two-player] tensor."""
   187	    return torch.where(seat_one, values[:, 1] - values[:, 0], values[:, 0] - values[:, 1])
   188	
   189	
   190	def _learner_value(values, seat_one):
   191	    return torch.where(seat_one, values[:, 1], values[:, 0])
   192	
   193	
   194	def rollout(net, ve, batch, dev, team, seed_base, league, greedy=False):
   195	    """Run the learner from a balanced mix of world seats against a fixed league draw."""
   196	    st = ve.reset(torch.arange(batch, device=dev) + seed_base)
   197	    so = gpufeat.ShopOrder(batch, dev)
   198	    names = list(league)
   199	    probs = [league[n][1] for n in names]
   200	    labels = _league_labels(batch, dev, seed_base ^ 0x9E3779B9, names, probs)
   201	    seat_one = _balanced_seats(batch, dev, seed_base ^ 0xC6A4A793)
   202	    buf = StreamingBuffer(STEPS, batch)
   203	    eq_prev = _learner_margin(conservative_equity(st), seat_one)
   204	    metric = {
   205	        "unit_hist": torch.zeros(O.N_UNIT_OPS, dtype=torch.int64, device=dev),
   206	        "market_hist": torch.zeros(O.N_MARKET_OPS, dtype=torch.int64, device=dev),
   207	        "active_units": torch.zeros((), dtype=torch.int64, device=dev),
   208	        "unit_noop": torch.zeros((), dtype=torch.int64, device=dev),
   209	        "market_noop": torch.zeros((), dtype=torch.int64, device=dev),
   210	        "league_counts": torch.bincount(labels, minlength=len(names)),
   211	        "learner_seat_one": seat_one.sum(),
   212	    }
   213	    with torch.no_grad():
   214	        for _ in range(STEPS):
   215	            so.update(st)
   216	            learner_state = _learner_view(st, seat_one)
   217	            out0 = policy.act(net, learner_state, 0, so, team, greedy=greedy)
   218	            # Calling each opponent on the full batch keeps ShopOrder state
   219	            # aligned and avoids host-side batch slicing in the hot loop.
   220	            opponent_out = {name: policy.act(league[name][0], learner_state, 1, so, league[name][2], greedy=False)
   221	                            for name in names}
   222	            out1 = _merge_actions(opponent_out, labels, names)
   223	            st, _, _, _ = ve.step(st, _world_actions(policy.combine(out0[0], out1), seat_one))
   224	            eq = conservative_equity(st)
   225	            equity_margin = _learner_margin(eq, seat_one)
   226	            reward = (equity_margin - eq_prev) / 1e4
   227	            eq_prev = equity_margin
   228	            _, logp, value, _, rec = out0
   229	            buf.put(rec, logp, value, reward)
   230	            farmer, hands, market = out0[0]
   231	            unit_ops = torch.cat((farmer[:, None, 0], hands[..., 0]), 1).long()
   232	            active = rec["umask"]
   233	            metric["unit_hist"] += torch.bincount(unit_ops[active], minlength=O.N_UNIT_OPS)
   234	            metric["active_units"] += active.sum()
   235	            metric["unit_noop"] += (unit_ops[active] == O.OP_PASS).sum()
   236	            market_ops = market[..., 0].long()
   237	            metric["market_hist"] += torch.bincount(market_ops.flatten(), minlength=O.N_MARKET_OPS)
   238	            metric["market_noop"] += (market_ops == O.MKT_NONE).sum()
   239	    # Sum of equity deltas is end equity difference.  Correct terminally to
   240	    # the true cash result required by the competition.
   241	    cash_margin = _learner_margin(st.money.float(), seat_one)
   242	    buf.terminal_add((cash_margin - eq_prev) / 1e4)
   243	    metric = {k: (v.detach().cpu() if torch.is_tensor(v) else v) for k, v in metric.items()}
   244	    league_counts = {name: int((labels == i).sum()) for i, name in enumerate(names)}
   245	    league_counts.update(learner_seat0=int((~seat_one).sum()), learner_seat1=int(seat_one.sum()))
   246	    return buf, _learner_value(st.money.float(), seat_one), metric, league_counts
   247	
   248	
   249	def gae(reward, value, gamma, lam):
   250	    steps = reward.shape[0]
   251	    adv = torch.zeros_like(reward)
   252	    last = torch.zeros_like(reward[0])
   253	    for t in reversed(range(steps)):
   254	        next_value = value[t + 1] if t + 1 < steps else torch.zeros_like(value[t])
   255	        delta = reward[t] + gamma * next_value - value[t]
   256	        last = delta + gamma * lam * last
   257	        adv[t] = last
   258	    return adv, adv + value
   259	
   260	
   261	def _explained_variance(pred, target):
   262	    var_y = torch.var(target)
   263	    if var_y <= 1e-12:
   264	        return torch.tensor(0.0, device=target.device)
   265	    return 1.0 - torch.var(target - pred) / var_y
   266	
   267	
   268	def _team_vec(ck, team, dev):
   269	    teams = ck.get("teams", ["mmpq", "dsm", "mgoose"]); v = torch.zeros((1, len(teams)), device=dev)
   270	    v[0, teams.index(team) if team in teams else 0] = 1
   271	    return v
   272	
   273	
   274	def _league_from_args(a, ck, net, bc, dev):
   275	    """Return name -> (net, probability, team_vec). --league-snapshot/--league-double accept CKPT or CKPT:TEAM
   276	    (TEAM = the team the opponent imitates; defaults to the learner's team)."""
   277	    def load(spec):
   278	        path, _, team = spec.partition(":")
   279	        oc = torch.load(path, map_location=dev)
   280	        return _new_net(oc, dev).eval(), _team_vec(oc, team or a.team, dev)
   280	        return _new_net(oc, dev).eval(), _team_vec(oc, team or a.team, dev)
   281	    snapshots = [load(s_) for s_ in a.league_snapshot]
   282	    doubles = [load(s_) for s_ in a.league_double]
   283	    own = _team_vec(ck, a.team, dev)
   284	    if not snapshots and not doubles:
   285	        return {"current": (net, 1.0, own)}
   286	    entries = [("current", net, .30, own)]
   287	    for i, (m, tv) in enumerate(snapshots):
   288	        entries.append((f"snapshot{i}", m, .35 / len(snapshots), tv))
   289	    for i, (m, tv) in enumerate(doubles):
   290	        entries.append((f"double{i}", m, .25 / len(doubles), tv))
   291	    entries.append(("bc_fallback", bc, .10, own))
   292	    total = sum(x[2] for x in entries)
   293	    return {name: (model, weight / total, tv) for name, model, weight, tv in entries}
   294	
   295	
   296	def _restore_resume(path, net, opt, dev):
   297	    ck = torch.load(path, map_location=dev)
   298	    net.load_state_dict(ck["state"])
   299	    if "optimizer" in ck:
   300	        opt.load_state_dict(ck["optimizer"])
   301	    if "rng_cpu" in ck:
   302	        torch.set_rng_state(ck["rng_cpu"].cpu())
   303	    if dev.startswith("cuda") and "rng_cuda" in ck:
   304	        torch.cuda.set_rng_state_all([x.cpu() for x in ck["rng_cuda"]])
   305	    return int(ck["iter"]) + 1
   306	
   307	
   308	def _save(path, net, opt, source_ck, teams, iteration):
   309	    payload = {
   310	        "state": net.state_dict(), "gdim": source_ck["gdim"], "teams": teams, "iter": iteration,
   311	        "optimizer": opt.state_dict(), "rng_cpu": torch.get_rng_state(),
   312	        "ch": source_ck.get("ch", 96), "blocks": source_ck.get("blocks", 6),
   313	    }
   314	    if torch.cuda.is_available():
   315	        payload["rng_cuda"] = torch.cuda.get_rng_state_all()
   316	    torch.save(payload, path)
