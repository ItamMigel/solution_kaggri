   134	
   135	
   136	def encode_market(orders):
   137	    q = np.zeros(len(MKT_KEYS), np.int64)
   138	    for o in orders or []:
   139	        if not isinstance(o, list) or not o:
   140	            continue
   141	        key = o[0] if o[0] in ("HIRE", "BUY_LAND") else o[0] + ":" + str(o[1]) if len(o) > 1 else o[0]
   142	        if key in MKT_IDX:
   143	            q[MKT_IDX[key]] += int(o[2]) if len(o) > 2 and o[0] not in ("HIRE", "BUY_LAND") else 1
