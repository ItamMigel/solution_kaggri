   158	def _masked(logits, mask):
   159	    return logits.masked_fill(~mask, -1e9)
   160	
   161	
   162	def market_mask(ml, hire_max, land_max):
   163	    b = torch.arange(NB, device=ml.device)
   164	    ml = ml.clone()
   165	    ml[:, feat.MKT_IDX["HIRE"]] = ml[:, feat.MKT_IDX["HIRE"]].masked_fill(b[None, :] > hire_max[:, None], -1e9)
   166	    ml[:, feat.MKT_IDX["BUY_LAND"]] = ml[:, feat.MKT_IDX["BUY_LAND"]].masked_fill(b[None, :] > land_max[:, None], -1e9)
   167	    return ml
