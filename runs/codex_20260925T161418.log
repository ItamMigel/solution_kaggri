   115	    bound = torch.where(is_sell, torch.minimum(remaining, shed_here), torch.zeros_like(remaining))
   116	    bound = torch.where(is_bp | is_bs | is_ba,
   117	                        torch.minimum(remaining, st.money // price0.clamp(min=1)), bound)
   118	    bound = torch.where(active, bound, torch.zeros_like(bound))
   119	    n_rounds = int(bound.max().item())
   120	    if n_rounds <= 0:
   121	        return
   122	    n_rounds = min(n_rounds, MARKET_UNIT_CAP)
   123	    if stats is not None:
   124	        stats["market_rounds"] = stats.get("market_rounds", 0) + n_rounds
   125	
   126	    item_p = item.clamp(0, O.N_PRODUCTS - 1)
   127	    crop_i = item.clamp(0, O.N_CROPS - 1).unsqueeze(-1)
   128	    item_iu = item_i.unsqueeze(-1)
   129	    for _ in range(n_rounds):
   130	        alive = active & (remaining > 0)
   131	        price = _quote(st, tab, is_sell, is_bp, is_bs, is_ba, item)
   132	        shed_here = st.shed.gather(-1, item_iu).squeeze(-1)
   133	        ok_sell = alive & is_sell & (shed_here > 0)
   134	        # kaggle-environments 1.32.7 applies shedCapacity to every market
   135	        # purchase that lands in the shed (BUY_PRODUCT and BUY_ANIMAL), but
   136	        # never to seeds.  Check it on each lockstep unit as the interpreter
   137	        # does, because an order can run out of room mid-quantity.
   138	        shed_room = st.shed.sum(-1) < SHED_CAPACITY
   139	        needs_shed = is_bp | is_ba
   140	        ok_buy = (alive & (is_bp | is_bs | is_ba) & (st.money >= price)
   141	                  & (~needs_shed | shed_room))
   142	        ok = ok_sell | ok_buy
   143	
   144	        st.money += torch.where(ok_sell, price, 0) - torch.where(ok_buy, price, 0)
   145	        d_shed = (ok & (is_bp | is_ba)).to(torch.int64) - ok_sell.to(torch.int64)
   146	        st.shed.scatter_add_(-1, item_iu, d_shed.unsqueeze(-1))
   147	        st.seeds.scatter_add_(-1, crop_i, (ok & is_bs).to(torch.int64).unsqueeze(-1))
   148	        d_mkt = (ok_sell & (price > 1)).to(torch.int64) - (ok & is_bp).to(torch.int64)
   149	        st.market_inv.scatter_add_(-1, item_p, d_mkt)
   150	
   151	        remaining = remaining - ok.to(remaining.dtype)
   152	        active = active & (~alive | ok)
   153	
   154	
   155	# --------------------------------------------------------------------------- #
   156	def _sell_closed(tab, item, v0, cmax):
   157	    """One player selling ``cmax`` units alone from table coord ``v0``.
   158	
   159	    Returns (revenue, market-inventory delta).  Once the price reaches the floor
   160	    the source stops crediting supply (``if price > 1``), so inventory advances
   161	    by at most ``floor_idx - v0`` and the rest sells at $1.
   162	    """
   163	    n = tab.inv_n
   164	    floor = tab.price_floor_idx[item]
   165	    k = torch.minimum(cmax, (floor - v0).clamp(min=0))
   166	    cum = tab.price_cumsum
   167	    rev = (cum[item, (v0 + k).clamp(0, n)] - cum[item, v0.clamp(0, n)]) + (cmax - k)
   168	    return rev, k
   169	
   170	
   171	def _bp_closed(tab, item, v0, money, n):
   172	    """BUY_PRODUCT: prices are P(v0-1), P(v0-2), ... (rising).  The largest k with
   173	    cumulative cost <= money, found by binary search on the price prefix sums."""
   174	    cum = tab.price_cumsum
   175	    base = cum[item, v0.clamp(0, tab.inv_n)]
   176	    target = base - money
   177	    lo = (v0 - n).clamp(min=0)
   178	    hi = v0.clone()
   179	    for _ in range(_BSEARCH_ITERS):
   180	        mid = (lo + hi) // 2
   181	        ge = cum[item, mid.clamp(0, tab.inv_n)] >= target
   182	        hi = torch.where(ge, mid, hi)
   183	        lo = torch.where(ge, lo, mid + 1)
   184	    k = (v0 - lo).clamp(min=0).minimum(n)
   185	    cost = base - cum[item, (v0 - k).clamp(0, tab.inv_n)]
   186	    return k, cost
   187	
   188	
   189	def _lane_fast(st, tab, op, item, qty, need_bp: bool, coupled_any: bool, stats=None):
   190	    is_sell, is_bp, is_bs, is_ba, active = _classify(op, item, qty)
   191	
   192	    is_mkt = is_sell | is_bp
   193	    both = active[:, 0] & active[:, 1]
   194	    same = both & is_mkt[:, 0] & is_mkt[:, 1] & (item[:, 0] == item[:, 1])
   195	    both_sell = same & is_sell[:, 0] & is_sell[:, 1]
   196	    coupled = same & ~both_sell
   197	
   198	    if coupled_any:
   199	        _lane_loop(st, tab, op, item, qty, active_in=coupled.unsqueeze(-1), stats=stats)
   200	    fast = active & ~coupled.unsqueeze(-1)
   201	
   202	    item_i = item.clamp(0, O.N_ITEMS - 1)
   203	    item_p = item.clamp(0, O.N_PRODUCTS - 1)
   204	    crop_i = item.clamp(0, O.N_CROPS - 1)
   205	    v0 = st.market_inv.gather(-1, item_p) - tab.inv_lo
   206	
   207	    # ---- fixed-price orders (BUY_SEED / BUY_ANIMAL) -------------------------
   208	    m_fixed = fast & (is_bs | is_ba)
   209	    cost1 = torch.where(is_bs, tab.crop_seed_cost[crop_i],
   210	                        tab.animal_cost[(item - O.ITEM_GOOSE).clamp(0, O.N_ANIMALS - 1)])
   211	    shed_room = (SHED_CAPACITY - st.shed.sum(-1)).clamp(min=0)
   212	    affordable = torch.minimum(qty, st.money // cost1.clamp(min=1))
   213	    cnt = torch.where(m_fixed,
   214	                      torch.where(is_ba, torch.minimum(affordable, shed_room), affordable),
   215	                      0)
   216	    st.money -= cnt * cost1
   217	    st.seeds.scatter_add_(-1, crop_i.unsqueeze(-1),
   218	                          torch.where(is_bs, cnt, 0).unsqueeze(-1))
   219	    st.shed.scatter_add_(-1, item_i.unsqueeze(-1),
   220	                         torch.where(is_ba, cnt, 0).unsqueeze(-1))
   221	
   222	    # ---- BUY_PRODUCT (never same-item across players here) ------------------
   223	    if need_bp:
   224	        m_bp = fast & is_bp
   225	        bp_qty = torch.minimum(qty, shed_room)
   226	        kbp, cost = _bp_closed(tab, item_p, v0, st.money, bp_qty)
   227	        kbp = torch.where(m_bp, kbp, 0)
   228	        cost = torch.where(m_bp, cost, 0)
   229	        st.money -= cost
   230	        st.shed.scatter_add_(-1, item_i.unsqueeze(-1), kbp.unsqueeze(-1))
   231	        st.market_inv.scatter_add_(-1, item_p, -kbp)
   232	        v0 = v0 - kbp                      # keep the local copy in sync
   233	
   234	    # ---- SELL ---------------------------------------------------------------
   235	    m_sell = fast & is_sell
   236	    shed_here = st.shed.gather(-1, item_i.unsqueeze(-1)).squeeze(-1)
   237	    cmax = torch.where(m_sell, torch.minimum(qty, shed_here), 0)
   238	
   239	    solo = m_sell & ~both_sell.unsqueeze(-1)
   240	    rev, dinv = _sell_closed(tab, item_p, v0, cmax)
   241	    rev = torch.where(solo, rev, 0)
   242	    dinv = torch.where(solo, dinv, 0)
   243	
   244	    if True:                                # mirror (both players, same item)
   245	        i0 = item_p[:, 0]
   246	        w0 = v0[:, 0]
   247	        c0, c1 = cmax[:, 0], cmax[:, 1]
   248	        kmin = torch.minimum(c0, c1)
   249	        d = (tab.price_floor_idx[i0] - w0).clamp(min=0)
   250	        kk = torch.minimum(kmin, (d + 1) // 2)
   251	        suf = tab.price_suf2
   252	        rev_each = (suf[i0, w0.clamp(0, tab.inv_n)] - suf[i0, (w0 + 2 * kk).clamp(0, tab.inv_n)]
   253	                    + (kmin - kk))
   254	        rev_x, dinv_x = _sell_closed(tab, i0, w0 + 2 * kk, torch.maximum(c0, c1) - kmin)
   255	        rev_each = torch.where(both_sell, rev_each, 0)
   256	        rev_x = torch.where(both_sell, rev_x, 0)
   257	        dinv_j = torch.where(both_sell, 2 * kk + dinv_x, 0)
   258	        rev = rev + torch.stack([rev_each + torch.where(c0 > c1, rev_x, 0),
   259	                                 rev_each + torch.where(c1 > c0, rev_x, 0)], dim=1)
   260	        st.market_inv.scatter_add_(-1, i0.unsqueeze(-1), dinv_j.unsqueeze(-1))
   261	
   262	    st.money += rev
   263	    st.shed.scatter_add_(-1, item_i.unsqueeze(-1), -cmax.unsqueeze(-1))
   264	    st.market_inv.scatter_add_(-1, item_p, dinv)
   265	
   266	
   267	# --------------------------------------------------------------------------- #
   268	N_SLOT_FLAGS = 5
   269	
   270	
   271	def slot_flags(market_actions) -> torch.Tensor:
   272	    """``[n_slots, 5]`` bool: (any order, any HIRE, any BUY_LAND, any BUY_PRODUCT,
   273	    any same-item SELL/BUY_PRODUCT collision) -- which passes each order slot
   274	    needs.  Derived from the actions alone, so the caller can fetch it to the
   275	    host in the same transfer as everything else it needs this step.
   276	    """
   277	    n_slots = min(market_actions.shape[2], MAX_MARKET_ORDERS)
   278	    ops_all = market_actions[:, :, :n_slots, 0]
   279	    items_all = market_actions[:, :, :n_slots, 1]
   280	    qty_all = market_actions[:, :, :n_slots, 2]
   281	    is_sell, is_bp, is_bs, is_ba, active = _classify(ops_all, items_all, qty_all)
   282	    is_mkt = is_sell | is_bp
   283	    same = (active[:, 0] & active[:, 1] & is_mkt[:, 0] & is_mkt[:, 1]
   284	            & (items_all[:, 0] == items_all[:, 1]))
   285	    coupled = same & ~(is_sell[:, 0] & is_sell[:, 1])
   286	    return torch.stack([
   287	        (ops_all != O.MKT_NONE).any(1).any(0),
   288	        (ops_all == O.MKT_HIRE).any(1).any(0),
   289	        (ops_all == O.MKT_BUY_LAND).any(1).any(0),
   290	        is_bp.any(1).any(0),
   291	        coupled.any(0),
   292	    ]).t()
   293	
   294	
   295	def process_market(st, market_actions, max_hands: int, stats=None, exact_loop=False,
   296	                   flags=None, graph_slot=None):
   297	    """``market_actions``: int64 ``[B, 2, MAX_ORDERS, 3]``.
   298	
   299	    ``flags``: optional host-side list of lists from ``slot_flags`` (pass it in to
   300	    avoid a second device->host sync per step).
   301	    ``graph_slot``: optional callable taking the slot's ``[B, 2, 3]`` action
   302	    tensor; when supplied it handles every slot that needs no host-side
   303	    branching (see ``market_slot_static``)."""
   304	    tab = get_tables(str(st.money.device))
   305	    n_slots = min(market_actions.shape[2], MAX_MARKET_ORDERS)
   306	    ops_all = market_actions[:, :, :n_slots, 0]
   307	    items_all = market_actions[:, :, :n_slots, 1]
   308	    qty_all = market_actions[:, :, :n_slots, 2]
   309	    if flags is None:
   310	        flags = slot_flags(market_actions).tolist()
   311	
   312	    for i in range(n_slots):
   313	        used, has_hire, has_land, has_bp, has_coupled = flags[i]
   314	        if not used:
   315	            continue
   316	        if (graph_slot is not None and not exact_loop
   317	                and not has_bp and not has_coupled):
   318	            # Cheap common case: no BUY_PRODUCT (no binary search) and no
   319	            # same-item SELL/BUY_PRODUCT collision (no lockstep fallback), so the
   320	            # slot is a fixed sequence of kernels -> replay it from a CUDA graph.
   321	            graph_slot(market_actions[:, :, i, :])
   322	            continue
   323	        op = ops_all[:, :, i]
   324	        if has_hire:
   325	            _do_hire(st, op == O.MKT_HIRE, tab, max_hands)
   326	        if has_land:
   327	            _do_buy_land(st, op == O.MKT_BUY_LAND, tab)
   328	        item = items_all[:, :, i]
   329	        qty = qty_all[:, :, i]
   330	        if exact_loop:
   331	            _lane_loop(st, tab, op, item, qty, stats=stats)
   332	        else:
   333	            _lane_fast(st, tab, op, item, qty, bool(has_bp), bool(has_coupled), stats)
   334	
   335	
   336	def market_slot_static(st, slot, max_hands: int):
   337	    """One order slot with no host-side branching: HIRE, BUY_LAND and the
   338	    closed-form lane, all mask-gated.  Assumes the slot needs neither the
   339	    BUY_PRODUCT binary search nor the coupled-lane fallback (the caller checks
   340	    that with the one sync it already does).  This is the CUDA-graph body."""
   341	    tab = get_tables(str(st.money.device))
   342	    op, item, qty = slot[:, :, 0], slot[:, :, 1], slot[:, :, 2]
   343	    _do_hire(st, op == O.MKT_HIRE, tab, max_hands)
   344	    _do_buy_land(st, op == O.MKT_BUY_LAND, tab)
   345	    _lane_fast(st, tab, op, item, qty, False, False, None)
   110	    fy = st.uy[:, :, u].to(torch.int64)
   111	
   112	    # ---------------- moves (source 308-316) ---------------------------------
   113	    is_move = act & (op <= O.OP_WEST)
   114	    mi = (op - O.OP_NORTH).clamp(0, 3)
   115	    nx = fx + tab.move_dx[mi]
   116	    ny = fy + tab.move_dy[mi]
   117	    inb = (nx >= 0) & (nx < BOARD_SIZE) & (ny >= 0) & (ny < BOARD_SIZE)
   118	    nflat = (ny.clamp(0, BOARD_SIZE - 1) * BOARD_SIZE + nx.clamp(0, BOARD_SIZE - 1)).unsqueeze(-1)
   119	    # 1.32.7 permits crossing into a LOCKED tile.  This matters at the shed:
   120	    # hands can spawn on one of its initially locked access tiles and otherwise
   121	    # would be stranded.  Tile operations still retain the guard below.
   122	    can_move = is_move & inb
   123	    st.ux[:, :, u] = torch.where(can_move, nx, fx).to(st.ux.dtype)
   124	    st.uy[:, :, u] = torch.where(can_move, ny, fy).to(st.uy.dtype)
   125	
   126	    flat = (fy * BOARD_SIZE + fx).unsqueeze(-1)
   127	
   128	    # ---------------- gather the standing tile -------------------------------
   129	    k = st.kind.gather(-1, flat).squeeze(-1).to(torch.int64)
   130	    sp = st.species.gather(-1, flat).squeeze(-1).to(torch.int64)
   131	    td = st.tday.gather(-1, flat).squeeze(-1).to(torch.int64)
   132	    ty = st.tyield.gather(-1, flat).squeeze(-1).to(torch.int64)
   133	    tw = st.tflag.gather(-1, flat).squeeze(-1)
   134	    tc = st.tcons.gather(-1, flat).squeeze(-1).to(torch.int64)
   135	    tm = st.tmls.gather(-1, flat).squeeze(-1).to(torch.int64)
   136	    tf = st.tfert.gather(-1, flat).squeeze(-1).to(torch.int64)
   137	    tcr = st.tcared.gather(-1, flat).squeeze(-1)
   138	    tfa = st.tfavail.gather(-1, flat).squeeze(-1)
   139	    tcb = st.tcare.gather(-1, flat).squeeze(-1).to(torch.int64)
   140	
   141	    # The 1.32.7 interpreter resolves PICKUP/DROP before rejecting operations
   142	    # on a LOCKED tile: three shed-access tiles begin locked, yet must remain
   143	    # usable as standing positions.  Other tile operations still no-op there.
   144	    shed_op = ((op == O.OP_PICKUP) | (op == O.OP_DROP) | (op == O.OP_PLACE))
   145	    act = act & ~is_move & ((k != O.TILE_LOCKED) | shed_op)
   146	
   147	    is_plant = k == O.TILE_PLANT
   148	    is_animal = k == O.TILE_ANIMAL
   149	    is_empty = k == O.TILE_EMPTY
   150	
   151	    inv = st.inv[:, :, u, :]
   152	    order = st.inv_order[:, :, u, :]
   153	    shed = st.shed
   154	
   155	    item_ok = (a1 >= 0) & (a1 < O.N_ITEMS)
   156	    item_i = a1.clamp(0, O.N_ITEMS - 1).unsqueeze(-1)
   157	    crop = a1.clamp(0, O.N_CROPS - 1)
   158	    crop_i = crop.unsqueeze(-1)
   159	    fert_i = torch.full_like(item_i, O.ITEM_FERTILIZER)
   160	    wheat_i = torch.zeros_like(item_i)          # ITEM_WHEAT == 0
   161	    one = torch.ones_like(td)
   162	
   163	    shed_adj = ((fx == HALF - 1) | (fx == HALF)) & ((fy == HALF - 1) | (fy == HALF))
   164	    room = (SHED_CAPACITY - shed.sum(-1)).clamp(min=0)
   165	
   166	    new_k, new_sp, new_td, new_ty = k, sp, td, ty
   167	    new_tw, new_tc, new_tm, new_tf = tw, tc, tm, tf
   168	    new_tcr, new_tfa, new_tcb = tcr, tfa, tcb
   169	
   170	    # ---------------- DROP (325-338) -----------------------------------------
   171	    greedy_drop(shed, inv, order, room, act & (op == O.OP_DROP) & shed_adj)
   172	
   173	    # ---------------- PICKUP (340-357) ---------------------------------------
   174	    m_pick = act & (op == O.OP_PICKUP) & shed_adj & (a2 > 0) & item_ok
   175	    npick = torch.minimum(a2, shed.gather(-1, item_i).squeeze(-1))
   176	    m_pick = m_pick & (npick > 0)
   177	    shed.scatter_add_(-1, item_i, -torch.where(m_pick, npick, 0).unsqueeze(-1))
   178	    _inv_add(inv, order, item_i, npick, m_pick, step)
   179	
   180	    # ---------------- PLANT (359-371) ----------------------------------------
   181	    m_plant = (act & (op == O.OP_PLANT) & (a1 >= 0) & (a1 < O.N_CROPS)
   182	               & is_empty & (st.seeds.gather(-1, crop_i).squeeze(-1) > 0)
   183	               & ~blocked.gather(-1, crop_i).squeeze(-1))
   184	    st.seeds.scatter_add_(-1, crop_i, -m_plant.to(torch.int64).unsqueeze(-1))
   185	    ongoing = tab.crop_ongoing[crop]
   186	    new_k = torch.where(m_plant, O.TILE_PLANT, new_k)
   187	    new_sp = torch.where(m_plant, crop, new_sp)
   188	    new_td = torch.where(m_plant, day, new_td)
   189	    new_ty = torch.where(m_plant, (~ongoing).to(torch.int64), new_ty)
   190	    new_tw = new_tw & ~m_plant
   191	    new_tc = torch.where(m_plant, one, new_tc)
   192	    new_tm = torch.where(m_plant,
   193	                         torch.where(ongoing, -one,
   194	                                     (day + tab.crop_max_yield_day[crop] + 1) * TURNS_PER_DAY),
   195	                         new_tm)
   196	    new_tf = torch.where(m_plant, -one, new_tf)
   197	    new_tcr = new_tcr & ~m_plant
   198	    new_tfa = new_tfa & ~m_plant
   199	    new_tcb = torch.where(m_plant, 0, new_tcb)
   200	
   201	    # ---------------- WATER (373-386) ----------------------------------------
   202	    m_water = act & (op == O.OP_WATER) & is_plant & ~tw
   203	    spc = sp.clamp(0, O.N_CROPS - 1)
   204	    age = day - td
   205	    in_window = ((~tab.crop_ongoing[spc]) & (age >= tab.crop_window_start[spc])
   206	                 & (age <= tab.crop_max_yield_day[spc]))
   207	    bonus = 1 + (tf >= day).to(torch.int64)
   208	    new_ty = torch.where(m_water & in_window,
   209	                         torch.minimum(tab.crop_max_yield[spc], ty + bonus), new_ty)
   210	    new_tw = new_tw | m_water
   211	
   212	    # ---------------- HARVEST (388-415) --------------------------------------
   213	    m_h = act & (op == O.OP_HARVEST) & (is_plant | is_animal) & (ty > 0)
   214	    c_ongoing = tab.crop_ongoing[spc]
   215	    m_hp = m_h & is_plant & (age >= tab.crop_first_yield[spc])
   216	    m_ha = m_h & is_animal
   217	    prod = torch.where(is_plant, spc, tab.animal_product[sp.clamp(0, O.N_ANIMALS - 1)])
   218	    m_harv = m_hp | m_ha
   219	    _inv_add(inv, order, prod.unsqueeze(-1), ty, m_harv, step)
   220	    new_ty = torch.where(m_harv, 0, new_ty)
   221	    new_k = torch.where(m_hp & ~c_ongoing, O.TILE_EMPTY, new_k)
   222	
   223	    # ---------------- FERTILIZE (417-424) ------------------------------------
   224	    m_fert = (act & (op == O.OP_FERTILIZE) & is_plant
   225	              & (inv.gather(-1, fert_i).squeeze(-1) > 0))
   226	    _inv_take(inv, order, fert_i, one, m_fert)
   227	    new_tf = torch.where(m_fert, torch.maximum(tf, (day + 2) * one), new_tf)
   228	
   229	    # ---------------- DIG (426-433) ------------------------------------------
   230	    new_k = torch.where(act & (op == O.OP_DIG) & ~is_empty & ~is_animal,
   231	                        O.TILE_EMPTY, new_k)
   232	
   233	    # ---------------- BUILD_COOP / BUILD_PASTURE (435-445) --------------------
   234	    new_k = torch.where(act & (op == O.OP_BUILD_COOP) & is_empty, O.TILE_COOP, new_k)
   235	    new_k = torch.where(act & (op == O.OP_BUILD_PASTURE) & is_empty, O.TILE_PASTURE, new_k)
   236	
   237	    # ---------------- PLACE (447-478) ----------------------------------------
   238	    aidx = (a1 - O.ITEM_GOOSE).clamp(0, O.N_ANIMALS - 1)
   239	    m_place = act & (op == O.OP_PLACE)
   240	    m_pab = (m_place & (a1 >= O.ITEM_GOOSE) & (a1 < O.ITEM_GOOSE + O.N_ANIMALS)
   241	             & (k == tab.animal_structure[aidx]))
   242	    held = inv.gather(-1, item_i).squeeze(-1)
   243	    m_pa = m_pab & (held > 0)
   244	    _inv_take(inv, order, item_i, one, m_pa)
   245	    new_k = torch.where(m_pa, O.TILE_ANIMAL, new_k)
   246	    new_sp = torch.where(m_pa, aidx, new_sp)
   247	    new_td = torch.where(m_pa, day, new_td)
   248	    new_ty = torch.where(m_pa, 0, new_ty)
   249	    new_tw = new_tw & ~m_pa
   250	    new_tc = torch.where(m_pa, 0, new_tc)
   251	    new_tm = torch.where(m_pa, 0, new_tm)
   252	    new_tf = torch.where(m_pa, 0, new_tf)
   253	    new_tcr = new_tcr & ~m_pa
   254	    new_tfa = new_tfa & ~m_pa
   255	    new_tcb = torch.where(m_pa, 0, new_tcb)
   256	
   257	    # shed-drop branch: only when the animal branch did not fire at all
   258	    nplace = torch.minimum(torch.minimum(a2, inv.gather(-1, item_i).squeeze(-1)), room)
   259	    m_ps = m_place & ~m_pab & shed_adj & (a2 > 0) & item_ok & (nplace > 0)
   260	    _inv_take(inv, order, item_i, nplace, m_ps)
   261	    shed.scatter_add_(-1, item_i, torch.where(m_ps, nplace, 0).unsqueeze(-1))
   262	
   263	    # ---------------- FEED (480-488) -----------------------------------------
   264	    m_feed = (act & (op == O.OP_FEED) & is_animal & ~tw
   265	              & (inv.gather(-1, wheat_i).squeeze(-1) > 0))
   266	    _inv_take(inv, order, wheat_i, one, m_feed)
   267	    new_tw = new_tw | m_feed
   268	
   269	    # ---------------- COLLECT_FERTILIZER (490-497) ---------------------------
   270	    m_cf = act & (op == O.OP_COLLECT_FERTILIZER) & is_animal & tfa
   271	    new_tfa = new_tfa & ~m_cf
   272	    _inv_add(inv, order, fert_i, one, m_cf, step)
   273	
   274	    # ---------------- CARE (499-505) -----------------------------------------
   275	    new_tcr = new_tcr | (act & (op == O.OP_CARE) & is_animal & ~tcr)
   276	
   277	    # ---------------- clear payload whenever the tile became bare ------------
   278	    bare = (new_k != k) & (new_k != O.TILE_ANIMAL) & (new_k != O.TILE_PLANT)
   279	    new_sp = torch.where(bare, 0, new_sp)
   280	    new_td = torch.where(bare, 0, new_td)
   281	    new_ty = torch.where(bare, 0, new_ty)
   282	    new_tw = new_tw & ~bare
   283	    new_tc = torch.where(bare, 0, new_tc)
   284	    new_tm = torch.where(bare, 0, new_tm)
   285	    new_tf = torch.where(bare, 0, new_tf)

