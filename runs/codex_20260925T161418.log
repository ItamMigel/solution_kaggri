   435	        unit_hist = action_metric["unit_hist"].tolist()
   436	        market_hist = action_metric["market_hist"].tolist()
   437	        active_units = max(1, int(action_metric["active_units"]))
   438	        market_slots = max(1, a.envs * STEPS * O.MAX_ORDERS)
   439	        record = {
   440	            "iter": it,
   441	            "money_mean": final.mean().item(),
   442	            "money_p90": final.flatten().quantile(.9).item(),
   443	            "money_max": final.max().item(),
   444	            "equity_reward_mean": reward.mean().item(),
   445	            "explained_variance": _explained_variance(data["v"], data["ret"]).item(),
   446	            "value_only": value_only,
   447	            "secs_roll": round(roll_seconds),
   448	            "secs": round(time.time() - t0),
   449	            "samples": samples,
   450	            "league_envs": league_counts,
   451	            "unit_op_distribution": [x / active_units for x in unit_hist],
   452	            "market_op_distribution": [x / market_slots for x in market_hist],
   453	            "unit_noop_fraction": int(action_metric["unit_noop"]) / active_units,
   454	            "market_noop_fraction": int(action_metric["market_noop"]) / market_slots,
   455	            # The gpuenv currently exposes no per-action rejection bit.  F11
   456	            # will add it; until then this is explicitly an honest placeholder.
   457	            "rejected_actions": None,
   458	        }
   459	        record.update({key: value / max(1, n_updates) for key, value in stats.items()})
   460	        print(json.dumps(record), flush=True)
   461	        log.write(json.dumps(record) + "\n")
   462	        log.flush()
   463	        _save(last, net, opt, source_ck, teams, it)
   464	        if it % 5 == 4:
   465	            _save(f"{a.out}/it{it:03d}.pt", net, opt, source_ck, teams, it)
