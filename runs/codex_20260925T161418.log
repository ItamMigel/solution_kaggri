    53	def _set_value_warmup_trainable(net, value_only):
    54	    """During critic warm-up, keep the BC policy distribution exactly frozen.
    55	
    56	    ``PolicyNet.value`` reads the shared convolutional trunk.  Merely removing
    57	    the policy loss still backpropagates a value loss through that trunk, which
    58	    changes action logits before the first PPO update.  The warm-up contract is
    59	    narrower: fit the new, separate value head only; enable every parameter
    60	    again for the first policy iteration.
    61	    """
    62	    for name, parameter in net.named_parameters():
    63	        parameter.requires_grad_(not value_only or name.startswith("value."))
    64	
