    70	def tile_masks(st, p, ux, uy, umask):
    71	    """Static (pre-allocation) per-unit legality following kaggriculture.py _apply_unit_action exactly.
    72	    Returns base [B,U,NOP] (excluding PLANT/PICKUP, which depend on running seeds/shed) and helper tensors."""
    73	    dev = ux.device; B, U = ux.shape
    74	    kind = st.kind[:, p].long(); cell = uy * 10 + ux
    75	    g = lambda t: t.gather(1, cell)
    76	    tk = g(kind); sp = g(st.species[:, p].long()); flag = g(st.tflag[:, p]); yld = g(st.tyield[:, p].long())
    77	    cared = g(st.tcared[:, p]); favail = g(st.tfavail[:, p]); age = int(st.step) // 24 - g(st.tday[:, p].long())
    78	    inv = st.inv[:, p].long()
    79	    m = torch.zeros((B, U, NOP), dtype=torch.bool, device=dev)
    80	    for mid, (dx, dy) in DXY.items():
    81	        nx = ux + dx; ny = uy + dy
    82	        m[..., mid] = (nx >= 0) & (nx < 10) & (ny >= 0) & (ny < 10)          # LOCKED tiles are walkable
    83	    locked = tk == O.TILE_LOCKED
    84	    plant = tk == O.TILE_PLANT; animal = tk == O.TILE_ANIMAL; empty = tk == O.TILE_EMPTY
    85	    first_yield = gpufeat.FIRST_YIELD.to(dev)[sp.clamp(0, 4)]
    86	    m[..., IDX["WATER"]] = plant & ~flag
    87	    m[..., IDX["HARVEST"]] = ((plant & (age >= first_yield)) | animal) & (yld > 0)
    88	    m[..., IDX["FERTILIZE"]] = plant & (inv[..., O.ITEM_FERTILIZER] > 0)
    89	    m[..., IDX["FEED"]] = animal & ~flag & (inv[..., O.ITEM_WHEAT] > 0)
    90	    m[..., IDX["CARE"]] = animal & ~cared
    91	    m[..., IDX["COLLECT_FERTILIZER"]] = animal & favail
    92	    m[..., IDX["BUILD_COOP"]] = empty; m[..., IDX["BUILD_PASTURE"]] = empty
    93	    m[..., IDX["DIG"]] = ~empty & ~locked & ~animal
    94	    adj = gpufeat.SHED_ADJ_MASK.to(dev)[cell]
    95	    m[..., IDX["DROP"]] = adj & (inv.sum(-1) > 0)
    96	    for it, name in enumerate(feat.ITEMS):
    97	        has = inv[..., it] > 0
    98	        if it >= 9:
    99	            on_struct = (tk == int(STRUCT_OF_ANIMAL[it - 9]))
   100	            m[..., IDX["PLACE:" + name]] = has & (on_struct | adj)
   101	        else:
   102	            m[..., IDX["PLACE:" + name]] = has & adj
   103	    m[..., IDX["PASS"]] = True
   104	    m &= umask[..., None]; m[..., IDX["PASS"]] = True
   105	    return m, dict(empty=empty & ~locked, adj=adj)
   106	
   107	
   108	PLANT_IDS = [IDX["PLANT:" + c] for c in feat.CROPS]
   109	PICK_IDS = [IDX["PICKUP:" + i] for i in feat.ITEMS]
   110	MOVE_T = torch.tensor(MOVE_IDS)
   111	
   112	
   113	def act(net, st, p, so, team_vec, greedy=False):
   114	    board, G, uv, ux, uy, umask = gpufeat.features(st, p, so)
   115	    G = torch.cat([G, team_vec.expand(G.shape[0], -1)], 1)
   116	    ul, tl, ml, v = net.full(board, G, uv, ux, uy, umask)
   117	    B, U = ux.shape; dev = ux.device
   118	    base, aux = tile_masks(st, p, ux, uy, umask)
   119	    # targets: any cell (LOCKED shed-access tiles are legitimate destinations)
   120	    t = tl.argmax(-1) if greedy else torch.distributions.Categorical(logits=tl).sample()
   121	    cur = uy.long() * 10 + ux.long(); tx = t % 10; ty = t // 10
   122	    want = torch.zeros((B, U, NOP), dtype=torch.bool, device=dev)
   123	    want[..., IDX["EAST"]] = tx > ux; want[..., IDX["WEST"]] = tx < ux; want[..., IDX["SOUTH"]] = ty > uy; want[..., IDX["NORTH"]] = ty < uy
   124	    seeds_left = st.seeds[:, p].long().clone(); shed_left = st.shed[:, p].long().clone()
   125	    used = torch.zeros((B, U, NOP), dtype=torch.bool, device=dev); o = torch.zeros((B, U), dtype=torch.long, device=dev)
   126	    qty = torch.zeros((B, U), dtype=torch.long, device=dev)
   127	    U_eff = int(umask.any(0).sum())  # slots beyond the largest hand count in the batch are PASS
   128	    for u in range(U_eff):
   129	        mu = base[:, u].clone()
   130	        for c, pid in enumerate(PLANT_IDS): mu[:, pid] = aux["empty"][:, u] & (seeds_left[:, c] > 0) & umask[:, u]
   131	        for it, pid in enumerate(PICK_IDS): mu[:, pid] = aux["adj"][:, u] & (shed_left[:, it] > 0) & umask[:, u]
   132	        mv = want[:, u] & mu
   133	        off = (t[:, u] != cur[:, u]) & mv.any(-1)
   134	        nonmove = mu.clone(); nonmove[:, MOVE_T.to(dev)] = False
   135	        mask = torch.where(off[:, None], mv, nonmove)
   136	        lg = ul[:, u].masked_fill(~mask, -1e9)
   137	        ou = lg.argmax(-1) if greedy else torch.distributions.Categorical(logits=lg).sample()
   138	        used[:, u] = mask; o[:, u] = ou
   139	        for c, pid in enumerate(PLANT_IDS): seeds_left[:, c] -= (ou == pid).long()
   140	        it_ = ARG1.to(dev)[ou].clamp(0, 11); is_pick = OPT.to(dev)[ou] == O.OP_PICKUP
   141	        n = torch.where(it_ >= 9, torch.ones_like(it_), torch.where(it_ == O.ITEM_FERTILIZER, 4, 3))
   142	        n = torch.minimum(n, shed_left.gather(1, it_[:, None]).squeeze(1)).clamp(min=1)
   143	        qty[:, u] = torch.where(is_pick, n, 0)
   144	        shed_left.scatter_add_(1, it_[:, None], -(n * is_pick.long())[:, None])
   145	    # market: hire / land caps as bucket masks
   146	    hire_max = (O.MAX_HANDS - st.n_hands[:, p].long()).clamp(min=0, max=feat.MKT_MAX)
   147	    land_max = (3 - st.land[:, p].long()).clamp(min=0)
   148	    mlm = market_mask(ml, hire_max, land_max)
   149	    mb = mlm.argmax(-1) if greedy else torch.distributions.Categorical(logits=mlm).sample()
   150	    orders, inc = build_market(mb)
   151	    rec = dict(board=board, G=G, uv=uv, ux=ux.to(torch.int8), uy=uy.to(torch.int8), umask=umask, opm=used,
   152	               t=t.to(torch.int8), o=o.to(torch.int8), mb=mb.to(torch.int8), hire_max=hire_max.to(torch.int8), land_max=land_max.to(torch.int8), minc=inc)
   153	    logp, ent = logprob(ul, tl, ml, rec)
   154	    farmer, hands = unit_triples(o, qty, st, p, umask)
   155	    return (farmer, hands, orders), logp, v, ent, rec
