     1	"""Train team-conditioned BC policy (board ResNet -> unit action head + market head).
     2	usage: python train.py --data mmpq,dsm,mgoose --out /workspace/shared/bc_runs/v1 --epochs 20"""
     3	import argparse, glob, json, os, sys, time
     4	import numpy as np, torch, torch.nn as nn, torch.nn.functional as F
     5	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
     6	import feat
     7	TEAMS = ["mmpq", "dsm", "mgoose"]  # default; overridden by --data
     8	
     9	def load(teams, root=os.environ.get("BC_DATA", "/workspace/shared/bc_data"), val_frac=0.1, seed=0):
    10	    rng = np.random.default_rng(seed); parts = {"train": [], "val": []}
    11	    for ti, t in enumerate(teams):
    12	        fs = sorted(glob.glob(f"{root}/{t}/*.npz")); rng.shuffle(fs)
    13	        nv = max(2, int(len(fs) * val_frac))
    14	        for k, f in enumerate(fs):
    15	            parts["val" if k < nv else "train"].append((ti, f))
    16	    out = {}
    17	    for split, lst in parts.items():
    18	        Bs, Gs, Qs, UT, UX, UY, UV, UA, W = [], [], [], [], [], [], [], [], []; TX, TY = [], []; off = 0
    19	        for ti, f in lst:
    20	            d = np.load(f); T = len(d["G"])
    21	            team = np.zeros((T, len(teams)), np.float32); team[:, ti] = 1
    22	            Bs.append(d["B"]); Gs.append(np.concatenate([d["G"], team], 1)); Qs.append(d["Q"])
    23	            UT.append(d["ut"] + off); UX.append(d["ux"]); UY.append(d["uy"]); UV.append(d["uv"]); UA.append(d["ua"]); TX.append(d["tx"]); TY.append(d["ty"])
    24	            W.append(np.full(T, 1.0 if bool(d["won"]) else 0.3, np.float32)); off += T
    25	        o = dict(B=np.concatenate(Bs), G=np.concatenate(Gs), Q=np.concatenate(Qs).astype(np.int64), ut=np.concatenate(UT),
    26	                 ux=np.concatenate(UX).astype(np.int64), uy=np.concatenate(UY).astype(np.int64), uv=np.concatenate(UV), ua=np.concatenate(UA).astype(np.int64), w=np.concatenate(W),
    27	                 tc=(np.concatenate(TY).astype(np.int64) * 10 + np.concatenate(TX).astype(np.int64)))
    28	        start = np.searchsorted(o["ut"], np.arange(len(o["G"]) + 1)); o["ustart"] = start
    29	        out[split] = o; print(split, len(lst), "eps", len(o["G"]), "steps", len(o["ua"]), "units", flush=True)
    30	    return out
    31	
    32	class Res(nn.Module):
    33	    def __init__(s, c):
    34	        super().__init__(); s.a = nn.Conv2d(c, c, 3, padding=1); s.b = nn.Conv2d(c, c, 3, padding=1)
    35	    def forward(s, x): return F.relu(x + s.b(F.relu(s.a(x))))
    36	
    37	class Net(nn.Module):
    38	    def __init__(s, gdim, ch=96, blocks=6):
    39	        super().__init__()
    40	        s.inp = nn.Conv2d(feat.C_BOARD + gdim, ch, 3, padding=1); s.body = nn.Sequential(*[Res(ch) for _ in range(blocks)])
    41	        s.unit = nn.Sequential(nn.Linear(ch + feat.U_DIM + gdim, 192), nn.ReLU(), nn.Linear(192, len(feat.UNIT_OPS)))
    42	        s.tq = nn.Sequential(nn.Linear(ch + feat.U_DIM + gdim, 192), nn.ReLU(), nn.Linear(192, ch))
    43	        s.mkt = nn.Sequential(nn.Linear(2 * ch + gdim, 384), nn.ReLU(), nn.Linear(384, len(feat.MKT_KEYS) * (feat.MKT_MAX + 1)))
    44	    def trunk(s, B, G):
    45	        x = torch.cat([B, G[:, :, None, None].expand(-1, -1, 10, 10)], 1)
    46	        return s.body(F.relu(s.inp(x)))
    47	    def forward(s, B, G, bi, ux, uy, uv):
    48	        h = s.trunk(B, G)
    49	        hu = h[bi, :, uy, ux]
    50	        uin = torch.cat([hu, uv, G[bi]], 1); ul = s.unit(uin)
    51	        tl = torch.einsum("uc,ucp->up", s.tq(uin), h.flatten(2)[bi]) / (h.shape[1] ** 0.5)
    52	        pooled = torch.cat([h.mean((2, 3)), h.amax((2, 3)), G], 1)
