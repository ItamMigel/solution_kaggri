   185	def unit_triples(o, qty, st, p, umask):
   186	    dev = o.device
   187	    opt = OPT.to(dev)[o]; a1 = ARG1.to(dev)[o]; item = a1.clamp(0, 11)
   188	    inv = st.inv[:, p].long()
   189	    is_place = opt == O.OP_PLACE; animal = item >= 9
   190	    place_n = torch.where(animal | (item == O.ITEM_FERTILIZER), torch.ones_like(item), inv.gather(2, item[..., None]).squeeze(-1)).clamp(min=1)
   191	    a2 = torch.where(opt == O.OP_PICKUP, qty, torch.where(is_place, place_n, torch.zeros_like(item)))
   192	    opt = torch.where(umask, opt, torch.zeros_like(opt))
   193	    trip = torch.stack([opt, a1, a2], -1)
   194	    return trip[:, 0], trip[:, 1:]
