   133	def _merge_actions(outputs, labels, names):
   134	    """Select player-one action batch rows from named league policies."""
   135	    chosen = None
   136	    for idx, name in enumerate(names):
   137	        action = outputs[name][0]
   138	        mask = labels == idx
   139	        if chosen is None:
   140	            chosen = tuple(x.clone() for x in action)
   141	        else:
   142	            chosen = tuple(torch.where(mask.view(-1, *([1] * (x.ndim - 1))), x, old)
   143	                           for old, x in zip(chosen, action))
   144	    return chosen
