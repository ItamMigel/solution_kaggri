    49	    Bd[:, 29] = torch.where(plant, (age >= FIRST_YIELD.to(dev)[sp.clamp(0, 4)]).float(), 0.0)
    50	    flag = st.tflag[:, p]; yld = st.tyield[:, p].float(); cons = st.tcons[:, p].float()
    51	    Bd[:, 9] = (plant & flag).float(); Bd[:, 10] = torch.where(plant, yld / 10.0, 0.0)
    52	    Bd[:, 11] = (plant & (st.tfert[:, p].long() >= day)).float(); Bd[:, 12] = torch.where(plant, cons, 0.0)
    53	    animal = kind == O.TILE_ANIMAL
