+def _deadline(world: _World, task: Task) -> bool:
+    """Only already-missed daily service may cross a worker's farm zone."""
+    tile = world.tile(task.target)
+    if not isinstance(tile, Mapping):
+        return False
+    if task.op == "FEED":
+        return int(tile.get("consecutive_unfed", 0) or 0) >= 1
+    if task.op == "WATER":
+        return int(tile.get("consecutive_unwatered", 0) or 0) >= 1
+    return False
