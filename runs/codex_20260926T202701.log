+        rows = range(0, world.height // 2) if north else range(world.height // 2, world.height)
+        cols = range(0, world.width // 2) if west else range(world.width // 2, world.width)
+        for y in rows:
+            row = list(cols)
+            if y % 2:
+                row.reverse()
+            result.extend((x, y) for x in row if world.owned((x, y)))
+    # Retain generic support for non-10x10 legality tests.
+    seen = set(result)
+    result.extend((x, y) for y in range(world.height) for x in range(world.width)
+                  if world.owned((x, y)) and (x, y) not in seen)
+    return result
+
+
+def _morning_zones(world: _World, state: _DispatchState) -> None:
+    """Partition the current farm once/day, then map actors to nearest zones."""
+    n = len(world.positions)
+    ordered = _zone_order(world)
+    chunks = tuple(frozenset(ordered[(i * len(ordered)) // n:((i + 1) * len(ordered)) // n])
+                   for i in range(n))
+    # Assign physical workers to the fixed contiguous chunks globally, rather
+    # than giving worker index i a randomly changing farm slice after hiring.
+    centres = []
+    for chunk in chunks:
+        centres.append(min(chunk, key=lambda xy: (xy[1], xy[0])) if chunk else (0, 0))
+    costs = [[_distance(_position(world, actor), centre) for centre in centres]
+             for actor in range(n)]
+    state.zones = chunks
+    state.zone_for_actor = tuple(_hungarian(costs)) if chunks else ()
+    state.day, state.unit_count = world.day, n
+    state.routes.clear()
+
+
+def _state_for(world: _World) -> _DispatchState:
+    state = _DISPATCH_STATE.setdefault(world.player, _DispatchState())
+    step = int(world.obs.get("step", 0) or 0)
+    # `step <= old` safely handles a fresh local episode and repeated
+    # observations; route intent is only meaningful across a forward step.
+    if step <= state.step:
+        state = _DISPATCH_STATE[world.player] = _DispatchState()
+    if (not state.zones or state.day != world.day or state.unit_count != len(world.positions)
+            or step % 24 == 0):
+        _morning_zones(world, state)
+    state.step = step
+    return state
+
+
