+def _nearby_route(world: _World, state: _DispatchState, actor: int, first: Task,
+                  candidates: list[Task]) -> list[Task]:
+    """Commit at most three same-zone stops, so a trip has useful local work."""
+    out = [first]
+    origin = first.target
+    for _ in range(2):
+        options = [task for task in candidates
+                   if task.key not in {x.key for x in out}
+                   and (_in_actor_zone(state, actor, task) or _deadline(world, task))
+                   and _distance(origin, task.target) <= 3]
+        if not options:
+            break
+        # Prefer an urgent/service endpoint, then the next physically nearby
+        # job.  Do not require current actor cargo here: a preceding FETCH may
+        # make a feed operation legal by the time this endpoint is visited.
