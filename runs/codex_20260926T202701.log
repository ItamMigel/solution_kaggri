+def _in_actor_zone(state: _DispatchState, actor: int, task: Task) -> bool:
+    return (0 <= actor < len(state.zone_for_actor) and
+            0 <= state.zone_for_actor[actor] < len(state.zones) and
+            task.target in state.zones[state.zone_for_actor[actor]])
+
+
+def _zone_eligible(world: _World, state: _DispatchState, actor: int, task: Task) -> bool:
+    # Shed access is shared infrastructure, not a competing farm zone.  All
+    # other work remains local unless a missed FEED/WATER deadline requires a
+    # rescue trip across a zone boundary.
+    return world.at_shed(task.target) or _in_actor_zone(state, actor, task) or _deadline(world, task)
