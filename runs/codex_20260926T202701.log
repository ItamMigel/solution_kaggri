"""top-RE agent entry (bundled into a single main.py by bundle.py).
Pipeline per turn: plan.desired -> market.orders -> units.act."""
def _unit_plan(obs, player, want):
    tiles = obs["farms"][player]["tiles"]; seeds = (obs.get("private") or {}).get("seeds") or {}
    plant, build, place, dig = {}, {}, {}, {}
    for (x, y), role in want.items():
        t = tiles[y][x]
        if ":" in role:
            kind, animal = role.split(":")
            if t is None: build[(x, y)] = kind
            elif isinstance(t, dict) and t.get("kind") == kind and not t.get("animal"): place[(x, y)] = animal
            elif isinstance(t, dict) and t.get("kind") == "WEED": dig[(x, y)] = 1
        else:
            if t is None and seeds.get(role, 0) > 0: plant[(x, y)] = role
            elif isinstance(t, dict) and t.get("kind") == "WEED": dig[(x, y)] = 1
    for y, row in enumerate(tiles):
        for x, t in enumerate(row):
            if isinstance(t, dict) and t.get("kind") == "WEED": dig[(x, y)] = 1
    return {"plant_targets": plant, "build_targets": build, "place_targets": place, "dig_targets": dig, "load_size": 6, "player": player, "want": want}

def agent(obs, config=None):
    player = int(obs["player"])
    want = plan_desired(obs, player)
    tg = plan_targets(obs, player)
    try:
        market = market_orders(obs, player, want, tg)
    except Exception:
        market = []
    try:
        farmer, hands = units_act(obs, _unit_plan(obs, player, want))
    except Exception:
        farmer, hands = ["PASS"], [["PASS"] for _ in obs["farms"][player].get("hands") or []]
    return {"farmer": farmer, "hands": hands, "market": market}
"""top-RE market layer: HIRE / BUY_LAND / BUY_SEED / BUY_ANIMAL / BUY_PRODUCT WHEAT / SELL, max 10 orders per turn.
orders(obs, player, want, tg) -> list of market orders. Cash priority: land > hires > animals > seeds > feed; sales first."""
SEED = {"WHEAT": 10, "CARROT": 20, "TOMATO": 50, "STRAWBERRY": 100, "MELON": 80}
ANIMAL = {"GOOSE": 300, "COW": 400, "SHEEP": 500}
LAND = [1000, 2000, 4000]
BASE = {"WHEAT": 25, "CARROT": 35, "TOMATO": 60, "STRAWBERRY": 120, "MELON": 250, "EGG": 50, "MILK": 160, "WOOL": 200, "FERTILIZER": 100}
STEEP = {"STRAWBERRY", "MELON", "MILK", "WOOL"}  # price falls fast with supply: meter these out
def fib_cost(n):  # cost of the (n+1)-th hire today
    a, b = 1, 1
    for _ in range(n): a, b = b, a + b
    return a
def orders(obs, player, want, tg):
    farm = obs["farms"][player]; priv = obs.get("private") or {}; shed = dict(priv.get("shed") or {}); seeds = dict(priv.get("seeds") or {})
    step = int(obs.get("step", 0)); day = int(obs["day"]); hour = int(obs.get("hour", step % 24)); money = float(farm["money"])
    prices = obs["market"]["prices"]; out = []
    carried = {}
    for inv in priv.get("inventories") or []:
        for k, v in inv.items(): carried[k] = carried.get(k, 0) + v
    animals = 0; empty_struct = {"COOP": 0, "PASTURE": 0}; tiles = farm["tiles"]
    for row in tiles:
        for t in row:
            if isinstance(t, dict) and t.get("kind") in ("COOP", "PASTURE"):
                if t.get("animal"): animals += 1
                else: empty_struct[t["kind"]] += 1
    last = step >= 715
    # --- SELL (revenue first). Keep feed wheat; meter steep items unless late game.
    planned_animals = sum(1 for r in want.values() if ":" in r)
    feed_need = max(animals, min(planned_animals, animals + 3)) * tg["wheat_reserve_per_animal"]
    for item in ("MELON", "STRAWBERRY", "MILK", "WOOL", "EGG", "CARROT", "TOMATO", "WHEAT", "FERTILIZER"):
        have = shed.get(item, 0)
        if item == "WHEAT": have -= feed_need
        if item == "FERTILIZER": have -= 4
        if have <= 0 or len(out) >= 6: continue
        if item in STEEP and not last and day < 28:
            if prices[item] < 0.4 * BASE[item] and have < 25: continue   # deep glut: wait for town consumption
            have = min(have, 15)
        out.append(["SELL", item, int(have)]); money += have * prices[item] * 0.9
    # --- LAND
    nq = len(farm.get("unlocked_quadrants") or ["NW"])
    if nq < 3:
        nxt = nq + 1; st = tg["land_step"].get(nxt)
        if st is not None and step >= st and money >= LAND[nq - 1] + 150:
            out.append(["BUY_LAND"]); money -= LAND[nq - 1]
    # --- HIRE up to today's target
    need_h = tg["hands"] - len(farm.get("hands") or [])
    h = int(farm.get("hires_today", 0))
    while need_h > 0 and len(out) < 10 and money >= fib_cost(h) + 50:
        out.append(["HIRE"]); money -= fib_cost(h); h += 1; need_h -= 1
    # --- SEEDS for empty desired crop tiles
    need_s = {}
    for (x, y), role in want.items():
        if ":" in role: continue
        if tiles[y][x] is None: need_s[role] = need_s.get(role, 0) + 1
    for c in ("MELON", "WHEAT", "STRAWBERRY", "CARROT", "TOMATO"):
        n = need_s.get(c, 0) - seeds.get(c, 0)
        if n > 0 and len(out) < 10:
            k = min(n, int(max(0, money - 30) // SEED[c]))
            if k > 0: out.append(["BUY_SEED", c, k]); money -= k * SEED[c]
    # --- ANIMALS for empty structures (+ planned structure tiles still empty ground)
    need_a = {"GOOSE": 0, "COW": 0, "SHEEP": 0}
    for (x, y), role in want.items():
        if ":" not in role: continue
        kind, a = role.split(":"); t = tiles[y][x]
        if t is None or (isinstance(t, dict) and t.get("kind") == kind and not t.get("animal")): need_a[a] += 1
    for a in ("COW", "SHEEP", "GOOSE"):
        n = need_a[a] - shed.get(a, 0) - carried.get(a, 0)
        if shed.get(a, 0) + carried.get(a, 0) >= 2: n = 0   # animals waiting for placement: don't buy more
        while n > 0 and money >= ANIMAL[a] + 100 and len(out) < 10:
            k = min(n, int((money - 100) // ANIMAL[a]))
            if k <= 0: break
            out.append(["BUY_ANIMAL", a, k]); money -= k * ANIMAL[a]; n -= k
    # --- FEED wheat top-up
    wheat = shed.get("WHEAT", 0) + carried.get("WHEAT", 0)
    if wheat < feed_need and len(out) < 10:
        k = min(feed_need - wheat, int(max(0, money - 30) // max(1, prices["WHEAT"] + 1)))
        if k > 0: out.append(["BUY_PRODUCT", "WHEAT", k])
    return out[:10]
"""Minimal greedy unit controller (fallback / smoke test for plan+market). act(obs, plan) -> (farmer, hands)."""
ACCESS = [(4, 4), (5, 4), (4, 5), (5, 5)]
CROPS = {"WHEAT": (2, 4, False, 6), "CARROT": (2, 3, False, 4), "TOMATO": (8, 8, True, 4), "STRAWBERRY": (10, 10, True, 4), "MELON": (10, 12, False, 6)}
PRODUCTS = ("WHEAT", "CARROT", "TOMATO", "STRAWBERRY", "MELON", "EGG", "MILK", "WOOL", "FERTILIZER")
def _step_toward(p, q):
    if p[0] < q[0]: return ["EAST"]
    if p[0] > q[0]: return ["WEST"]
    if p[1] < q[1]: return ["SOUTH"]
    if p[1] > q[1]: return ["NORTH"]
    return None
def act(obs, plan):
    p = plan["player"]; farm = obs["farms"][p]; priv = obs.get("private") or {}; day = int(obs["day"]); hour = int(obs.get("hour", 0))
    tiles = farm["tiles"]; want = plan["want"]; seeds = dict(priv.get("seeds") or {}); shed = dict(priv.get("shed") or {})
    units = [tuple(farm["farmer"])] + [tuple(h) for h in (farm.get("hands") or [])]
    invs = list(priv.get("inventories") or [])
    while len(invs) < len(units): invs.append({})
    tasks = []  # (value, (x,y), action, needs)
    for y in range(10):
        for x in range(10):
            t = tiles[y][x]; role = want.get((x, y))
            if t == "LOCKED": continue
            if t is None:
                if role and ":" not in role and seeds.get(role, 0) > 0: tasks.append((6, (x, y), ["PLANT", role], None))
                elif role and ":" in role: tasks.append((5, (x, y), ["BUILD_" + role.split(":")[0]], None))
                continue
            k = t.get("kind")
            if k == "WEED": tasks.append((2, (x, y), ["DIG"], None)); continue
            if k == "PLANT":
                fyd, myd, ongoing, mx = CROPS[t["crop"]]; age = day - t["planted_day"]
                if not t["watered_today"]: tasks.append((9 if t["consecutive_unwatered"] >= 1 else 4, (x, y), ["WATER"], None))
                if t.get("yield_units", 0) > 0 and (ongoing or age >= myd or t["yield_units"] >= mx): tasks.append((7, (x, y), ["HARVEST"], None))
                if role and role != t["crop"] and not ongoing and age >= myd and t.get("yield_units", 0) <= 0: tasks.append((1, (x, y), ["DIG"], None))
                continue
            if k in ("COOP", "PASTURE"):
                if t.get("animal"):
                    if not t.get("fed_today"): tasks.append((10 if t.get("consecutive_unfed", 0) >= 1 else 8, (x, y), ["FEED"], "WHEAT"))
                    if not t.get("cared_today"): tasks.append((3, (x, y), ["CARE"], None))
                    if t.get("yield_units", 0) > 0: tasks.append((6, (x, y), ["HARVEST"], None))
                    if t.get("fertilizer_available"): tasks.append((2, (x, y), ["COLLECT_FERTILIZER"], None))
                else:
                    a = (role or ":").split(":")[1]
                    if a: tasks.append((7, (x, y), ["PLACE", a], a))
    # zones: split owned tiles into len(units) contiguous chunks (by quadrant, then row) -> each unit prefers its zone
    owned = [(x, y) for y in range(10) for x in range(10) if tiles[y][x] != "LOCKED"]
    owned.sort(key=lambda t: (("NW", "NE", "SW", "SE").index(("N" if t[1] < 5 else "S") + ("W" if t[0] < 5 else "E")), t[1], t[0] if t[1] % 2 == 0 else -t[0]))
    nz = max(1, len(units)); zone = {t: (i * nz) // max(1, len(owned)) for i, t in enumerate(owned)}
    taken = set(); acts = []
    for i, u in enumerate(units):
        inv = invs[i]; carrying = {k: v for k, v in inv.items() if v > 0}
        prod = sum(v for k, v in carrying.items() if k in PRODUCTS and k != "WHEAT")
        best = None
        for val, pos, a, need in tasks:
            if (pos, a[0]) in taken: continue
            if need and carrying.get(need, 0) <= 0: continue
            d = abs(u[0] - pos[0]) + abs(u[1] - pos[1]); score = val / (1 + d)
            if zone.get(pos, 0) == i % nz: score *= 3.0
            if best is None or score > best[0]: best = (score, pos, a, d)
        # shed errands: drop products / fetch wheat or animals
        acc = min(ACCESS, key=lambda q: abs(u[0] - q[0]) + abs(u[1] - q[1])); dacc = abs(u[0] - acc[0]) + abs(u[1] - acc[1])
        unfed = sum(1 for _, _, a, n in tasks if n == "WHEAT")
        need_wheat = unfed > 0 and carrying.get("WHEAT", 0) <= 0 and shed.get("WHEAT", 0) > 0 and i < 1 + max(2, unfed // 3)
        need_animal = next((n for _, _, a, n in tasks if a[0] == "PLACE" and shed.get(n, 0) > 0 and carrying.get(n, 0) <= 0), None)
        errand = None
        at_shed = dacc == 0
        if at_shed and prod > 0: errand = ["DROP"]
        elif at_shed and carrying.get("WHEAT", 0) < 2 and shed.get("WHEAT", 0) >= 4 and unfed > 0:
            k = min(shed["WHEAT"], 4); errand = ["PICKUP", "WHEAT", k]; shed["WHEAT"] -= k
        elif at_shed and need_animal: errand = ["PICKUP", need_animal, 1]; shed[need_animal] -= 1
        elif prod >= 8 or (hour >= 22 and prod > 0): errand = ["DROP"]
        elif need_wheat: k = min(shed.get("WHEAT", 0), max(4, unfed)); errand = ["PICKUP", "WHEAT", k]; shed["WHEAT"] = shed.get("WHEAT", 0) - k
        elif need_animal: errand = ["PICKUP", need_animal, 1]; shed[need_animal] -= 1
        if errand:
            acts.append(errand if dacc == 0 else _step_toward(u, acc)); continue
        if best is None: acts.append(["PASS"]); continue
        _, pos, a, d = best; taken.add((pos, a[0]))
        acts.append(a if d == 0 else _step_toward(u, pos))
    return acts[0], acts[1:]
